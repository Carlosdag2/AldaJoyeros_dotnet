using AutoMapper;
using AldaJoyeros.DTOs;
using AldaJoyeros.Entities;

namespace AldaJoyeros.Mappings
{
    public class MappingProfile : Profile
    {
        public MappingProfile()
        {
            // Usuario
            CreateMap<Usuario, UsuarioDto>();
            CreateMap<UsuarioCreateDto, Usuario>();
            CreateMap<UsuarioUpdateDto, Usuario>();

            // Categoria
            CreateMap<Categoria, CategoriaDto>();
            CreateMap<CategoriaCreateDto, Categoria>();
            CreateMap<CategoriaUpdateDto, Categoria>();

            // Producto
            CreateMap<Producto, ProductoDto>()
                .ForMember(dest => dest.CategoriaNombre, opt => opt.MapFrom(src => src.Categoria.Nombre));
            CreateMap<ProductoCreateDto, Producto>();
            CreateMap<ProductoUpdateDto, Producto>();

            // CarritoItem
            CreateMap<CarritoItem, CarritoItemDto>()
                .ForMember(dest => dest.ProductoNombre, opt => opt.MapFrom(src => src.Producto.Nombre))
                .ForMember(dest => dest.Subtotal, opt => opt.MapFrom(src => src.Cantidad * src.Precio));
            CreateMap<CarritoItemCreateDto, CarritoItem>();

            // Direccion
            CreateMap<Direccion, DireccionDto>();
            CreateMap<DireccionCreateDto, Direccion>();
            CreateMap<DireccionUpdateDto, Direccion>();

            // Pedido
            CreateMap<Pedido, PedidoDto>()
                .ForMember(dest => dest.Estado, opt => opt.MapFrom(src => src.Estado.ToString()))
                .ForMember(dest => dest.UsuarioEmail, opt => opt.MapFrom(src => src.Usuario != null ? src.Usuario.Email : null))
                .ForMember(dest => dest.Total, opt => opt.MapFrom(src => src.LineasPedido.Sum(l => l.Cantidad * l.Precio)));

            // LineaPedido
            CreateMap<LineaPedido, LineaPedidoDto>()
                .ForMember(dest => dest.ProductoNombre, opt => opt.MapFrom(src => src.Producto != null ? src.Producto.Nombre : null))
                .ForMember(dest => dest.Subtotal, opt => opt.MapFrom(src => src.Cantidad * src.Precio));
        }
    }
}
