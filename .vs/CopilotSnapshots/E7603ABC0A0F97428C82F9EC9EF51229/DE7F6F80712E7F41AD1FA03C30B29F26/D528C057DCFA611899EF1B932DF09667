@model AldaJoyeros.DTOs.ProductoDto

@{
    ViewData["Title"] = Model.Nombre;
}

<!-- Breadcrumb -->
<nav class="mb-8">
    <ol class="flex items-center space-x-2 text-sm text-gray-600">
        <li><a asp-controller="Home" asp-action="Index" class="hover:text-yellow-600 transition-colors">Inicio</a></li>
        <li><i class="fas fa-chevron-right text-xs"></i></li>
        <li><a asp-action="Index" class="hover:text-yellow-600 transition-colors">Productos</a></li>
        <li><i class="fas fa-chevron-right text-xs"></i></li>
        <li class="text-gray-900 font-semibold">@Model.Nombre</li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
    <!-- Product Image -->
    <div class="space-y-4">
        <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-3xl p-12 shadow-2xl">
            <div class="aspect-square flex items-center justify-center">
                <i class="fas fa-gem text-yellow-600" style="font-size: 15rem; opacity: 0.3;"></i>
            </div>
        </div>
        
        <!-- Trust Badges -->
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-white rounded-xl p-4 text-center shadow-md">
                <i class="fas fa-shipping-fast text-2xl text-blue-600 mb-2"></i>
                <p class="text-xs text-gray-700 font-medium">Envío rápido</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-md">
                <i class="fas fa-undo text-2xl text-green-600 mb-2"></i>
                <p class="text-xs text-gray-700 font-medium">30 días devolución</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-md">
                <i class="fas fa-certificate text-2xl text-purple-600 mb-2"></i>
                <p class="text-xs text-gray-700 font-medium">Garantía oficial</p>
            </div>
        </div>
    </div>

    <!-- Product Info -->
    <div class="space-y-6">
        <!-- Category Badge -->
        <div>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-purple-100 text-purple-800">
                <i class="fas fa-tag mr-2"></i>
                @Model.CategoriaNombre
            </span>
        </div>

        <!-- Title -->
        <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-900">
            @Model.Nombre
        </h1>

        <!-- Price -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-6">
            <div class="flex items-baseline">
                <span class="text-5xl font-bold text-gradient">@Model.Precio.ToString("C")</span>
                <span class="ml-3 text-gray-600">IVA incluido</span>
            </div>
        </div>

        <!-- Description -->
        <div class="bg-white rounded-2xl p-6 shadow-md">
            <h3 class="font-display text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-info-circle text-blue-600 mr-3"></i>
                Descripción
            </h3>
            <p class="text-gray-700 leading-relaxed">@Model.Descripcion</p>
        </div>

        <!-- Add to Cart Form -->
        <form asp-controller="Carrito" asp-action="Agregar" method="post" class="space-y-4">
            <input type="hidden" name="productoId" value="@Model.Id" />
            
            <div class="bg-gray-50 rounded-xl p-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-calculator mr-2"></i>Cantidad
                </label>
                <input type="number" 
                       name="cantidad" 
                       value="1" 
                       min="1" 
                       max="10" 
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200 font-semibold text-lg" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <button type="submit" 
                        class="w-full gradient-gold text-gray-900 py-4 rounded-xl font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                    <i class="fas fa-cart-plus mr-2"></i>
                    Agregar al Carrito
                </button>
                <a asp-action="Index" 
                   class="w-full flex items-center justify-center px-6 py-4 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 font-bold text-lg">
                    <i class="fas fa-arrow-left mr-2"></i>
                    Volver
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Features -->
<div class="bg-white rounded-3xl p-8 shadow-lg mb-12">
    <h3 class="font-display text-3xl font-bold text-gray-900 mb-8 text-center">
        Características del Producto
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex items-start space-x-4 bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-green-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Material de alta calidad</h4>
                <p class="text-gray-600 text-sm">Materiales premium seleccionados</p>
            </div>
        </div>
        <div class="flex items-start space-x-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-blue-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Acabado profesional</h4>
                <p class="text-gray-600 text-sm">Elaborado por expertos artesanos</p>
            </div>
        </div>
        <div class="flex items-start space-x-4 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-purple-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Diseño exclusivo</h4>
                <p class="text-gray-600 text-sm">Piezas únicas y originales</p>
            </div>
        </div>
        <div class="flex items-start space-x-4 bg-gradient-to-br from-yellow-50 to-orange-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-yellow-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Certificado de autenticidad</h4>
                <p class="text-gray-600 text-sm">Garantía oficial incluida</p>
            </div>
        </div>
        <div class="flex items-start space-x-4 bg-gradient-to-br from-red-50 to-pink-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-red-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Caja de regalo incluida</h4>
                <p class="text-gray-600 text-sm">Presentación especial premium</p>
            </div>
        </div>
        <div class="flex items-start space-x-4 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-6">
            <i class="fas fa-check-circle text-3xl text-indigo-600"></i>
            <div>
                <h4 class="font-bold text-gray-900 mb-1">Garantía de por vida</h4>
                <p class="text-gray-600 text-sm">Respaldo total del fabricante</p>
            </div>
        </div>
    </div>
</div>

<!-- CTA Banner -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 rounded-3xl p-12 text-center text-white">
    <i class="fas fa-headset text-5xl text-yellow-500 mb-4"></i>
    <h3 class="font-display text-3xl font-bold mb-4">¿Necesitas ayuda?</h3>
    <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
        Nuestro equipo de expertos está disponible para asesorarte en tu compra
    </p>
    <a href="#" class="inline-flex items-center gradient-gold text-gray-900 px-8 py-4 rounded-full font-bold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
        <i class="fas fa-phone mr-3"></i>
        Contactar Ahora
    </a>
</div>
