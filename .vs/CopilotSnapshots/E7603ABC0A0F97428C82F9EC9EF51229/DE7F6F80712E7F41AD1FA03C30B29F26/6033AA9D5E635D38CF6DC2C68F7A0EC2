@{
    ViewData["Title"] = "Panel de Administración";
}

<!-- Header -->
<div class="mb-8">
    <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-900 mb-2">
        <i class="fas fa-tachometer-alt text-yellow-600"></i> Panel de Administración
    </h1>
    <p class="text-gray-600">Gestiona todos los aspectos de Alda Joyeros desde aquí</p>
</div>

<!-- Quick Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
    <!-- Categorías -->
    <div class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl p-6 text-white shadow-xl transform hover:-translate-y-2 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <i class="fas fa-tags text-3xl"></i>
            </div>
            <i class="fas fa-arrow-up text-green-300"></i>
        </div>
        <h3 class="text-sm font-semibold text-purple-100 mb-1">CATEGORÍAS</h3>
        <div class="text-3xl font-bold mb-2">--</div>
        <a asp-controller="AdminCategorias" asp-action="Index" 
           class="inline-flex items-center text-sm font-semibold hover:text-purple-100 transition-colors group">
            Ver todas
            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>

    <!-- Productos -->
    <div class="bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl p-6 text-white shadow-xl transform hover:-translate-y-2 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <i class="fas fa-gem text-3xl"></i>
            </div>
            <i class="fas fa-arrow-up text-green-300"></i>
        </div>
        <h3 class="text-sm font-semibold text-green-100 mb-1">PRODUCTOS</h3>
        <div class="text-3xl font-bold mb-2">--</div>
        <a asp-controller="AdminProductos" asp-action="Index" 
           class="inline-flex items-center text-sm font-semibold hover:text-green-100 transition-colors group">
            Gestionar
            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>

    <!-- Pedidos -->
    <div class="bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl p-6 text-white shadow-xl transform hover:-translate-y-2 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <i class="fas fa-box text-3xl"></i>
            </div>
            <i class="fas fa-arrow-up text-orange-300"></i>
        </div>
        <h3 class="text-sm font-semibold text-orange-100 mb-1">PEDIDOS</h3>
        <div class="text-3xl font-bold mb-2">--</div>
        <a asp-controller="AdminPedidos" asp-action="Index" 
           class="inline-flex items-center text-sm font-semibold hover:text-orange-100 transition-colors group">
            Ver pedidos
            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>

    <!-- Usuarios -->
    <div class="bg-gradient-to-br from-blue-500 to-indigo-500 rounded-2xl p-6 text-white shadow-xl transform hover:-translate-y-2 transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <i class="fas fa-users text-3xl"></i>
            </div>
            <i class="fas fa-arrow-up text-blue-300"></i>
        </div>
        <h3 class="text-sm font-semibold text-blue-100 mb-1">USUARIOS</h3>
        <div class="text-3xl font-bold mb-2">--</div>
        <a asp-controller="AdminUsuarios" asp-action="Index" 
           class="inline-flex items-center text-sm font-semibold hover:text-blue-100 transition-colors group">
            Gestionar
            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>
</div>

<!-- Quick Actions -->
<div class="bg-white rounded-3xl shadow-xl p-8 mb-12">
    <h2 class="font-display text-3xl font-bold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-bolt text-yellow-600 mr-3"></i>
        Acciones Rápidas
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a asp-controller="AdminCategorias" asp-action="Crear" 
           class="group bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-purple-500">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-purple-500 rounded-lg flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-plus text-white text-xl"></i>
                </div>
                <div>
                    <div class="font-bold text-gray-900">Nueva Categoría</div>
                    <div class="text-sm text-gray-600">Crear categoría de productos</div>
                </div>
            </div>
        </a>

        <a asp-controller="AdminProductos" asp-action="Crear" 
           class="group bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-green-500">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-plus text-white text-xl"></i>
                </div>
                <div>
                    <div class="font-bold text-gray-900">Nuevo Producto</div>
                    <div class="text-sm text-gray-600">Agregar producto al catálogo</div>
                </div>
            </div>
        </a>

        <a asp-controller="AdminUsuarios" asp-action="Crear" 
           class="group bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-blue-500">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-user-plus text-white text-xl"></i>
                </div>
                <div>
                    <div class="font-bold text-gray-900">Nuevo Usuario</div>
                    <div class="text-sm text-gray-600">Crear cuenta de usuario</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Management Sections -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Categories & Products -->
    <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-8 text-white shadow-2xl">
        <h2 class="font-display text-2xl font-bold mb-6 flex items-center">
            <i class="fas fa-store text-yellow-500 mr-3"></i>
            Catálogo
        </h2>
        <div class="space-y-4">
            <a asp-controller="AdminCategorias" asp-action="Index" 
               class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group">
                <div class="flex items-center">
                    <i class="fas fa-tags text-purple-400 text-2xl mr-4"></i>
                    <div>
                        <div class="font-bold">Categorías</div>
                        <div class="text-sm text-gray-400">Gestionar categorías de productos</div>
                    </div>
                </div>
                <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
            </a>
            <a asp-controller="AdminProductos" asp-action="Index" 
               class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group">
                <div class="flex items-center">
                    <i class="fas fa-gem text-green-400 text-2xl mr-4"></i>
                    <div>
                        <div class="font-bold">Productos</div>
                        <div class="text-sm text-gray-400">Administrar inventario</div>
                    </div>
                </div>
                <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>
    </div>

    <!-- Orders & Users -->
    <div class="bg-gradient-to-br from-yellow-500 to-orange-500 rounded-3xl p-8 text-white shadow-2xl">
        <h2 class="font-display text-2xl font-bold mb-6 flex items-center">
            <i class="fas fa-users-cog text-white mr-3"></i>
            Gestión
        </h2>
        <div class="space-y-4">
            <a asp-controller="AdminPedidos" asp-action="Index" 
               class="flex items-center justify-between bg-white bg-opacity-20 rounded-xl p-4 hover:bg-opacity-30 transition-all group">
                <div class="flex items-center">
                    <i class="fas fa-box text-white text-2xl mr-4"></i>
                    <div>
                        <div class="font-bold">Pedidos</div>
                        <div class="text-sm text-yellow-100">Ver y gestionar pedidos</div>
                    </div>
                </div>
                <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
            </a>
            <a asp-controller="AdminUsuarios" asp-action="Index" 
               class="flex items-center justify-between bg-white bg-opacity-20 rounded-xl p-4 hover:bg-opacity-30 transition-all group">
                <div class="flex items-center">
                    <i class="fas fa-users text-white text-2xl mr-4"></i>
                    <div>
                        <div class="font-bold">Usuarios</div>
                        <div class="text-sm text-yellow-100">Administrar cuentas</div>
                    </div>
                </div>
                <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>
    </div>
</div>

<!-- Info Banner -->
<div class="mt-12 bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-6">
    <div class="flex items-start">
        <i class="fas fa-info-circle text-3xl text-blue-600 mr-4 mt-1"></i>
        <div>
            <h3 class="font-bold text-gray-900 text-lg mb-2">
                Bienvenido al Panel de Administración
            </h3>
            <p class="text-gray-700">
                Desde aquí puedes gestionar todas las funcionalidades de Alda Joyeros: categorías, productos, pedidos y usuarios. 
                Utiliza el menú superior o las tarjetas de acceso rápido para navegar entre las diferentes secciones.
            </p>
        </div>
    </div>
</div>
