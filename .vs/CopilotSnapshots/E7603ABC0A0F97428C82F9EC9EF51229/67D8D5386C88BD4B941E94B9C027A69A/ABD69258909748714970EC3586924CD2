@model IEnumerable<AldaJoyeros.DTOs.UsuarioDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users"></i> Usuarios</h1>
    <a asp-action="Crear" class="btn btn-info">
        <i class="fas fa-user-plus"></i> Nuevo Usuario
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.Id</td>
                                <td><i class="fas fa-user"></i> @usuario.Email</td>
                                <td>
                                    @if (usuario.Rol == "ADMIN")
                                    {
                                        <span class="badge bg-danger">🛡️ ADMIN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">👤 USER</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@usuario.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este usuario?')">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No hay usuarios registrados.
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Volver al Panel
    </a>
</div>
