@model AldaJoyeros.DTOs.DireccionDto

@{
    ViewData["Title"] = "Checkout";
}

<h1 class="mb-4"><i class="fas fa-credit-card"></i> Finalizar Compra</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Dirección de Envío</h5>
            </div>
            <div class="card-body">
                <form asp-action="Checkout" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Calle" class="form-label"></label>
                            <input asp-for="Calle" class="form-control" placeholder="Nombre de la calle" />
                            <span asp-validation-for="Calle" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Numero" class="form-label"></label>
                            <input asp-for="Numero" class="form-control" placeholder="Núm." />
                            <span asp-validation-for="Numero" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Piso" class="form-label"></label>
                        <input asp-for="Piso" class="form-control" placeholder="Piso, puerta (opcional)" />
                        <span asp-validation-for="Piso" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CodigoPostal" class="form-label"></label>
                            <input asp-for="CodigoPostal" class="form-control" placeholder="28001" />
                            <span asp-validation-for="CodigoPostal" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Ciudad" class="form-label"></label>
                            <input asp-for="Ciudad" class="form-control" placeholder="Madrid" />
                            <span asp-validation-for="Ciudad" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Provincia" class="form-label"></label>
                            <input asp-for="Provincia" class="form-control" placeholder="Madrid" />
                            <span asp-validation-for="Provincia" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Carrito" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Volver al Carrito
                        </a>
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check"></i> Confirmar Pedido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Información del Pedido</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-truck text-primary"></i> Envío en 3-5 días laborables</li>
                    <li class="mb-2"><i class="fas fa-shield-alt text-primary"></i> Compra 100% segura</li>
                    <li class="mb-2"><i class="fas fa-undo text-primary"></i> 30 días para devoluciones</li>
                    <li class="mb-2"><i class="fas fa-gift text-primary"></i> Empaquetado especial incluido</li>
                </ul>
            </div>
        </div>

        <div class="alert alert-info mt-3">
            <h6><i class="fas fa-info-circle"></i> Métodos de Pago</h6>
            <p class="small mb-0">Contra reembolso / Transferencia bancaria</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
