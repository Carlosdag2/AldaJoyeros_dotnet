using Microsoft.AspNetCore.Mvc;
using AldaJoyeros.Services.Interfaces;
using AldaJoyeros.DTOs;

namespace AldaJoyeros.Controllers
{
    public class PedidosController : BaseController
    {
        private readonly IPedidoService _pedidoService;
        private readonly IDireccionService _direccionService;

        public PedidosController(IPedidoService pedidoService, IDireccionService direccionService)
        {
            _pedidoService = pedidoService;
            _direccionService = direccionService;
        }

        public async Task<IActionResult> Index()
        {
            if (!IsAuthenticated)
            {
                return RedirectToAction("Login", "Auth");
            }

            var pedidos = await _pedidoService.GetByUsuarioIdAsync(CurrentUser!.Id);
            return View(pedidos);
        }

        public async Task<IActionResult> Detalle(long id)
        {
            if (!IsAuthenticated)
            {
                return RedirectToAction("Login", "Auth");
            }

            var pedido = await _pedidoService.GetByIdAsync(id);
            
            if (pedido == null || pedido.UsuarioId != CurrentUser!.Id)
            {
                return NotFound();
            }

            return View(pedido);
        }

        [HttpGet]
        public async Task<IActionResult> Checkout()
        {
            if (!IsAuthenticated)
            {
                return RedirectToAction("Login", "Auth");
            }

            var direccion = await _direccionService.GetByUsuarioIdAsync(CurrentUser!.Id);
            return View(direccion);
        }

        [HttpPost]
        public async Task<IActionResult> Checkout(DireccionCreateDto direccionDto)
        {
            if (!IsAuthenticated)
            {
                return RedirectToAction("Login", "Auth");
            }

            if (!ModelState.IsValid)
            {
                return View(direccionDto);
            }

            try
            {
                var pedidoCreateDto = new PedidoCreateDto
                {
                    Direccion = direccionDto
                };

                var pedido = await _pedidoService.CreateFromCarritoAsync(CurrentUser!.Id, pedidoCreateDto);
                TempData["Success"] = "Pedido realizado con éxito";
                
                return RedirectToAction("Detalle", new { id = pedido.Id });
            }
            catch (Exception ex)
            {
                ModelState.AddModelError("", ex.Message);
                return View(direccionDto);
            }
        }
    }
}
