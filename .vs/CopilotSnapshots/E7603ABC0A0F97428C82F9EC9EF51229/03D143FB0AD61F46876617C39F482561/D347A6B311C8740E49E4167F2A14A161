@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Catálogo de Productos";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as long?;
    var busqueda = ViewBag.Busqueda as string ?? "";
}

<!-- Hero Section -->
<div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl p-8 mb-8 shadow-lg">
    <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        <i class="fas fa-gem text-yellow-600"></i> Catálogo de Joyas
    </h1>
    <p class="text-gray-600 text-lg mb-6">Descubre nuestra exclusiva colección de joyería fina</p>
    
    <!-- Buscador -->
    <form asp-action="Index" method="get" class="max-w-2xl">
        <div class="relative">
            <input type="hidden" name="categoriaId" value="@categoriaSeleccionada" />
            <input type="text" 
                   name="busqueda" 
                   value="@busqueda"
                   placeholder="Buscar por nombre, descripción o categoría..."
                   class="w-full px-6 py-4 pr-32 text-lg border-2 border-gray-300 rounded-xl focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200 shadow-sm" />
            <button type="submit" 
                    class="absolute right-2 top-1/2 -translate-y-1/2 gradient-gold text-gray-900 px-6 py-2 rounded-lg font-semibold hover:shadow-lg transition-all duration-200 transform hover:scale-105">
                <i class="fas fa-search mr-2"></i>Buscar
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(busqueda))
        {
            <div class="mt-3 flex items-center gap-2">
                <span class="text-sm text-gray-600">
                    <i class="fas fa-info-circle mr-1"></i>
                    Buscando: <strong>"@busqueda"</strong>
                </span>
                <a asp-action="Index" asp-route-categoriaId="@categoriaSeleccionada" 
                   class="text-sm text-red-600 hover:text-red-700 font-semibold">
                    <i class="fas fa-times-circle mr-1"></i>Limpiar búsqueda
                </a>
            </div>
        }
    </form>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Sidebar - Categorías -->
    <aside class="lg:col-span-1">
        <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24">
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-6 flex items-center">
                <i class="fas fa-filter text-yellow-600 mr-3"></i>
                Filtrar
            </h2>
            
            <div class="space-y-2">
                <a asp-action="Index" asp-route-busqueda="@busqueda"
                   class="block px-4 py-3 rounded-lg transition-all duration-200 @(categoriaSeleccionada == null ? "bg-gradient-to-r from-yellow-500 to-orange-500 text-white shadow-md" : "bg-gray-50 text-gray-700 hover:bg-gray-100")">
                    <i class="fas fa-th-large mr-2"></i>
                    Todas las categorías
                </a>
                
                @if (categorias != null)
                {
                    @foreach (var categoria in categorias)
                    {
                        <a asp-action="Index" asp-route-categoriaId="@categoria.Id" asp-route-busqueda="@busqueda"
                           class="block px-4 py-3 rounded-lg transition-all duration-200 @(categoriaSeleccionada == categoria.Id ? "bg-gradient-to-r from-yellow-500 to-orange-500 text-white shadow-md" : "bg-gray-50 text-gray-700 hover:bg-gray-100")">
                            <i class="fas fa-tag mr-2"></i>
                            @categoria.Nombre
                        </a>
                    }
                }
            </div>

            <!-- Stats -->
            <div class="mt-8 p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl">
                <div class="text-center">
                    <div class="text-3xl font-bold text-indigo-600">@Model.TotalItems</div>
                    <div class="text-sm text-gray-600 mt-1">
                        @if (!string.IsNullOrWhiteSpace(busqueda))
                        {
                            <span>Resultados encontrados</span>
                        }
                        else
                        {
                            <span>Productos disponibles</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Products Grid -->
    <div class="lg:col-span-3">
        <!-- Results Info -->
        <div class="flex justify-between items-center mb-6">
            <div class="text-gray-600">
                Mostrando <span class="font-semibold text-gray-900">@Model.StartItem</span> - 
                <span class="font-semibold text-gray-900">@Model.EndItem</span> de 
                <span class="font-semibold text-gray-900">@Model.TotalItems</span> productos
            </div>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <!-- Products Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
                @foreach (var producto in Model.Items)
                {
                    <div class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2">
                        <!-- Product Image -->
                        <div class="relative bg-gradient-to-br from-amber-50 to-orange-50 overflow-hidden" style="aspect-ratio: 1 / 1;">
                            @if (producto.TieneImagenes)
                            {
                                <img src="@producto.ImagenPrincipal" 
                                     alt="@producto.Nombre" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                     onerror="this.onerror=null; this.src='/images/placeholder-product.jpg'; this.classList.add('opacity-50');" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="fas fa-gem text-8xl text-yellow-600 opacity-20"></i>
                                </div>
                            }
                            
                            <!-- Badge de Categoría -->
                            <div class="absolute top-4 right-4">
                                <span class="bg-white text-gray-900 px-3 py-1 rounded-full text-xs font-semibold shadow-md backdrop-blur-sm bg-opacity-90">
                                    @producto.CategoriaNombre
                                </span>
                            </div>

                            <!-- Badge de Imágenes -->
                            @if (producto.Imagenes.Count > 1)
                            {
                                <div class="absolute bottom-4 left-4">
                                    <span class="bg-gray-900 bg-opacity-75 text-white px-2 py-1 rounded-full text-xs font-semibold backdrop-blur-sm">
                                        <i class="fas fa-images mr-1"></i>@producto.Imagenes.Count
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Product Info -->
                        <div class="p-6">
                            <h3 class="font-display text-xl font-bold text-gray-900 mb-2 group-hover:text-yellow-600 transition-colors line-clamp-1">
                                @producto.Nombre
                            </h3>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                @producto.Descripcion
                            </p>
                            
                            <div class="flex items-center justify-between mb-4">
                                <div class="text-3xl font-bold text-gradient">
                                    @producto.Precio.ToString("C")
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="grid grid-cols-2 gap-3">
                                <a asp-action="Detalle" asp-route-id="@producto.Id" 
                                   class="flex items-center justify-center px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 font-medium">
                                    <i class="fas fa-eye mr-2"></i>Ver
                                </a>
                                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                    <input type="hidden" name="productoId" value="@producto.Id" />
                                    <button type="submit" 
                                            class="w-full flex items-center justify-center px-4 py-2 gradient-gold text-gray-900 rounded-lg hover:shadow-lg transition-all duration-200 font-semibold transform hover:scale-105">
                                        <i class="fas fa-cart-plus mr-2"></i>Añadir
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center items-center space-x-2 mt-8">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" 
                           asp-route-page="@(Model.PageNumber - 1)" 
                           asp-route-categoriaId="@categoriaSeleccionada"
                           asp-route-busqueda="@busqueda"
                           class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                            <i class="fas fa-chevron-left"></i>
                        </span>
                    }

                    <!-- Page Numbers -->
                    @{
                        var startPage = Math.Max(1, Model.PageNumber - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                    }

                    @if (startPage > 1)
                    {
                        <a asp-action="Index" 
                           asp-route-page="1" 
                           asp-route-categoriaId="@categoriaSeleccionada"
                           asp-route-busqueda="@busqueda"
                           class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                            1
                        </a>
                        @if (startPage > 2)
                        {
                            <span class="px-2 text-gray-500">...</span>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        @if (i == Model.PageNumber)
                        {
                            <span class="px-4 py-2 gradient-gold text-gray-900 rounded-lg font-bold shadow-md">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-action="Index" 
                               asp-route-page="@i" 
                               asp-route-categoriaId="@categoriaSeleccionada"
                               asp-route-busqueda="@busqueda"
                               class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                                @i
                            </a>
                        }
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <span class="px-2 text-gray-500">...</span>
                        }
                        <a asp-action="Index" 
                           asp-route-page="@Model.TotalPages" 
                           asp-route-categoriaId="@categoriaSeleccionada"
                           asp-route-busqueda="@busqueda"
                           class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                            @Model.TotalPages
                        </a>
                    }

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" 
                           asp-route-page="@(Model.PageNumber + 1)" 
                           asp-route-categoriaId="@categoriaSeleccionada"
                           asp-route-busqueda="@busqueda"
                           class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                            <i class="fas fa-chevron-right"></i>
                        </span>
                    }
                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-16">
                <i class="fas fa-search text-gray-300 text-6xl mb-4"></i>
                <h3 class="font-display text-2xl font-bold text-gray-700 mb-2">
                    @if (!string.IsNullOrWhiteSpace(busqueda))
                    {
                        <span>No se encontraron resultados</span>
                    }
                    else
                    {
                        <span>No hay productos disponibles</span>
                    }
                </h3>
                <p class="text-gray-500 mb-6">
                    @if (!string.IsNullOrWhiteSpace(busqueda))
                    {
                        <span>Intenta con otros términos de búsqueda</span>
                    }
                    else
                    {
                        <span>No se encontraron productos en esta categoría</span>
                    }
                </p>
                <a asp-action="Index" class="inline-block gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-lg transition-all duration-200">
                    <i class="fas fa-arrow-left mr-2"></i>Ver todos los productos
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}
