@model AldaJoyeros.DTOs.PedidoUpdateEstadoDto

@{
    ViewData["Title"] = "Editar Estado del Pedido";
    var pedido = ViewBag.Pedido as AldaJoyeros.DTOs.PedidoDto;
}

<h1 class="mb-4"><i class="fas fa-edit"></i> Editar Estado del Pedido #@pedido?.Id</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="EditarEstado" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Estado Actual:</label>
                        <p class="form-control-plaintext">
                            @switch (pedido?.Estado)
                            {
                                case "PENDIENTE":
                                    <span class="badge bg-warning fs-6">⏳ Pendiente</span>
                                    break;
                                case "EN_PROCESO":
                                    <span class="badge bg-info fs-6">🔄 En Proceso</span>
                                    break;
                                case "ENVIADO":
                                    <span class="badge bg-primary fs-6">📦 Enviado</span>
                                    break;
                                case "ENTREGADO":
                                    <span class="badge bg-success fs-6">✅ Entregado</span>
                                    break;
                                case "CANCELADO":
                                    <span class="badge bg-danger fs-6">❌ Cancelado</span>
                                    break;
                            }
                        </p>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label">Nuevo Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="">Seleccionar estado...</option>
                            <option value="PENDIENTE">⏳ Pendiente</option>
                            <option value="EN_PROCESO">🔄 En Proceso</option>
                            <option value="ENVIADO">📦 Enviado</option>
                            <option value="ENTREGADO">✅ Entregado</option>
                            <option value="CANCELADO">❌ Cancelado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaEntregaReal" class="form-label">Fecha de Entrega Real (opcional)</label>
                        <input asp-for="FechaEntregaReal" type="date" class="form-control" />
                        <small class="form-text text-muted">Solo si el estado es "Entregado"</small>
                        <span asp-validation-for="FechaEntregaReal" class="text-danger"></span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Detalle" asp-route-id="@pedido?.Id" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save"></i> Actualizar Estado
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5><i class="fas fa-info-circle"></i> Información</h5>
                <p class="small">Cambios de estado del pedido:</p>
                <ul class="small">
                    <li><strong>Pendiente:</strong> El pedido ha sido recibido</li>
                    <li><strong>En Proceso:</strong> Se está preparando el pedido</li>
                    <li><strong>Enviado:</strong> El pedido está en camino</li>
                    <li><strong>Entregado:</strong> El pedido ha sido entregado</li>
                    <li><strong>Cancelado:</strong> El pedido ha sido cancelado</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
