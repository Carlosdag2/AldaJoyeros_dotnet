@{
    ViewData["Title"] = "Panel de Administración";
}

<h1 class="mb-4"><i class="fas fa-tachometer-alt"></i> Panel de Administración</h1>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Categorías</h6>
                        <h3 class="mb-0"><i class="fas fa-tags fa-2x"></i></h3>
                    </div>
                </div>
            </div>
            <a asp-controller="AdminCategorias" asp-action="Index" class="card-footer text-white d-flex align-items-center justify-content-between text-decoration-none">
                <span>Ver Categorías</span>
                <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Productos</h6>
                        <h3 class="mb-0"><i class="fas fa-gem fa-2x"></i></h3>
                    </div>
                </div>
            </div>
            <a asp-controller="AdminProductos" asp-action="Index" class="card-footer text-white d-flex align-items-center justify-content-between text-decoration-none">
                <span>Gestionar Productos</span>
                <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Pedidos</h6>
                        <h3 class="mb-0"><i class="fas fa-box fa-2x"></i></h3>
                    </div>
                </div>
            </div>
            <a asp-controller="AdminPedidos" asp-action="Index" class="card-footer text-white d-flex align-items-center justify-content-between text-decoration-none">
                <span>Ver Pedidos</span>
                <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Usuarios</h6>
                        <h3 class="mb-0"><i class="fas fa-users fa-2x"></i></h3>
                    </div>
                </div>
            </div>
            <a asp-controller="AdminUsuarios" asp-action="Index" class="card-footer text-white d-flex align-items-center justify-content-between text-decoration-none">
                <span>Gestionar Usuarios</span>
                <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-chart-line"></i> Accesos Rápidos</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <a asp-controller="AdminCategorias" asp-action="Crear" class="btn btn-outline-primary w-100">
                            <i class="fas fa-plus-circle"></i> Nueva Categoría
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a asp-controller="AdminProductos" asp-action="Crear" class="btn btn-outline-success w-100">
                            <i class="fas fa-plus-circle"></i> Nuevo Producto
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a asp-controller="AdminUsuarios" asp-action="Crear" class="btn btn-outline-info w-100">
                            <i class="fas fa-user-plus"></i> Nuevo Usuario
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <h5><i class="fas fa-info-circle"></i> Bienvenido al Panel de Administración</h5>
    <p class="mb-0">Desde aquí puedes gestionar todas las funcionalidades de Alda Joyeros: categorías, productos, pedidos y usuarios.</p>
</div>
