@model IEnumerable<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Inicio";
}

<div class="jumbotron bg-light p-5 rounded-3 mb-4">
    <div class="container-fluid py-5">
        <h1 class="display-4">Bienvenido a Alda Joyeros</h1>
        <p class="lead">Las mejores joyas para tus momentos más especiales</p>
        <hr class="my-4">
        <p>Descubre nuestra exclusiva colección de joyería fina</p>
        <a class="btn btn-primary btn-lg" asp-controller="Productos" asp-action="Index" role="button">
            <i class="fas fa-shopping-bag"></i> Ver Catálogo
        </a>
    </div>
</div>

<h2 class="mb-4">Productos Destacados</h2>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var producto in Model.Take(8))
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="fas fa-gem fa-4x text-secondary"></i>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@producto.Nombre</h5>
                        <p class="card-text text-muted small">@producto.CategoriaNombre</p>
                        <p class="card-text">@producto.Descripcion.Substring(0, Math.Min(80, producto.Descripcion.Length))...</p>
                        <h4 class="text-primary">@producto.Precio.ToString("C")</h4>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.Id" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i> Ver
                            </a>
                            <form asp-controller="Carrito" asp-action="Agregar" method="post" class="d-inline">
                                <input type="hidden" name="productoId" value="@producto.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-cart-plus"></i> Agregar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No hay productos disponibles en este momento.
            </div>
        </div>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center mb-4">
        <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
        <h4>Envío Gratis</h4>
        <p>En compras superiores a 50€</p>
    </div>
    <div class="col-md-4 text-center mb-4">
        <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
        <h4>Compra Segura</h4>
        <p>Protección en todas tus compras</p>
    </div>
    <div class="col-md-4 text-center mb-4">
        <i class="fas fa-headset fa-3x text-primary mb-3"></i>
        <h4>Atención 24/7</h4>
        <p>Estamos para ayudarte siempre</p>
    </div>
</div>
