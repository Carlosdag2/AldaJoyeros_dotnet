@model IEnumerable<AldaJoyeros.DTOs.PedidoDto>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<h1 class="mb-4"><i class="fas fa-box"></i> Mis Pedidos</h1>

@if (Model != null && Model.Any())
{
    @foreach (var pedido in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-light">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <strong>Pedido #@pedido.Id</strong>
                    </div>
                    <div class="col-md-3">
                        <i class="fas fa-calendar"></i> @pedido.Fecha?.ToString("dd/MM/yyyy HH:mm")
                    </div>
                    <div class="col-md-3">
                        @switch (pedido.Estado)
                        {
                            case "PENDIENTE":
                                <span class="badge bg-warning">⏳ Pendiente</span>
                                break;
                            case "EN_PROCESO":
                                <span class="badge bg-info">🔄 En Proceso</span>
                                break;
                            case "ENVIADO":
                                <span class="badge bg-primary">📦 Enviado</span>
                                break;
                            case "ENTREGADO":
                                <span class="badge bg-success">✅ Entregado</span>
                                break;
                            case "CANCELADO":
                                <span class="badge bg-danger">❌ Cancelado</span>
                                break;
                        }
                    </div>
                    <div class="col-md-3 text-end">
                        <strong class="text-primary">@pedido.Total.ToString("C")</strong>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h6>Productos:</h6>
                        <ul class="list-unstyled">
                            @foreach (var linea in pedido.LineasPedido)
                            {
                                <li class="mb-1">
                                    <i class="fas fa-gem text-secondary"></i> 
                                    @linea.ProductoNombre - 
                                    <strong>@linea.Cantidad</strong> x @linea.Precio.ToString("C") = 
                                    <span class="text-primary">@linea.Subtotal.ToString("C")</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-4">
                        @if (pedido.Direccion != null)
                        {
                            <h6>Dirección de envío:</h6>
                            <address class="small">
                                @pedido.Direccion.Calle, @pedido.Direccion.Numero
                                @if (!string.IsNullOrEmpty(pedido.Direccion.Piso))
                                {
                                    <br />@pedido.Direccion.Piso
                                }
                                <br />@pedido.Direccion.CodigoPostal - @pedido.Direccion.Ciudad
                                <br />@pedido.Direccion.Provincia
                            </address>
                        }
                    </div>
                </div>
                <div class="text-end">
                    <a asp-action="Detalle" asp-route-id="@pedido.Id" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-eye"></i> Ver Detalle
                    </a>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-box-open fa-5x text-muted mb-4"></i>
        <h3>No tienes pedidos</h3>
        <p class="text-muted mb-4">Cuando realices una compra, aparecerá aquí</p>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-shopping-bag"></i> Ir a la Tienda
        </a>
    </div>
}
