using AldaJoyeros.Entities;
using System.ComponentModel.DataAnnotations;

namespace AldaJoyeros.DTOs
{
    public class PedidoDto
    {
        public long Id { get; set; }
        public DateTime? Fecha { get; set; }
        public EstadoPedido Estado { get; set; }
        public DateTime? FechaEntregaEstimada { get; set; }
        public DateTime? FechaEntregaReal { get; set; }
        public long? UsuarioId { get; set; }
        public string? UsuarioEmail { get; set; }
        public DireccionDto? Direccion { get; set; }
        public List<LineaPedidoDto> LineasPedido { get; set; } = new List<LineaPedidoDto>();
        public double Total { get; set; }
    }

    public class PedidoCreateDto
    {
        [Required(ErrorMessage = "La dirección es obligatoria")]
        public DireccionCreateDto Direccion { get; set; } = null!;
    }

    public class PedidoUpdateEstadoDto
    {
        [Required(ErrorMessage = "El estado es obligatorio")]
        public EstadoPedido Estado { get; set; }

        public DateTime? FechaEntregaReal { get; set; }
    }
}
