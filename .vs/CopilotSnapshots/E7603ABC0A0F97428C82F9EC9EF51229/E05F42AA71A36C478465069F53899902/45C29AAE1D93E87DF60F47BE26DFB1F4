using AutoMapper;
using AldaJoyeros.DTOs;
using AldaJoyeros.Entities;

namespace AldaJoyeros.Mappings
{
    public class MappingProfile : Profile
    {
        public MappingProfile()
        {
            // Usuario mappings
            CreateMap<Usuario, UsuarioDto>();
            CreateMap<UsuarioCreateDto, Usuario>()
                .ForMember(dest => dest.Password, opt => opt.Ignore()); // Se hashea en el servicio
            CreateMap<UsuarioUpdateDto, Usuario>()
                .ForMember(dest => dest.Id, opt => opt.Ignore())
                .ForMember(dest => dest.Password, opt => opt.Ignore()); // Se hashea en el servicio si se proporciona

            // Categoria mappings
            CreateMap<Categoria, CategoriaDto>();
            CreateMap<CategoriaCreateDto, Categoria>();
            CreateMap<CategoriaUpdateDto, Categoria>()
                .ForMember(dest => dest.Id, opt => opt.Ignore());

            // Producto mappings
            CreateMap<Producto, ProductoDto>()
                .ForMember(dest => dest.CategoriaNombre, opt => opt.MapFrom(src => src.Categoria != null ? src.Categoria.Nombre : string.Empty))
                .ForMember(dest => dest.Imagenes, opt => opt.MapFrom(src => src.Imagenes.OrderBy(i => i.Orden)));
            CreateMap<ProductoCreateDto, Producto>();
            CreateMap<ProductoUpdateDto, Producto>()
                .ForMember(dest => dest.Id, opt => opt.Ignore());

            // ProductoImagen mappings (ahora con Base64)
            CreateMap<ProductoImagen, ProductoImagenDto>()
                .ForMember(dest => dest.ImagenBase64, opt => opt.MapFrom(src => src.ImagenBase64));
            CreateMap<ProductoImagenCreateDto, ProductoImagen>()
                .ForMember(dest => dest.TamanoBytes, opt => opt.MapFrom(src => src.ImagenData.Length))
                .ForMember(dest => dest.FechaCreacion, opt => opt.MapFrom(src => DateTime.Now));

            // CarritoItem mappings
            CreateMap<CarritoItem, CarritoItemDto>()
                .ForMember(dest => dest.ProductoNombre, opt => opt.MapFrom(src => src.Producto != null ? src.Producto.Nombre : string.Empty));
            CreateMap<CarritoItemCreateDto, CarritoItem>();
            CreateMap<CarritoItemUpdateDto, CarritoItem>()
                .ForMember(dest => dest.Id, opt => opt.Ignore())
                .ForMember(dest => dest.UsuarioId, opt => opt.Ignore())
                .ForMember(dest => dest.ProductoId, opt => opt.Ignore())
                .ForMember(dest => dest.Precio, opt => opt.Ignore());

            // Direccion mappings
            CreateMap<Direccion, DireccionDto>();
            CreateMap<DireccionCreateDto, Direccion>();
            CreateMap<DireccionUpdateDto, Direccion>()
                .ForMember(dest => dest.Id, opt => opt.Ignore())
                .ForMember(dest => dest.UsuarioId, opt => opt.Ignore());

            // Pedido mappings
            CreateMap<Pedido, PedidoDto>()
                .ForMember(dest => dest.UsuarioEmail, opt => opt.MapFrom(src => src.Usuario != null ? src.Usuario.Email : string.Empty))
                .ForMember(dest => dest.Direccion, opt => opt.MapFrom(src => src.Direccion))
                .ForMember(dest => dest.LineasPedido, opt => opt.MapFrom(src => src.LineasPedido));
            CreateMap<PedidoCreateDto, Pedido>()
                .ForMember(dest => dest.Fecha, opt => opt.MapFrom(src => DateTime.Now))
                .ForMember(dest => dest.Estado, opt => opt.MapFrom(src => "PENDIENTE"))
                .ForMember(dest => dest.FechaEntregaEstimada, opt => opt.MapFrom(src => DateTime.Now.AddDays(7)));

            // LineaPedido mappings
            CreateMap<LineaPedido, LineaPedidoDto>()
                .ForMember(dest => dest.ProductoNombre, opt => opt.MapFrom(src => src.Producto != null ? src.Producto.Nombre : string.Empty));
            CreateMap<LineaPedidoCreateDto, LineaPedido>();
        }
    }
}
