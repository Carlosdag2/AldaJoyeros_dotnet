using System.ComponentModel.DataAnnotations;

namespace AldaJoyeros.DTOs
{
    public class ProductoImagenDto
    {
        public long Id { get; set; }
        public long ProductoId { get; set; }
        public string ImagenBase64 { get; set; } = string.Empty;
        public string TipoMime { get; set; } = "image/jpeg";
        public int TamanoBytes { get; set; }
        public int Orden { get; set; }
        public bool EsPrincipal { get; set; }
        public DateTime? FechaCreacion { get; set; }
    }

    public class ProductoImagenCreateDto
    {
        [Required(ErrorMessage = "El ID del producto es obligatorio")]
        public long ProductoId { get; set; }

        [Required(ErrorMessage = "Los datos de la imagen son obligatorios")]
        public byte[] ImagenData { get; set; } = Array.Empty<byte>();

        [Required(ErrorMessage = "El tipo MIME es obligatorio")]
        [StringLength(50)]
        public string TipoMime { get; set; } = "image/jpeg";

        public int Orden { get; set; } = 0;
        public bool EsPrincipal { get; set; } = false;
    }

    public class ProductoImagenUploadDto
    {
        [Required(ErrorMessage = "El ID del producto es obligatorio")]
        public long ProductoId { get; set; }

        [Required(ErrorMessage = "Debe seleccionar una imagen")]
        public IFormFile Archivo { get; set; } = null!;

        public int Orden { get; set; } = 0;
        public bool EsPrincipal { get; set; } = false;
    }
}
