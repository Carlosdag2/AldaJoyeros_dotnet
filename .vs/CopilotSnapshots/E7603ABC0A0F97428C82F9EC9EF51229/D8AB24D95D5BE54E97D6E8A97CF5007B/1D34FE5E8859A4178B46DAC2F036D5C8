# Script PowerShell para migrar datos de MySQL a PostgreSQL
# AldaJoyeros - Migración de Base de Datos

param(
    [string]$MySqlServer = "localhost",
    [string]$MySqlUser = "root",
    [string]$MySqlPassword = "curso",
    [string]$MySqlDatabase = "tfg_carlosdealda",
    [string]$PgServer = "localhost",
    [string]$PgPort = "5432",
    [string]$PgUser = "postgres",
    [string]$PgPassword = "curso",
    [string]$PgDatabase = "aldajoyeros"
)

Write-Host "============================================" -ForegroundColor Cyan
Write-Host "  MIGRACIÓN MySQL ? PostgreSQL" -ForegroundColor Cyan
Write-Host "  AldaJoyeros Database Migration" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""

# Función para exportar datos de MySQL a CSV
function Export-MySqlToCSV {
    param(
        [string]$Table,
        [string]$OutputFile
    )
    
    Write-Host "?? Exportando tabla: $Table" -ForegroundColor Yellow
    
    $query = "SELECT * FROM $Table"
    
    try {
        mysql -h $MySqlServer -u $MySqlUser -p$MySqlPassword $MySqlDatabase -e "$query" --batch --skip-column-names | Out-File -FilePath $OutputFile -Encoding UTF8
        Write-Host "   ? Exportado: $OutputFile" -ForegroundColor Green
        return $true
    }
    catch {
        Write-Host "   ? Error exportando $Table : $_" -ForegroundColor Red
        return $false
    }
}

# Función para importar CSV a PostgreSQL
function Import-CSVToPostgreSQL {
    param(
        [string]$Table,
        [string]$InputFile
    )
    
    Write-Host "?? Importando a PostgreSQL: $Table" -ForegroundColor Yellow
    
    try {
        $env:PGPASSWORD = $PgPassword
        psql -h $PgServer -p $PgPort -U $PgUser -d $PgDatabase -c "\COPY $Table FROM '$InputFile' WITH (FORMAT csv, HEADER true, DELIMITER E'\t')"
        Write-Host "   ? Importado: $Table" -ForegroundColor Green
        return $true
    }
    catch {
        Write-Host "   ? Error importando $Table : $_" -ForegroundColor Red
        return $false
    }
}

Write-Host "PASO 1: Verificar conexiones" -ForegroundColor Cyan
Write-Host "?????????????????????????????" -ForegroundColor Cyan

# Verificar MySQL
Write-Host "?? Verificando MySQL..." -ForegroundColor Yellow
try {
    $mysqlTest = mysql -h $MySqlServer -u $MySqlUser -p$MySqlPassword -e "SELECT 1" 2>&1
    if ($LASTEXITCODE -eq 0) {
        Write-Host "   ? MySQL: Conexión exitosa" -ForegroundColor Green
    } else {
        Write-Host "   ? MySQL: Error de conexión" -ForegroundColor Red
        Write-Host "   Verifica: servidor, usuario y contraseña" -ForegroundColor Yellow
        exit 1
    }
}
catch {
    Write-Host "   ? MySQL no está instalado o no está en el PATH" -ForegroundColor Red
    exit 1
}

# Verificar PostgreSQL
Write-Host "?? Verificando PostgreSQL..." -ForegroundColor Yellow
try {
    $env:PGPASSWORD = $PgPassword
    $pgTest = psql -h $PgServer -p $PgPort -U $PgUser -d postgres -c "SELECT 1" 2>&1
    if ($LASTEXITCODE -eq 0) {
        Write-Host "   ? PostgreSQL: Conexión exitosa" -ForegroundColor Green
    } else {
        Write-Host "   ? PostgreSQL: Error de conexión" -ForegroundColor Red
        Write-Host "   Verifica: servidor, usuario y contraseña" -ForegroundColor Yellow
        exit 1
    }
}
catch {
    Write-Host "   ? PostgreSQL no está instalado o no está en el PATH" -ForegroundColor Red
    exit 1
}

Write-Host ""
Write-Host "PASO 2: Crear base de datos PostgreSQL" -ForegroundColor Cyan
Write-Host "??????????????????????????????????????" -ForegroundColor Cyan

Write-Host "???  Ejecutando script de inicialización..." -ForegroundColor Yellow
$env:PGPASSWORD = $PgPassword
psql -h $PgServer -p $PgPort -U $PgUser -f database_init_postgresql.sql

if ($LASTEXITCODE -eq 0) {
    Write-Host "   ? Base de datos PostgreSQL creada" -ForegroundColor Green
} else {
    Write-Host "   ? Error creando base de datos" -ForegroundColor Red
    exit 1
}

Write-Host ""
Write-Host "PASO 3: Exportar datos de MySQL" -ForegroundColor Cyan
Write-Host "?????????????????????????????????" -ForegroundColor Cyan

$tempDir = ".\migration_temp"
if (!(Test-Path $tempDir)) {
    New-Item -ItemType Directory -Path $tempDir | Out-Null
}

$tables = @("usuario", "categoria", "producto", "direccion", "carrito_item", "pedido", "linea_pedido")

foreach ($table in $tables) {
    $csvFile = Join-Path $tempDir "$table.csv"
    Export-MySqlToCSV -Table $table -OutputFile $csvFile
}

Write-Host ""
Write-Host "PASO 4: Importar datos a PostgreSQL" -ForegroundColor Cyan
Write-Host "???????????????????????????????????" -ForegroundColor Cyan

# Deshabilitar restricciones temporalmente
Write-Host "?? Deshabilitando restricciones FK..." -ForegroundColor Yellow
$env:PGPASSWORD = $PgPassword
psql -h $PgServer -p $PgPort -U $PgUser -d $PgDatabase -c "SET session_replication_role = replica;"

# Importar en orden correcto (respetando FK)
$importOrder = @("usuario", "categoria", "producto", "direccion", "carrito_item", "pedido", "linea_pedido")

foreach ($table in $importOrder) {
    $csvFile = Join-Path $tempDir "$table.csv"
    if (Test-Path $csvFile) {
        Import-CSVToPostgreSQL -Table $table -InputFile $csvFile
    }
}

# Habilitar restricciones
Write-Host "?? Habilitando restricciones FK..." -ForegroundColor Yellow
psql -h $PgServer -p $PgPort -U $PgUser -d $PgDatabase -c "SET session_replication_role = DEFAULT;"

# Actualizar secuencias (importante para BIGSERIAL)
Write-Host "?? Actualizando secuencias..." -ForegroundColor Yellow
foreach ($table in $tables) {
    $query = "SELECT setval(pg_get_serial_sequence('$table', 'id'), COALESCE((SELECT MAX(id) FROM $table), 1));"
    psql -h $PgServer -p $PgPort -U $PgUser -d $PgDatabase -c $query
}

Write-Host ""
Write-Host "PASO 5: Verificar migración" -ForegroundColor Cyan
Write-Host "??????????????????????????????" -ForegroundColor Cyan

Write-Host "?? Conteo de registros:" -ForegroundColor Yellow
foreach ($table in $tables) {
    $count = psql -h $PgServer -p $PgPort -U $PgUser -d $PgDatabase -t -c "SELECT COUNT(*) FROM $table;"
    Write-Host "   $table : $count registros" -ForegroundColor White
}

Write-Host ""
Write-Host "PASO 6: Limpiar archivos temporales" -ForegroundColor Cyan
Write-Host "???????????????????????????????????" -ForegroundColor Cyan

Write-Host "?? Eliminando archivos temporales..." -ForegroundColor Yellow
Remove-Item -Path $tempDir -Recurse -Force
Write-Host "   ? Archivos temporales eliminados" -ForegroundColor Green

Write-Host ""
Write-Host "============================================" -ForegroundColor Green
Write-Host "  ? MIGRACIÓN COMPLETADA EXITOSAMENTE" -ForegroundColor Green
Write-Host "============================================" -ForegroundColor Green
Write-Host ""
Write-Host "?? Resumen:" -ForegroundColor Cyan
Write-Host "   • Base de datos origen: MySQL ($MySqlDatabase)" -ForegroundColor White
Write-Host "   • Base de datos destino: PostgreSQL ($PgDatabase)" -ForegroundColor White
Write-Host "   • Tablas migradas: $($tables.Count)" -ForegroundColor White
Write-Host ""
Write-Host "??  IMPORTANTE:" -ForegroundColor Yellow
Write-Host "   1. Actualiza appsettings.json con la conexión PostgreSQL" -ForegroundColor White
Write-Host "   2. Instala el paquete Npgsql.EntityFrameworkCore.PostgreSQL" -ForegroundColor White
Write-Host "   3. Ejecuta la aplicación y verifica que todo funcione" -ForegroundColor White
Write-Host "   4. Las imágenes siguen en MongoDB (sin cambios)" -ForegroundColor White
Write-Host ""
Write-Host "?? ¡Tu aplicación ahora usa PostgreSQL!" -ForegroundColor Green
