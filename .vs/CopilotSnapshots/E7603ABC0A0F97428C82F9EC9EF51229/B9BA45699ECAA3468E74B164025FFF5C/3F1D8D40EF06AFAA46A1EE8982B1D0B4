@model AldaJoyeros.DTOs.PedidoDto

@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<!-- Breadcrumb -->
<nav class="mb-8">
    <ol class="flex items-center space-x-2 text-sm text-gray-600">
        <li><a asp-controller="Home" asp-action="Index" class="hover:text-yellow-600 transition-colors">Inicio</a></li>
        <li><i class="fas fa-chevron-right text-xs"></i></li>
        <li><a asp-action="Index" class="hover:text-yellow-600 transition-colors">Mis Pedidos</a></li>
        <li><i class="fas fa-chevron-right text-xs"></i></li>
        <li class="text-gray-900 font-semibold">Pedido #@Model.Id</li>
    </ol>
</nav>

<!-- Header Card -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 rounded-3xl p-8 mb-8 text-white shadow-2xl">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="font-display text-4xl font-bold mb-2">
                <i class="fas fa-box text-yellow-500"></i> Pedido #@Model.Id
            </h1>
            <p class="text-gray-300">
                <i class="fas fa-calendar mr-2"></i>
                Realizado el @Model.Fecha?.ToString("dd/MM/yyyy 'a las' HH:mm")
            </p>
        </div>
        <div class="text-right">
            @switch (Model.Estado)
            {
                case "PENDIENTE":
                    <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-yellow-500 text-white shadow-lg">
                        <i class="fas fa-clock mr-2"></i> Pendiente
                    </span>
                    break;
                case "EN_PROCESO":
                    <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-blue-500 text-white shadow-lg">
                        <i class="fas fa-sync-alt mr-2 animate-spin"></i> En Proceso
                    </span>
                    break;
                case "ENVIADO":
                    <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-purple-500 text-white shadow-lg">
                        <i class="fas fa-shipping-fast mr-2"></i> Enviado
                    </span>
                    break;
                case "ENTREGADO":
                    <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-green-500 text-white shadow-lg">
                        <i class="fas fa-check-circle mr-2"></i> Entregado
                    </span>
                    break;
                case "CANCELADO":
                    <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-red-500 text-white shadow-lg">
                        <i class="fas fa-times-circle mr-2"></i> Cancelado
                    </span>
                    break;
            }
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-8">
        <!-- Order Info -->
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-6 flex items-center">
                <i class="fas fa-info-circle text-blue-600 mr-3"></i>
                Información del Pedido
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4">
                    <div class="text-sm text-gray-600 mb-1">Fecha de Pedido</div>
                    <div class="font-bold text-gray-900">@Model.Fecha?.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-4">
                    <div class="text-sm text-gray-600 mb-1">Estado</div>
                    <div class="font-bold text-gray-900">@Model.Estado</div>
                </div>
                <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4">
                    <div class="text-sm text-gray-600 mb-1">Entrega Estimada</div>
                    <div class="font-bold text-gray-900">@Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</div>
                </div>
                @if (Model.FechaEntregaReal.HasValue)
                {
                    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-4">
                        <div class="text-sm text-gray-600 mb-1">Fecha de Entrega</div>
                        <div class="font-bold text-green-700">
                            <i class="fas fa-check-circle mr-1"></i>
                            @Model.FechaEntregaReal?.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Products -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-r from-yellow-500 to-orange-500 p-6">
                <h2 class="font-display text-2xl font-bold text-white flex items-center">
                    <i class="fas fa-shopping-bag mr-3"></i>
                    Productos del Pedido
                </h2>
            </div>
            <div class="p-6">
                <div class="space-y-4">
                    @foreach (var linea in Model.LineasPedido)
                    {
                        <div class="flex items-center justify-between bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition-colors">
                            <div class="flex items-center flex-1">
                                <div class="w-16 h-16 bg-gradient-to-br from-amber-100 to-orange-100 rounded-lg overflow-hidden flex items-center justify-center mr-4">
                                    @if (linea.Producto?.TieneImagenes == true)
                                    {
                                        <img src="@linea.Producto.ImagenPrincipal" 
                                             alt="@linea.ProductoNombre" 
                                             class="w-full h-full object-cover"
                                             onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'fas fa-gem text-2xl text-yellow-600\'></i>';" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-gem text-2xl text-yellow-600"></i>
                                    }
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-bold text-gray-900 mb-1">@linea.ProductoNombre</h3>
                                    <p class="text-sm text-gray-600">
                                        Cantidad: <span class="font-semibold">@linea.Cantidad</span> × @linea.Precio.ToString("C")
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-xs text-gray-600 mb-1">Subtotal</div>
                                <div class="text-xl font-bold text-gradient">@linea.Subtotal.ToString("C")</div>
                            </div>
                        </div>
                    }

                <!-- Total -->
                <div class="mt-6 pt-6 border-t-2 border-gray-200">
                    <div class="flex justify-between items-center">
                        <span class="text-2xl font-bold text-gray-900">Total del Pedido:</span>
                        <span class="text-4xl font-bold text-gradient">@Model.Total.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Shipping Address -->
        <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24">
            <h2 class="font-display text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-map-marker-alt text-red-600 mr-3"></i>
                Dirección de Envío
            </h2>
            @if (Model.Direccion != null)
            {
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5">
                    <address class="not-italic text-gray-700">
                        <div class="font-bold text-gray-900 text-lg mb-3">
                            <i class="fas fa-home mr-2"></i>
                            @Model.Direccion.Calle, @Model.Direccion.Numero
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Direccion.Piso))
                        {
                            <div class="mb-2">
                                <i class="fas fa-building mr-2 text-gray-500"></i>
                                @Model.Direccion.Piso
                            </div>
                        }
                        <div class="mb-2">
                            <i class="fas fa-mail-bulk mr-2 text-gray-500"></i>
                            @Model.Direccion.CodigoPostal - @Model.Direccion.Ciudad
                        </div>
                        <div>
                            <i class="fas fa-map mr-2 text-gray-500"></i>
                            @Model.Direccion.Provincia
                        </div>
                    </address>
                </div>
            }
        </div>

        <!-- Tracking Info -->
        @if (Model.Estado == "ENVIADO" || Model.Estado == "ENTREGADO")
        {
            <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                    <i class="fas fa-truck text-purple-600 mr-2"></i>
                    Estado del Envío
                </h3>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 mr-3"></i>
                        <span class="text-sm">Pedido confirmado</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 mr-3"></i>
                        <span class="text-sm">En preparación</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 mr-3"></i>
                        <span class="text-sm">Enviado</span>
                    </div>
                    @if (Model.Estado == "ENTREGADO")
                    {
                        <div class="flex items-center">
                            <i class="fas fa-check-circle text-green-600 mr-3"></i>
                            <span class="text-sm font-bold text-green-700">Entregado</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Help -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-3 flex items-center">
                <i class="fas fa-headset text-yellow-600 mr-2"></i>
                ¿Necesitas ayuda?
            </h3>
            <p class="text-sm text-gray-700 mb-4">
                Si tienes alguna pregunta sobre tu pedido, estamos aquí para ayudarte
            </p>
            <a href="#" class="text-yellow-600 hover:text-yellow-700 font-semibold text-sm flex items-center group">
                Contactar soporte
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>
    </div>
</div>

<!-- Back Button -->
<div class="mt-8">
    <a asp-action="Index" 
       class="inline-flex items-center px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 font-semibold">
        <i class="fas fa-arrow-left mr-2"></i>
        Volver a Mis Pedidos
    </a>
</div>
