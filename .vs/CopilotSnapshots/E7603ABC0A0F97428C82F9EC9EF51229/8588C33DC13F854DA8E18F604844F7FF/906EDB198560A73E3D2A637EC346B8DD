@model IEnumerable<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<div class="relative overflow-hidden rounded-3xl mb-12">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 opacity-95"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-10"></div>
    
    <div class="relative px-8 py-24 text-center">
        <i class="fas fa-gem text-6xl text-yellow-500 mb-6 animate-pulse"></i>
        <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-6">
            Bienvenido a Alda Joyeros
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
            Las mejores joyas para tus momentos más especiales
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a asp-controller="Productos" asp-action="Index" 
               class="inline-flex items-center px-8 py-4 gradient-gold text-gray-900 rounded-full font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                <i class="fas fa-shopping-bag mr-3"></i>
                Explorar Catálogo
            </a>
            <a href="#features" 
               class="inline-flex items-center px-8 py-4 bg-white bg-opacity-10 text-white rounded-full font-bold text-lg hover:bg-opacity-20 transition-all duration-200 backdrop-blur-sm">
                <i class="fas fa-info-circle mr-3"></i>
                Más Información
            </a>
        </div>
    </div>
</div>

<!-- Features Section -->
<div id="features" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 text-center transform hover:-translate-y-2 transition-all duration-300 shadow-lg hover:shadow-2xl">
        <div class="w-20 h-20 gradient-gold rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-shipping-fast text-3xl text-gray-900"></i>
        </div>
        <h3 class="font-display text-2xl font-bold text-gray-900 mb-3">Envío Gratis</h3>
        <p class="text-gray-600">En compras superiores a 50€</p>
    </div>

    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-8 text-center transform hover:-translate-y-2 transition-all duration-300 shadow-lg hover:shadow-2xl">
        <div class="w-20 h-20 gradient-gold rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-shield-alt text-3xl text-gray-900"></i>
        </div>
        <h3 class="font-display text-2xl font-bold text-gray-900 mb-3">Compra Segura</h3>
        <p class="text-gray-600">Protección en todas tus compras</p>
    </div>

    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-8 text-center transform hover:-translate-y-2 transition-all duration-300 shadow-lg hover:shadow-2xl">
        <div class="w-20 h-20 gradient-gold rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-headset text-3xl text-gray-900"></i>
        </div>
        <h3 class="font-display text-2xl font-bold text-gray-900 mb-3">Atención 24/7</h3>
        <p class="text-gray-600">Estamos para ayudarte siempre</p>
    </div>
</div>

<!-- Featured Products -->
<div class="mb-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="font-display text-4xl font-bold text-gray-900 mb-2">
                Productos Destacados
            </h2>
            <p class="text-gray-600">Descubre nuestra selección especial</p>
        </div>
        <a asp-controller="Productos" asp-action="Index" 
           class="hidden md:inline-flex items-center text-yellow-600 hover:text-yellow-700 font-semibold group">
            Ver todo
            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var producto in Model.Take(8))
            {
                <div class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2">
                    <div class="relative bg-gradient-to-br from-amber-50 to-orange-50 h-48 flex items-center justify-center overflow-hidden">
                        <i class="fas fa-gem text-6xl text-yellow-600 opacity-20 group-hover:scale-110 transition-transform duration-300"></i>
                        <div class="absolute top-3 right-3">
                            <span class="bg-white text-gray-900 px-3 py-1 rounded-full text-xs font-semibold shadow-md">
                                @producto.CategoriaNombre
                            </span>
                        </div>
                    </div>

                    <div class="p-5">
                        <h3 class="font-display text-lg font-bold text-gray-900 mb-2 line-clamp-1 group-hover:text-yellow-600 transition-colors">
                            @producto.Nombre
                        </h3>
                        <p class="text-gray-600 text-sm mb-3 line-clamp-2">
                            @producto.Descripcion
                        </p>
                        
                        <div class="text-2xl font-bold text-gradient mb-4">
                            @producto.Precio.ToString("C")
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.Id" 
                               class="flex items-center justify-center px-3 py-2 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 text-sm font-medium">
                                <i class="fas fa-eye mr-1"></i>Ver
                            </a>
                            <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                <input type="hidden" name="productoId" value="@producto.Id" />
                                <button type="submit" 
                                        class="w-full flex items-center justify-center px-3 py-2 gradient-gold text-gray-900 rounded-lg hover:shadow-lg transition-all duration-200 text-sm font-semibold transform hover:scale-105">
                                    <i class="fas fa-cart-plus mr-1"></i>Añadir
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-8">
            <a asp-controller="Productos" asp-action="Index" 
               class="inline-flex items-center gradient-gold text-gray-900 px-8 py-4 rounded-full font-bold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                <i class="fas fa-shopping-bag mr-3"></i>
                Ver Todo el Catálogo
            </a>
        </div>
    }
    else
    {
        <div class="bg-gray-50 rounded-2xl p-12 text-center">
            <i class="fas fa-gem text-gray-300 text-6xl mb-4"></i>
            <h3 class="font-display text-2xl font-bold text-gray-700 mb-2">No hay productos disponibles</h3>
            <p class="text-gray-500">Vuelve pronto para ver nuestras novedades</p>
        </div>
    }
</div>

<!-- CTA Section -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 rounded-3xl p-12 text-center text-white">
    <i class="fas fa-certificate text-6xl text-yellow-500 mb-6"></i>
    <h2 class="font-display text-4xl font-bold mb-4">Calidad Garantizada</h2>
    <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Todas nuestras joyas cuentan con certificado de autenticidad y garantía de por vida
    </p>
    <a href="#" class="inline-flex items-center gradient-gold text-gray-900 px-8 py-4 rounded-full font-bold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
        <i class="fas fa-award mr-3"></i>
        Conoce Más
    </a>
</div>

@section Styles {
    <style>
        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        @@keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fade-in {
            animation: fade-in 0.5s ease-out;
        }
    </style>
}
