@model IEnumerable<AldaJoyeros.DTOs.CategoriaDto>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-tags"></i> Categorías</h1>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Nueva Categoría
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.Id</td>
                                <td><strong>@categoria.Nombre</strong></td>
                                <td class="text-end">
                                    <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@categoria.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta categoría?')">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No hay categorías registradas.
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Volver al Panel
    </a>
</div>
