@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">
            <i class="fas fa-gem text-yellow-600"></i> Gestión de Productos
        </h1>
        <p class="text-gray-600">Administra el catálogo de productos</p>
    </div>
    <a asp-action="Crear" 
       class="inline-flex items-center gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
        <i class="fas fa-plus-circle mr-2"></i>
        Nuevo Producto
    </a>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-gem text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">@Model.TotalItems</div>
                <div class="text-sm text-gray-600">Total Productos</div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-chart-line text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">@Model.TotalPages</div>
                <div class="text-sm text-gray-600">Páginas</div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-eye text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">Página @Model.PageNumber</div>
                <div class="text-sm text-gray-600">de @Model.TotalPages</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Items != null && Model.Items.Any())
{
    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gradient-to-r from-gray-900 to-gray-800 text-white">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Producto</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Categoría</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Precio</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Descripción</th>
                        <th class="px-6 py-4 text-right text-sm font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var producto in Model.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-sm text-gray-600">
                                #@producto.Id
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-gradient-to-br from-amber-100 to-orange-100 rounded-lg flex items-center justify-center mr-3">
                                        <i class="fas fa-gem text-yellow-600"></i>
                                    </div>
                                    <span class="font-semibold text-gray-900">@producto.Nombre</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                    <i class="fas fa-tag mr-1"></i>
                                    @producto.CategoriaNombre
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-lg font-bold text-gradient">
                                    @producto.Precio.ToString("C")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate">
                                @producto.Descripcion
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end space-x-2">
                                    <a asp-action="Editar" asp-route-id="@producto.Id" 
                                       class="inline-flex items-center px-3 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-colors text-sm font-medium">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@producto.Id" method="post" class="inline" 
                                          onsubmit="return confirm('¿Estás seguro de eliminar este producto?')">
                                        <button type="submit" 
                                                class="inline-flex items-center px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-center items-center space-x-2 mt-8">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" 
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                    <i class="fas fa-chevron-left"></i>
                </span>
            }

            @{
                var startPage = Math.Max(1, Model.PageNumber - 2);
                var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
            }

            @if (startPage > 1)
            {
                <a asp-action="Index" asp-route-page="1" 
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                    1
                </a>
                @if (startPage > 2)
                {
                    <span class="px-2 text-gray-500">...</span>
                }
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                @if (i == Model.PageNumber)
                {
                    <span class="px-4 py-2 gradient-gold text-gray-900 rounded-lg font-bold shadow-md">
                        @i
                    </span>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i" 
                       class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                        @i
                    </a>
                }
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <span class="px-2 text-gray-500">...</span>
                }
                <a asp-action="Index" asp-route-page="@Model.TotalPages" 
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                    @Model.TotalPages
                </a>
            }

            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" 
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-yellow-500 hover:border-yellow-500 hover:text-white transition-all duration-200 font-medium">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                    <i class="fas fa-chevron-right"></i>
                </span>
            }
        </div>
    }
}
else
{
    <div class="bg-white rounded-2xl p-12 text-center shadow-lg">
        <i class="fas fa-gem text-gray-300 text-6xl mb-4"></i>
        <h3 class="font-display text-2xl font-bold text-gray-700 mb-2">No hay productos registrados</h3>
        <p class="text-gray-500 mb-6">Comienza agregando tu primer producto</p>
        <a asp-action="Crear" 
           class="inline-flex items-center gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-xl transition-all duration-200">
            <i class="fas fa-plus-circle mr-2"></i>
            Crear Producto
        </a>
    </div>
}

<!-- Back Button -->
<div class="mt-8">
    <a asp-controller="Admin" asp-action="Index" 
       class="inline-flex items-center text-gray-600 hover:text-gray-900 font-medium group">
        <i class="fas fa-arrow-left mr-2 group-hover:-translate-x-2 transition-transform"></i>
        Volver al Panel
    </a>
</div>
