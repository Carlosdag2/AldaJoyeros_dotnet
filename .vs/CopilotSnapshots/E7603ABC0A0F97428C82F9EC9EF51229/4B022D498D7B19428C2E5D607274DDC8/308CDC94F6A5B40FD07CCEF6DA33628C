@model AldaJoyeros.DTOs.CheckoutViewModel

@{
    ViewData["Title"] = "Finalizar Compra";
}

<!-- Header -->
<div class="mb-8 text-center">
    <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-900 mb-2">
        <i class="fas fa-credit-card text-yellow-600"></i> Finalizar Compra
    </h1>
    <p class="text-gray-600">Estás a un paso de completar tu pedido</p>
</div>

<!-- Progress Steps -->
<div class="max-w-3xl mx-auto mb-12">
    <div class="flex items-center justify-between">
        <div class="flex-1">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold">
                    <i class="fas fa-check"></i>
                </div>
                <div class="ml-4">
                    <div class="text-sm font-semibold text-green-600">Paso 1</div>
                    <div class="text-xs text-gray-600">Carrito</div>
                </div>
            </div>
        </div>
        <div class="flex-1 h-1 bg-yellow-500 mx-2"></div>
        <div class="flex-1">
            <div class="flex items-center">
                <div class="w-10 h-10 gradient-gold rounded-full flex items-center justify-center text-gray-900 font-bold">
                    2
                </div>
                <div class="ml-4">
                    <div class="text-sm font-semibold text-yellow-600">Paso 2</div>
                    <div class="text-xs text-gray-600">Dirección</div>
                </div>
            </div>
        </div>
        <div class="flex-1 h-1 bg-gray-300 mx-2"></div>
        <div class="flex-1">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold">
                    3
                </div>
                <div class="ml-4">
                    <div class="text-sm font-semibold text-gray-400">Paso 3</div>
                    <div class="text-xs text-gray-400">Confirmación</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <!-- Resumen del Carrito -->
        <div class="bg-white rounded-3xl shadow-xl p-8 mb-8">
            <h2 class="font-display text-3xl font-bold text-gray-900 mb-6 flex items-center">
                <i class="fas fa-shopping-cart text-yellow-600 mr-3"></i>
                Resumen del Pedido
            </h2>

            <div class="space-y-4">
                @foreach (var item in Model.CarritoItems)
                {
                    <div class="flex items-center gap-4 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-4">
                        <!-- Product Image -->
                        <div class="flex-shrink-0">
                            <div class="w-20 h-20 bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl overflow-hidden">
                                @if (item.Producto?.TieneImagenes == true)
                                {
                                    <img src="@item.Producto.ImagenPrincipal" 
                                         alt="@item.ProductoNombre" 
                                         class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <i class="fas fa-gem text-2xl text-yellow-600 opacity-30"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Product Info -->
                        <div class="flex-1">
                            <h3 class="font-bold text-gray-900 mb-1">@item.ProductoNombre</h3>
                            <p class="text-sm text-gray-600">
                                Cantidad: <span class="font-semibold">@item.Cantidad</span> × @item.Precio.ToString("C")
                            </p>
                        </div>

                        <!-- Subtotal -->
                        <div class="text-right">
                            <div class="text-lg font-bold text-gradient">@item.Subtotal.ToString("C")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 pt-6 border-t-2 border-gray-200">
                <div class="flex justify-between items-center">
                    <span class="text-2xl font-bold text-gray-900">Total:</span>
                    <span class="text-4xl font-bold text-gradient">@Model.Total.ToString("C")</span>
                </div>
            </div>
        </div>

        <!-- Dirección Form -->
        <div class="bg-white rounded-3xl shadow-xl p-8">
            <h2 class="font-display text-3xl font-bold text-gray-900 mb-6 flex items-center">
                <i class="fas fa-map-marker-alt text-yellow-600 mr-3"></i>
                Dirección de Envío
            </h2>

            <form asp-action="Checkout" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                        <span class="text-red-800 text-sm"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="md:col-span-3">
                        <label asp-for="Direccion.Calle" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-road mr-2 text-gray-500"></i>Calle
                        </label>
                        <input asp-for="Direccion.Calle" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                               placeholder="Nombre de la calle" />
                        <span asp-validation-for="Direccion.Calle" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <div class="md:col-span-1">
                        <label asp-for="Direccion.Numero" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-hashtag mr-2 text-gray-500"></i>Número
                        </label>
                        <input asp-for="Direccion.Numero" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                               placeholder="Núm." />
                        <span asp-validation-for="Direccion.Numero" class="text-red-500 text-sm mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Direccion.Piso" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-building mr-2 text-gray-500"></i>Piso / Puerta (opcional)
                    </label>
                    <input asp-for="Direccion.Piso" 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                           placeholder="Ej: 2º A" />
                    <span asp-validation-for="Direccion.Piso" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="Direccion.CodigoPostal" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-mail-bulk mr-2 text-gray-500"></i>Código Postal
                        </label>
                        <input asp-for="Direccion.CodigoPostal" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                               placeholder="28001" />
                        <span asp-validation-for="Direccion.CodigoPostal" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Direccion.Ciudad" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-city mr-2 text-gray-500"></i>Ciudad
                        </label>
                        <input asp-for="Direccion.Ciudad" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                               placeholder="Madrid" />
                        <span asp-validation-for="Direccion.Ciudad" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Direccion.Provincia" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-map mr-2 text-gray-500"></i>Provincia
                        </label>
                        <input asp-for="Direccion.Provincia" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-yellow-500 focus:ring focus:ring-yellow-200 transition-all duration-200"
                               placeholder="Madrid" />
                        <span asp-validation-for="Direccion.Provincia" class="text-red-500 text-sm mt-1 block"></span>
                    </div>
                </div>

                <hr class="my-8" />

                <div class="flex flex-col sm:flex-row justify-between gap-4">
                    <a asp-controller="Carrito" asp-action="Index" 
                       class="inline-flex items-center justify-center px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 font-semibold">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Volver al Carrito
                    </a>
                    <button type="submit" 
                            class="inline-flex items-center justify-center gradient-gold text-gray-900 px-8 py-4 rounded-lg font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                        <i class="fas fa-check mr-2"></i>
                        Confirmar Pedido
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Info Sidebar -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-3xl shadow-xl p-6 space-y-6 sticky top-24">
            <!-- Order Summary -->
            <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-xl p-6">
                <h3 class="font-display text-xl font-bold text-gray-900 mb-4">
                    <i class="fas fa-receipt text-yellow-600 mr-2"></i>
                    Total del Pedido
                </h3>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Productos:</span>
                        <span class="font-semibold text-gray-900">@Model.CarritoItems.Count()</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Subtotal:</span>
                        <span class="font-semibold text-gray-900">@Model.Total.ToString("C")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Envío:</span>
                        <span class="font-semibold text-green-600">GRATIS</span>
                    </div>
                    <hr class="my-3" />
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-bold text-gray-900">Total:</span>
                        <span class="text-2xl font-bold text-gradient">@Model.Total.ToString("C")</span>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Shipping Info -->
            <div>
                <h3 class="font-display text-xl font-bold text-gray-900 mb-4">
                    <i class="fas fa-info-circle text-blue-600 mr-2"></i>
                    Información de Envío
                </h3>
                <div class="space-y-3">
                    <div class="flex items-start">
                        <i class="fas fa-truck text-green-600 mt-1 mr-3"></i>
                        <div class="text-sm">
                            <div class="font-semibold text-gray-900">Envío en 3-5 días</div>
                            <div class="text-gray-600">Laborables a toda España</div>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-shield-alt text-blue-600 mt-1 mr-3"></i>
                        <div class="text-sm">
                            <div class="font-semibold text-gray-900">100% Seguro</div>
                            <div class="text-gray-600">Compra protegida</div>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-undo text-purple-600 mt-1 mr-3"></i>
                        <div class="text-sm">
                            <div class="font-semibold text-gray-900">30 días devolución</div>
                            <div class="text-gray-600">Sin preguntas</div>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-gift text-yellow-600 mt-1 mr-3"></i>
                        <div class="text-sm">
                            <div class="font-semibold text-gray-900">Empaquetado premium</div>
                            <div class="text-gray-600">Caja de regalo incluida</div>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Payment Methods -->
            <div>
                <h3 class="font-display text-xl font-bold text-gray-900 mb-4">
                    <i class="fas fa-credit-card text-green-600 mr-2"></i>
                    Métodos de Pago
                </h3>
                <div class="space-y-2 text-sm text-gray-700">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 mr-2"></i>
                        <span>Contra reembolso</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 mr-2"></i>
                        <span>Transferencia bancaria</span>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Contact -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4">
                <h4 class="font-semibold text-gray-900 mb-2 flex items-center">
                    <i class="fas fa-headset text-blue-600 mr-2"></i>
                    ¿Necesitas ayuda?
                </h4>
                <p class="text-xs text-gray-600 mb-3">
                    Nuestro equipo está disponible para asistirte
                </p>
                <a href="#" class="text-blue-600 hover:text-blue-700 font-semibold text-sm flex items-center group">
                    Contactar soporte
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
