@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var rolFiltro = ViewBag.RolFiltro as string ?? "";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">
            <i class="fas fa-users text-indigo-600"></i> Gestión de Usuarios
        </h1>
        <p class="text-gray-600">Administra las cuentas de usuarios del sistema</p>
    </div>
    <a asp-action="Crear" 
       class="inline-flex items-center gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
        <i class="fas fa-user-plus mr-2"></i>
        Nuevo Usuario
    </a>
</div>

<!-- Filter & Stats -->
<div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <div class="flex flex-wrap gap-2">
            <a asp-action="Index" 
               class="px-4 py-2 rounded-lg font-medium transition-all @(string.IsNullOrEmpty(rolFiltro) ? "bg-gradient-to-r from-indigo-500 to-purple-500 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                <i class="fas fa-th-large mr-2"></i>Todos
            </a>
            <a asp-action="Index" asp-route-rol="ADMIN"
               class="px-4 py-2 rounded-lg font-medium transition-all @(rolFiltro == "ADMIN" ? "bg-red-500 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                <i class="fas fa-user-shield mr-2"></i>Administradores
            </a>
            <a asp-action="Index" asp-route-rol="CLIENTE"
               class="px-4 py-2 rounded-lg font-medium transition-all @(rolFiltro == "CLIENTE" ? "bg-blue-500 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                <i class="fas fa-user mr-2"></i>Clientes
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center">
            <div class="text-2xl font-bold text-gray-900">@Model.TotalItems</div>
            <div class="text-sm text-gray-600">Total Usuarios</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-red-600">--</div>
            <div class="text-sm text-gray-600">Administradores</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-blue-600">--</div>
            <div class="text-sm text-gray-600">Clientes</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-green-600">@Model.PageNumber / @Model.TotalPages</div>
            <div class="text-sm text-gray-600">Página Actual</div>
        </div>
    </div>
</div>

@if (Model.Items != null && Model.Items.Any())
{
    <!-- Users Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        @foreach (var usuario in Model.Items)
        {
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden">
                <div class="@(usuario.Rol == "ADMIN" ? "bg-gradient-to-br from-red-500 to-pink-500" : "bg-gradient-to-br from-blue-500 to-indigo-500") p-6 text-white">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center backdrop-blur-sm">
                            <i class="@(usuario.Rol == "ADMIN" ? "fas fa-user-shield" : "fas fa-user") text-3xl"></i>
                        </div>
                        <div class="text-right">
                            <div class="text-sm opacity-80">ID</div>
                            <div class="text-2xl font-bold">#@usuario.Id</div>
                        </div>
                    </div>
                    <div class="text-xs font-semibold mb-1 opacity-80">EMAIL</div>
                    <h3 class="font-display text-lg font-bold truncate">@usuario.Email</h3>
                </div>

                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="text-sm text-gray-600 mb-1">Rol</div>
                            @if (usuario.Rol == "ADMIN")
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                    <i class="fas fa-user-shield mr-1"></i>Administrador
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                    <i class="fas fa-user mr-1"></i>Cliente
                                </span>
                            }
                        </div>
                        <div class="text-right">
                            <div class="text-sm text-gray-600 mb-1">Pedidos</div>
                            <div class="font-bold text-gray-900">--</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <a asp-action="Editar" asp-route-id="@usuario.Id" 
                           class="flex items-center justify-center px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-all duration-200 font-medium text-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form asp-action="Eliminar" asp-route-id="@usuario.Id" method="post" 
                              onsubmit="return confirm('¿Eliminar a @usuario.Email?')">
                            <button type="submit" 
                                    class="w-full flex items-center justify-center px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-all duration-200 font-medium text-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-center items-center space-x-2 mt-8">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-rol="@rolFiltro"
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-indigo-500 hover:border-indigo-500 hover:text-white transition-all duration-200 font-medium">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                    <i class="fas fa-chevron-left"></i>
                </span>
            }

            @{
                var startPage = Math.Max(1, Model.PageNumber - 2);
                var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
            }

            @if (startPage > 1)
            {
                <a asp-action="Index" asp-route-page="1" asp-route-rol="@rolFiltro"
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-indigo-500 hover:border-indigo-500 hover:text-white transition-all duration-200 font-medium">
                    1
                </a>
                @if (startPage > 2)
                {
                    <span class="px-2 text-gray-500">...</span>
                }
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                @if (i == Model.PageNumber)
                {
                    <span class="px-4 py-2 bg-gradient-to-r from-indigo-500 to-purple-500 text-white rounded-lg font-bold shadow-md">
                        @i
                    </span>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-rol="@rolFiltro"
                       class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-indigo-500 hover:border-indigo-500 hover:text-white transition-all duration-200 font-medium">
                        @i
                    </a>
                }
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <span class="px-2 text-gray-500">...</span>
                }
                <a asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-rol="@rolFiltro"
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-indigo-500 hover:border-indigo-500 hover:text-white transition-all duration-200 font-medium">
                    @Model.TotalPages
                </a>
            }

            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-rol="@rolFiltro"
                   class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-indigo-500 hover:border-indigo-500 hover:text-white transition-all duration-200 font-medium">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                    <i class="fas fa-chevron-right"></i>
                </span>
            }
        </div>
    }
}
else
{
    <!-- Empty State -->
    <div class="bg-white rounded-3xl p-12 text-center shadow-lg">
        <i class="fas fa-users text-gray-300 text-6xl mb-4"></i>
        <h3 class="font-display text-2xl font-bold text-gray-700 mb-2">No hay usuarios</h3>
        <p class="text-gray-500">@(!string.IsNullOrEmpty(rolFiltro) ? $"No hay usuarios con rol {rolFiltro}" : "Crea el primer usuario")</p>
    </div>
}

<!-- Back Button -->
<div class="mt-8">
    <a asp-controller="Admin" asp-action="Index" 
       class="inline-flex items-center text-gray-600 hover:text-gray-900 font-medium group">
        <i class="fas fa-arrow-left mr-2 group-hover:-translate-x-2 transition-transform"></i>
        Volver al Panel
    </a>
</div>
