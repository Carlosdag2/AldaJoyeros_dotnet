@model AldaJoyeros.DTOs.UsuarioUpdateDto

@{
    ViewData["Title"] = "Editar Usuario";
}

<h1 class="mb-4"><i class="fas fa-edit"></i> Editar Usuario</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="Editar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" class="form-select">
                            <option value="USER">👤 Usuario</option>
                            <option value="ADMIN">🛡️ Administrador</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle"></i> Para cambiar la contraseña, el usuario debe solicitarla desde su perfil.
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save"></i> Actualizar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5><i class="fas fa-shield-alt"></i> Permisos</h5>
                <ul class="small">
                    <li><strong>Usuario:</strong> Acceso a la tienda y sus pedidos</li>
                    <li><strong>Administrador:</strong> Acceso completo al sistema</li>
                </ul>
                <hr />
                <p class="small text-warning mb-0">
                    <i class="fas fa-exclamation-triangle"></i> Ten cuidado al cambiar roles de usuarios
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
