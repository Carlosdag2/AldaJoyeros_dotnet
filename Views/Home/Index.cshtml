@model IEnumerable<AldaJoyeros.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Inicio";
    var destacados = Model?.Take(8).ToArray() ?? Array.Empty<AldaJoyeros.DTOs.ProductoDto>();
    var tiposPrincipales = new[] { "Anillos", "Pendientes", "Pulseras", "Collares", "Relojes", "Smartwatches" };
    var categorias = (ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto> ?? Array.Empty<AldaJoyeros.DTOs.CategoriaDto>())
        .GroupBy(c => c.Nombre.Split(" · ")[0])
        .OrderBy(g => Array.IndexOf(tiposPrincipales, g.Key) is var i && i >= 0 ? i : tiposPrincipales.Length)
        .ThenBy(g => g.Key).Take(6).Select(g => g.OrderBy(c => c.Nombre.Contains(" · ")).First()).ToArray();
    var ecommerce = ViewBag.EcommerceEnabled == true;
}

<div class="home-page" x-data="carritoNotificacion()">
    @if (ecommerce) { <partial name="_CarritoNotificacion" /> }

    <section class="home-hero" aria-labelledby="home-title">
        <div class="container mx-auto grid lg:grid-cols-2">
            <div class="flex flex-col justify-center px-6 py-12 sm:px-10 sm:py-16 lg:py-24 lg:pr-16">
                <p class="mb-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-800">
                    <span class="h-px w-8 bg-emerald-700" aria-hidden="true"></span>Illescas · Desde 1962
                </p>
                <h1 id="home-title" class="max-w-xl font-serif text-5xl leading-[1.08] tracking-tight text-stone-900 sm:text-6xl xl:text-7xl">
                    Hay momentos<br />que merecen<br /><em class="font-normal text-emerald-800">una joya.</em>
                </h1>
                <p class="mt-6 max-w-md text-base leading-relaxed text-stone-600 sm:text-lg">Joyas y relojes para acompañarte cada día y celebrar lo que de verdad importa. Encuentra tu próxima pieza en Alda Joyeros.</p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <a asp-controller="Productos" asp-action="Index" asp-route-categoria="" class="inline-flex items-center justify-center gap-4 rounded-lg bg-emerald-800 px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-emerald-900">
                        Descubrir el catálogo <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                    </a>
                    <a href="#visitanos" class="inline-flex items-center justify-center gap-3 rounded-lg border border-stone-300 px-6 py-4 text-sm font-semibold text-stone-800 transition-colors hover:bg-white">Conoce nuestra tienda</a>
                </div>
                <p class="mt-8 text-xs leading-relaxed text-stone-500"><i class="fas fa-location-dot mr-2 text-emerald-700" aria-hidden="true"></i>Tu joyería en Illescas, Toledo.</p>
            </div>
            <div class="home-hero-visual relative min-w-0 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1573408301185-9146fe634ad0?q=80&amp;w=1400&amp;auto=format&amp;fit=crop"
                     alt="Detalles de una colección de joyas" width="1000" height="1100" fetchpriority="high" decoding="async" class="h-full w-full object-cover" />
                <div class="home-hero-shade absolute inset-0" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
                    <p class="home-photo-caption text-xs uppercase tracking-[0.25em]">Alda Joyeros 1962</p>
                    <p class="home-photo-caption mt-3 max-w-sm font-serif text-3xl sm:text-4xl">Pequeños detalles.<br />Grandes recuerdos.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-y border-stone-200 bg-white" aria-label="La experiencia Alda Joyeros">
        <div class="container mx-auto grid gap-6 px-6 py-7 sm:grid-cols-3 sm:gap-8">
            @foreach (var item in new[] {
                (Icon: "fa-gem", Title: "Una historia desde 1962", Text: "La joyería de siempre, cerca de ti."),
                (Icon: "fa-comments", Title: "Te ayudamos a elegir", Text: "Atención personal en nuestra tienda."),
                (Icon: ecommerce ? "fa-lock" : "fa-store", Title: ecommerce ? "Compra a tu manera" : "Descubre y ven a vernos", Text: ecommerce ? "Online o en nuestra tienda de Illescas." : "Explora el catálogo y consulta tus favoritos.") })
            {
                <div class="flex items-start gap-4">
                    <i class="fas @item.Icon mt-1 text-lg text-emerald-800" aria-hidden="true"></i>
                    <div><h2 class="text-sm font-semibold text-stone-900">@item.Title</h2><p class="mt-1 text-xs leading-relaxed text-stone-600">@item.Text</p></div>
                </div>
            }
        </div>
    </section>

    @if (categorias.Length > 0)
    {
        <section class="bg-stone-50 py-12 sm:py-16" aria-labelledby="home-categories-title">
            <div class="container mx-auto px-6">
                <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
                    <div><p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-800">Encuentra tu estilo</p><h2 id="home-categories-title" class="font-serif text-3xl text-stone-900 sm:text-4xl">¿Qué estás buscando?</h2></div>
                    <a asp-controller="Productos" asp-action="Index" asp-route-categoria="" class="text-sm font-semibold text-emerald-800 underline underline-offset-4">Ver todas las categorías</a>
                </div>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var categoria in categorias)
                    {
                        <a href="@(Context.Request.PathBase + AldaJoyeros.Helpers.PublicUrls.CatalogPath(categoria.UrlSlug))" class="group flex min-w-0 items-center justify-between gap-4 rounded-xl border border-stone-200 bg-white p-5 text-stone-900 transition-colors hover:border-emerald-700 hover:bg-emerald-50">
                            <span class="min-w-0 break-words font-serif text-xl">@categoria.Nombre</span><i class="fas fa-arrow-right shrink-0 text-sm text-emerald-800" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section id="productos-destacados" class="scroll-mt-24 bg-white py-14 sm:py-20" aria-labelledby="home-featured-title">
        <div class="container mx-auto px-6">
            <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
                <div><p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-800">Nuestra selección</p><h2 id="home-featured-title" class="font-serif text-3xl text-stone-900 sm:text-5xl">Piezas que enamoran</h2><p class="mt-4 max-w-xl text-sm leading-relaxed text-stone-600">Una selección de nuestra tienda para inspirarte. Descubre sus detalles y encuentra la que va contigo.</p></div>
                <a asp-controller="Productos" asp-action="Index" asp-route-categoria="" class="inline-flex items-center gap-3 text-sm font-semibold text-emerald-800">Explorar todo <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            @if (destacados.Length > 0)
            {
                <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 lg:grid-cols-4">
                    @foreach (var producto in destacados)
                    {
                        var link = AldaJoyeros.Helpers.PublicUrls.ProductLink(Context.Request, producto);
                        <article class="group flex min-w-0 flex-col" data-home-product>
                            <a href="@link" data-product-id="@producto.Id" class="product-media relative block aspect-square overflow-hidden rounded-xl border border-stone-200 bg-white p-3 sm:p-6" aria-label="Ver @producto.CategoriaNombre, referencia @producto.Nombre">
                                @if (producto.TieneImagenes)
                                {
                                    <img src="@producto.ImagenPrincipal" alt="@producto.CategoriaNombre, referencia @producto.Nombre" loading="lazy" decoding="async" width="400" height="400" class="h-full w-full object-contain transition-transform duration-500 motion-safe:group-hover:scale-105" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                                    <span hidden class="absolute inset-0 items-center justify-center p-6 text-center text-sm text-stone-500">Imagen no disponible</span>
                                }
                                else
                                { <span class="flex h-full items-center justify-center"><i class="fas fa-gem text-4xl text-stone-300" aria-hidden="true"></i></span> }
                            </a>
                            <div class="flex flex-1 flex-col pt-4">
                                <p class="mb-2 break-words text-xs text-stone-500">@producto.CategoriaNombre</p>
                                <h3 class="break-words text-sm font-semibold text-stone-900"><a href="@link" data-product-id="@producto.Id" class="hover:underline">@producto.Nombre</a></h3>
                                <p class="mt-2 font-serif text-xl text-emerald-800">@(producto.PrecioDesde ? "Desde " : "")@producto.Precio.ToString("C")</p>
                                <div class="mt-auto pt-4">
                                    @if (ecommerce && !producto.TieneTallas)
                                    {
                                        <button type="button" data-product-name="@producto.Nombre" @@click="agregarAlCarrito(@producto.Id, $el.dataset.productName, $event)" :disabled="cargandoProducto === @producto.Id" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-emerald-800 px-3 py-3 text-xs font-semibold text-emerald-800 transition-colors hover:bg-emerald-50 disabled:opacity-50">
                                            <i class="fas fa-plus" aria-hidden="true"></i><span x-text="cargandoProducto === @producto.Id ? 'Añadiendo…' : 'Añadir al carrito'">Añadir al carrito</span>
                                        </button>
                                    }
                                    else
                                    { <a href="@link" data-product-id="@producto.Id" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-stone-300 px-3 py-3 text-xs font-semibold text-stone-800 transition-colors hover:border-emerald-700 hover:text-emerald-800">@(ecommerce && producto.TieneTallas ? "Elegir talla" : "Descubrir pieza")<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a> }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-stone-200 bg-stone-50 px-6 py-12 text-center"><i class="fas fa-gem mb-4 text-3xl text-emerald-800" aria-hidden="true"></i><h3 class="font-serif text-2xl text-stone-900">Tu próxima joya te espera</h3><p class="mt-3 text-sm text-stone-600">Explora nuestro catálogo y descubre todas las piezas de la tienda.</p><a asp-controller="Productos" asp-action="Index" asp-route-categoria="" class="mt-5 inline-flex rounded-lg bg-emerald-800 px-6 py-3 text-sm font-semibold text-white">Ir al catálogo</a></div>
            }
        </div>
    </section>

    <section class="home-story py-12 sm:py-16" aria-labelledby="home-story-title">
        <div class="container mx-auto grid items-center gap-8 px-6 md:grid-cols-3 md:gap-12">
            <div><p class="text-xs uppercase tracking-[0.2em] text-emerald-800">Alda Joyeros</p><p class="mt-2 font-serif text-6xl text-emerald-900">1962<span class="mt-2 block font-sans text-xs uppercase tracking-[0.2em] text-stone-600">El comienzo de nuestra historia</span></p></div>
            <div class="md:col-span-2"><h2 id="home-story-title" class="font-serif text-3xl text-stone-900 sm:text-4xl">La confianza de siempre.<br />La ilusión de cada ocasión.</h2><p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-600">Llevamos más de seis décadas formando parte de los momentos de nuestros clientes. Ven a nuestra tienda de Illescas: te ayudamos a elegir con calma, de cerca y a tu manera.</p><a href="#visitanos" class="mt-5 inline-flex items-center gap-3 text-sm font-semibold text-emerald-800 underline underline-offset-4">Te esperamos en la tienda <i class="fas fa-arrow-down text-xs" aria-hidden="true"></i></a></div>
        </div>
    </section>

    <!-- Store Location Section -->
    <section id="visitanos" class="scroll-mt-24 py-16 sm:py-20 lg:py-28 bg-white" aria-labelledby="store-location-title">
        <div class="container mx-auto px-6">
            <!-- Section Header -->
            <div class="text-center mb-16">
                <div class="flex items-center justify-center gap-4 mb-6">
                    <div class="w-12 h-px bg-emerald-500"></div>
                    <span class="text-emerald-600 text-xs uppercase tracking-[0.4em]">Visítanos</span>
                    <div class="w-12 h-px bg-emerald-500"></div>
                </div>
                <h2 id="store-location-title" class="font-serif text-3xl sm:text-4xl md:text-5xl font-light text-gray-900 mb-4">
                    Nuestra Tienda
                </h2>
                <p class="text-gray-500 max-w-xl mx-auto">
                    Te esperamos para ofrecerte una experiencia personalizada
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-5 gap-0 rounded-2xl border border-stone-200 overflow-hidden">
                <!-- Map -->
                <div class="relative h-72 min-w-0 overflow-hidden bg-gray-100 sm:h-96 lg:col-span-3 lg:h-auto lg:min-h-[550px]">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3040.262772693775!2d-3.850095!3d40.1228119!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd41f1eb52287a03%3A0x7ea236ec19f47b25!2sAlda%20Joyeros%201962!5e0!3m2!1ses!2ses!4v1703123456789!5m2!1ses!2ses"
                        width="100%"
                        height="100%"
                        title="Ubicación de Alda Joyeros 1962 en Illescas"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="w-full h-full absolute inset-0">
                    </iframe>
                </div>

                <!-- Contact Info -->
                <div class="min-w-0 lg:col-span-2 bg-emerald-950 text-white p-6 sm:p-10 lg:p-12 xl:p-14 flex flex-col justify-center">
                    <div class="space-y-8 sm:space-y-10">
                        <!-- Logo -->
                        <div class="mb-4">
                            <p class="font-serif text-3xl tracking-wider">ALDA</p>
                            <p class="text-emerald-400 text-sm tracking-[0.3em]">JOYEROS 1962</p>
                        </div>

                        <!-- Address -->
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bg-emerald-900 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-map-marker-alt text-emerald-400 text-sm"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-emerald-500 text-xs uppercase tracking-[0.2em] mb-2">Dirección</p>
                                <p class="text-white/80 leading-relaxed">
                                    C/ Sor Livia Alcorta, 24<br />
                                    45200 Illescas, Toledo
                                </p>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bg-emerald-900 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-phone text-emerald-400 text-sm"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-emerald-500 text-xs uppercase tracking-[0.2em] mb-2">Teléfono</p>
                                <a href="tel:+34925541227" class="text-white hover:text-emerald-400 transition-colors text-lg">
                                    +34 925 54 12 27
                                </a>
                            </div>
                        </div>

                        <!-- Hours -->
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bg-emerald-900 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-clock text-emerald-400 text-sm"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-emerald-500 text-xs uppercase tracking-[0.2em] mb-2">Horario</p>
                                <div class="text-white/80 text-sm space-y-1">
                                    <p>Lun - Vie: 10:15 - 13:30 / 17:00 - 20:00</p>
                                    <p>Sábados: 10:15 - 13:30</p>
                                    <p class="text-emerald-300">Domingos: Cerrado</p>
                                </div>
                            </div>
                        </div>

                        <!-- CTA -->
                        <a href="https://www.google.com/maps/dir//Calle+Sor+Livia+Alcorta,+24,+45200+Illescas,+Toledo"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="inline-flex w-full sm:w-auto items-center justify-center px-6 sm:px-8 py-4 bg-emerald-600 text-white text-xs uppercase tracking-[0.2em] hover:bg-emerald-500 transition-colors mt-4">
                            <i class="fas fa-directions mr-3"></i>
                            Cómo Llegar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
