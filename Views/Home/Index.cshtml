@model IEnumerable<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<section class="relative h-screen w-full overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>
        <img src="https://images.unsplash.com/photo-1573408301185-9146fe634ad0?q=80&w=2400&auto=format&fit=crop"
             class="w-full h-full object-cover scale-105 animate-float" 
             alt="Imagen de fondo de joya en incio">
    </div>

    <!-- Hero Content -->
    <div class="relative z-20 container mx-auto h-full flex flex-col justify-center items-center text-center text-white px-6">
        <span class="text-emerald-300 text-xs md:text-sm tracking-[0.3em] uppercase mb-4 opacity-0 animate-fade-in-up" 
              style="animation-delay: 0.2s; animation-fill-mode: forwards;">
            <i class="fas fa-gem mr-2"></i>Colección 2025
        </span>
        
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-bold mb-6 opacity-0 animate-fade-in-up luxury-text-shadow" 
            style="animation-delay: 0.4s; animation-fill-mode: forwards;">
            Alda Joyeros 1962
        </h1>
        
        <p class="text-lg md:text-xl text-gray-200 max-w-2xl mx-auto mb-10 font-light opacity-0 animate-fade-in-up" 
           style="animation-delay: 0.6s; animation-fill-mode: forwards;">
            Elegancia atemporal para tus momentos más especiales.<br/>
            Descubre la excelencia en cada pieza.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4 opacity-0 animate-fade-in-up" 
             style="animation-delay: 0.8s; animation-fill-mode: forwards;">
            <a asp-controller="Productos" asp-action="Index"
               class="inline-flex items-center px-8 py-4 bg-white/10 backdrop-blur-md border border-white/30 text-white text-sm uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all duration-500 rounded-sm">
                <i class="fas fa-shopping-bag mr-3"></i>
                Explorar Catálogo
            </a>
            <a href="#productos-destacados"
               class="inline-flex items-center px-8 py-4 bg-emerald-500 text-white text-sm uppercase tracking-[0.2em] hover:bg-emerald-600 transition-all duration-300 rounded-sm font-semibold">
                Ver Productos
                <i class="fas fa-arrow-down ml-3"></i>
            </a>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 z-20 animate-bounce">
        <i class="fas fa-chevron-down text-white text-2xl opacity-50"></i>
    </div>
</section>

<!-- Features Section -->
<section class="py-20 bg-stone-50">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature 1 -->
            <div class="text-center p-8 bg-white rounded-lg shadow-sm hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-shipping-fast text-2xl text-emerald-600"></i>
                </div>
                <h3 class="font-serif text-xl font-bold text-gray-900 mb-2">Envío Gratis</h3>
                <p class="text-gray-600 text-sm">En compras superiores a 50€. Entrega en 3-5 días laborables.</p>
            </div>

            <!-- Feature 2 -->
            <div class="text-center p-8 bg-white rounded-lg shadow-sm hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-certificate text-2xl text-emerald-600"></i>
                </div>
                <h3 class="font-serif text-xl font-bold text-gray-900 mb-2">Garantía de Autenticidad</h3>
                <p class="text-gray-600 text-sm">Cada pieza incluye certificado de autenticidad y garantía de por vida.</p>
            </div>

            <!-- Feature 3 -->
            <div class="text-center p-8 bg-white rounded-lg shadow-sm hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-headset text-2xl text-emerald-600"></i>
                </div>
                <h3 class="font-serif text-xl font-bold text-gray-900 mb-2">Atención Personalizada</h3>
                <p class="text-gray-600 text-sm">Asesoramiento experto para ayudarte a encontrar la joya perfecta.</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section id="productos-destacados" class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <span class="text-emerald-600 text-xs uppercase tracking-[0.3em] mb-2 block">Selección Exclusiva</span>
            <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Productos Destacados
            </h2>
            <div class="w-20 h-px bg-emerald-500 mx-auto"></div>
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Products Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                @foreach (var producto in Model.Take(8))
                {
                    <div class="group">
                        <!-- Product Image -->
                        <div class="relative aspect-[3/4] overflow-hidden bg-stone-50 mb-4 rounded-lg">
                            @if (producto.TieneImagenes)
                            {
                                <img src="@producto.ImagenPrincipal"
                                     alt="@producto.Nombre"
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                     onerror="this.onerror=null; this.src='/images/placeholder-product.jpg';" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="fas fa-gem text-6xl text-emerald-300 opacity-30"></i>
                                </div>
                            }

                            <!-- Category Badge -->
                            @if (!string.IsNullOrEmpty(producto.CategoriaNombre))
                            {
                                <div class="absolute top-3 left-3">
                                    <span class="bg-white/90 backdrop-blur-sm text-gray-900 px-3 py-1 rounded-full text-xs font-semibold">
                                        @producto.CategoriaNombre
                                    </span>
                                </div>
                            }

                            <!-- Quick Add Button -->
                            <div class="absolute inset-x-0 bottom-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                                <form asp-controller="Carrito" asp-action="Agregar" method="post" class="w-full">
                                    <input type="hidden" name="productoId" value="@producto.Id" />
                                    <button type="submit" 
                                            class="w-full bg-emerald-600 text-white py-3 text-xs uppercase tracking-widest hover:bg-emerald-700 transition-colors font-semibold">
                                        <i class="fas fa-cart-plus mr-2"></i>Añadir al Carrito
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Product Info -->
                        <div class="text-center">
                            <h3 class="font-sans text-sm uppercase tracking-wider text-gray-900 mb-2 group-hover:text-emerald-600 transition-colors">
                                <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.Id" class="hover:underline">
                                    @producto.Nombre
                                </a>
                            </h3>
                            <p class="text-emerald-600 font-serif text-xl font-semibold">
                                @producto.Precio.ToString("C")
                            </p>
                            
                            <!-- View Details Link -->
                            <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.Id"
                               class="inline-block mt-3 text-xs uppercase tracking-widest text-gray-600 hover:text-emerald-600 transition-colors border-b border-transparent hover:border-emerald-600 pb-1">
                                Ver Detalles
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- View All Button -->
            <div class="text-center mt-16">
                <a asp-controller="Productos" asp-action="Index" 
                   class="inline-flex items-center px-8 py-4 bg-dark-900 text-white text-sm uppercase tracking-[0.2em] hover:bg-emerald-600 hover:text-white transition-all duration-300 rounded-sm">
                    <i class="fas fa-th mr-3"></i>
                    Ver Todo el Catálogo
                    <i class="fas fa-arrow-right ml-3"></i>
                </a>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-20">
                <i class="fas fa-gem text-6xl text-gray-300 mb-6"></i>
                <h3 class="font-serif text-2xl text-gray-700 mb-2">Próximamente</h3>
                <p class="text-gray-500">Estamos preparando nuestra colección exclusiva para ti.</p>
            </div>
        }
    </div>
</section>

