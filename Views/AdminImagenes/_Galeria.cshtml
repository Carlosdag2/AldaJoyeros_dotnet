@model AldaJoyeros.DTOs.ProductoDto
@{ var images = Model.Imagenes.OrderBy(i => i.Orden).ThenBy(i => i.Id).ToList(); }
<div data-gallery-content data-image-count="@images.Count" class="space-y-5">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500"><p><strong class="text-slate-800">@images.Count</strong> @(images.Count == 1 ? "imagen" : "imágenes")</p><p>@((images.Sum(i => (long)i.TamanoBytes) / 1024d).ToString("N0")) KB en total</p><p>Mueve las fotos con las flechas o arrastra el asa de cada tarjeta.</p></div>
    @if(images.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center"><i class="far fa-images mb-4 text-3xl text-slate-400" aria-hidden="true"></i><h3 class="text-lg font-semibold text-slate-800">Todavía no hay imágenes</h3><p class="mt-2 text-sm text-slate-500">Añade las primeras fotos desde la zona de arriba.</p></div>
    }
    else
    {
        <div data-image-grid class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @for(var index = 0; index < images.Count; index++)
        {
            var image = images[index];
            var name = string.IsNullOrWhiteSpace(image.NombreArchivo) ? $"Imagen {index + 1}" : image.NombreArchivo;
            <article data-image-id="@image.Id" data-image-name="@name" data-principal="@image.EsPrincipal.ToString().ToLowerInvariant()" class="min-w-0 overflow-hidden rounded-2xl border @(image.EsPrincipal ? "border-emerald-500" : "border-slate-200") bg-white shadow-sm">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 px-3 py-2"><span class="text-xs font-semibold text-slate-500">Posición <span data-image-position>@(index + 1)</span></span><button type="button" draggable="true" data-image-drag aria-label="Arrastrar @name para cambiar su posición" title="Arrastrar para ordenar" class="image-drag-handle flex h-11 w-11 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100"><i class="fas fa-grip-vertical" aria-hidden="true"></i></button></div>
                <button type="button" data-image-preview class="block aspect-square w-full bg-white p-4" aria-label="Ampliar @name"><img src="@image.ImagenBase64" alt="@Model.Nombre, @name" loading="lazy" class="h-full w-full object-contain" /></button>
                <div class="space-y-3 p-4"><div class="min-h-11"><h3 class="break-words text-sm font-semibold text-slate-800">@name</h3><p class="mt-1 text-xs text-slate-500">@((image.TamanoBytes / 1024d).ToString("N0")) KB · @image.TipoMime.Replace("image/", "").ToUpperInvariant()</p></div>
                    <button type="button" data-image-principal disabled="@image.EsPrincipal" class="admin-row-action w-full border-emerald-200 text-emerald-800 disabled:cursor-default disabled:opacity-70"><i class="@(image.EsPrincipal ? "fas" : "far") fa-star" aria-hidden="true"></i>@(image.EsPrincipal ? "Imagen principal" : "Usar como principal")</button>
                    <div class="flex flex-wrap justify-between gap-2"><div class="flex gap-1"><button type="button" data-image-move="-1" disabled="@(index == 0)" aria-label="Mover @name antes" class="admin-row-action border-slate-200 text-slate-600 disabled:opacity-30"><i class="fas fa-arrow-left" aria-hidden="true"></i></button><button type="button" data-image-move="1" disabled="@(index == images.Count - 1)" aria-label="Mover @name después" class="admin-row-action border-slate-200 text-slate-600 disabled:opacity-30"><i class="fas fa-arrow-right" aria-hidden="true"></i></button></div><button type="button" data-image-delete class="admin-row-action border-red-200 text-red-700"><i class="far fa-trash-alt" aria-hidden="true"></i>Eliminar</button></div>
                </div>
            </article>
        }
        </div>
    }
</div>
