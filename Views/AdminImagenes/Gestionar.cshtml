@model AldaJoyeros.DTOs.ProductoDto
@{ ViewData["Title"] = "Imágenes del producto"; }
<div class="min-h-screen bg-slate-50 pb-12" data-image-manager data-product-id="@Model.Id" data-gallery-url="@Url.Action("Galeria", new { id = Model.Id })" data-order-url="@Url.Action("Ordenar")" data-principal-url="@Url.Action("EstablecerPrincipal")" data-delete-url="@Url.Action("Eliminar")">
    <header class="bg-slate-900 text-white"><div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <a asp-controller="AdminProductos" asp-action="Index" class="mb-5 inline-flex min-h-11 items-center gap-2 text-sm text-slate-300 hover:text-white"><i class="fas fa-arrow-left" aria-hidden="true"></i>Volver a productos</a>
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div class="min-w-0"><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-300">Cuida cada detalle</p><h1 class="text-3xl font-bold">Imágenes del producto</h1><p class="mt-2 break-words text-sm text-slate-300">@Model.Nombre · #@Model.Id</p></div><a href="@Url.Action("Detalle", "Productos", new { id = Model.Id, slug = (string?)null })" target="_blank" rel="noopener" class="admin-row-action border-slate-600 text-white"><i class="fas fa-external-link-alt" aria-hidden="true"></i>Ver ficha en la tienda</a></div>
    </div></header>
    <div class="mx-auto max-w-7xl space-y-6 px-4 pt-6 sm:px-6 lg:px-8">
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="upload-title">
            <div class="mb-5"><h2 id="upload-title" class="text-lg font-semibold text-slate-900">Añadir imágenes</h2><p id="upload-help" class="mt-2 text-sm leading-relaxed text-slate-500">Selecciona o arrastra hasta 10 imágenes por tanda. JPG, PNG, WEBP o GIF, hasta 5 MB por imagen. Se añadirán al final de la galería.</p></div>
            <form asp-action="Subir" method="post" enctype="multipart/form-data" data-image-upload>
                <input type="hidden" name="productoId" value="@Model.Id" />
                <div data-image-drop class="rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 p-5 text-center sm:p-8"><i class="far fa-images mb-3 text-3xl text-emerald-700" aria-hidden="true"></i><p class="mb-4 text-sm text-slate-600">Arrastra tus fotos aquí o selecciónalas desde tu dispositivo.</p><label for="imageFiles" class="sr-only">Seleccionar imágenes</label><input id="imageFiles" name="archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" multiple aria-describedby="upload-help" class="block w-full min-w-0 text-sm text-slate-600 file:mr-3 file:min-h-11 file:rounded-lg file:border-0 file:bg-emerald-800 file:px-4 file:font-semibold file:text-white" /></div>
                <p data-upload-status role="status" class="mt-4 break-words text-sm text-slate-600">La primera foto de un producto sin imágenes se marca como principal.</p>
                <ul data-image-queue class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Imágenes seleccionadas"></ul>
                <div class="mt-5 flex flex-wrap gap-3"><button type="submit" data-upload-submit disabled class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50"><i class="fas fa-upload mr-2" aria-hidden="true"></i>Subir imágenes</button><button type="button" data-queue-clear class="admin-row-action border-slate-300 text-slate-600" disabled>Limpiar selección</button></div>
            </form>
        </section>
        <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-xl font-semibold text-slate-900">Galería del producto</h2><p class="mt-1 text-sm text-slate-500">La principal es la portada del catálogo. El orden organiza las demás fotos.</p></div><button type="button" data-gallery-refresh class="admin-row-action border-slate-300 text-slate-600"><i class="fas fa-sync-alt" aria-hidden="true"></i>Actualizar galería</button></div>
        <div data-order-toolbar hidden class="rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="mb-3 text-sm font-medium text-amber-900">Has cambiado el orden. Guárdalo antes de añadir o modificar imágenes.</p><div class="flex flex-wrap gap-3"><button type="button" data-order-save class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Guardar orden</button><button type="button" data-order-discard class="admin-row-action border-slate-300 text-slate-600">Descartar cambios</button></div></div>
        <p data-gallery-status role="status" class="text-sm text-slate-500"></p>
        <div data-image-gallery><partial name="_Galeria" model="Model" /></div>
    </div>
</div>
<partial name="_AdminWorkDialog" />
<dialog data-image-viewer aria-labelledby="imageViewerTitle" class="image-viewer rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 shadow-xl sm:p-6"><div class="mb-4 flex items-center justify-between gap-4"><h2 id="imageViewerTitle" class="break-words text-lg font-semibold">Vista de la imagen</h2><button type="button" data-viewer-close aria-label="Cerrar vista de imagen" class="admin-row-action shrink-0 border-slate-200 text-slate-600"><i class="fas fa-times" aria-hidden="true"></i></button></div><img data-viewer-image alt="" class="image-viewer-photo w-full rounded-xl bg-white object-contain" /><p data-viewer-caption class="mt-3 break-words text-sm text-slate-500"></p></dialog>
@section Styles { <link href="~/css/admin-workspace.css" rel="stylesheet" asp-append-version="true" /><link href="~/css/admin-images.css" rel="stylesheet" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-workspace.js" asp-append-version="true"></script><script src="~/js/admin-images.js" asp-append-version="true"></script> }
