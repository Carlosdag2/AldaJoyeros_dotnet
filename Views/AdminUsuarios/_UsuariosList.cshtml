@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
<div data-current-page="@Model.PageNumber">
@if (Model.Items.Any())
{
<div class="admin-list overflow-hidden rounded-xl border border-slate-200 bg-white">
<div class="admin-list-header md:grid md:grid-cols-[minmax(0,1fr)_140px_90px_205px] hidden items-center gap-5 border-b border-slate-200 bg-slate-50 px-5 py-4 text-[11px] font-bold uppercase tracking-wide text-slate-500" aria-hidden="true"><span>Usuario</span><span>Rol</span><span>Pedidos</span><span class="text-right">Acciones</span></div>
@foreach (var u in Model.Items)
{
<div class="admin-row usuario-card grid-cols-[minmax(0,1fr)_auto] md:grid-cols-[minmax(0,1fr)_140px_90px_205px] grid min-w-0 items-center gap-3.5 border-b border-slate-100 p-4 text-sm last:border-b-0 hover:bg-slate-50 md:gap-5 md:px-5" data-usuario-id="@u.Id">
<div class="admin-identity col-span-2 md:col-span-1 flex min-w-0 items-center gap-3 [&>div]:min-w-0"><span class="admin-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500"><i class="fas fa-user" aria-hidden="true"></i></span><div><span class="admin-name block font-semibold [overflow-wrap:anywhere]">@u.Email</span><span class="admin-sub mt-1 block text-xs text-slate-500 [overflow-wrap:anywhere]">Usuario #@u.Id</span></div></div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 md:hidden">Rol</span><span class="admin-badge inline-flex w-fit items-center gap-1.5 rounded-md px-2 py-1 text-[11px] font-semibold @(u.Rol == "ADMIN" ? "bg-violet-50 text-violet-700" : "bg-blue-50 text-blue-700")">@(u.Rol == "ADMIN" ? "Administrador" : "Cliente")</span></div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 md:hidden">Pedidos</span><strong>@u.CantidadPedidos</strong></div>
<div class="admin-actions col-span-2 justify-start md:col-span-1 md:justify-end flex flex-wrap gap-1.5"><a asp-action="Editar" asp-route-id="@u.Id" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100"><i class="fas fa-pen" aria-hidden="true"></i>Editar</a><button type="button" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-transparent bg-transparent text-red-700 hover:border-red-200 hover:bg-red-50" data-delete-record="@u.Id" data-email="@u.Email" aria-label="Eliminar usuario @u.Email"><i class="fas fa-trash-alt" aria-hidden="true"></i>Eliminar</button></div>
</div>
}
</div>
}
else
{
<div class="admin-empty rounded-xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center text-slate-500 [&_h2]:mb-1.5 [&_h2]:mt-2.5 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-slate-700"><i class="fas fa-users" aria-hidden="true"></i><h2>No hay usuarios que coincidan</h2><p>Prueba otro correo, ID o rol, o limpia los filtros.</p></div>
}
@if (Model.TotalPages > 1)
{
@await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, "adminUsuarios.cargarPagina", "paginacionUsuarios", false))
}
<p class="admin-results mt-4 text-center text-xs text-slate-500">Mostrando @Model.StartItem–@Model.EndItem de @Model.TotalItems usuarios</p>
</div>
