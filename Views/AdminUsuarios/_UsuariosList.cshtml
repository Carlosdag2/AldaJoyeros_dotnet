@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
@{
    var rolFiltro = ViewBag.RolFiltro as string ?? "";
}

@if(Model.Items != null && Model.Items.Any())
{
    <!-- Users Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
        @foreach(var u in Model.Items)
        {
            var userEmail = u.Email.Replace("'", "\\'");
            <div data-usuario-id="@u.Id" class="usuario-card group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 hover:border-blue-200">
                <!-- Header -->
                <div class="@(u.Rol == "ADMIN" ? "bg-gradient-to-br from-red-500 to-rose-600" : "bg-gradient-to-br from-blue-500 to-indigo-600") p-5 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-20 h-20 bg-white/10 rounded-full -mr-10 -mt-10"></div>
                    <div class="relative flex items-center gap-3">
                        <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center">
                            <i class="@(u.Rol == "ADMIN" ? "fas fa-user-shield" : "fas fa-user") text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-bold text-white truncate">@u.Email</div>
                            <div class="text-white/70 text-sm">ID #@u.Id</div>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="p-5">
                    <div class="flex items-center justify-between mb-4 bg-slate-50 rounded-xl p-4 border border-slate-100">
                        <div>
                            <div class="text-xs text-slate-400 mb-1">Rol</div>
                            @if(u.Rol == "ADMIN")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                    <i class="fas fa-user-shield mr-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                    <i class="fas fa-user mr-1"></i>Cliente
                                </span>
                            }
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-slate-400 mb-1">Pedidos</div>
                            <div class="text-xl font-bold text-emerald-600">@u.CantidadPedidos</div>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <a href="/AdminUsuarios/Editar/@u.Id" class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-emerald-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                            <i class="fas fa-edit"></i>Editar
                        </a>
                        <button type="button" 
                                onclick="adminUsuarios.eliminar(@u.Id, '@userEmail')"
                                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-red-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                            <i class="fas fa-trash"></i>Eliminar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination AJAX -->
    @if(Model.TotalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 flex-wrap" id="paginacionUsuarios">
            @if(Model.HasPreviousPage)
            {
                <button type="button" 
                        onclick="adminUsuarios.cargarPagina(@(Model.PageNumber-1))"
                        class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
            }
            @{var startPage = Math.Max(1, Model.PageNumber - 2); var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);}
            @for(var i = startPage; i <= endPage; i++)
            {
                var pageNum = i;
                @if(i == Model.PageNumber)
                {
                    <span class="px-3 py-2 bg-emerald-500 text-white rounded-lg font-medium">@i</span>
                }
                else
                {
                    <button type="button"
                            onclick="adminUsuarios.cargarPagina(@pageNum)"
                            class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                        @i
                    </button>
                }
            }
            @if(Model.HasNextPage)
            {
                <button type="button"
                        onclick="adminUsuarios.cargarPagina(@(Model.PageNumber+1))"
                        class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            }
        </div>
    }

    <!-- Info de paginación -->
    <div class="text-center text-sm text-slate-500 mt-4">
        Mostrando @Model.StartItem-@Model.EndItem de @Model.TotalItems usuarios
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-100">
        <div class="w-20 h-20 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-users text-blue-500 text-3xl"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">No hay usuarios</h3>
        <p class="text-slate-500">@(string.IsNullOrEmpty(rolFiltro) ? "Crea el primer usuario" : $"No hay usuarios con rol {rolFiltro}")</p>
    </div>
}
