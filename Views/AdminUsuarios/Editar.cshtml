@model AldaJoyeros.DTOs.UsuarioUpdateDto
@{
    ViewData["Title"] = "Editar Usuario";
    var usuarioId = ViewBag.UsuarioId as long?;
    var cantidadPedidos = ViewBag.CantidadPedidos as int? ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" class="hover:text-white transition-colors">Usuarios</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Editar #@usuarioId</span>
            </nav>
            
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl flex items-center justify-center shadow-xl shadow-blue-500/25">
                    <i class="fas fa-user-edit text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white">Editar Usuario</h1>
                    <p class="text-slate-400 text-sm mt-1">Modificando usuario #@usuarioId</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-6 border-b border-slate-100">
                        <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i class="fas fa-user text-blue-500"></i>
                            Información del Usuario
                        </h2>
                    </div>
                    
                    <form asp-action="Editar" method="post" class="p-6 space-y-5">
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg text-red-700 text-sm"></div>

                        <div>
                            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-2">Correo Electrónico *</label>
                            <input asp-for="Email" type="email" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" placeholder="usuario@ejemplo.com"/>
                            <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-2">Nueva Contraseña (opcional)</label>
                            <input asp-for="Password" type="password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" placeholder="Dejar en blanco para mantener"/>
                            <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
                            <p class="text-xs text-slate-400 mt-1"><i class="fas fa-info-circle mr-1"></i>Déjalo en blanco si no quieres cambiarla</p>
                        </div>

                        <div>
                            <label asp-for="Rol" class="block text-sm font-medium text-slate-700 mb-3">Rol del Usuario *</label>
                            <div class="space-y-3">
                                <label class="flex items-center p-4 bg-gradient-to-r from-red-50 to-rose-50 border-2 border-red-200 rounded-xl hover:border-red-400 cursor-pointer transition-all">
                                    <input type="radio" asp-for="Rol" value="ADMIN" class="w-4 h-4 text-red-600 focus:ring-red-500"/>
                                    <div class="ml-3 flex items-center gap-3">
                                        <div class="w-10 h-10 bg-red-500 rounded-lg flex items-center justify-center">
                                            <i class="fas fa-user-shield text-white"></i>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-slate-800">Administrador</div>
                                            <div class="text-xs text-slate-500">Acceso completo al sistema</div>
                                        </div>
                                    </div>
                                </label>

                                <label class="flex items-center p-4 bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-xl hover:border-blue-400 cursor-pointer transition-all">
                                    <input type="radio" asp-for="Rol" value="CLIENTE" class="w-4 h-4 text-blue-600 focus:ring-blue-500"/>
                                    <div class="ml-3 flex items-center gap-3">
                                        <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                                            <i class="fas fa-user text-white"></i>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-slate-800">Cliente</div>
                                            <div class="text-xs text-slate-500">Usuario que puede realizar compras</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <span asp-validation-for="Rol" class="text-red-500 text-sm mt-2 block"></span>
                        </div>

                        <!-- Info -->
                        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
                                <div class="text-sm text-blue-700">
                                    <p class="font-medium mb-1">Información</p>
                                    <ul class="space-y-1 text-blue-600">
                                        <li>• Los cambios se aplican inmediatamente</li>
                                        <li>• Cambiar el rol afecta los permisos del usuario</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4 border-t border-slate-100">
                            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 transition-all font-medium">
                                <i class="fas fa-times"></i>Cancelar
                            </a>
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl font-semibold shadow-lg shadow-emerald-500/25 transition-all">
                                <i class="fas fa-save"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-chart-bar text-emerald-500"></i>Información
                    </h3>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center bg-slate-50 rounded-lg p-3">
                            <span class="text-sm text-slate-600">ID</span>
                            <span class="font-semibold text-slate-800">#@usuarioId</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-50 rounded-lg p-3">
                            <span class="text-sm text-slate-600">Pedidos</span>
                            <span class="font-semibold text-emerald-600">@cantidadPedidos</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-bolt text-amber-500"></i>Acciones Rápidas
                    </h3>
                    <div class="space-y-2">
                        <a asp-controller="AdminPedidos" asp-action="Index" class="flex items-center gap-2 px-4 py-3 bg-slate-50 hover:bg-blue-50 rounded-xl text-slate-600 hover:text-blue-600 transition-all text-sm font-medium">
                            <i class="fas fa-box"></i>Ver Pedidos
                            <i class="fas fa-arrow-right ml-auto text-xs"></i>
                        </a>
                    </div>
                </div>

                <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
                    <h3 class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle text-red-500"></i>Zona de Peligro
                    </h3>
                    <p class="text-sm text-slate-600 mb-4">Eliminar es permanente y no se puede deshacer.</p>
                    <form asp-action="Eliminar" asp-route-id="@usuarioId" method="post" onsubmit="return confirm('¿Eliminar este usuario? Esta acción NO se puede deshacer.')">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium transition-all">
                            <i class="fas fa-trash"></i>Eliminar Usuario
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
