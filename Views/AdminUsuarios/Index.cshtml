@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
@{ViewData["Title"]="Gestión de Usuarios";var rolFiltro=ViewBag.RolFiltro as string??"";}

<div class="container mx-auto px-6 py-8">
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
<div><h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3"><div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-2xl flex items-center justify-center shadow-lg"><i class="fas fa-users text-white text-2xl"></i></div>Gestión de Usuarios</h1><p class="text-gray-600 text-lg">Administra las cuentas de usuarios del sistema</p></div>
<a asp-action="Crear" class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105"><i class="fas fa-user-plus mr-2"></i>Nuevo Usuario</a>
</div>

<div class="bg-white rounded-3xl shadow-xl p-8 mb-8 border border-gray-100">
<div class="flex flex-wrap gap-2 mb-6">
<a asp-action="Index" class="px-4 py-2.5 rounded-xl font-bold transition-all @(string.IsNullOrEmpty(rolFiltro)?"bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-md":"bg-gray-100 text-gray-700 hover:bg-gray-200")"><i class="fas fa-th-large mr-2"></i>Todos</a>
<a asp-action="Index" asp-route-rol="ADMIN" class="px-4 py-2.5 rounded-xl font-bold transition-all @(rolFiltro=="ADMIN"?"bg-red-500 text-white shadow-md":"bg-gray-100 text-gray-700 hover:bg-gray-200")"><i class="fas fa-user-shield mr-2"></i>Administradores</a>
<a asp-action="Index" asp-route-rol="USER" class="px-4 py-2.5 rounded-xl font-bold transition-all @(rolFiltro=="USER"?"bg-blue-500 text-white shadow-md":"bg-gray-100 text-gray-700 hover:bg-gray-200")"><i class="fas fa-user mr-2"></i>Clientes</a>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 border-t border-gray-200">
<div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-4 text-center border border-emerald-200"><div class="text-3xl font-bold text-emerald-600">@Model.TotalItems</div><div class="text-sm text-gray-600 font-medium">Total Usuarios</div></div>
<div class="bg-gradient-to-br from-red-50 to-pink-50 rounded-xl p-4 text-center border border-red-200"><div class="text-3xl font-bold text-red-600">@ViewBag.TotalAdministradores</div><div class="text-sm text-gray-600 font-medium">Administradores</div></div>
<div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4 text-center border border-blue-200"><div class="text-3xl font-bold text-blue-600">@ViewBag.TotalClientes</div><div class="text-sm text-gray-600 font-medium">Clientes</div></div>
<div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4 text-center border border-purple-200"><div class="text-3xl font-bold text-purple-600">@Model.PageNumber/@Model.TotalPages</div><div class="text-sm text-gray-600 font-medium">Página</div></div>
</div>
</div>

@if(Model.Items!=null&&Model.Items.Any()){
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
@foreach(var u in Model.Items){
<div class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
<div class="@(u.Rol=="ADMIN"?"bg-gradient-to-br from-red-500 to-pink-500":"bg-gradient-to-br from-blue-500 to-indigo-500") p-6 text-white relative overflow-hidden">
<div class="absolute top-0 right-0 w-24 h-24 bg-white opacity-10 rounded-full -mr-12 -mt-12"></div>
<div class="relative flex items-center justify-between mb-4">
<div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm shadow-lg"><i class="@(u.Rol=="ADMIN"?"fas fa-user-shield":"fas fa-user") text-3xl"></i></div>
<div class="text-right"><div class="text-xs opacity-80 font-semibold">ID</div><div class="text-2xl font-bold">#@u.Id</div></div>
</div>
<div class="relative"><div class="text-xs font-bold mb-1 opacity-80">EMAIL</div><h3 class="font-serif text-lg font-bold truncate">@u.Email</h3></div>
</div>
<div class="p-6">
<div class="flex items-center justify-between mb-6 bg-gradient-to-r from-gray-50 to-emerald-50 rounded-xl p-4 border border-gray-200">
<div><div class="text-xs text-gray-500 mb-1 font-medium">Rol</div>
@if(u.Rol=="ADMIN"){<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-700"><i class="fas fa-user-shield mr-1"></i>Administrador</span>}else{<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700"><i class="fas fa-user mr-1"></i>Cliente</span>}
</div>
<div class="text-right"><div class="text-xs text-gray-500 mb-1 font-medium">Pedidos</div><div class="text-xl font-bold text-emerald-600">@u.CantidadPedidos</div></div>
</div>
<div class="flex gap-2">
<a asp-action="Editar" asp-route-id="@u.Id" class="flex-1 flex items-center justify-center px-4 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl hover:from-emerald-600 hover:to-emerald-700 transition-all font-bold shadow-sm"><i class="fas fa-edit mr-2"></i>Editar</a>
<form asp-action="Eliminar" asp-route-id="@u.Id" method="post" class="flex-1" onsubmit="return confirm('¿Eliminar a @u.Email?')">
<button type="submit" class="w-full flex items-center justify-center px-4 py-3 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-xl hover:from-red-600 hover:to-red-700 transition-all font-bold shadow-sm"><i class="fas fa-trash mr-2"></i>Eliminar</button>
</form>
</div>
</div>
</div>
}}
</div>

@if(Model.TotalPages>1){<div class="flex justify-center items-center space-x-2 flex-wrap gap-2">
@if(Model.HasPreviousPage){<a asp-action="Index" asp-route-page="@(Model.PageNumber-1)" asp-route-rol="@rolFiltro" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold"><i class="fas fa-chevron-left"></i></a>}else{<span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-xl cursor-not-allowed"><i class="fas fa-chevron-left"></i></span>}
@{var startPage=Math.Max(1,Model.PageNumber-2);var endPage=Math.Min(Model.TotalPages,Model.PageNumber+2);}
@if(startPage>1){<a asp-action="Index" asp-route-page="1" asp-route-rol="@rolFiltro" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">1</a>
@if(startPage>2){<span class="px-2 text-gray-500">...</span>}}
@for(var i=startPage;i<=endPage;i++){
@if(i==Model.PageNumber){<span class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl font-bold shadow-md">@i</span>}else{<a asp-action="Index" asp-route-page="@i" asp-route-rol="@rolFiltro" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">@i</a>}}
@if(endPage<Model.TotalPages){@if(endPage<Model.TotalPages-1){<span class="px-2 text-gray-500">...</span>}
<a asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-rol="@rolFiltro" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">@Model.TotalPages</a>}
@if(Model.HasNextPage){<a asp-action="Index" asp-route-page="@(Model.PageNumber+1)" asp-route-rol="@rolFiltro" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold"><i class="fas fa-chevron-right"></i></a>}else{<span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-xl cursor-not-allowed"><i class="fas fa-chevron-right"></i></span>}
</div>}}else{
<div class="bg-white rounded-3xl p-12 text-center shadow-xl border border-gray-100"><div class="w-24 h-24 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-full flex items-center justify-center mx-auto mb-6"><i class="fas fa-users text-indigo-600 text-5xl"></i></div>
<h3 class="font-serif text-3xl font-bold text-gray-900 mb-3">No hay usuarios</h3>
<p class="text-gray-600 text-lg">@(string.IsNullOrEmpty(rolFiltro)?"Crea el primer usuario":$"No hay usuarios con rol {rolFiltro}")</p>
</div>}

<div class="mt-8">
<a asp-controller="Admin" asp-action="Index" class="inline-flex items-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all font-semibold group"><i class="fas fa-arrow-left mr-2 group-hover:-translate-x-2 transition-transform"></i>Volver al Panel</a>
</div>
</div>
