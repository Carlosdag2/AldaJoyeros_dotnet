@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var rolFiltro = ViewBag.RolFiltro as string ?? "";
    var totalAdministradores = ViewBag.TotalAdministradores ?? 0;
    var totalClientes = ViewBag.TotalClientes ?? 0;
}

<partial name="_AdminConfirmModal" />

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Usuarios</span>
            </nav>
            
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl flex items-center justify-center shadow-xl shadow-blue-500/25">
                        <i class="fas fa-users text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-white">Gestión de Usuarios</h1>
                        <p class="text-slate-400 text-sm mt-1">Administra las cuentas de usuarios del sistema</p>
                    </div>
                </div>
                <a asp-action="Crear" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-emerald-500/25">
                    <i class="fas fa-user-plus"></i>Nuevo Usuario
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 -mt-6 relative z-10 pb-12">
        <!-- Filters & Stats -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
            <!-- Filter Tabs -->
            <div class="flex flex-wrap gap-2 mb-5">
                <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(string.IsNullOrEmpty(rolFiltro) ? "bg-emerald-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="fas fa-th-large"></i>Todos
                </a>
                <a asp-action="Index" asp-route-rol="ADMIN" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(rolFiltro == "ADMIN" ? "bg-red-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="fas fa-user-shield"></i>Administradores
                </a>
                <a asp-action="Index" asp-route-rol="USER" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(rolFiltro == "USER" ? "bg-blue-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="fas fa-user"></i>Clientes
                </a>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-5 border-t border-slate-100">
                <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl p-3 text-center border border-slate-200">
                    <div class="text-2xl font-bold text-slate-700">@Model.TotalItems</div>
                    <div class="text-xs text-slate-500">Total</div>
                </div>
                <div class="bg-gradient-to-br from-red-50 to-rose-50 rounded-xl p-3 text-center border border-red-200">
                    <div class="text-2xl font-bold text-red-600">@totalAdministradores</div>
                    <div class="text-xs text-slate-500">Administradores</div>
                </div>
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-3 text-center border border-blue-200">
                    <div class="text-2xl font-bold text-blue-600">@totalClientes</div>
                    <div class="text-xs text-slate-500">Clientes</div>
                </div>
                <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-xl p-3 text-center border border-violet-200">
                    <div class="text-2xl font-bold text-violet-600">@Model.PageNumber/@Model.TotalPages</div>
                    <div class="text-xs text-slate-500">Página</div>
                </div>
            </div>
        </div>

        @if(Model.Items != null && Model.Items.Any())
        {
            <!-- Users Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
                @foreach(var u in Model.Items)
                {
                    var userEmail = u.Email.Replace("'", "\\'");
                    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 hover:border-blue-200">
                        <!-- Header -->
                        <div class="@(u.Rol == "ADMIN" ? "bg-gradient-to-br from-red-500 to-rose-600" : "bg-gradient-to-br from-blue-500 to-indigo-600") p-5 relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-20 h-20 bg-white/10 rounded-full -mr-10 -mt-10"></div>
                            <div class="relative flex items-center gap-3">
                                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center">
                                    <i class="@(u.Rol == "ADMIN" ? "fas fa-user-shield" : "fas fa-user") text-white text-xl"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-white truncate">@u.Email</div>
                                    <div class="text-white/70 text-sm">ID #@u.Id</div>
                                </div>
                            </div>
                        </div>

                        <!-- Body -->
                        <div class="p-5">
                            <div class="flex items-center justify-between mb-4 bg-slate-50 rounded-xl p-4 border border-slate-100">
                                <div>
                                    <div class="text-xs text-slate-400 mb-1">Rol</div>
                                    @if(u.Rol == "ADMIN")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                            <i class="fas fa-user-shield mr-1"></i>Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                            <i class="fas fa-user mr-1"></i>Cliente
                                        </span>
                                    }
                                </div>
                                <div class="text-right">
                                    <div class="text-xs text-slate-400 mb-1">Pedidos</div>
                                    <div class="text-xl font-bold text-emerald-600">@u.CantidadPedidos</div>
                                </div>
                            </div>

                            <div class="flex gap-2">
                                <a asp-action="Editar" asp-route-id="@u.Id" class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-emerald-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                                    <i class="fas fa-edit"></i>Editar
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@u.Id" method="post" class="flex-1" id="deleteUserForm-@u.Id">
                                    <button type="button" onclick="confirmDelete('deleteUserForm-@u.Id', '@userEmail')" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-red-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                                        <i class="fas fa-trash"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if(Model.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-2 flex-wrap">
                    @if(Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber-1)" asp-route-rol="@rolFiltro" class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </a>
                    }
                    @{var startPage = Math.Max(1, Model.PageNumber - 2); var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);}
                    @for(var i = startPage; i <= endPage; i++)
                    {
                        @if(i == Model.PageNumber)
                        {
                            <span class="px-3 py-2 bg-emerald-500 text-white rounded-lg font-medium">@i</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@i" asp-route-rol="@rolFiltro" class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">@i</a>
                        }
                    }
                    @if(Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber+1)" asp-route-rol="@rolFiltro" class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-100">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-users text-blue-500 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">No hay usuarios</h3>
                <p class="text-slate-500">@(string.IsNullOrEmpty(rolFiltro) ? "Crea el primer usuario" : $"No hay usuarios con rol {rolFiltro}")</p>
            </div>
        }

        <!-- Navigation -->
        <div class="mt-8">
            <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>Volver al Panel
            </a>
        </div>
    </div>
</div>
