@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
@{ ViewData["Title"] = "Gestión de Usuarios"; }
<partial name="_AdminConfirmModal" />
<main class="admin-workspace admin-users min-h-[70vh] bg-slate-50 px-4 py-6 pb-10 text-slate-800 md:px-6 md:py-8 md:pb-14 [&_[hidden]]:!hidden" data-admin-list="usuarios"><div class="admin-shell mx-auto max-w-7xl">
<div class="admin-breadcrumb mb-5 flex items-center gap-2 text-xs text-slate-500 [&_a:hover]:text-green-800"><a asp-controller="Admin" asp-action="Index">Panel de administración</a><span aria-hidden="true">/</span><span>Usuarios</span></div><header class="admin-heading mb-6 flex flex-col items-start justify-between gap-4 md:flex-row md:items-center [&_h1]:mb-1.5 [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:tracking-tight md:[&_h1]:text-3xl [&_p]:text-sm [&_p]:text-slate-500"><div><h1>Usuarios</h1><p>Consulta las cuentas, sus pedidos y los permisos de acceso.</p></div><a asp-action="Crear" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-green-800 bg-green-800 text-white hover:border-green-900 hover:bg-green-900"><i class="fas fa-plus" aria-hidden="true"></i>Nuevo usuario</a></header>
<div class="admin-stats mb-6 grid grid-cols-2 gap-3 md:grid-cols-[repeat(auto-fit,minmax(145px,1fr))]"><div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Resultados</span><strong id="statTotal">@Model.TotalItems</strong></div>
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Clientes</span><strong id="statClientes">@ViewBag.TotalClientes</strong></div>
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Administradores</span><strong id="statAdmins">@ViewBag.TotalAdministradores</strong></div></div>
<div class="admin-toolbar mb-5 rounded-xl border border-slate-200 bg-white p-4 md:p-5">
<form asp-action="Index" method="get" class="admin-search flex flex-wrap items-end gap-2.5 [&>button]:flex-1 md:[&>button]:flex-none" data-admin-search>
<div class="admin-field min-w-full flex-1 md:min-w-[180px] [&_label]:mb-1.5 [&_label]:block [&_label]:text-xs [&_label]:font-semibold [&_label]:text-slate-600"><label for="buscarUsuarios">Buscar usuarios</label><input id="buscarUsuarios" type="search" name="busqueda" value="@ViewBag.Busqueda" placeholder="Correo electrónico o ID de usuario" maxlength="200" / class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400"></div>
<input type="hidden" name="rol" value="@(ViewBag.RolFiltro)" />
<button type="submit" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-green-800 bg-green-800 text-white hover:border-green-900 hover:bg-green-900"><i class="fas fa-search" aria-hidden="true"></i>Buscar</button>
<button type="button" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100" data-clear-search>Limpiar filtros</button>
</form>
<div class="admin-tabs mt-4 flex flex-wrap gap-1.5 border-t border-slate-100 pt-4 md:gap-2" aria-label="Filtrar por rol"><button type="button" class="admin-tab rounded-lg border border-transparent bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-200 aria-pressed:border-green-200 aria-pressed:bg-green-50 aria-pressed:text-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-filter="" aria-pressed="false">Todos</button>
<button type="button" class="admin-tab rounded-lg border border-transparent bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-200 aria-pressed:border-green-200 aria-pressed:bg-green-50 aria-pressed:text-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-filter="USER" aria-pressed="false">Clientes</button>
<button type="button" class="admin-tab rounded-lg border border-transparent bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-200 aria-pressed:border-green-200 aria-pressed:bg-green-50 aria-pressed:text-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-filter="ADMIN" aria-pressed="false">Administradores</button></div>
</div>
<p class="admin-status my-2 min-h-5 text-xs text-slate-500" data-admin-status role="status" aria-live="polite"></p>
<div id="usuariosContainer" data-admin-results aria-busy="false"><partial name="_UsuariosList" model="Model" /></div>
<p class="admin-note my-5 text-sm leading-relaxed text-slate-500">Los administradores pueden acceder a la gestión de la tienda. Revisa el rol antes de modificar una cuenta.</p>
<a asp-controller="Admin" asp-action="Index" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100"><i class="fas fa-arrow-left" aria-hidden="true"></i>Volver al panel</a>
</div></main>
@section Scripts { <script src="~/js/admin-listas.js" asp-append-version="true"></script> }
