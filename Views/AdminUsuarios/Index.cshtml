@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var rolFiltro = ViewBag.RolFiltro as string ?? "";
    var totalAdministradores = ViewBag.TotalAdministradores ?? 0;
    var totalClientes = ViewBag.TotalClientes ?? 0;
}

<partial name="_AdminConfirmModal" />

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Usuarios</span>
            </nav>
            
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl flex items-center justify-center shadow-xl shadow-blue-500/25">
                        <i class="fas fa-users text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-white">Gestión de Usuarios</h1>
                        <p class="text-slate-400 text-sm mt-1">Administra las cuentas de usuarios del sistema</p>
                    </div>
                </div>
                <a asp-action="Crear" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-emerald-500/25">
                    <i class="fas fa-user-plus"></i>Nuevo Usuario
                </a>
            </div>
        </div>
    </div>


    <div class="container mx-auto px-6 -mt-6 relative z-10 pb-12">
        <!-- Filters & Stats -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
            <!-- Filter Tabs AJAX -->
            <div class="flex flex-wrap gap-2 mb-5" id="filtrosUsuarios">
                <button type="button" onclick="adminUsuarios.filtrar('')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(string.IsNullOrEmpty(rolFiltro) ? "bg-emerald-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-rol="">
                    <i class="fas fa-th-large"></i>Todos
                </button>
                <button type="button" onclick="adminUsuarios.filtrar('ADMIN')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(rolFiltro == "ADMIN" ? "bg-red-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-rol="ADMIN">
                    <i class="fas fa-user-shield"></i>Administradores
                </button>
                <button type="button" onclick="adminUsuarios.filtrar('USER')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(rolFiltro == "USER" ? "bg-blue-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-rol="USER">
                    <i class="fas fa-user"></i>Clientes
                </button>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-5 border-t border-slate-100" id="statsUsuarios">
                <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl p-3 text-center border border-slate-200">
                    <div id="statTotal" class="text-2xl font-bold text-slate-700">@Model.TotalItems</div>
                    <div class="text-xs text-slate-500">Total</div>
                </div>
                <div class="bg-gradient-to-br from-red-50 to-rose-50 rounded-xl p-3 text-center border border-red-200">
                    <div id="statAdmins" class="text-2xl font-bold text-red-600">@totalAdministradores</div>
                    <div class="text-xs text-slate-500">Administradores</div>
                </div>
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-3 text-center border border-blue-200">
                    <div id="statClientes" class="text-2xl font-bold text-blue-600">@totalClientes</div>
                    <div class="text-xs text-slate-500">Clientes</div>
                </div>
                <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-xl p-3 text-center border border-violet-200">
                    <div id="statPagina" class="text-2xl font-bold text-violet-600">@Model.PageNumber/@Model.TotalPages</div>
                    <div class="text-xs text-slate-500">Página</div>
                </div>
            </div>
        </div>

        <!-- Contenedor dinámico para la lista de usuarios -->
        <div id="usuariosContainer">
            <partial name="_UsuariosList" model="Model" />
        </div>

        <!-- Navigation -->
        <div class="mt-8">
            <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>Volver al Panel
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminUsuarios = {
            rolActual: '@rolFiltro',
            paginaActual: @Model.PageNumber,
            cargando: false,

            // Filtrar por rol
            async filtrar(rol) {
                if (this.cargando) return;
                this.rolActual = rol;
                this.paginaActual = 1;
                await this.cargarDatos();
                this.actualizarBotonesFiltro(rol);
                this.actualizarURL();
            },

            // Cargar página específica
            async cargarPagina(pagina) {
                if (this.cargando) return;
                this.paginaActual = pagina;
                await this.cargarDatos();
                this.actualizarURL();
                document.getElementById('usuariosContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });
            },

            // Cargar datos via AJAX
            async cargarDatos() {
                this.cargando = true;
                const container = document.getElementById('usuariosContainer');
                
                container.style.opacity = '0.5';
                container.style.pointerEvents = 'none';

                try {
                    const params = new URLSearchParams();
                    if (this.rolActual) params.append('rol', this.rolActual);
                    params.append('page', this.paginaActual);

                    const response = await fetch(`/AdminUsuarios/Index?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.ok) {
                        const html = await response.text();
                        container.innerHTML = html;
                        container.style.opacity = '1';
                        container.style.pointerEvents = '';
                        
                        // Actualizar estadísticas desde los headers
                        this.actualizarEstadisticas(response);
                    } else {
                        throw new Error('Error al cargar');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error al cargar los usuarios');
                    container.style.opacity = '1';
                    container.style.pointerEvents = '';
                } finally {
                    this.cargando = false;
                }
            },

            // Actualizar estadísticas desde response headers
            actualizarEstadisticas(response) {
                const admins = response.headers.get('X-Stats-Admins');
                const clientes = response.headers.get('X-Stats-Clientes');
                const total = response.headers.get('X-Stats-Total');
                const pagina = response.headers.get('X-Stats-Pagina');

                if (admins) document.getElementById('statAdmins').textContent = admins;
                if (clientes) document.getElementById('statClientes').textContent = clientes;
                if (total) document.getElementById('statTotal').textContent = total;
                if (pagina) document.getElementById('statPagina').textContent = pagina;
            },

            // Actualizar botones de filtro
            actualizarBotonesFiltro(rolActivo) {
                const botones = document.querySelectorAll('#filtrosUsuarios .filtro-btn');
                const colores = {
                    '': { activo: 'bg-emerald-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'ADMIN': { activo: 'bg-red-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'USER': { activo: 'bg-blue-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' }
                };

                botones.forEach(btn => {
                    const rol = btn.dataset.rol;
                    const esActivo = rol === rolActivo;
                    
                    // Remover clases de color/estado previas
                    btn.classList.remove(
                        'bg-emerald-500', 'bg-red-500', 'bg-blue-500',
                        'bg-slate-100', 'text-white', 'text-slate-600', 'shadow-md', 'hover:bg-slate-200'
                    );
                    
                    // Añadir clases correspondientes
                    const clases = esActivo ? colores[rol].activo : colores[rol].inactivo;
                    btn.classList.add(...clases.split(' '));
                });
            },

            // Actualizar URL
            actualizarURL() {
                const params = new URLSearchParams();
                if (this.rolActual) params.append('rol', this.rolActual);
                if (this.paginaActual > 1) params.append('page', this.paginaActual);
                
                const newUrl = params.toString() 
                    ? `${window.location.pathname}?${params.toString()}`
                    : window.location.pathname;
                    
                history.pushState({ rol: this.rolActual, page: this.paginaActual }, '', newUrl);
            },

            // Eliminar usuario
            async eliminar(id, email) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar usuario?',
                    message: `El usuario "${email}" será eliminado permanentemente.`,
                    type: 'danger',
                    confirmText: 'Eliminar'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminUsuarios/EliminarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.animarUsuarioEliminado(id);
                        AldaToast.success(data.message);
                        setTimeout(() => this.cargarDatos(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Cambiar rol
            async cambiarRol(id, email, nuevoRol) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Cambiar rol?',
                    message: `El usuario "${email}" pasará a ser ${nuevoRol === 'ADMIN' ? 'Administrador' : 'Cliente'}.`,
                    type: 'warning',
                    confirmText: 'Cambiar rol'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminUsuarios/CambiarRolAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}&nuevoRol=${nuevoRol}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        AldaToast.success(data.message);
                        setTimeout(() => this.cargarDatos(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Animar usuario al eliminarlo
            animarUsuarioEliminado(id) {
                const card = document.querySelector(`[data-usuario-id="${id}"]`);
                if (card) {
                    card.style.transition = 'all 0.4s ease';
                    card.style.transform = 'scale(0.9)';
                    card.style.opacity = '0';
                    setTimeout(() => card.remove(), 400);
                }
            }
        };

        // Manejar botón atrás del navegador
        window.addEventListener('popstate', (event) => {
            if (event.state) {
                adminUsuarios.rolActual = event.state.rol || '';
                adminUsuarios.paginaActual = event.state.page || 1;
                adminUsuarios.cargarDatos();
                adminUsuarios.actualizarBotonesFiltro(adminUsuarios.rolActual);
            }
        });

        window.adminUsuarios = adminUsuarios;
    </script>
}
