@model AldaJoyeros.Models.PromotionsAdminViewModel
@{var c=Model.Config;}
<form data-promotion-form="presentation" action="@Url.Action("Presentation")" method="post" class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
@Html.AntiForgeryToken()<input type="hidden" name="revision" value="@c.Revision"/><input type="hidden" name="homeProducts" value="@string.Join(',',c.HomeProducts)"/><input type="hidden" name="popupPreviewProducts" value="@string.Join(',',c.PopupPreviewProducts)"/>
<div class="border-b border-stone-200 bg-stone-50 p-5 sm:p-7"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Primero, elige lo que quieres enseñar</p><h2 class="mt-2 font-serif text-2xl sm:text-3xl">Las ofertas de tu escaparate</h2><p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">Elige las piezas, arrástralas hasta su posición y guarda. La primera tarjeta será la primera oferta del inicio.</p></div><a href="#promotion-rules" class="text-sm font-semibold text-emerald-800 underline">Gestionar descuentos</a></div></div>
<div class="grid lg:grid-cols-3"><section class="min-w-0 p-5 sm:p-7 lg:col-span-2" aria-labelledby="home-selection-title"><div class="flex flex-wrap items-center justify-between gap-3"><div><h3 id="home-selection-title" class="font-semibold">Ofertas de la página de inicio</h3><p data-home-count class="mt-1 text-xs text-stone-600">@c.HomeProducts.Count de 8 seleccionados</p></div><button type="button" data-offer-picker="home" class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-emerald-800 px-4 py-3 text-sm font-semibold text-white"><i class="fas fa-plus" aria-hidden="true"></i>Elegir productos</button></div><label class="my-5 flex items-center gap-3 rounded-xl border border-stone-200 p-3 text-sm"><input type="checkbox" name="homeEnabled" value="true" checked="@c.HomeEnabled" class="h-5 w-5 accent-emerald-800"/><span>Mostrar estas ofertas en el inicio</span></label><div data-home-chips class="offer-selection-grid" role="list" aria-label="Orden de ofertas del inicio"></div><p class="mt-4 text-xs leading-relaxed text-stone-500"><i class="fas fa-grip-vertical mr-1" aria-hidden="true"></i>Arrastra desde el asa. También puedes usar Subir y Bajar, incluso en móvil.</p></section>
<section class="min-w-0 border-t border-stone-200 bg-stone-50 p-5 sm:p-7 lg:border-l lg:border-t-0" aria-labelledby="popup-settings-title"><p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Una invitación a descubrir</p><h3 id="popup-settings-title" class="mt-2 font-serif text-2xl">Aviso de descuentos</h3><label class="mt-5 flex items-center gap-3 text-sm font-semibold"><input type="checkbox" name="popupEnabled" value="true" checked="@c.PopupEnabled" class="h-5 w-5 accent-emerald-800"/>Activar aviso emergente</label><p class="mt-2 text-xs leading-relaxed text-stone-600">Una vez cada 24 horas. Se puede cerrar y no interrumpe el pago.</p><label for="popupProduct" class="mb-2 mt-5 block text-sm font-semibold">¿Qué quieres anunciar?</label><select name="popupProductId" id="popupProduct" class="w-full rounded-lg border border-stone-300 bg-white p-3 text-sm"><option value="">Todas las ofertas: anuncio general</option>@foreach(var product in Model.Selected.Concat(Model.Products).Where(p=>p.TieneDescuento).DistinctBy(p=>p.Id)){<option value="@product.Id" selected="@(c.PopupProductId==product.Id)">@product.Nombre</option>}</select><button type="button" data-offer-picker="popup" class="mt-3 min-h-11 text-sm font-semibold text-emerald-800 underline">Elegir un producto con imagen</button><div class="mt-4 flex flex-wrap gap-2"><button type="button" data-popup-general class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-xs">Usar anuncio general</button><button type="button" data-popup-preview class="rounded-lg border border-emerald-800 px-3 py-2 text-xs font-semibold text-emerald-800">Ver cómo quedará</button></div><div class="mt-5 rounded-xl border border-stone-200 bg-white p-3"><p class="text-sm font-semibold">Imágenes del anuncio general</p><p class="mt-2 text-xs leading-relaxed text-stone-600">Automáticas por defecto. Si prefieres elegirlas, selecciona hasta 3 productos con descuento. Solo se usan en el anuncio general.</p><div data-general-images class="mt-3 space-y-2"></div><div class="mt-3 flex flex-wrap gap-3"><button type="button" data-offer-picker="general" class="min-h-11 text-xs font-semibold text-emerald-800 underline">Elegir imágenes</button><button type="button" data-general-auto class="min-h-11 text-xs text-stone-600 underline">Volver a automáticas</button></div></div><label for="popupSeconds" class="mb-2 mt-5 block text-sm font-semibold">Aparecer después de</label><div class="flex items-center gap-2"><input id="popupSeconds" name="popupSeconds" type="number" min="5" max="60" value="@c.PopupSeconds" class="w-24 rounded-lg border border-stone-300 p-3"/><span class="text-sm text-stone-600">segundos</span></div></section></div>
<div class="offer-save-bar flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 bg-white px-5 py-4 sm:px-7"><p data-offer-draft role="status" class="text-sm text-stone-600">La selección y el orden se aplican al guardar.</p><button type="submit" class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Guardar presentación</button></div>
</form>
