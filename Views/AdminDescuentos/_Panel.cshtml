@model AldaJoyeros.Models.PromotionsAdminViewModel
@using System.Text.Json
@{var c=Model.Config;var names=Model.Products.Concat(Model.Selected).DistinctBy(p=>p.Id).ToDictionary(p=>p.Id,p=>p.Nombre);}
<div data-promotion-state data-home="@JsonSerializer.Serialize(c.HomeProducts)" data-selected="@JsonSerializer.Serialize(Model.Selected.Select(p=>new{id=p.Id,name=p.Nombre,image=p.ImagenPrincipal}))" class="space-y-7">
<section class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-7"><div class="flex flex-wrap items-center justify-between gap-4"><div><h2 class="text-xl font-semibold">1. Tus descuentos</h2><p class="mt-2 text-sm text-stone-600">Se aplica la oferta más favorable, sin sumar porcentajes. Las categorías principales incluyen sus subcategorías.</p></div><button type="button" data-new-rule class="rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Crear descuento</button></div>
@if(c.Rules.Count==0){<p class="mt-6 rounded-xl bg-stone-50 p-5 text-sm text-stone-600">Todavía no has creado descuentos. Puedes empezar por una categoría o elegir un artículo del listado.</p>}
else{<ul class="mt-5 divide-y divide-stone-200">@foreach(var rule in c.Rules){<li class="flex flex-wrap items-center justify-between gap-4 py-4"><div class="min-w-0"><p class="break-words font-semibold">@rule.Name <span class="ml-2 rounded-full bg-emerald-50 px-2 py-1 text-xs text-emerald-900">@rule.Percent.ToString("0.##") %</span></p><p class="mt-2 text-xs text-stone-600">@(rule.CategoryId.HasValue?rule.CategoryName:(names.GetValueOrDefault(rule.ProductId??0)??"Producto seleccionado")) · @(rule.Enabled?"Activo":"Pausado")</p></div><div class="flex flex-wrap gap-2"><button type="button" data-edit-rule="@JsonSerializer.Serialize(rule)" class="rounded-lg border border-stone-300 px-3 py-2 text-sm">Modificar</button><button type="button" data-rule-action="@Url.Action("Toggle")" data-rule-id="@rule.Id" data-revision="@c.Revision" data-confirm="@(rule.Enabled?"¿Pausar este descuento? Los productos volverán al precio que corresponda.":"¿Volver a activar este descuento con sus precios de referencia guardados?")" class="rounded-lg border border-stone-300 px-3 py-2 text-sm">@(rule.Enabled?"Pausar":"Activar")</button><button type="button" data-rule-action="@Url.Action("Toggle")" data-rule-id="@rule.Id" data-remove="true" data-revision="@c.Revision" data-confirm="¿Eliminar este descuento? No se borrará ningún producto." class="rounded-lg border border-red-200 px-3 py-2 text-sm text-red-700">Eliminar</button></div></li>}</ul>}
</section>
<div class="grid items-start gap-6 lg:grid-cols-2">
<form data-promotion-form="presentation" action="@Url.Action("Presentation")" method="post" class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-7">@Html.AntiForgeryToken()<input type="hidden" name="revision" value="@c.Revision"/><input type="hidden" name="homeProducts" value="@string.Join(',',c.HomeProducts)"/><h2 class="text-xl font-semibold">2. Ofertas en la web</h2><p class="mt-2 text-sm text-stone-600">Añade hasta 8 productos desde el listado de abajo. Si no hay artículos seleccionados, la sección no se muestra.</p><label class="mt-5 flex items-center gap-3 text-sm font-semibold"><input type="checkbox" name="homeEnabled" value="true" checked="@c.HomeEnabled" class="h-5 w-5 accent-emerald-800"/>Mostrar sección de ofertas en el inicio</label><div data-home-chips class="mt-4 flex flex-wrap gap-2">@foreach(var id in c.HomeProducts){<button type="button" data-home-remove="@id" class="rounded-full border border-stone-300 px-3 py-2 text-xs">@(names.GetValueOrDefault(id)??"Producto no disponible") <span aria-hidden="true">×</span><span class="sr-only">Quitar del inicio</span></button>}</div><p data-home-count class="mt-3 text-xs text-stone-600">@c.HomeProducts.Count de 8 seleccionados</p>
<div class="mt-6 border-t border-stone-200 pt-5"><label class="flex items-center gap-3 text-sm font-semibold"><input type="checkbox" name="popupEnabled" value="true" checked="@c.PopupEnabled" class="h-5 w-5 accent-emerald-800"/>Mostrar aviso emergente</label><p class="mt-2 text-xs leading-relaxed text-stone-600">En inicio, catálogo y fichas. Una vez cada 24 horas en este navegador; se puede cerrar con Escape o con el botón. No interrumpe el pago.</p><label for="popupProduct" class="mb-2 mt-4 block text-sm font-semibold">Contenido del aviso</label><select name="popupProductId" id="popupProduct" class="w-full rounded-lg border border-stone-300 bg-white p-3 text-sm"><option value="">Anuncio general: tenemos artículos con descuento</option>@foreach(var product in Model.Selected.Concat(Model.Products).Where(p=>p.TieneDescuento).DistinctBy(p=>p.Id)){<option value="@product.Id" selected="@(c.PopupProductId==product.Id)">@product.Nombre</option>}</select><label for="popupSeconds" class="mb-2 mt-4 block text-sm font-semibold">Segundos antes de aparecer</label><input id="popupSeconds" name="popupSeconds" type="number" min="5" max="60" value="@c.PopupSeconds" class="w-24 rounded-lg border border-stone-300 p-3"/></div><button class="mt-6 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Guardar presentación</button></form>
<form data-promotion-form="preview" action="@Url.Action("Preview")" data-send="@Url.Action("Send")" method="post" class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-7">@Html.AntiForgeryToken()<h2 class="text-xl font-semibold">3. Correos de ofertas</h2><p class="mt-2 text-sm text-stone-600">@Model.Audience usuarios suscritos. Solo recibirán publicidad quienes la hayan aceptado.</p><label for="mailSubject" class="mb-2 mt-5 block text-sm font-semibold">Asunto</label><input id="mailSubject" name="subject" required maxlength="160" value="Descubre las ofertas de Alda Joyeros 1962" class="w-full rounded-lg border border-stone-300 p-3 text-sm"/><input type="hidden" name="productIds" value=""/><p class="mt-4 text-sm text-stone-600">Marca «Incluir en correo» en los productos del listado. Si no eliges ninguno, se preparará una selección de hasta 4 artículos con descuento.</p><div data-mail-selection class="mt-3 text-sm font-semibold text-emerald-800">Selección automática</div><button class="mt-6 rounded-lg border border-emerald-800 px-5 py-3 text-sm font-semibold text-emerald-800">Preparar vista previa</button><p class="mt-3 text-xs text-stone-500">Este botón no envía correos. Podrás revisar el mensaje antes de confirmar.</p></form>
</div>
<section class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-7"><h2 class="text-xl font-semibold">Elige productos</h2><form data-promotion-search action="@Url.Action("Index")" class="mt-5 grid gap-3 sm:grid-cols-3"><div><label for="promotionSearch" class="mb-2 block text-sm">Nombre o referencia</label><input id="promotionSearch" name="search" value="@Model.Search" placeholder="Busca una pieza…" class="w-full rounded-lg border border-stone-300 p-3 text-sm"/></div><div><label for="promotionCategory" class="mb-2 block text-sm">Categoría</label><select id="promotionCategory" name="categoryId" class="w-full rounded-lg border border-stone-300 bg-white p-3 text-sm"><option value="">Todas las categorías</option>@foreach(var cat in Model.Categories){<option value="@cat.Id" selected="@(Model.CategoryId==cat.Id)">@cat.Nombre</option>}</select></div><button class="self-end rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Buscar productos</button></form><p class="my-5 text-sm text-stone-600">@Model.Total productos · Página @Model.Page de @Model.TotalPages</p><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">@foreach(var product in Model.Products){<article class="flex min-w-0 gap-3 rounded-xl border border-stone-200 p-3" data-promotion-product="@product.Id">@if(product.ImagenPrincipal is {} image){<img src="@image" alt="@product.Nombre" loading="lazy" class="h-20 w-20 shrink-0 rounded-lg bg-white object-contain"/>}else{<span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-stone-50 text-stone-400"><i class="fas fa-gem" aria-hidden="true"></i><span class="sr-only">Sin imagen</span></span>}<div class="min-w-0 flex-1"><h3 class="break-words text-sm font-semibold">@product.Nombre</h3><p class="mt-1 text-xs text-stone-600">@product.CategoriaNombre</p><partial name="_ProductPrice" model="product"/><button type="button" data-discount-product="@product.Id" data-product-name="@product.Nombre" class="mt-3 text-xs font-semibold text-emerald-800 underline">Crear descuento</button>@if(product.TieneDescuento){<div class="mt-3 space-y-2"><button type="button" data-home-toggle="@product.Id" data-product-name="@product.Nombre" aria-pressed="@c.HomeProducts.Contains(product.Id).ToString().ToLowerInvariant()" class="block text-xs font-semibold text-emerald-800 underline">@(c.HomeProducts.Contains(product.Id)?"Quitar del inicio":"Mostrar en inicio")</button><label class="flex items-center gap-2 text-xs"><input type="checkbox" data-mail-product="@product.Id" class="h-4 w-4 accent-emerald-800"/>Incluir en correo</label><button type="button" data-popup-product="@product.Id" data-product-name="@product.Nombre" class="text-xs text-emerald-800 underline">Elegir para el aviso</button></div>}</div></article>}</div>@if(Model.Total==0){<p class="py-8 text-sm text-stone-600">No hay productos para esta búsqueda.</p>}<div class="mt-6 flex flex-wrap justify-center gap-2">@if(Model.Page>1){<a data-promotion-page href="@Url.Action("Index",new{search=Model.Search,categoryId=Model.CategoryId,page=Model.Page-1})" class="rounded-lg border px-4 py-3 text-sm">Anterior</a>}@if(Model.Page<Model.TotalPages){<a data-promotion-page href="@Url.Action("Index",new{search=Model.Search,categoryId=Model.CategoryId,page=Model.Page+1})" class="rounded-lg border px-4 py-3 text-sm">Siguiente</a>}</div></section>
<section class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-7"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold">Historial de correos</h2><button type="button" data-promotions-refresh class="text-sm text-emerald-800 underline">Actualizar resultados</button></div><p class="mt-2 text-xs text-stone-600">Los envíos fallidos o inciertos no se reintentan automáticamente. Las bajas y las ofertas que ya no están vigentes se omiten.</p>@if(Model.Campaigns.Count==0){<p class="mt-5 text-sm text-stone-600">Aún no has enviado campañas.</p>}@foreach(var campaign in Model.Campaigns){<div class="mt-4 rounded-xl bg-stone-50 p-4"><p class="break-words text-sm font-semibold">@campaign.Subject</p><p class="mt-2 text-xs text-stone-600">@campaign.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @campaign.Sent enviados · @campaign.Pending pendientes · @campaign.Skipped omitidos · @campaign.Failed incidencias</p></div>}</section>
<dialog data-rule-dialog class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-6 text-stone-900 shadow-xl"><div class="flex justify-between gap-3"><h2 class="font-serif text-2xl">Configurar descuento</h2><button type="button" data-close-dialog aria-label="Cerrar descuento" class="rounded-lg border px-3 py-2">✕</button></div><form data-promotion-form="rule" action="@Url.Action("Rule")" method="post" class="mt-5 space-y-4">@Html.AntiForgeryToken()<input type="hidden" name="revision" value="@c.Revision"/><input type="hidden" name="id"/><div><label for="ruleName" class="mb-2 block text-sm font-semibold">Nota interna (opcional)</label><input id="ruleName" name="name" maxlength="80" class="w-full rounded-lg border border-stone-300 p-3"/></div><div class="grid gap-4 sm:grid-cols-2"><div><label for="rulePercent" class="mb-2 block text-sm font-semibold">Descuento (%)</label><input id="rulePercent" name="percent" type="number" min="0.01" max="99.99" step="0.01" required class="w-full rounded-lg border border-stone-300 p-3"/></div><div><label for="ruleKind" class="mb-2 block text-sm font-semibold">Aplicar a</label><select id="ruleKind" name="targetKind" class="w-full rounded-lg border border-stone-300 bg-white p-3"><option value="category">Una categoría</option><option value="product">Un producto y sus tallas</option></select></div></div><div data-rule-category><label for="ruleCategory" class="mb-2 block text-sm font-semibold">Categoría</label><select id="ruleCategory" name="categoryId" class="w-full rounded-lg border border-stone-300 bg-white p-3"><option value="">Selecciona una categoría</option>@foreach(var cat in Model.Categories){<option value="@cat.Id">@cat.Nombre</option>}</select></div><div data-rule-product hidden><label for="ruleProduct" class="mb-2 block text-sm font-semibold">Producto</label><select id="ruleProduct" name="productId" class="w-full rounded-lg border border-stone-300 bg-white p-3"><option value="">Selecciona desde el listado</option>@foreach(var product in Model.Products){<option value="@product.Id">@product.Nombre</option>}</select></div><p class="rounded-xl bg-stone-50 p-4 text-xs leading-relaxed text-stone-600">El porcentaje se aplica siempre al PVP sin descuento: si pones 50 %, se cobra la mitad del PVP. Si coinciden varias ofertas se aplica la más favorable. El historial de 30 días se muestra como referencia aparte: no cambia el porcentaje ni oculta el producto del filtro de ofertas.</p><label class="flex items-start gap-3 text-xs leading-relaxed"><input name="confirmed" value="true" type="checkbox" required class="mt-1 h-5 w-5 shrink-0 accent-emerald-800"/><span>He revisado y confirmo que los precios de referencia de esta selección corresponden al menor precio aplicado en los 30 días anteriores, incluyendo el período anterior al registro de la web.</span></label><div class="flex flex-wrap gap-3"><button class="rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white">Guardar descuento</button><button type="button" data-close-dialog class="rounded-lg border border-stone-300 px-5 py-3">Cancelar</button></div></form></dialog>
</div>
