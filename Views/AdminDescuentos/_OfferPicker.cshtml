@model AldaJoyeros.Models.PromotionsAdminViewModel
<dialog data-offer-picker-dialog data-url="@Url.Action("Elegir")" class="promotion-dialog offer-picker rounded-2xl border border-stone-200 bg-white text-stone-900 shadow-xl" aria-labelledby="offer-picker-title"><header class="flex items-start justify-between gap-4 border-b border-stone-200 p-5 sm:p-6"><div><p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Elige con un clic</p><h2 id="offer-picker-title" class="mt-2 font-serif text-2xl">Seleccionar ofertas</h2><p data-picker-help class="mt-2 text-sm text-stone-600"></p></div><button type="button" data-picker-close aria-label="Cerrar selección" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-stone-300">✕</button></header><form data-picker-search class="grid gap-3 border-b border-stone-200 bg-stone-50 p-5 sm:grid-cols-2 sm:px-6"><div><label for="offer-picker-search" class="mb-2 block text-xs font-semibold">Nombre o referencia</label><input id="offer-picker-search" name="search" type="search" placeholder="Busca una joya o un reloj…" autocomplete="off" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-sm"/></div><div><label for="offer-picker-category" class="mb-2 block text-xs font-semibold">Categoría</label><select id="offer-picker-category" name="categoryId" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-sm"><option value="">Todas las categorías</option>@foreach(var category in Model.Categories){<option value="@category.Id">@category.Nombre</option>}</select></div><button type="submit" class="sr-only">Buscar ofertas</button></form><div class="offer-picker-scroll p-5 sm:p-6"><div class="mb-4 flex flex-wrap justify-between gap-2"><p data-picker-result role="status" class="text-xs text-stone-600"></p><button type="button" data-picker-clear class="text-xs font-semibold text-emerald-800 underline">Vaciar selección</button></div><p data-picker-error role="alert" class="mb-4 text-sm text-red-700" hidden></p><div data-picker-results class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div><div data-picker-empty class="rounded-xl bg-stone-50 p-6 text-center" hidden><i class="far fa-gem text-3xl text-stone-400" aria-hidden="true"></i><p class="mt-3 text-sm font-semibold">No hay ofertas para esta búsqueda</p><p class="mt-2 text-xs leading-relaxed text-stone-600">Prueba otra categoría o crea un descuento para que aparezca aquí.</p><button type="button" data-picker-create class="mt-4 min-h-11 rounded-lg bg-emerald-800 px-4 py-3 text-sm font-semibold text-white">Crear un descuento</button></div><nav data-picker-pages aria-label="Páginas de ofertas" class="mt-5 flex items-center justify-center gap-3"><button type="button" data-picker-page="-1" class="min-h-11 rounded-lg border border-stone-300 px-3 text-sm">Anterior</button><span data-picker-page-label class="text-xs"></span><button type="button" data-picker-page="1" class="min-h-11 rounded-lg border border-stone-300 px-3 text-sm">Siguiente</button></nav></div><footer class="flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 bg-white p-5 sm:px-6"><p data-picker-count role="status" class="text-sm font-semibold text-emerald-800"></p><div class="flex flex-wrap gap-2"><button type="button" data-picker-close class="min-h-11 rounded-lg border border-stone-300 px-4 py-3 text-sm">Cancelar</button><button type="button" data-picker-apply class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Usar esta selección</button></div></footer></dialog>
<dialog data-popup-preview-dialog class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-5 text-stone-900 shadow-xl" aria-labelledby="popup-preview-title"><div class="flex justify-between gap-3"><h2 id="popup-preview-title" class="font-serif text-2xl">Vista previa del aviso</h2><button type="button" data-popup-preview-close aria-label="Cerrar vista previa" class="rounded-lg border px-3 py-2">✕</button></div><p class="my-3 text-xs text-stone-600">Usa la selección que estás preparando, sin mostrar el aviso a tus clientes ni cambiar su límite de 24 horas.</p><iframe data-popup-preview-frame data-url="@Url.Action("VistaAviso")" title="Vista previa del aviso de descuentos" class="h-96 w-full rounded-xl border border-stone-200 bg-stone-50" sandbox="allow-scripts"></iframe></dialog>
