@model AldaJoyeros.Models.PromotionsAdminViewModel
@{ViewData["Title"]="Descuentos y promociones";}
<div data-promotions-admin data-url="@Url.Action("Index")" class="mx-auto max-w-7xl px-4 py-8 sm:px-6"><a asp-controller="Admin" asp-action="Index" class="text-sm text-emerald-800 underline">Volver al panel</a><div class="mb-8 mt-4"><p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Tu tienda, a tu manera</p><h1 class="mt-2 font-serif text-3xl sm:text-4xl">Descuentos y promociones</h1><p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">Elige las ofertas, decide dónde enseñarlas y prepara tus correos. Los precios del proveedor se mantienen separados.</p></div><p data-promotion-status role="status" tabindex="-1" class="mb-4 rounded-lg p-3 text-sm" hidden></p><div data-promotion-panel><partial name="_Panel" model="Model" /></div>
<dialog data-promotion-confirm class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-6 text-stone-900 shadow-xl"><h2 class="font-serif text-2xl">Confirmar acción</h2><p data-confirm-text class="mt-4 text-sm"></p><div class="mt-6 flex flex-wrap gap-3"><button type="button" data-confirm-yes class="rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white">Confirmar</button><button type="button" data-close-dialog class="rounded-lg border border-stone-300 px-5 py-3">Cancelar</button></div></dialog>
<dialog data-mail-preview class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-4 text-stone-900 shadow-xl sm:p-6"><div class="flex items-start justify-between gap-3"><div><h2 class="font-serif text-2xl">Vista previa del correo</h2><p data-mail-audience class="mt-2 text-sm"></p></div><button type="button" data-close-dialog aria-label="Cerrar vista previa" class="rounded-lg border px-3 py-2">✕</button></div><iframe title="Vista previa del correo de ofertas" sandbox="" class="mt-5 h-96 w-full rounded-xl border border-stone-200 bg-white"></iframe><p class="mt-4 text-xs text-stone-600">Se envía un correo individual por suscriptor. No se muestran direcciones de otros clientes. Si un precio deja de estar vigente, ese producto se omitirá del envío.</p><div class="mt-5 flex flex-wrap gap-3"><button type="button" data-mail-send class="rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white">Enviar a los suscriptores</button><button type="button" data-close-dialog class="rounded-lg border border-stone-300 px-5 py-3">Seguir editando</button></div></dialog>
</div>
@section Styles{<link href="~/css/promotions.css" rel="stylesheet" asp-append-version="true"/>}
@section Scripts{<script src="~/js/admin-promotions.js" asp-append-version="true" defer></script>}
