@model AldaJoyeros.DTOs.PedidoDto
@using AldaJoyeros.Helpers
@{ var estado = PedidoPresentacion.Desde(Model.Estado); var pasos = new[] { ("Recibido", "fa-clipboard-check"), ("En preparación", "fa-box"), ("Enviado", "fa-truck"), ("Entregado", "fa-check-circle") }; }
                <section aria-labelledby="seguimiento-titulo" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6">
                    <h2 id="seguimiento-titulo" class="font-semibold text-lg text-slate-900">Seguimiento del pedido</h2>
                    <p class="text-sm text-slate-500 mt-1">Estado actual: <span class="font-medium text-slate-700">@estado.Etiqueta</span></p>
                    @if (estado.Paso >= 0)
                    {
                        <ol class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5" aria-label="Fases del pedido">
                            @for (var i = 0; i < pasos.Length; i++)
                            {
                                var actual = i == estado.Paso;
                                <li aria-current="@(actual ? "step" : null)" class="rounded-xl border p-3 @(actual ? "border-emerald-200 bg-emerald-50" : "border-slate-100 bg-slate-50")">
                                    <span class="w-8 h-8 rounded-full flex items-center justify-center mb-3 @(i <= estado.Paso ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-500")"><i class="fas @pasos[i].Item2 text-xs" aria-hidden="true"></i></span>
                                    <span class="block text-xs font-semibold text-slate-800">@pasos[i].Item1</span>
                                    <span class="block text-[11px] mt-1 text-slate-500">@(actual ? "Estado actual" : i < estado.Paso ? "Fase anterior" : "Pendiente")</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 rounded-xl p-4 mt-5 @estado.Color"><i class="fas @estado.Icono" aria-hidden="true"></i><p class="text-sm">@(estado.Grupo == "cancelados" ? "Este pedido está cancelado." : "No hay seguimiento disponible para este estado.")</p></div>
                    }
                </section>
