@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.PedidoDto>
<div data-current-page="@Model.PageNumber">
@if (Model.Items.Any())
{
<div class="admin-list overflow-hidden rounded-xl border border-slate-200 bg-white" id="pedidosListContainer">
<div class="admin-list-header xl:grid xl:grid-cols-[minmax(0,1fr)_105px_110px_120px_275px] hidden items-center gap-5 border-b border-slate-200 bg-slate-50 px-5 py-4 text-[11px] font-bold uppercase tracking-wide text-slate-500" aria-hidden="true"><span>Pedido / Cliente</span><span>Fecha</span><span>Total</span><span>Estado</span><span class="text-right">Acciones</span></div>
@foreach (var p in Model.Items)
{
var (estado, color) = p.Estado switch
{
"PENDIENTE" => ("Pendiente", "bg-amber-50 text-amber-800"),
"EN_PROCESO" => ("En proceso", "bg-blue-50 text-blue-700"),
"ENVIADO" => ("Enviado", "bg-violet-50 text-violet-700"),
"ENTREGADO" => ("Entregado", "bg-green-50 text-green-700"),
"CANCELADO" => ("Cancelado", "bg-red-50 text-red-700"),
_ => (p.Estado ?? "Sin estado", "bg-slate-100 text-slate-600")
};
<div class="admin-row pedido-card grid-cols-[minmax(0,1fr)_120px] xl:grid-cols-[minmax(0,1fr)_105px_110px_120px_275px] grid min-w-0 items-center gap-3.5 border-b border-slate-100 p-4 text-sm last:border-b-0 hover:bg-slate-50 md:gap-5 md:px-5" data-pedido-id="@p.Id">
<div class="admin-identity col-span-2 md:col-span-1 flex min-w-0 items-center gap-3 [&>div]:min-w-0"><span class="admin-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500"><i class="fas fa-shopping-bag" aria-hidden="true"></i></span><div><a asp-action="Detalle" asp-route-id="@p.Id" class="admin-name block font-semibold [overflow-wrap:anywhere]">Pedido #@p.Id</a><span class="admin-sub mt-1 block text-xs text-slate-500 [overflow-wrap:anywhere]">@(p.UsuarioEmail ?? "Cliente no disponible")</span><span class="admin-sub mt-1 block text-xs text-slate-500 [overflow-wrap:anywhere]">@p.LineasPedido.Count artículos</span></div></div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 xl:hidden">Fecha</span>@(p.Fecha?.ToString("dd/MM/yyyy") ?? "—")</div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 xl:hidden">Total</span><strong>@p.Total.ToString("C")</strong></div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 xl:hidden">Estado</span><span class="admin-badge @color inline-flex w-fit items-center gap-1.5 rounded-md px-2 py-1 text-[11px] font-semibold">@estado</span></div>
<div class="admin-actions col-span-2 justify-start xl:col-span-1 xl:justify-end flex flex-wrap gap-1.5"><a asp-action="Detalle" asp-route-id="@p.Id" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100">Ver</a><a asp-action="EditarEstado" asp-route-id="@p.Id" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100"><i class="fas fa-sync-alt" aria-hidden="true"></i>Estado</a><button type="button" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-transparent bg-transparent text-red-700 hover:border-red-200 hover:bg-red-50" data-delete-record="@p.Id" aria-label="Eliminar pedido @p.Id"><i class="fas fa-trash-alt" aria-hidden="true"></i>Eliminar</button></div>
</div>
}
</div>
}
else
{
<div class="admin-empty rounded-xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center text-slate-500 [&_h2]:mb-1.5 [&_h2]:mt-2.5 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-slate-700"><i class="fas fa-shopping-bag" aria-hidden="true"></i><h2>No hay pedidos que coincidan</h2><p>Prueba otro número, correo o estado, o limpia los filtros.</p></div>
}
@if (Model.TotalPages > 1)
{
@await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, "adminPedidos.cargarPagina", "paginacionPedidos", false))
}
<p class="admin-results mt-4 text-center text-xs text-slate-500">Mostrando @Model.StartItem–@Model.EndItem de @Model.TotalItems pedidos</p>
</div>
