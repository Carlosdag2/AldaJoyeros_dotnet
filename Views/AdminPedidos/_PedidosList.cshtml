@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.PedidoDto>
@{
    var estadoFiltro = ViewBag.EstadoFiltro as string ?? "";
}

@if(Model.Items != null && Model.Items.Any())
{
    <!-- Orders List -->
    <div class="space-y-4 mb-6" id="pedidosListContainer">
        @foreach(var p in Model.Items)
        {
            <div data-pedido-id="@p.Id" class="pedido-card bg-white rounded-2xl shadow-sm hover:shadow-md transition-all overflow-hidden border border-slate-100">
                <div class="flex flex-col md:flex-row">
                    <div class="flex-1 p-5">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                            <div>
                                <div class="text-xs text-slate-400 mb-1">Nº Pedido</div>
                                <div class="font-bold text-slate-800">#@p.Id</div>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 mb-1">Cliente</div>
                                <div class="font-medium text-slate-700 truncate">@p.UsuarioEmail</div>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 mb-1">Fecha</div>
                                <div class="font-medium text-slate-700">@p.Fecha?.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 mb-1">Total</div>
                                <div class="text-lg font-bold text-emerald-600">@p.Total.ToString("C")</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            @switch(p.Estado)
                            {
                                case "PENDIENTE":
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700"><i class="fas fa-clock mr-1"></i>Pendiente</span>
                                    break;
                                case "EN_PROCESO":
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700"><i class="fas fa-sync-alt mr-1"></i>En Proceso</span>
                                    break;
                                case "ENVIADO":
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-700"><i class="fas fa-shipping-fast mr-1"></i>Enviado</span>
                                    break;
                                case "ENTREGADO":
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700"><i class="fas fa-check-circle mr-1"></i>Entregado</span>
                                    break;
                                case "CANCELADO":
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700"><i class="fas fa-times-circle mr-1"></i>Cancelado</span>
                                    break;
                            }
                            <span class="text-sm text-slate-500">@p.LineasPedido.Count producto@(p.LineasPedido.Count != 1 ? "s" : "")</span>
                        </div>
                    </div>
                    <div class="bg-slate-50 p-5 md:w-44 flex flex-row md:flex-col justify-center gap-2 border-t md:border-t-0 md:border-l border-slate-100">
                        <a href="/AdminPedidos/Detalle/@p.Id" class="flex-1 md:flex-none flex items-center justify-center gap-1 px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-all text-sm font-medium">
                            <i class="fas fa-eye text-xs"></i>Ver
                        </a>
                        <a href="/AdminPedidos/EditarEstado/@p.Id" class="flex-1 md:flex-none flex items-center justify-center gap-1 px-3 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg transition-all text-sm font-medium">
                            <i class="fas fa-edit text-xs"></i>Estado
                        </a>
                        <button type="button" 
                                onclick="adminPedidos.eliminar(@p.Id)"
                                class="flex-1 md:flex-none flex items-center justify-center gap-1 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-all text-sm font-medium">
                            <i class="fas fa-trash text-xs"></i>Eliminar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination AJAX -->
    @if(Model.TotalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 flex-wrap" id="paginacionPedidos">
            @if(Model.HasPreviousPage)
            {
                <button type="button" 
                        onclick="adminPedidos.cargarPagina(@(Model.PageNumber-1))"
                        class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
            }
            @{var startPage = Math.Max(1, Model.PageNumber - 2); var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);}
            @for(var i = startPage; i <= endPage; i++)
            {
                var pageNum = i;
                @if(i == Model.PageNumber)
                {
                    <span class="px-3 py-2 bg-emerald-500 text-white rounded-lg font-medium">@i</span>
                }
                else
                {
                    <button type="button"
                            onclick="adminPedidos.cargarPagina(@pageNum)"
                            class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                        @i
                    </button>
                }
            }
            @if(Model.HasNextPage)
            {
                <button type="button"
                        onclick="adminPedidos.cargarPagina(@(Model.PageNumber+1))"
                        class="px-3 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all">
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            }
        </div>
    }

    <!-- Info de paginación -->
    <div class="text-center text-sm text-slate-500 mt-4">
        Mostrando @Model.StartItem-@Model.EndItem de @Model.TotalItems pedidos
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-100">
        <div class="w-20 h-20 bg-gradient-to-br from-amber-100 to-orange-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-box-open text-amber-500 text-3xl"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">No hay pedidos</h3>
        <p class="text-slate-500">@(string.IsNullOrEmpty(estadoFiltro) ? "Aún no se han realizado pedidos" : $"No hay pedidos con estado {estadoFiltro}")</p>
    </div>
}
