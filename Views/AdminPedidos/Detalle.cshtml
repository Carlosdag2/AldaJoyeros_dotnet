@model AldaJoyeros.DTOs.PedidoDto
@using AldaJoyeros.Helpers
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
    var estado = PedidoPresentacion.Desde(Model.Estado);
    var unidades = Model.LineasPedido.Sum(x => x.Cantidad);
}
<partial name="_AdminConfirmModal" />
<div class="min-h-screen bg-slate-50 pb-12">
    <header class="bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-9 sm:pt-8 sm:pb-12">
            <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-2 text-xs text-slate-400 mb-6">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white">Administración</a>
                <i class="fas fa-chevron-right text-[9px]" aria-hidden="true"></i>
                <a asp-action="Index" class="hover:text-white">Pedidos</a>
                <i class="fas fa-chevron-right text-[9px]" aria-hidden="true"></i>
                <span class="text-slate-200">#@Model.Id</span>
            </nav>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-300 mb-2">Gestión de pedidos</p>
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Pedido #@Model.Id</h1>
                        <div data-order-badge><partial name="_PedidoEstado" model="estado" /></div>
                    </div>
                    <p class="text-sm text-slate-300 mt-3"><i class="far fa-calendar-alt mr-2" aria-hidden="true"></i>@(Model.Fecha?.ToString("dd MMM yyyy · HH:mm") ?? "Fecha no registrada")</p>
                </div>
                <a asp-action="EditarEstado" asp-route-id="@Model.Id" data-order-state-editor data-editor-url="@Url.Action("EstadoEditor", new { id = Model.Id })" data-state-url="@Url.Action("EstadoActual", new { id = Model.Id })" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">
                    <i class="fas fa-pen" aria-hidden="true"></i>Cambiar estado
                </a>
            </div>
        </div>
    </header>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-8">
        <a asp-action="Index" class="inline-flex items-center gap-2 mb-6 text-sm font-medium text-slate-500 hover:text-emerald-700"><i class="fas fa-arrow-left" aria-hidden="true"></i>Volver a pedidos</a>
        <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5"><dt class="text-xs font-medium text-slate-500 mb-2">Total del pedido</dt><dd class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 break-words">@Model.Total.ToString("C")</dd></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5"><dt class="text-xs font-medium text-slate-500 mb-2">Artículos</dt><dd class="text-xl sm:text-2xl font-bold text-slate-900">@unidades <span class="text-xs font-normal text-slate-500">@(unidades == 1 ? "unidad" : "unidades")</span></dd></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5"><dt class="text-xs font-medium text-slate-500 mb-2">Entrega estimada</dt><dd class="text-sm sm:text-base font-semibold text-slate-900">@(Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "Sin fecha prevista")</dd></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5"><dt class="text-xs font-medium text-slate-500 mb-2">Entrega registrada</dt><dd data-order-delivery class="text-sm sm:text-base font-semibold text-slate-900">@(Model.FechaEntregaReal?.ToString("dd/MM/yyyy") ?? "Sin registrar")</dd></div>
        </dl>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
            <div class="lg:col-span-2 min-w-0 space-y-6">
                <section aria-labelledby="articulos-titulo" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-5 sm:p-6 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2">
                        <h2 id="articulos-titulo" class="font-semibold text-lg text-slate-900">Artículos del pedido</h2>
                        <span class="text-xs font-medium text-slate-500 bg-slate-100 rounded-full px-3 py-1">@Model.LineasPedido.Count @(Model.LineasPedido.Count == 1 ? "línea" : "líneas")</span>
                    </div>
                    <div class="hidden sm:grid grid-cols-12 gap-4 px-6 py-3 bg-slate-50 text-xs font-medium text-slate-500" aria-hidden="true"><span class="col-span-7">Producto</span><span class="col-span-2 text-center">Cantidad</span><span class="col-span-3 text-right">Importe</span></div>
                    <div class="divide-y divide-slate-100">
                        @foreach (var linea in Model.LineasPedido)
                        {
                            <div class="p-4 sm:p-6 grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 sm:items-center">
                                <div class="sm:col-span-7 flex items-start gap-3 sm:gap-4 min-w-0">
                                    <div class="w-16 h-20 sm:w-20 sm:h-24 shrink-0 rounded-xl border border-slate-100 bg-slate-50 overflow-hidden">
                                        @if (linea.Producto?.TieneImagenes == true)
                                        {
                                            <img src="@linea.Producto.ImagenPrincipal" alt="" loading="lazy" class="w-full h-full object-contain p-1" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-slate-300"><i class="fas fa-gem text-xl" aria-hidden="true"></i><span class="sr-only">Sin imagen</span></div>
                                        }
                                    </div>
                                    <div class="min-w-0 py-1">
                                        <h3 class="text-sm font-semibold text-slate-900 break-words">@(string.IsNullOrWhiteSpace(linea.ProductoNombre) ? "Producto no disponible" : linea.ProductoNombre)</h3>
                                        <p class="text-xs text-slate-500 mt-2 break-words">@linea.Precio.ToString("C") / unidad</p>
                                    </div>
                                </div>
                                <div class="sm:col-span-2 flex sm:justify-center items-center gap-2 text-sm text-slate-600"><span class="sm:hidden">Cantidad:</span><span class="inline-flex items-center justify-center min-w-[2rem] rounded-lg bg-slate-100 px-2 py-1 font-semibold text-slate-800">@linea.Cantidad</span></div>
                                <div class="sm:col-span-3 flex items-center justify-between gap-2 sm:justify-end text-sm font-semibold text-slate-900"><span class="sm:hidden text-slate-500 font-normal">Importe</span><span>@linea.Subtotal.ToString("C")</span></div>
                            </div>
                        }
                        @if (!Model.LineasPedido.Any())
                        {
                            <div class="text-center px-5 py-10"><i class="fas fa-box-open text-2xl text-slate-300 mb-3" aria-hidden="true"></i><p class="text-sm text-slate-500">No hay artículos registrados en este pedido.</p></div>
                        }
                    </div>
                    <div class="p-5 sm:p-6 bg-emerald-50 border-t border-emerald-100 flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold text-slate-900">Total del pedido</p><p class="text-xs text-slate-500 mt-1">Importe registrado en el pedido</p></div><p class="text-2xl font-bold tracking-tight text-emerald-800">@Model.Total.ToString("C")</p></div>
                </section>
                <div data-order-tracking><partial name="_SeguimientoPedido" model="Model" /></div>
            </div>
            <aside aria-label="Cliente y gestión del pedido" class="min-w-0 space-y-6">
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6">
                    <div class="flex items-center gap-3 mb-5"><span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center"><i class="far fa-user" aria-hidden="true"></i></span><h2 class="font-semibold text-lg text-slate-900">Cliente</h2></div>
                    <dl class="space-y-4 text-sm"><div><dt class="text-xs text-slate-500 mb-1">Correo electrónico</dt><dd class="font-medium text-slate-800 break-all">@(string.IsNullOrWhiteSpace(Model.UsuarioEmail) ? "Sin correo registrado" : Model.UsuarioEmail)</dd></div><div><dt class="text-xs text-slate-500 mb-1">Número de cliente</dt><dd class="font-medium text-slate-800">@(Model.UsuarioId.HasValue ? $"#{Model.UsuarioId}" : "No disponible")</dd></div></dl>
                    <div class="border-t border-slate-100 pt-5 mt-5"><h3 class="font-semibold text-sm text-slate-900 mb-3"><i class="fas fa-map-marker-alt text-slate-400 mr-2" aria-hidden="true"></i>Dirección de entrega</h3>
                        @if (Model.Direccion != null)
                        {
                            <address class="not-italic text-sm text-slate-600 break-words leading-relaxed"><p class="font-medium text-slate-800">@Model.Direccion.Calle, @Model.Direccion.Numero</p>@if (!string.IsNullOrWhiteSpace(Model.Direccion.Piso)) { <p>@Model.Direccion.Piso</p> }<p>@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad</p><p>@Model.Direccion.Provincia</p></address>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">No hay una dirección registrada.</p>
                        }
                    </div>
                </section>
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6">
                    <h2 class="font-semibold text-lg text-slate-900">Factura</h2><p class="text-sm text-slate-500 mt-2 mb-5">Descarga el documento de este pedido en PDF.</p>
                    <a href="@Url.Content($"~/Pedidos/{Model.Id}/Factura")" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 hover:bg-slate-800 px-4 py-3 text-white font-semibold text-sm transition-colors"><i class="fas fa-file-download" aria-hidden="true"></i>Descargar factura</a>
                </section>
                <section class="rounded-2xl border border-red-100 bg-white p-5 sm:p-6">
                    <h2 class="font-semibold text-sm text-slate-800">Eliminar pedido</h2><p class="text-xs text-slate-500 leading-relaxed mt-2 mb-4">Si necesitas cancelar el pedido, utiliza el cambio de estado para conservar su registro.</p>
                    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" id="deleteOrderForm"><button type="button" onclick="confirmDelete('deleteOrderForm', 'Pedido #@Model.Id')" class="w-full inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 px-4 py-2.5 text-sm font-medium text-red-700 hover:bg-red-50 transition-colors"><i class="far fa-trash-alt" aria-hidden="true"></i>Eliminar pedido</button></form>
                </section>
            </aside>
        </div>
    </div>
</div>

<partial name="_AdminWorkDialog" />
@section Styles { <link href="~/css/admin-workspace.css" rel="stylesheet" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-workspace.js" asp-append-version="true"></script><script src="~/js/admin-order-detail.js" asp-append-version="true"></script> }
