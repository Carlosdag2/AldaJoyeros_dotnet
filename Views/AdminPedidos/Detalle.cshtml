@model AldaJoyeros.DTOs.PedidoDto
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" class="hover:text-white transition-colors">Pedidos</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">#@Model.Id</span>
            </nav>
            
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center shadow-xl shadow-amber-500/25">
                        <i class="fas fa-box text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-white">Pedido #@Model.Id</h1>
                        <p class="text-slate-400 text-sm mt-1">@Model.Fecha?.ToString("dd/MM/yyyy 'a las' HH:mm")</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    @switch(Model.Estado)
                    {
                        case "PENDIENTE":
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-yellow-500 text-white shadow-lg"><i class="fas fa-clock mr-2"></i>Pendiente</span>
                            break;
                        case "EN_PROCESO":
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-blue-500 text-white shadow-lg"><i class="fas fa-sync-alt mr-2"></i>En Proceso</span>
                            break;
                        case "ENVIADO":
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-purple-500 text-white shadow-lg"><i class="fas fa-shipping-fast mr-2"></i>Enviado</span>
                            break;
                        case "ENTREGADO":
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-green-500 text-white shadow-lg"><i class="fas fa-check-circle mr-2"></i>Entregado</span>
                            break;
                        case "CANCELADO":
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-red-500 text-white shadow-lg"><i class="fas fa-times-circle mr-2"></i>Cancelado</span>
                            break;
                    }
                    <a asp-action="EditarEstado" asp-route-id="@Model.Id" class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-xl font-medium transition-all border border-white/10">
                        <i class="fas fa-edit"></i>Cambiar Estado
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Products -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
                        <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i class="fas fa-shopping-bag text-emerald-500"></i>
                            Productos (@Model.LineasPedido.Count)
                        </h2>
                    </div>
                    <div class="p-5 space-y-4">
                        @foreach(var l in Model.LineasPedido)
                        {
                            <div class="flex items-center gap-4 bg-slate-50 rounded-xl p-4 border border-slate-100">
                                <div class="w-16 h-16 bg-white rounded-lg overflow-hidden flex items-center justify-center shadow-sm">
                                    @if(l.Producto?.TieneImagenes == true)
                                    {
                                        <img src="@l.Producto.ImagenPrincipal" alt="@l.ProductoNombre" class="w-full h-full object-cover"/>
                                    }
                                    else
                                    {
                                        <i class="fas fa-gem text-slate-300 text-xl"></i>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-semibold text-slate-800 truncate">@l.ProductoNombre</h3>
                                    <div class="flex items-center gap-3 mt-1 text-sm">
                                        <span class="text-slate-500">Cantidad: <span class="font-medium text-slate-700">@l.Cantidad</span></span>
                                        <span class="text-slate-500">Precio: <span class="font-medium text-emerald-600">@l.Precio.ToString("C")</span></span>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-xs text-slate-400">Subtotal</div>
                                    <div class="text-lg font-bold text-emerald-600">@l.Subtotal.ToString("C")</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-5 border-t border-slate-100 bg-gradient-to-r from-emerald-50 to-green-50">
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-slate-800">Total del Pedido</span>
                            <span class="text-2xl font-bold text-emerald-600">@Model.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h2 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-history text-blue-500"></i>Historial
                    </h2>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-emerald-500 rounded-lg flex items-center justify-center">
                                <i class="fas fa-check text-white"></i>
                            </div>
                            <div>
                                <div class="font-medium text-slate-800">Pedido Creado</div>
                                <div class="text-sm text-slate-500">@Model.Fecha?.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        @if(Model.Estado != "PENDIENTE" && Model.Estado != "CANCELADO")
                        {
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-cog text-white"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-800">En Proceso</div>
                                    <div class="text-sm text-slate-500">Preparando pedido</div>
                                </div>
                            </div>
                        }
                        @if(Model.Estado == "ENVIADO" || Model.Estado == "ENTREGADO")
                        {
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-shipping-fast text-white"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-800">Enviado</div>
                                    <div class="text-sm text-slate-500">Entrega estimada: @Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        }
                        @if(Model.Estado == "ENTREGADO" && Model.FechaEntregaReal.HasValue)
                        {
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-check-double text-white"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-green-700">Entregado</div>
                                    <div class="text-sm text-slate-500">@Model.FechaEntregaReal?.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Customer Info -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-user text-blue-500"></i>Cliente
                    </h3>
                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                        <div class="text-sm text-slate-500 mb-1">Email</div>
                        <div class="font-medium text-slate-800">@Model.UsuarioEmail</div>
                        <div class="text-sm text-slate-500 mt-3 mb-1">ID Usuario</div>
                        <div class="font-medium text-slate-800">#@Model.UsuarioId</div>
                    </div>
                </div>

                <!-- Address -->
                @if(Model.Direccion != null)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                        <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-red-500"></i>Dirección de Envío
                        </h3>
                        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                            <address class="not-italic text-sm text-slate-700 space-y-1">
                                <div class="font-medium text-slate-800">@Model.Direccion.Calle, @Model.Direccion.Numero</div>
                                @if(!string.IsNullOrEmpty(Model.Direccion.Piso))
                                {
                                    <div>@Model.Direccion.Piso</div>
                                }
                                <div>@Model.Direccion.CodigoPostal - @Model.Direccion.Ciudad</div>
                                <div>@Model.Direccion.Provincia</div>
                            </address>
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-bolt text-amber-500"></i>Acciones
                    </h3>
                    <div class="space-y-2">
                        <a asp-action="EditarEstado" asp-route-id="@Model.Id" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-medium transition-all">
                            <i class="fas fa-edit"></i>Cambiar Estado
                        </a>
                        <a href="/Pedidos/@Model.Id/Factura" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-medium transition-all">
                            <i class="fas fa-file-invoice"></i>Descargar Factura
                        </a>
                        <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este pedido?')">
                            <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium transition-all">
                                <i class="fas fa-trash"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="mt-8 flex flex-wrap gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>Volver a Pedidos
            </a>
            <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 text-slate-500 hover:text-slate-700 transition-all font-medium">
                <i class="fas fa-home"></i>Ir al Panel
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function enviarFacturaAdmin(pedidoId) {
            const btn = document.getElementById('btnEnviarFactura');
            const originalHtml = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';
            
            try {
                const response = await fetch(`/Pedidos/${pedidoId}/EnviarFactura`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> ¡Enviada!';
                    btn.classList.remove('bg-purple-500', 'hover:bg-purple-600');
                    btn.classList.add('bg-green-500');
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('bg-green-500');
                        btn.classList.add('bg-purple-500', 'hover:bg-purple-600');
                        btn.disabled = false;
                    }, 3000);
                } else {
                    btn.innerHTML = '<i class="fas fa-times"></i> Error';
                    btn.classList.remove('bg-purple-500', 'hover:bg-purple-600');
                    btn.classList.add('bg-red-500');
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('bg-red-500');
                        btn.classList.add('bg-purple-500', 'hover:bg-purple-600');
                        btn.disabled = false;
                    }, 3000);
                }
            } catch (error) {
                console.error('Error:', error);
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }
    </script>
}
