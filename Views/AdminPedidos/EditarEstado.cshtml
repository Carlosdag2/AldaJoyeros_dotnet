@model AldaJoyeros.DTOs.PedidoUpdateEstadoDto
@using AldaJoyeros.Entities

@{
    ViewData["Title"] = "Cambiar Estado del Pedido";
    var pedidoId = ViewBag.PedidoId as long?;
}

<!-- Header -->
<div class="mb-8">
    <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">
        <i class="fas fa-edit text-yellow-600"></i> Cambiar Estado del Pedido
    </h1>
    <p class="text-gray-600">Actualiza el estado del pedido #@pedidoId</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-3xl shadow-xl p-8">
            <form asp-action="EditarEstado" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                        <span class="text-red-800 text-sm"></span>
                    </div>
                </div>

                <!-- Estado Actual -->
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border-2 border-blue-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm text-gray-600 mb-2">Estado Actual:</div>
                            <div class="text-2xl font-bold text-gray-900">
                                @switch (Model.Estado.ToString())
                                {
                                    case "PENDIENTE":
                                        <span class="inline-flex items-center text-yellow-600">
                                            <i class="fas fa-clock mr-2"></i> Pendiente
                                        </span>
                                        break;
                                    case "EN_PROCESO":
                                        <span class="inline-flex items-center text-blue-600">
                                            <i class="fas fa-sync-alt mr-2"></i> En Proceso
                                        </span>
                                        break;
                                    case "ENVIADO":
                                        <span class="inline-flex items-center text-purple-600">
                                            <i class="fas fa-shipping-fast mr-2"></i> Enviado
                                        </span>
                                        break;
                                    case "ENTREGADO":
                                        <span class="inline-flex items-center text-green-600">
                                            <i class="fas fa-check-circle mr-2"></i> Entregado
                                        </span>
                                        break;
                                    case "CANCELADO":
                                        <span class="inline-flex items-center text-red-600">
                                            <i class="fas fa-times-circle mr-2"></i> Cancelado
                                        </span>
                                        break;
                                }
                            </div>
                        </div>
                        <i class="fas fa-arrow-right text-3xl text-blue-600"></i>
                    </div>
                </div>

                <!-- Nuevo Estado -->
                <div>
                    <label asp-for="Estado" class="block text-sm font-semibold text-gray-700 mb-3">
                        <i class="fas fa-exchange-alt mr-2 text-gray-500"></i>Nuevo Estado
                    </label>
                    
                    <div class="space-y-3">
                        <!-- PENDIENTE -->
                        <label class="flex items-center p-4 bg-yellow-50 border-2 border-yellow-200 rounded-xl hover:border-yellow-400 cursor-pointer transition-all group">
                            <input type="radio" asp-for="Estado" value="@EstadoPedido.PENDIENTE" 
                                   class="w-5 h-5 text-yellow-600 focus:ring-yellow-500" />
                            <div class="ml-4 flex-1">
                                <div class="flex items-center">
                                    <i class="fas fa-clock text-2xl text-yellow-600 mr-3"></i>
                                    <div>
                                        <div class="font-bold text-gray-900">Pendiente</div>
                                        <div class="text-sm text-gray-600">El pedido está pendiente de procesamiento</div>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- EN_PROCESO -->
                        <label class="flex items-center p-4 bg-blue-50 border-2 border-blue-200 rounded-xl hover:border-blue-400 cursor-pointer transition-all group">
                            <input type="radio" asp-for="Estado" value="@EstadoPedido.EN_PROCESO" 
                                   class="w-5 h-5 text-blue-600 focus:ring-blue-500" />
                            <div class="ml-4 flex-1">
                                <div class="flex items-center">
                                    <i class="fas fa-sync-alt text-2xl text-blue-600 mr-3"></i>
                                    <div>
                                        <div class="font-bold text-gray-900">En Proceso</div>
                                        <div class="text-sm text-gray-600">El pedido se está preparando</div>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- ENVIADO -->
                        <label class="flex items-center p-4 bg-purple-50 border-2 border-purple-200 rounded-xl hover:border-purple-400 cursor-pointer transition-all group">
                            <input type="radio" asp-for="Estado" value="@EstadoPedido.ENVIADO" 
                                   class="w-5 h-5 text-purple-600 focus:ring-purple-500" />
                            <div class="ml-4 flex-1">
                                <div class="flex items-center">
                                    <i class="fas fa-shipping-fast text-2xl text-purple-600 mr-3"></i>
                                    <div>
                                        <div class="font-bold text-gray-900">Enviado</div>
                                        <div class="text-sm text-gray-600">El pedido está en camino al cliente</div>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- ENTREGADO -->
                        <label class="flex items-center p-4 bg-green-50 border-2 border-green-200 rounded-xl hover:border-green-400 cursor-pointer transition-all group">
                            <input type="radio" asp-for="Estado" value="@EstadoPedido.ENTREGADO" 
                                   class="w-5 h-5 text-green-600 focus:ring-green-500" />
                            <div class="ml-4 flex-1">
                                <div class="flex items-center">
                                    <i class="fas fa-check-circle text-2xl text-green-600 mr-3"></i>
                                    <div>
                                        <div class="font-bold text-gray-900">Entregado</div>
                                        <div class="text-sm text-gray-600">El pedido ha sido entregado al cliente</div>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- CANCELADO -->
                        <label class="flex items-center p-4 bg-red-50 border-2 border-red-200 rounded-xl hover:border-red-400 cursor-pointer transition-all group">
                            <input type="radio" asp-for="Estado" value="@EstadoPedido.CANCELADO" 
                                   class="w-5 h-5 text-red-600 focus:ring-red-500" />
                            <div class="ml-4 flex-1">
                                <div class="flex items-center">
                                    <i class="fas fa-times-circle text-2xl text-red-600 mr-3"></i>
                                    <div>
                                        <div class="font-bold text-gray-900">Cancelado</div>
                                        <div class="text-sm text-gray-600">El pedido ha sido cancelado</div>
                                    </div>
                                </div>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="Estado" class="text-red-500 text-sm mt-2 block"></span>
                </div>

                <hr />

                <div class="flex flex-col sm:flex-row justify-between gap-4">
                    <a asp-action="Detalle" asp-route-id="@pedidoId"
                       class="inline-flex items-center justify-center px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-yellow-500 hover:text-yellow-600 transition-all duration-200 font-semibold">
                        <i class="fas fa-times mr-2"></i>
                        Cancelar
                    </a>
                    <button type="submit" 
                            class="inline-flex items-center justify-center gradient-gold text-gray-900 px-8 py-3 rounded-lg font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                        <i class="fas fa-save mr-2"></i>
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Info Sidebar -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Order Info -->
        <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-info-circle text-orange-600 mr-2"></i>
                Info del Pedido
            </h3>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-600">ID Pedido:</span>
                    <span class="font-bold text-gray-900">#@pedidoId</span>
                </div>
            </div>
        </div>

        <!-- State Flow -->
        <div class="bg-white rounded-2xl p-6 shadow-lg">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-route text-blue-600 mr-2"></i>
                Flujo de Estados
            </h3>
            <div class="space-y-3">
                <div class="flex items-center text-sm">
                    <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center mr-3">
                        <i class="fas fa-clock text-yellow-600"></i>
                    </div>
                    <span class="text-gray-700">Pendiente</span>
                </div>
                <div class="ml-4 h-6 w-0.5 bg-gray-300"></div>
                <div class="flex items-center text-sm">
                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                        <i class="fas fa-sync-alt text-blue-600"></i>
                    </div>
                    <span class="text-gray-700">En Proceso</span>
                </div>
                <div class="ml-4 h-6 w-0.5 bg-gray-300"></div>
                <div class="flex items-center text-sm">
                    <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3">
                        <i class="fas fa-shipping-fast text-purple-600"></i>
                    </div>
                    <span class="text-gray-700">Enviado</span>
                </div>
                <div class="ml-4 h-6 w-0.5 bg-gray-300"></div>
                <div class="flex items-center text-sm">
                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3">
                        <i class="fas fa-check-circle text-green-600"></i>
                    </div>
                    <span class="text-gray-700">Entregado</span>
                </div>
            </div>
        </div>

        <!-- Warning -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-6 border-2 border-yellow-200">
            <div class="flex items-start">
                <i class="fas fa-exclamation-triangle text-yellow-600 text-2xl mr-3 mt-1"></i>
                <div>
                    <h3 class="font-semibold text-gray-900 mb-2">Importante</h3>
                    <ul class="text-sm text-gray-700 space-y-1">
                        <li>• Los cambios son inmediatos</li>
                        <li>• El cliente será notificado</li>
                        <li>• No se puede deshacer</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
