@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.PedidoDto>
@{
    ViewData["Title"] = "Gestión de Pedidos";
    var estadoFiltro = ViewBag.EstadoFiltro as string ?? "";
    var totalPendientes = ViewBag.TotalPendientes ?? 0;
    var totalEnProceso = ViewBag.TotalEnProceso ?? 0;
    var totalEnviados = ViewBag.TotalEnviados ?? 0;
    var totalEntregados = ViewBag.TotalEntregados ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Pedidos</span>
            </nav>
            
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center shadow-xl shadow-amber-500/25">
                    <i class="fas fa-shopping-bag text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white">Gestión de Pedidos</h1>
                    <p class="text-slate-400 text-sm mt-1">Administra todos los pedidos de la tienda</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 -mt-6 relative z-10 pb-12">
        <!-- Filters & Stats -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
            <!-- Filter Tabs AJAX -->
            <div class="flex flex-wrap gap-2 mb-5" id="filtrosPedidos">
                <button type="button" onclick="adminPedidos.filtrar('')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(string.IsNullOrEmpty(estadoFiltro) ? "bg-emerald-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="">
                    <i class="fas fa-th-large"></i>Todos
                </button>
                <button type="button" onclick="adminPedidos.filtrar('PENDIENTE')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(estadoFiltro == "PENDIENTE" ? "bg-yellow-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="PENDIENTE">
                    <i class="fas fa-clock"></i>Pendientes
                </button>
                <button type="button" onclick="adminPedidos.filtrar('EN_PROCESO')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(estadoFiltro == "EN_PROCESO" ? "bg-blue-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="EN_PROCESO">
                    <i class="fas fa-sync-alt"></i>En Proceso
                </button>
                <button type="button" onclick="adminPedidos.filtrar('ENVIADO')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(estadoFiltro == "ENVIADO" ? "bg-purple-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="ENVIADO">
                    <i class="fas fa-shipping-fast"></i>Enviados
                </button>
                <button type="button" onclick="adminPedidos.filtrar('ENTREGADO')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(estadoFiltro == "ENTREGADO" ? "bg-green-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="ENTREGADO">
                    <i class="fas fa-check-circle"></i>Entregados
                </button>
                <button type="button" onclick="adminPedidos.filtrar('CANCELADO')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(estadoFiltro == "CANCELADO" ? "bg-red-500 text-white shadow-md active" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-estado="CANCELADO">
                    <i class="fas fa-times-circle"></i>Cancelados
                </button>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3 pt-5 border-t border-slate-100" id="statsPedidos">
                <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl p-3 text-center border border-slate-200">
                    <div id="statTotal" class="text-2xl font-bold text-slate-700">@Model.TotalItems</div>
                    <div class="text-xs text-slate-500">Total</div>
                </div>
                <div class="bg-gradient-to-br from-yellow-50 to-amber-50 rounded-xl p-3 text-center border border-yellow-200">
                    <div id="statPendientes" class="text-2xl font-bold text-yellow-600">@totalPendientes</div>
                    <div class="text-xs text-slate-500">Pendientes</div>
                </div>
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-3 text-center border border-blue-200">
                    <div id="statEnProceso" class="text-2xl font-bold text-blue-600">@totalEnProceso</div>
                    <div class="text-xs text-slate-500">En Proceso</div>
                </div>
                <div class="bg-gradient-to-br from-purple-50 to-violet-50 rounded-xl p-3 text-center border border-purple-200">
                    <div id="statEnviados" class="text-2xl font-bold text-purple-600">@totalEnviados</div>
                    <div class="text-xs text-slate-500">Enviados</div>
                </div>
                <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-3 text-center border border-green-200">
                    <div id="statEntregados" class="text-2xl font-bold text-green-600">@totalEntregados</div>
                    <div class="text-xs text-slate-500">Entregados</div>
                </div>
            </div>
        </div>

        <!-- Contenedor dinámico para la lista de pedidos -->
        <div id="pedidosContainer">
            <partial name="_PedidosList" model="Model" />
        </div>

        <!-- Navigation -->
        <div class="mt-8">
            <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>Volver al Panel
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminPedidos = {
            estadoActual: '@estadoFiltro',
            paginaActual: @Model.PageNumber,
            cargando: false,

            // Filtrar por estado
            async filtrar(estado) {
                if (this.cargando) return;
                this.estadoActual = estado;
                this.paginaActual = 1;
                await this.cargarDatos();
                this.actualizarBotonesFiltro(estado);
                this.actualizarURL();
            },

            // Cargar página específica
            async cargarPagina(pagina) {
                if (this.cargando) return;
                this.paginaActual = pagina;
                await this.cargarDatos();
                this.actualizarURL();
                // Scroll suave hacia arriba
                document.getElementById('pedidosContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });
            },

            // Cargar datos via AJAX
            async cargarDatos() {
                this.cargando = true;
                const container = document.getElementById('pedidosContainer');
                
                // Mostrar loading
                container.style.opacity = '0.5';
                container.style.pointerEvents = 'none';

                try {
                    const params = new URLSearchParams();
                    if (this.estadoActual) params.append('estado', this.estadoActual);
                    params.append('page', this.paginaActual);

                    const response = await fetch(`/AdminPedidos/Index?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.ok) {
                        const html = await response.text();
                        container.innerHTML = html;
                        container.style.opacity = '1';
                        container.style.pointerEvents = '';
                        
                        // Actualizar estadísticas desde los headers
                        this.actualizarEstadisticas(response);
                    } else {
                        throw new Error('Error al cargar');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error al cargar los pedidos');
                    container.style.opacity = '1';
                    container.style.pointerEvents = '';
                } finally {
                    this.cargando = false;
                }
            },

            // Actualizar estadísticas desde response headers
            actualizarEstadisticas(response) {
                const pendientes = response.headers.get('X-Stats-Pendientes');
                const enProceso = response.headers.get('X-Stats-EnProceso');
                const enviados = response.headers.get('X-Stats-Enviados');
                const entregados = response.headers.get('X-Stats-Entregados');
                const total = response.headers.get('X-Stats-Total');

                if (pendientes) document.getElementById('statPendientes').textContent = pendientes;
                if (enProceso) document.getElementById('statEnProceso').textContent = enProceso;
                if (enviados) document.getElementById('statEnviados').textContent = enviados;
                if (entregados) document.getElementById('statEntregados').textContent = entregados;
                if (total) document.getElementById('statTotal').textContent = total;
            },

            // Actualizar botones de filtro activo
            actualizarBotonesFiltro(estadoActivo) {
                const botones = document.querySelectorAll('#filtrosPedidos .filtro-btn');
                const colores = {
                    '': { activo: 'bg-emerald-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'PENDIENTE': { activo: 'bg-yellow-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'EN_PROCESO': { activo: 'bg-blue-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'ENVIADO': { activo: 'bg-purple-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'ENTREGADO': { activo: 'bg-green-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'CANCELADO': { activo: 'bg-red-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' }
                };

                botones.forEach(btn => {
                    const estado = btn.dataset.estado;
                    const esActivo = estado === estadoActivo;
                    
                    // Remover clases de color/estado previas
                    btn.classList.remove(
                        'bg-emerald-500', 'bg-yellow-500', 'bg-blue-500', 'bg-purple-500', 'bg-green-500', 'bg-red-500',
                        'bg-slate-100', 'text-white', 'text-slate-600', 'shadow-md', 'hover:bg-slate-200'
                    );
                    
                    // Añadir clases correspondientes
                    const clases = esActivo ? colores[estado].activo : colores[estado].inactivo;
                    btn.classList.add(...clases.split(' '));
                });
            },

            // Actualizar URL sin recargar
            actualizarURL() {
                const params = new URLSearchParams();
                if (this.estadoActual) params.append('estado', this.estadoActual);
                if (this.paginaActual > 1) params.append('page', this.paginaActual);
                
                const newUrl = params.toString() 
                    ? `${window.location.pathname}?${params.toString()}`
                    : window.location.pathname;
                    
                history.pushState({ estado: this.estadoActual, page: this.paginaActual }, '', newUrl);
            },

            // Eliminar pedido
            async eliminar(id) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar pedido?',
                    message: `El pedido #${id} será eliminado permanentemente.`,
                    type: 'danger',
                    confirmText: 'Eliminar'
                });

                if (!confirmar) return;

                try {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = `/AdminPedidos/Eliminar/${id}`;
                    document.body.appendChild(form);
                    form.submit();
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error al eliminar');
                }
            }
        };

        // Manejar botón atrás del navegador
        window.addEventListener('popstate', (event) => {
            if (event.state) {
                adminPedidos.estadoActual = event.state.estado || '';
                adminPedidos.paginaActual = event.state.page || 1;
                adminPedidos.cargarDatos();
                adminPedidos.actualizarBotonesFiltro(adminPedidos.estadoActual);
            }
        });

        window.adminPedidos = adminPedidos;
    </script>
}