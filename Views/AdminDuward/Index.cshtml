@model AldaJoyeros.Services.Duward.DuwardDashboard
@using System.Text.Json
@{
 ViewData["Title"]="Catálogo de Duward";
 var active=Model.Jobs.FirstOrDefault(x=>x.Active);
 string Local(DateTime value)=>TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value,DateTimeKind.Utc),AldaJoyeros.Services.Munreco.MunrecoSchedule.Zone).ToString("dd/MM/yyyy HH:mm");
 string Metric(string? json,string name){if(string.IsNullOrEmpty(json))return "0";try{using var doc=JsonDocument.Parse(json);return doc.RootElement.TryGetProperty(name,out var v)?v.ToString():"0";}catch(JsonException){return "0";}}
}
<div class="min-h-screen bg-slate-50 pb-12 text-slate-900" data-duward-panel data-status-url="@Url.Action("Estado")">
 <header class="bg-slate-900 text-white"><div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><a asp-controller="Admin" asp-action="Index" class="mb-5 inline-flex min-h-11 items-center gap-2 text-sm text-slate-300"><i class="fas fa-arrow-left" aria-hidden="true"></i>Panel de administración</a><p class="text-xs font-semibold uppercase tracking-widest text-emerald-300">Actualización de proveedores</p><h1 class="mt-3 text-3xl font-bold">Catálogo de Duward</h1><p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300">Sube los CSV de Sport, Aquastar o Lady para comprobar novedades, existencias y precios. Puedes seleccionar varias colecciones a la vez.</p></div></header>
 <div class="mx-auto max-w-7xl space-y-6 px-4 pt-6 sm:px-6 lg:px-8">
  <section class="grid gap-4 sm:grid-cols-3" aria-label="Cómo funciona">
   <div class="rounded-2xl border border-slate-200 bg-white p-5"><span class="text-xs font-bold uppercase tracking-wide text-emerald-800">01 · Comprobar</span><h2 class="mt-2 font-semibold">Revisa antes de guardar</h2><p class="mt-2 text-sm leading-relaxed text-slate-500">Valida los archivos y las imágenes y descarga el informe PDF. Esta acción no cambia los productos.</p></div>
   <div class="rounded-2xl border border-slate-200 bg-white p-5"><span class="text-xs font-bold uppercase tracking-wide text-emerald-800">02 · Actualizar</span><h2 class="mt-2 font-semibold">Cada referencia, una ficha</h2><p class="mt-2 text-sm leading-relaxed text-slate-500">Añade los nuevos y actualiza los existentes sin duplicarlos. Conserva los cambios manuales de la tienda.</p></div>
   <div class="rounded-2xl border border-slate-200 bg-white p-5"><span class="text-xs font-bold uppercase tracking-wide text-emerald-800">03 · Imágenes</span><h2 class="mt-2 font-semibold">Recuperación automática</h2><p class="mt-2 text-sm leading-relaxed text-slate-500">Si falla el enlace del CSV, busca la referencia exacta en Duward. Si no encuentra una foto válida, la ficha queda oculta para revisión.</p></div>
  </section>
  @if(!Model.WorkerEnabled){<p role="alert" class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">El proceso de importación está desactivado en este servidor.</p>}
  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="duward-upload-title">
   <div class="flex flex-wrap items-center justify-between gap-4"><div><h2 id="duward-upload-title" class="text-xl font-semibold">Importar archivos CSV</h2><p class="mt-2 text-sm text-slate-500">Selecciona uno, dos o los tres archivos del proveedor, sin cambiar sus columnas.</p></div><span class="rounded-full bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-800">Precio con IVA del CSV → PVP</span></div>
   <form asp-action="Subir" method="post" enctype="multipart/form-data" class="mt-6 space-y-5" data-duward-upload>
    <label for="duwardFiles" class="block rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 p-5 sm:p-7"><span class="mb-3 block font-semibold">CSV de Duward</span><input id="duwardFiles" name="archivos" type="file" accept=".csv,text/csv" multiple required aria-describedby="duward-files-help" class="block w-full min-w-0 text-sm file:mr-3 file:min-h-11 file:rounded-lg file:border-0 file:bg-emerald-800 file:px-4 file:font-semibold file:text-white" /><span id="duward-files-help" class="mt-3 block text-xs leading-relaxed text-slate-500">Hasta 10 archivos de 10 MB, con un máximo de 30 MB en total. Se reconocen los decimales con coma y las tildes de los archivos originales.</span></label>
    <ul data-file-list class="space-y-2 text-sm text-slate-600" aria-live="polite"></ul>
    <label class="flex items-start gap-3 rounded-xl border border-slate-200 p-4"><input type="checkbox" name="retirarAusentes" value="true" class="mt-1 h-4 w-4 shrink-0 accent-emerald-700" /><span><span class="block text-sm font-semibold">Ocultar referencias que ya no aparecen en estas colecciones</span><span class="mt-1 block text-xs leading-relaxed text-slate-500">Márcalo solo si cada CSV contiene la colección completa. Sport no retira productos de Lady ni de Aquastar. Si está desmarcado, solo se añaden o actualizan las referencias incluidas.</span></span></label>
    <div class="flex flex-col gap-3 sm:flex-row"><button type="submit" name="aplicar" value="false" disabled="@(active!=null||!Model.WorkerEnabled)" class="min-h-11 rounded-xl border border-emerald-800 px-5 py-3 text-sm font-semibold text-emerald-800 disabled:opacity-40"><i class="fas fa-search mr-2" aria-hidden="true"></i>Comprobar archivos</button><button type="submit" name="aplicar" value="true" disabled="@(active!=null||!Model.WorkerEnabled)" class="min-h-11 rounded-xl bg-emerald-800 px-5 py-3 text-sm font-semibold text-white disabled:opacity-40"><i class="fas fa-sync-alt mr-2" aria-hidden="true"></i>Importar / actualizar catálogo</button></div>
   </form>
   <p class="mt-5 text-xs leading-relaxed text-slate-500">El PVP y las existencias proceden del CSV, no de la tienda pública de Duward. Las medidas sospechosas y los códigos incompletos se conservan en los datos originales y se señalan en el informe. Los agotados y las fichas sin imagen válida permanecen ocultos, respetando las decisiones manuales del administrador.</p>
  </section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="duward-history-title"><h2 id="duward-history-title" class="text-xl font-semibold">Historial e informes</h2><p class="mt-2 text-sm text-slate-500">Puedes cerrar el panel mientras trabaja. Vuelve aquí para consultar el resultado y descargar sus PDF.</p>
   <p data-duward-status role="status" class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-700">@(active?.Progress??"No hay tareas en marcha.")</p>
   @if(Model.Jobs.Count==0){<div class="py-10 text-center text-sm text-slate-500">Sube los primeros CSV para comprobar el catálogo.</div>}else{
    <div class="mt-5 overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="border-b border-slate-200 text-xs text-slate-500"><tr><th class="px-3 py-3">Fecha (Madrid)</th><th class="px-3 py-3">Operación</th><th class="px-3 py-3">Resultado</th><th class="px-3 py-3">Referencias</th><th class="px-3 py-3">Informes PDF</th></tr></thead><tbody class="divide-y divide-slate-100">
     @foreach(var job in Model.Jobs){<tr data-job-id="@job.Id" data-active="@job.Active.ToString().ToLowerInvariant()"><td class="whitespace-nowrap px-3 py-4 align-top">@Local(job.CreatedUtc)</td><td class="px-3 py-4 align-top">@(job.Trigger=="preview_csv"?"Comprobación CSV":"Actualización CSV")</td><td class="max-w-xs px-3 py-4 align-top"><p data-job-label class="font-semibold">@job.Label</p><p data-job-progress class="mt-1 text-xs leading-relaxed text-slate-500">@job.Progress</p></td><td class="px-3 py-4 align-top text-xs leading-relaxed">@if(job.ResultJson!=null){<p>@Metric(job.ResultJson,"added") nuevos · @Metric(job.ResultJson,"restocked") reposiciones</p><p>@Metric(job.ResultJson,"modified") modificados · @Metric(job.ResultJson,"soldOut") agotados · @Metric(job.ResultJson,"removed") retirados</p><p>@Metric(job.ResultJson,"imagesRecovered") con imagen recuperada</p><p>@Metric(job.ResultJson,"needsReview") para revisar · @Metric(job.ResultJson,"collisions") coincidencias</p><p>@Metric(job.ResultJson,"dataWarnings") avisos de datos</p>}</td><td class="px-3 py-4 align-top"><div class="flex flex-col gap-2 text-xs font-semibold text-emerald-800">@if(job.State is "completed" or "previewed"){
      @if(job.State=="completed"){<a asp-action="Informe" asp-route-id="@job.Id" class="underline underline-offset-2">Resultado (PDF)</a>}
      <a asp-action="Informe" asp-route-id="@job.Id" asp-route-tipo="comparacion" class="underline underline-offset-2">Cambios detectados (PDF)</a><a asp-action="Informe" asp-route-id="@job.Id" asp-route-tipo="revision" class="underline underline-offset-2">Datos e imágenes para revisar (PDF)</a>
     }else if(job.State is "failed" or "interrupted"){<a asp-action="Informe" asp-route-id="@job.Id" asp-route-tipo="error" class="underline underline-offset-2">Incidencia (PDF)</a>}</div></td></tr>}
    </tbody></table></div>
   }
  </section>
 </div>
</div>
@section Scripts{<script src="~/js/admin-duward.js" asp-append-version="true"></script>}
