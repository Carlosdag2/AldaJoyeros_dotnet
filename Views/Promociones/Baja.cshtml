@model bool
@{ViewData["Title"]="Baja de ofertas";ViewData["Robots"]="noindex, nofollow";}
<section class="mx-auto max-w-xl px-4 py-16"><div class="rounded-2xl border border-stone-200 bg-white p-8"><h1 class="font-serif text-3xl">@(Model?"Preferencia actualizada":"¿Quieres dejar de recibir ofertas?")</h1><p class="mt-4 text-sm text-stone-600">@(Model?"Si esta suscripción seguía vigente, ya no recibirás correos comerciales. Los mensajes necesarios de pedidos y de tu cuenta seguirán funcionando.":"Puedes darte de baja sin iniciar sesión. Seguirás recibiendo los mensajes necesarios para gestionar tu cuenta y tus pedidos.")</p>@if(!Model){<form asp-action="BajaConfirmar" method="post" class="mt-6">@Html.AntiForgeryToken()<input type="hidden" name="token" value="@ViewBag.Token"/><button class="rounded-lg bg-emerald-800 px-6 py-3 font-semibold text-white">Dejar de recibir ofertas</button></form>}<a href="~/catalogo" class="mt-6 inline-block text-sm text-emerald-800 underline">Volver a la tienda</a></div></section>
