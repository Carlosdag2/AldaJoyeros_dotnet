@model AldaJoyeros.DTOs.CategoriaUpdateDto
@{
    ViewData["Title"] = "Editar Categoría";
    var categoriaId = ViewBag.CategoriaId as long?;
    var cantidadProductos = ViewBag.CantidadProductos as int? ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" class="hover:text-white transition-colors">Categorías</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Editar #@categoriaId</span>
            </nav>
            
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-violet-400 to-purple-600 rounded-2xl flex items-center justify-center shadow-xl shadow-violet-500/25">
                    <i class="fas fa-edit text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white">Editar Categoría</h1>
                    <p class="text-slate-400 text-sm mt-1">Modificando categoría #@categoriaId</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-6 border-b border-slate-100">
                        <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i class="fas fa-edit text-violet-500"></i>
                            Información de la Categoría
                        </h2>
                    </div>
                    
                    <form asp-action="Editar" method="post" class="p-6 space-y-6">
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg text-red-700 text-sm"></div>

                        <div>
                            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 mb-2">
                                Nombre de la Categoría *
                            </label>
                            <input asp-for="Nombre" 
                                   class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none"
                                   placeholder="Nombre de la categoría" />
                            <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Info -->
                        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
                                <div class="text-sm text-blue-700">
                                    <p class="font-medium mb-1">Información</p>
                                    <ul class="space-y-1 text-blue-600">
                                        <li>• Los cambios afectarán a todos los productos asociados</li>
                                        <li>• El nombre debe ser único en el sistema</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4 border-t border-slate-100">
                            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 transition-all font-medium">
                                <i class="fas fa-times"></i>Cancelar
                            </a>
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl font-semibold shadow-lg shadow-emerald-500/25 transition-all">
                                <i class="fas fa-save"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-chart-bar text-emerald-500"></i>Estadísticas
                    </h3>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center bg-slate-50 rounded-lg p-3">
                            <span class="text-sm text-slate-600">ID</span>
                            <span class="font-semibold text-slate-800">#@categoriaId</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-50 rounded-lg p-3">
                            <span class="text-sm text-slate-600">Productos</span>
                            <span class="font-semibold text-emerald-600">@cantidadProductos</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-bolt text-amber-500"></i>Acciones Rápidas
                    </h3>
                    <div class="space-y-2">
                        <a asp-controller="AdminProductos" asp-action="Index" 
                           class="flex items-center gap-2 px-4 py-3 bg-slate-50 hover:bg-emerald-50 rounded-xl text-slate-600 hover:text-emerald-600 transition-all text-sm font-medium">
                            <i class="fas fa-gem"></i>Ver productos
                            <i class="fas fa-arrow-right ml-auto text-xs"></i>
                        </a>
                    </div>
                </div>

                @if(cantidadProductos > 0)
                {
                    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5"></i>
                            <div class="text-sm text-amber-700">
                                <p class="font-medium mb-1">Precaución</p>
                                <p>Esta categoría tiene @cantidadProductos producto(s) asociado(s).</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
