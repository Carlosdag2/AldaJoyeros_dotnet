@model IEnumerable<AldaJoyeros.DTOs.CategoriaDto>
@{
    ViewData["Title"] = "Gestión de Categorías";
    var totalCategorias = Model?.Count() ?? 0;
    var categoriasPersonalizadas = Model?.Count(c => c.Nombre != "Sin categoría") ?? 0;
    var totalProductos = ViewBag.TotalProductos ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors">
                    <i class="fas fa-home"></i>
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Categorías</span>
            </nav>
            
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-violet-400 to-violet-600 rounded-2xl flex items-center justify-center shadow-xl shadow-violet-500/25">
                        <i class="fas fa-tags text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-white">Gestión de Categorías</h1>
                        <p class="text-slate-400 text-sm mt-1">Organiza y administra las categorías de productos</p>
                    </div>
                </div>
                <a asp-action="Crear" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40">
                    <i class="fas fa-plus"></i>
                    Nueva Categoría
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 -mt-6 relative z-10 pb-12">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 hover:shadow-md transition-all">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-violet-400 to-violet-600 rounded-xl flex items-center justify-center shadow-lg shadow-violet-500/20">
                        <i class="fas fa-tags text-white"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-slate-800">@totalCategorias</div>
                        <div class="text-sm text-slate-500">Total Categorías</div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 hover:shadow-md transition-all">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20">
                        <i class="fas fa-check-circle text-white"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-slate-800">@categoriasPersonalizadas</div>
                        <div class="text-sm text-slate-500">Personalizadas</div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 hover:shadow-md transition-all">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20">
                        <i class="fas fa-gem text-white"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-slate-800">@totalProductos</div>
                        <div class="text-sm text-slate-500">Productos Totales</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Categories Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
                @foreach (var categoria in Model.OrderBy(c => c.Nombre == "Sin categoría" ? 1 : 0).ThenBy(c => c.Nombre))
                {
                    var isDefaultCategory = categoria.Nombre == "Sin categoría";
                    var nombreCategoria = categoria.Nombre.Replace("'", "\\'");
                    
                    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 hover:border-violet-200">
                        <!-- Header -->
                        <div class="@(isDefaultCategory ? "bg-gradient-to-br from-slate-600 to-slate-700" : "bg-gradient-to-br from-violet-500 to-purple-600") p-5 relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-20 h-20 bg-white/10 rounded-full -mr-10 -mt-10"></div>
                            
                            @if(isDefaultCategory)
                            {
                                <div class="absolute top-3 right-3">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-white/20 text-white">
                                        <i class="fas fa-lock mr-1 text-[10px]"></i>Sistema
                                    </span>
                                </div>
                            }
                            
                            <div class="relative flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center">
                                        <i class="fas @(isDefaultCategory ? "fa-folder" : "fa-tag") text-white text-xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-white text-lg">@categoria.Nombre</h3>
                                        <div class="text-white/70 text-sm">ID #@categoria.Id</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Body -->
                        <div class="p-5">
                            <div class="flex items-center justify-between mb-4 bg-gradient-to-r @(isDefaultCategory ? "from-slate-50 to-slate-100" : "from-violet-50 to-purple-50") rounded-xl p-4 border @(isDefaultCategory ? "border-slate-200" : "border-violet-200")">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 @(isDefaultCategory ? "bg-slate-500" : "bg-violet-500") rounded-lg flex items-center justify-center">
                                        <i class="fas fa-gem text-white text-xs"></i>
                                    </div>
                                    <span class="font-bold text-slate-800">@categoria.CantidadProductos</span>
                                </div>
                                <span class="text-sm text-slate-500">producto@(categoria.CantidadProductos != 1 ? "s" : "")</span>
                            </div>

                            @if(isDefaultCategory)
                            {
                                <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-sm text-amber-700">
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-info-circle mt-0.5 text-amber-500"></i>
                                        <span>Categoría del sistema para productos sin asignar.</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex gap-2">
                                    <a asp-action="Editar" asp-route-id="@categoria.Id" 
                                       class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-emerald-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                                        <i class="fas fa-edit"></i>Editar
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@categoria.Id" method="post" class="flex-1" 
                                          onsubmit="return confirm('@(categoria.CantidadProductos > 0 ? $"Esta categoría tiene {categoria.CantidadProductos} producto(s). Al eliminarla, los productos serán movidos a Sin categoría. ¿Continuar?" : $"¿Eliminar la categoría {nombreCategoria}?")');">
                                        <button type="submit" 
                                                class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-red-500 text-slate-600 hover:text-white rounded-xl transition-all font-medium text-sm">
                                            <i class="fas fa-trash"></i>Eliminar
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-100 mb-8">
                <div class="w-20 h-20 bg-gradient-to-br from-violet-100 to-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-tags text-violet-500 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">No hay categorías</h3>
                <p class="text-slate-500 mb-6">Crea tu primera categoría para organizar los productos</p>
                <a asp-action="Crear" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl hover:shadow-lg transition-all">
                    <i class="fas fa-plus"></i>
                    Crear Primera Categoría
                </a>
            </div>
        }

        <!-- Info Banner -->
        <div class="bg-gradient-to-r from-violet-50 to-purple-50 border-l-4 border-violet-500 rounded-r-xl p-5 mb-8">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-violet-500 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-lightbulb text-white"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-slate-800 mb-1">Consejo</h3>
                    <p class="text-sm text-slate-600">Las categorías ayudan a organizar tu catálogo. Al eliminar una, los productos se moverán a "Sin categoría".</p>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Admin" asp-action="Index" 
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>
                Volver al Panel
            </a>
            <a asp-controller="AdminProductos" asp-action="Index" 
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-emerald-300 hover:text-emerald-600 rounded-xl transition-all font-medium">
                <i class="fas fa-gem"></i>
                Ver Productos
            </a>
        </div>
    </div>
</div>
