@model IEnumerable<AldaJoyeros.DTOs.CategoriaDto>
@{
ViewData["Title"] = "Gestión de Categorías";
var categorias = (Model ?? Enumerable.Empty<AldaJoyeros.DTOs.CategoriaDto>()).ToList();
var grupos = categorias.GroupBy(c => c.Grupo).OrderBy(g => AldaJoyeros.Catalog.CatalogTaxonomy.GroupOrder(g.Key)).ToList();
}
<partial name="_AdminConfirmModal" />
<main class="admin-workspace admin-categories min-h-[70vh] bg-slate-50 px-4 py-6 pb-10 text-slate-800 md:px-6 md:py-8 md:pb-14 [&_[hidden]]:!hidden" data-admin-list="categorias"><div class="admin-shell mx-auto max-w-7xl">
<div class="admin-breadcrumb mb-5 flex items-center gap-2 text-xs text-slate-500 [&_a:hover]:text-green-800"><a asp-controller="Admin" asp-action="Index">Panel de administración</a><span aria-hidden="true">/</span><span>Categorías</span></div><header class="admin-heading mb-6 flex flex-col items-start justify-between gap-4 md:flex-row md:items-center [&_h1]:mb-1.5 [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:tracking-tight md:[&_h1]:text-3xl [&_p]:text-sm [&_p]:text-slate-500"><div><h1>Categorías</h1><p>Organiza el catálogo por familias y encuentra cada categoría de un vistazo.</p></div><a asp-action="Crear" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-green-800 bg-green-800 text-white hover:border-green-900 hover:bg-green-900"><i class="fas fa-plus" aria-hidden="true"></i>Nueva categoría</a></header>
<div class="admin-stats mb-6 grid grid-cols-2 gap-3 md:grid-cols-[repeat(auto-fit,minmax(145px,1fr))]">
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Categorías</span><strong >@categorias.Count</strong></div>
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Grupos del catálogo</span><strong >@grupos.Count</strong></div>
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Productos visibles</span><strong >@ViewBag.TotalProductos</strong></div>
<div class="admin-stat rounded-xl border border-slate-200 bg-white p-4 md:p-5 [&_span]:mb-1.5 [&_span]:block [&_span]:text-xs [&_span]:text-slate-500 [&_strong]:text-2xl [&_strong]:font-bold"><span>Categorías sin productos</span><strong >@categorias.Count(c => c.CantidadProductos == 0)</strong></div>
</div>
<div class="admin-toolbar mb-5 rounded-xl border border-slate-200 bg-white p-4 md:p-5"><form class="admin-search flex flex-wrap items-end gap-2.5 [&>button]:flex-1 md:[&>button]:flex-none" data-admin-search>
<div class="admin-field min-w-full flex-1 md:min-w-[180px] [&_label]:mb-1.5 [&_label]:block [&_label]:text-xs [&_label]:font-semibold [&_label]:text-slate-600"><label for="buscarCategorias">Buscar categoría</label><input id="buscarCategorias" name="busqueda" type="search" placeholder="Escribe el nombre de la categoría" / class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400"></div>
<div class="admin-field min-w-full flex-1 md:min-w-[180px] [&_label]:mb-1.5 [&_label]:block [&_label]:text-xs [&_label]:font-semibold [&_label]:text-slate-600"><label for="grupoCategorias">Grupo del catálogo</label><select id="grupoCategorias" name="grupo" class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400"><option value="">Todos los grupos</option>@foreach(var grupo in grupos) { <option value="@grupo.Key">@grupo.Key</option> }</select></div>
<button class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100" type="button" data-clear-search>Limpiar filtros</button>
</form></div>
<p class="admin-status my-2 min-h-5 text-xs text-slate-500" data-admin-status role="status" aria-live="polite"></p>
@foreach (var grupo in grupos)
{
<details open class="admin-list admin-category-group overflow-hidden rounded-xl border border-slate-200 bg-white group mb-5" data-category-group="@grupo.Key">
<summary class="flex cursor-pointer list-none items-center gap-3 bg-slate-50 px-4 py-4 text-sm font-semibold md:px-5 [&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400">@grupo.Key <span class="mr-auto text-xs font-normal text-slate-500" data-group-count>@grupo.Count() categorías</span><span aria-hidden="true" class="text-slate-500 group-open:hidden">+</span><span aria-hidden="true" class="hidden text-slate-500 group-open:block">−</span></summary>
@foreach (var categoria in grupo.OrderBy(c => c.Nombre))
{
var predeterminada = categoria.Nombre == "Sin categoría";
<div class="admin-row categoria-card grid-cols-[minmax(0,1fr)_auto] md:grid-cols-[minmax(0,1fr)_110px_205px] grid min-w-0 items-center gap-3.5 border-b border-slate-100 p-4 text-sm last:border-b-0 hover:bg-slate-50 md:gap-5 md:px-5" data-categoria-id="@categoria.Id" data-nombre="@categoria.Nombre">
<div class="admin-identity flex min-w-0 items-center gap-3 [&>div]:min-w-0"><span class="admin-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500"><i class="fas fa-tag" aria-hidden="true"></i></span><div><span class="admin-name block font-semibold [overflow-wrap:anywhere]">@categoria.Nombre</span><span class="admin-sub mt-1 block text-xs text-slate-500 [overflow-wrap:anywhere]">@(predeterminada ? "Categoría del sistema" : "Categoría #" + categoria.Id)</span></div></div>
<div><span class="admin-mobile-label mb-1 block text-[11px] text-slate-500 md:hidden">Productos</span><span class="admin-badge bg-slate-100 text-slate-600 inline-flex w-fit items-center gap-1.5 rounded-md px-2 py-1 text-[11px] font-semibold">@categoria.CantidadProductos productos</span></div>
<div class="admin-actions col-span-2 justify-start md:col-span-1 md:justify-end flex flex-wrap gap-1.5">
@if (predeterminada)
{ <span class="admin-badge bg-slate-100 text-slate-600 inline-flex w-fit items-center gap-1.5 rounded-md px-2 py-1 text-[11px] font-semibold"><i class="fas fa-lock" aria-hidden="true"></i>Protegida</span> }
else
{
<a asp-action="Editar" asp-route-id="@categoria.Id" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100"><i class="fas fa-pen" aria-hidden="true"></i>Editar</a>
<button type="button" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-transparent bg-transparent text-red-700 hover:border-red-200 hover:bg-red-50" data-delete-category="@categoria.Id" data-nombre="@categoria.Nombre" data-productos="@categoria.CantidadProductos" aria-label="Eliminar categoría @categoria.Nombre"><i class="fas fa-trash-alt" aria-hidden="true"></i>Eliminar</button>
}
</div></div>
}
</details>
}
<div class="admin-empty rounded-xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center text-slate-500 [&_h2]:mb-1.5 [&_h2]:mt-2.5 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-slate-700" data-no-results hidden><i class="fas fa-tags" aria-hidden="true"></i><h2>No hay categorías que coincidan</h2><p>Prueba otro nombre o selecciona otro grupo.</p></div>
<p class="admin-note my-5 text-sm leading-relaxed text-slate-500"><i class="fas fa-info-circle" aria-hidden="true"></i> Al eliminar una categoría, sus productos pasan a «Sin categoría». Los contadores muestran los productos visibles de la tienda.</p>
<div class="admin-actions flex flex-wrap justify-start gap-1.5"><a asp-controller="Admin" asp-action="Index" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100"><i class="fas fa-arrow-left" aria-hidden="true"></i>Volver al panel</a><a asp-controller="AdminProductos" asp-action="Index" class="admin-btn inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400 border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-100">Ver productos</a></div>
</div></main>
@section Scripts {
    <script>
        const adminCategorias = {
            // Eliminar categoría
            async eliminar(id, nombre, cantidadProductos) {
                const mensaje = cantidadProductos > 0
                    ? `"${nombre}" tiene ${cantidadProductos} producto(s). Al eliminarla, serán movidos a "Sin categoría".`
                    : `¿Eliminar la categoría "${nombre}"?`;

                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar categoría?',
                    message: mensaje,
                    type: cantidadProductos > 0 ? 'warning' : 'danger',
                    confirmText: 'Eliminar'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminCategorias/EliminarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.animarCategoriaEliminada(id);
                        AldaToast.success(data.message);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Animar categoría al eliminarla
            animarCategoriaEliminada(id) {
                const card = document.querySelector(`[data-categoria-id="${id}"]`);
                if (card) {
                    card.style.transition = 'all 0.4s ease';
                    card.style.transform = 'scale(0.9)';
                    card.style.opacity = '0';
                    setTimeout(() => {
                        card.remove();
                        // Recargar para actualizar contadores
                        setTimeout(() => location.reload(), 300);
                    }, 400);
                }
            }
        };

        window.adminCategorias = adminCategorias;
    </script>
    <script src="~/js/admin-listas.js" asp-append-version="true"></script>
}
