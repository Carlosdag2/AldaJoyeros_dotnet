@model IEnumerable<AldaJoyeros.DTOs.CategoriaDto>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">
            <i class="fas fa-tags text-purple-600"></i> Gestión de Categorías
        </h1>
        <p class="text-gray-600">Administra las categorías de productos</p>
    </div>
    <a asp-action="Crear" 
       class="inline-flex items-center gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
        <i class="fas fa-plus-circle mr-2"></i>
        Nueva Categoría
    </a>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-tags text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">@(Model?.Count() ?? 0)</div>
                <div class="text-sm text-gray-600">Total Categorías</div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-check-circle text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">@(Model?.Count() ?? 0)</div>
                <div class="text-sm text-gray-600">Activas</div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mr-4">
                <i class="fas fa-gem text-white text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-gray-900">@ViewBag.TotalProductos</div>
                <div class="text-sm text-gray-600">Productos Totales</div>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var categoria in Model)
        {
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden">
                <div class="bg-gradient-to-br from-purple-500 to-pink-500 p-6 text-white">
                    <div class="flex items-center justify-between mb-4">
                        <i class="fas fa-tag text-5xl opacity-20"></i>
                        <div class="text-right">
                            <div class="text-sm opacity-80">ID</div>
                            <div class="text-2xl font-bold">#@categoria.Id</div>
                        </div>
                    </div>
                    <h3 class="font-display text-2xl font-bold">@categoria.Nombre</h3>
                </div>

                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="text-sm text-gray-600">
                            <i class="fas fa-gem mr-2"></i>
                            <span class="font-semibold">@categoria.CantidadProductos producto@(categoria.CantidadProductos != 1 ? "s" : "")</span>
                        </div>
                        <div class="flex items-center space-x-1">
                            <i class="fas fa-star text-yellow-500"></i>
                            <i class="fas fa-star text-yellow-500"></i>
                            <i class="fas fa-star text-yellow-500"></i>
                            <i class="fas fa-star text-yellow-500"></i>
                            <i class="fas fa-star text-gray-300"></i>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <a asp-action="Editar" asp-route-id="@categoria.Id" 
                           class="flex-1 flex items-center justify-center px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-all duration-200 font-medium">
                            <i class="fas fa-edit mr-2"></i>Editar
                        </a>
                        <form asp-action="Eliminar" asp-route-id="@categoria.Id" method="post" class="flex-1" 
                              onsubmit="return confirm('¿Estás seguro de eliminar esta categoría?')">
                            <button type="submit" 
                                    class="w-full flex items-center justify-center px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-all duration-200 font-medium">
                                <i class="fas fa-trash mr-2"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-white rounded-3xl p-12 text-center shadow-lg">
        <i class="fas fa-tags text-gray-300 text-6xl mb-4"></i>
        <h3 class="font-display text-2xl font-bold text-gray-700 mb-2">No hay categorías registradas</h3>
        <p class="text-gray-500 mb-6">Comienza creando tu primera categoría de productos</p>
        <a asp-action="Crear" 
           class="inline-flex items-center gradient-gold text-gray-900 px-6 py-3 rounded-lg font-semibold hover:shadow-xl transition-all duration-200">
            <i class="fas fa-plus-circle mr-2"></i>
            Crear Primera Categoría
        </a>
    </div>
}

<!-- Back Button -->
<div class="mt-8">
    <a asp-controller="Admin" asp-action="Index" 
       class="inline-flex items-center text-gray-600 hover:text-gray-900 font-medium group">
        <i class="fas fa-arrow-left mr-2 group-hover:-translate-x-2 transition-transform"></i>
        Volver al Panel
    </a>
</div>
