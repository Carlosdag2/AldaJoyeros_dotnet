@model AldaJoyeros.DTOs.CategoriaCreateDto

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container mx-auto px-6 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-plus-circle text-white text-2xl"></i>
            </div>
            Nueva Categoría
        </h1>
        <p class="text-gray-600 text-lg">Crea una nueva categoría para organizar tus productos</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Form -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
                <form asp-action="Crear" method="post" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl mb-6">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                            <span class="text-red-800 text-sm"></span>
                        </div>
                    </div>

                    <!-- Nombre Field -->
                    <div>
                        <label asp-for="Nombre" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                            <div class="w-6 h-6 bg-purple-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-tag text-purple-600 text-xs"></i>
                            </div>
                            Nombre de la Categoría
                        </label>
                        <input asp-for="Nombre" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all duration-200 text-lg outline-none"
                               placeholder="Ej: Anillos, Collares, Pulseras..." />
                        <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                        <p class="text-gray-500 text-xs mt-2 flex items-center gap-1">
                            <i class="fas fa-info-circle"></i>
                            El nombre debe ser único y descriptivo
                        </p>
                    </div>

                    <!-- Preview Card -->
                    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-200">
                        <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center">
                                <i class="fas fa-eye text-white"></i>
                            </div>
                            Vista Previa
                        </h3>
                        <div class="bg-white rounded-xl p-5 shadow-md">
                            <div class="flex items-center">
                                <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center mr-4 shadow-lg">
                                    <i class="fas fa-tag text-white text-2xl"></i>
                                </div>
                                <div>
                                    <div class="font-bold text-gray-900 text-lg" id="preview-nombre">Nueva Categoría</div>
                                    <div class="text-sm text-gray-600 flex items-center gap-1 mt-1">
                                        <i class="fas fa-gem text-emerald-600"></i>
                                        <span>0 productos</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200" />

                    <!-- Actions -->
                    <div class="flex flex-col sm:flex-row justify-between gap-4">
                        <a asp-action="Index" 
                           class="inline-flex items-center justify-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all duration-200 font-semibold">
                            <i class="fas fa-times mr-2"></i>
                            Cancelar
                        </a>
                        <button type="submit" 
                                class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                            <i class="fas fa-save mr-2"></i>
                            Guardar Categoría
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Tips -->
            <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center">
                        <i class="fas fa-lightbulb text-white"></i>
                    </div>
                    Consejos
                </h3>
                <ul class="space-y-3 text-sm text-gray-700">
                    <li class="flex items-start gap-2">
                        <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        <span>Usa nombres claros y concisos</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        <span>Evita categorías muy similares</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        <span>Piensa en la experiencia del usuario</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        <span>Agrupa productos relacionados</span>
                    </li>
                </ul>
            </div>

            <!-- Examples -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-list text-purple-600"></i>
                    </div>
                    Ejemplos
                </h3>
                <div class="space-y-2">
                    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 text-sm border border-purple-200 hover:border-purple-400 transition-colors">
                        <i class="fas fa-tag text-purple-600 mr-2"></i>
                        <span class="font-medium">Anillos</span>
                    </div>
                    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 text-sm border border-purple-200 hover:border-purple-400 transition-colors">
                        <i class="fas fa-tag text-purple-600 mr-2"></i>
                        <span class="font-medium">Collares</span>
                    </div>
                    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 text-sm border border-purple-200 hover:border-purple-400 transition-colors">
                        <i class="fas fa-tag text-purple-600 mr-2"></i>
                        <span class="font-medium">Pulseras</span>
                    </div>
                    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 text-sm border border-purple-200 hover:border-purple-400 transition-colors">
                        <i class="fas fa-tag text-purple-600 mr-2"></i>
                        <span class="font-medium">Pendientes</span>
                    </div>
                </div>
            </div>

            <!-- Help -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-200">
                <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
                    <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center">
                        <i class="fas fa-question-circle text-white"></i>
                    </div>
                    ¿Necesitas ayuda?
                </h3>
                <p class="text-sm text-gray-700 leading-relaxed">
                    Si tienes dudas sobre cómo crear categorías efectivas, contacta con soporte.
                </p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Smooth animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .lg\:col-span-2 > div, .lg\:col-span-1 > div {
            animation: fadeInUp 0.6s ease-out;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview
        document.querySelector('input[name="Nombre"]')?.addEventListener('input', function(e) {
            document.getElementById('preview-nombre').textContent = e.target.value || 'Nueva Categoría';
        });
    </script>
}
