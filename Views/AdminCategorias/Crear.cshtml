@model AldaJoyeros.DTOs.CategoriaCreateDto
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" class="hover:text-white transition-colors">Categorías</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Nueva</span>
            </nav>
            
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-2xl flex items-center justify-center shadow-xl shadow-emerald-500/25">
                    <i class="fas fa-plus text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white">Nueva Categoría</h1>
                    <p class="text-slate-400 text-sm mt-1">Crea una nueva categoría para organizar productos</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-6 border-b border-slate-100">
                        <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i class="fas fa-edit text-violet-500"></i>
                            Información de la Categoría
                        </h2>
                    </div>
                    
                    <form asp-action="Crear" method="post" class="p-6 space-y-6">
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg text-red-700 text-sm"></div>

                        <div>
                            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 mb-2">
                                Nombre de la Categoría *
                            </label>
                            <input asp-for="Nombre" 
                                   class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none"
                                   placeholder="Ej: Anillos, Collares, Pulseras..." />
                            <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Preview -->
                        <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-xl p-5 border border-violet-200">
                            <h3 class="font-medium text-slate-700 mb-3 flex items-center gap-2">
                                <i class="fas fa-eye text-violet-500"></i>Vista Previa
                            </h3>
                            <div class="bg-white rounded-lg p-4 shadow-sm flex items-center gap-3">
                                <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center">
                                    <i class="fas fa-tag text-white"></i>
                                </div>
                                <div>
                                    <div class="font-semibold text-slate-800" id="preview-nombre">Nueva Categoría</div>
                                    <div class="text-sm text-slate-500">0 productos</div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4 border-t border-slate-100">
                            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 transition-all font-medium">
                                <i class="fas fa-times"></i>Cancelar
                            </a>
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl font-semibold shadow-lg shadow-emerald-500/25 transition-all">
                                <i class="fas fa-save"></i>Guardar Categoría
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-lightbulb text-amber-500"></i>Consejos
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-600">
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Usa nombres claros y concisos</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Evita categorías muy similares</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Agrupa productos relacionados</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl p-5 border border-violet-200">
                    <h3 class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-list text-violet-500"></i>Ejemplos
                    </h3>
                    <div class="space-y-2">
                        <div class="bg-white/80 rounded-lg px-3 py-2 text-sm text-slate-600">
                            <i class="fas fa-tag text-violet-400 mr-2"></i>Anillos
                        </div>
                        <div class="bg-white/80 rounded-lg px-3 py-2 text-sm text-slate-600">
                            <i class="fas fa-tag text-violet-400 mr-2"></i>Collares
                        </div>
                        <div class="bg-white/80 rounded-lg px-3 py-2 text-sm text-slate-600">
                            <i class="fas fa-tag text-violet-400 mr-2"></i>Pendientes
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[name="Nombre"]')?.addEventListener('input', function(e) {
            document.getElementById('preview-nombre').textContent = e.target.value || 'Nueva Categoría';
        });
    </script>
}
