@model AldaJoyeros.DTOs.PedidoDto

@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
    var totalItems = Model.LineasPedido.Sum(x => x.Cantidad);
    
    var (statusBg, statusText, statusIcon, statusLabel) = Model.Estado switch
    {
        "PENDIENTE" => ("bg-amber-100", "text-amber-700", "fa-clock", "Pendiente"),
        "EN_PROCESO" => ("bg-blue-100", "text-blue-700", "fa-sync-alt", "En proceso"),
        "ENVIADO" => ("bg-purple-100", "text-purple-700", "fa-truck", "Enviado"),
        "ENTREGADO" => ("bg-emerald-100", "text-emerald-700", "fa-check-circle", "Entregado"),
        "CANCELADO" => ("bg-red-100", "text-red-700", "fa-times-circle", "Cancelado"),
        _ => ("bg-gray-100", "text-gray-700", "fa-circle", Model.Estado ?? "")
    };
}

<!-- Header -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 py-10">
    <div class="container mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">
                <i class="fas fa-home"></i>
            </a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <a asp-action="Index" class="hover:text-white transition-colors">Mis Pedidos</a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <span class="text-emerald-400">#@Model.Id</span>
        </nav>
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white">Pedido #@Model.Id</h1>
                <p class="text-gray-400 mt-1">
                    <i class="fas fa-calendar-alt mr-1"></i>
                    @Model.Fecha?.ToString("dd MMM yyyy, HH:mm")
                </p>
            </div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold @statusBg @statusText">
                <i class="fas @statusIcon"></i>
                @statusLabel
            </span>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Products -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <h2 class="font-bold text-gray-900 flex items-center gap-2">
                            <i class="fas fa-shopping-bag text-emerald-500"></i>
                            Productos (@totalItems)
                        </h2>
                    </div>
                    <div class="divide-y divide-gray-100">
                        @foreach (var linea in Model.LineasPedido)
                        {
                            <div class="p-4 flex items-center gap-4">
                                <div class="relative flex-shrink-0">
                                    <div class="w-16 h-16 bg-gray-100 rounded-lg overflow-hidden">
                                        @if (linea.Producto?.TieneImagenes == true)
                                        {
                                            <img src="@linea.Producto.ImagenPrincipal" alt="@linea.ProductoNombre" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="fas fa-gem text-gray-300"></i>
                                            </div>
                                        }
                                    </div>
                                    @if (linea.Cantidad > 1)
                                    {
                                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-gray-700 text-white text-xs rounded-full flex items-center justify-center">
                                            @linea.Cantidad
                                        </span>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-medium text-gray-900">@linea.ProductoNombre</div>
                                    <div class="text-sm text-gray-500">
                                        @linea.Precio.ToString("C") × @linea.Cantidad
                                    </div>
                                </div>
                                <div class="font-bold text-gray-900">@linea.Subtotal.ToString("C")</div>
                            </div>
                        }
                    </div>
                    <!-- Total -->
                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                        <div class="flex justify-between items-center">
                            <span class="font-medium text-gray-700">Total del pedido</span>
                            <span class="text-2xl font-bold text-emerald-600">@Model.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>

                <!-- Order Timeline -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <h2 class="font-bold text-gray-900 flex items-center gap-2">
                            <i class="fas fa-clock text-emerald-500"></i>
                            Estado del pedido
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="relative">
                            @{
                                var steps = new[] { 
                                    ("Pedido confirmado", "fa-clipboard-check", true),
                                    ("En preparación", "fa-box", Model.Estado != "PENDIENTE" && Model.Estado != "CANCELADO"),
                                    ("Enviado", "fa-truck", Model.Estado == "ENVIADO" || Model.Estado == "ENTREGADO"),
                                    ("Entregado", "fa-check-circle", Model.Estado == "ENTREGADO")
                                };
                            }
                            
                            <div class="flex items-center justify-between relative">
                                <!-- Progress line -->
                                <div class="absolute top-4 left-0 right-0 h-0.5 bg-gray-200"></div>
                                @{
                                    var completedSteps = steps.Count(s => s.Item3);
                                    var progressWidth = completedSteps > 0 ? ((completedSteps - 1) * 100 / (steps.Length - 1)) : 0;
                                }
                                <div class="absolute top-4 left-0 h-0.5 bg-emerald-500 transition-all" style="width: @(progressWidth)%"></div>
                                
                                @foreach (var (label, icon, completed) in steps)
                                {
                                    <div class="relative flex flex-col items-center">
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center z-10 @(completed ? "bg-emerald-500 text-white" : "bg-gray-200 text-gray-400")">
                                            <i class="fas @icon text-sm"></i>
                                        </div>
                                        <span class="text-xs mt-2 text-center @(completed ? "text-gray-900 font-medium" : "text-gray-400")">@label</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div class="text-center p-3 bg-gray-50 rounded-lg">
                                <div class="text-xs text-gray-500 mb-1">Fecha de pedido</div>
                                <div class="font-medium text-gray-900">@Model.Fecha?.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="text-center p-3 bg-gray-50 rounded-lg">
                                <div class="text-xs text-gray-500 mb-1">Entrega estimada</div>
                                <div class="font-medium text-gray-900">
                                    @(Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "3-5 días")
                                </div>
                            </div>
                            @if (Model.FechaEntregaReal.HasValue)
                            {
                                <div class="text-center p-3 bg-emerald-50 rounded-lg">
                                    <div class="text-xs text-emerald-600 mb-1">Entregado</div>
                                    <div class="font-medium text-emerald-700">@Model.FechaEntregaReal?.ToString("dd/MM/yyyy")</div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center p-3 bg-gray-50 rounded-lg">
                                    <div class="text-xs text-gray-500 mb-1">Entregado</div>
                                    <div class="font-medium text-gray-400">Pendiente</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Shipping Address -->
                @if (Model.Direccion != null)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <h3 class="font-bold text-gray-900 flex items-center gap-2 mb-4">
                            <i class="fas fa-map-marker-alt text-emerald-500"></i>
                            Dirección de envío
                        </h3>
                        <div class="text-sm">
                            <div class="font-medium text-gray-900">
                                @Model.Direccion.Calle, @Model.Direccion.Numero
                                @if (!string.IsNullOrEmpty(Model.Direccion.Piso))
                                {
                                    <span>- @Model.Direccion.Piso</span>
                                }
                            </div>
                            <div class="text-gray-500 mt-1">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad</div>
                            <div class="text-gray-500">@Model.Direccion.Provincia</div>
                        </div>
                    </div>
                }

                <!-- Help -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="font-bold text-gray-900 flex items-center gap-2 mb-3">
                        <i class="fas fa-question-circle text-emerald-500"></i>
                        ¿Necesitas ayuda?
                    </h3>
                    <p class="text-sm text-gray-500 mb-4">
                        Si tienes alguna pregunta sobre tu pedido, contacta con nosotros
                    </p>
                    <a href="tel:+34925541227" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-medium text-sm">
                        <i class="fas fa-phone"></i>
                        925 54 12 27
                    </a>
                </div>

                <!-- Actions -->
                <div class="space-y-3">
                    <!-- Factura -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <h3 class="font-bold text-gray-900 flex items-center gap-2 mb-4">
                            <i class="fas fa-file-invoice text-emerald-500"></i>
                            Factura
                        </h3>
                        <div class="space-y-2">
                            <a href="/Pedidos/@Model.Id/Factura" 
                               class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium text-sm transition-colors">
                                <i class="fas fa-download"></i>
                                <span>Descargar PDF</span>
                            </a>
                            <button type="button" 
                                    id="btnEnviarFactura"
                                    onclick="enviarFactura(@Model.Id)"
                                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 border border-emerald-500 text-emerald-600 hover:bg-emerald-50 rounded-lg font-medium text-sm transition-colors">
                                <i class="fas fa-envelope"></i>
                                <span>Enviar por email</span>
                            </button>
                        </div>
                    </div>

                    <a asp-action="Index" 
                       class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 border border-gray-200 text-gray-700 rounded-xl font-medium hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver a pedidos</span>
                    </a>
                    <a asp-controller="Productos" asp-action="Index" 
                       class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-medium transition-colors">
                        <i class="fas fa-shopping-bag"></i>
                        <span>Seguir comprando</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function enviarFactura(pedidoId) {
            const btn = document.getElementById('btnEnviarFactura');
            const originalHtml = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Enviando...</span>';
            
            try {
                const response = await fetch(`/Pedidos/${pedidoId}/EnviarFactura`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i> <span class="text-emerald-600">¡Enviada!</span>';
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }, 3000);
                } else {
                    btn.innerHTML = '<i class="fas fa-times text-red-500"></i> <span class="text-red-600">Error</span>';
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }, 3000);
                }
            } catch (error) {
                console.error('Error:', error);
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }
    </script>
}
