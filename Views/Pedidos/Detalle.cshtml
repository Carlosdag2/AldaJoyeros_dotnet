@model AldaJoyeros.DTOs.PedidoDto

@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<div class="container mx-auto px-6 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li><a asp-controller="Home" asp-action="Index" class="hover:text-emerald-600 transition-colors">Inicio</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li><a asp-action="Index" class="hover:text-emerald-600 transition-colors">Mis Pedidos</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li class="text-gray-900 font-semibold">Pedido #@Model.Id</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-emerald-900 rounded-3xl p-8 mb-8 text-white shadow-2xl relative overflow-hidden">
        <!-- Decorative Elements -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-700 rounded-full opacity-20 -mr-32 -mt-32"></div>
        
        <div class="relative flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="font-serif text-4xl font-bold mb-3 flex items-center gap-3">
                    <div class="w-14 h-14 bg-emerald-500 rounded-2xl flex items-center justify-center shadow-lg">
                        <i class="fas fa-box text-white text-2xl"></i>
                    </div>
                    Pedido #@Model.Id
                </h1>
                <p class="text-emerald-200 flex items-center gap-2 text-lg">
                    <i class="fas fa-calendar-alt"></i>
                    Realizado el @Model.Fecha?.ToString("dd/MM/yyyy 'a las' HH:mm")
                </p>
            </div>
            <div class="text-right">
                @switch (Model.Estado)
                {
                    case "PENDIENTE":
                        <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-yellow-500 text-white shadow-lg">
                            <i class="fas fa-clock mr-2"></i> Pendiente
                        </span>
                        break;
                    case "EN_PROCESO":
                        <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-blue-500 text-white shadow-lg">
                            <i class="fas fa-sync-alt mr-2 animate-spin"></i> En Proceso
                        </span>
                        break;
                    case "ENVIADO":
                        <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-purple-500 text-white shadow-lg">
                            <i class="fas fa-shipping-fast mr-2"></i> Enviado
                        </span>
                        break;
                    case "ENTREGADO":
                        <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-green-500 text-white shadow-lg">
                            <i class="fas fa-check-circle mr-2"></i> Entregado
                        </span>
                        break;
                    case "CANCELADO":
                        <span class="inline-flex items-center px-6 py-3 rounded-xl text-lg font-bold bg-red-500 text-white shadow-lg">
                            <i class="fas fa-times-circle mr-2"></i> Cancelado
                        </span>
                        break;
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Order Info -->
            <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
                <h2 class="font-serif text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-info-circle text-blue-600"></i>
                    </div>
                    Información del Pedido
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100">
                        <div class="text-sm text-gray-600 mb-2 font-semibold">Fecha de Pedido</div>
                        <div class="font-bold text-gray-900 text-lg">@Model.Fecha?.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-5 border border-green-100">
                        <div class="text-sm text-gray-600 mb-2 font-semibold">Estado</div>
                        <div class="font-bold text-gray-900 text-lg">@Model.Estado</div>
                    </div>
                    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-5 border border-purple-100">
                        <div class="text-sm text-gray-600 mb-2 font-semibold">Entrega Estimada</div>
                        <div class="font-bold text-gray-900 text-lg">@Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</div>
                    </div>
                    @if (Model.FechaEntregaReal.HasValue)
                    {
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-5 border border-green-100">
                            <div class="text-sm text-gray-600 mb-2 font-semibold">Fecha de Entrega</div>
                            <div class="font-bold text-green-700 text-lg flex items-center gap-2">
                                <i class="fas fa-check-circle"></i>
                                @Model.FechaEntregaReal?.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Products -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
                <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 p-6">
                    <h2 class="font-serif text-2xl font-bold text-white flex items-center gap-2">
                        <i class="fas fa-shopping-bag"></i>
                        Productos del Pedido
                    </h2>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        @foreach (var linea in Model.LineasPedido)
                        {
                            <div class="flex items-center gap-4 bg-gradient-to-r from-gray-50 to-emerald-50 rounded-xl p-5 hover:shadow-md transition-all duration-200 border border-gray-100">
                                <!-- Product Image -->
                                <div class="w-24 h-24 bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl overflow-hidden flex items-center justify-center flex-shrink-0 shadow-md">
                                    @if (linea.Producto?.TieneImagenes == true)
                                    {
                                        <img src="@linea.Producto.ImagenPrincipal" 
                                             alt="@linea.ProductoNombre" 
                                             class="w-full h-full object-cover hover:scale-110 transition-transform duration-300"
                                             onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'fas fa-gem text-3xl text-emerald-600\'></i>';" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-gem text-3xl text-emerald-600"></i>
                                    }
                                </div>
                                <!-- Product Info -->
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-gray-900 mb-2 text-lg">@linea.ProductoNombre</h3>
                                    <div class="flex flex-wrap items-center gap-2 text-sm">
                                        <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full font-semibold">
                                            <i class="fas fa-cubes mr-1"></i>
                                            @linea.Cantidad unidades
                                        </span>
                                        <span class="text-gray-400">•</span>
                                        <span class="text-gray-600 font-semibold">
                                            @linea.Precio.ToString("C") / unidad
                                        </span>
                                    </div>
                                </div>
                                <!-- Subtotal -->
                                <div class="text-right">
                                    <div class="text-xs text-gray-500 mb-1">Subtotal</div>
                                    <div class="text-2xl font-bold text-emerald-600">@linea.Subtotal.ToString("C")</div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Total -->
                    <div class="mt-6 pt-6 border-t-2 border-emerald-200">
                        <div class="flex justify-between items-center bg-gradient-to-r from-emerald-50 to-green-50 rounded-xl p-5">
                            <span class="text-2xl font-bold text-gray-900">Total del Pedido:</span>
                            <span class="text-4xl font-bold text-emerald-600">@Model.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Shipping Address -->
            <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24 border border-gray-100">
                <h2 class="font-serif text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-map-marker-alt text-red-600"></i>
                    </div>
                    Dirección de Envío
                </h2>
                @if (Model.Direccion != null)
                {
                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-200">
                        <address class="not-italic text-gray-700">
                            <div class="flex items-start gap-3 mb-3">
                                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-home text-white"></i>
                                </div>
                                <div>
                                    <div class="font-bold text-gray-900 text-lg mb-1">
                                        @Model.Direccion.Calle, @Model.Direccion.Numero
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.Direccion.Piso))
                                    {
                                        <div class="text-gray-700 text-sm">@Model.Direccion.Piso</div>
                                    }
                                </div>
                            </div>
                            <div class="ml-13 space-y-2">
                                <div class="flex items-center gap-2 text-sm">
                                    <i class="fas fa-map-pin text-blue-600 w-4"></i>
                                    <span>@Model.Direccion.CodigoPostal - @Model.Direccion.Ciudad</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm">
                                    <i class="fas fa-map text-blue-600 w-4"></i>
                                    <span>@Model.Direccion.Provincia</span>
                                </div>
                            </div>
                        </address>
                    </div>
                }
            </div>

            <!-- Tracking Info -->
            @if (Model.Estado == "ENVIADO" || Model.Estado == "ENTREGADO")
            {
                <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-200">
                    <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-truck text-purple-600"></i>
                        Estado del Envío
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-check-circle text-green-600 text-xl"></i>
                            <span class="text-sm font-semibold">Pedido confirmado</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <i class="fas fa-check-circle text-green-600 text-xl"></i>
                            <span class="text-sm font-semibold">En preparación</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <i class="fas fa-check-circle text-green-600 text-xl"></i>
                            <span class="text-sm font-semibold">Enviado</span>
                        </div>
                        @if (Model.Estado == "ENTREGADO")
                        {
                            <div class="flex items-center gap-3">
                                <i class="fas fa-check-circle text-green-600 text-xl"></i>
                                <span class="text-sm font-bold text-green-700">Entregado</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Help -->
            <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
                <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
                    <i class="fas fa-headset text-emerald-600"></i>
                    ¿Necesitas ayuda?
                </h3>
                <p class="text-sm text-gray-700 mb-4 leading-relaxed">
                    Si tienes alguna pregunta sobre tu pedido, estamos aquí para ayudarte
                </p>
                <a href="#" class="text-emerald-600 hover:text-emerald-700 font-semibold text-sm flex items-center group">
                    Contactar soporte
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-8">
        <a asp-action="Index" 
           class="inline-flex items-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all duration-200 font-semibold">
            <i class="fas fa-arrow-left mr-2"></i>
            Volver a Mis Pedidos
        </a>
    </div>
</div>

@section Styles {
    <style>
        /* Smooth animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .space-y-8 > div, .space-y-6 > div {
            animation: fadeInUp 0.6s ease-out;
            animation-fill-mode: both;
        }

        .space-y-8 > div:nth-child(1) { animation-delay: 0.1s; }
        .space-y-8 > div:nth-child(2) { animation-delay: 0.2s; }
        
        /* Hover effect for product images */
        .space-y-4 > div:hover img {
            transform: scale(1.1);
        }
    </style>
}
