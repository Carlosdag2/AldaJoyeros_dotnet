@model AldaJoyeros.DTOs.PedidoDto
@using AldaJoyeros.Helpers
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
    var estado = PedidoPresentacion.Desde(Model.Estado);
    var totalItems = Model.LineasPedido.Sum(x => x.Cantidad);
    var pasos = new[] { ("Recibido", "fa-clipboard-check"), ("En preparación", "fa-box"), ("Enviado", "fa-truck"), ("Entregado", "fa-check-circle") };
}
<div class="bg-gray-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <nav aria-label="Ruta de navegación" class="text-xs text-gray-400 mb-4"><a asp-action="Index" class="hover:text-white">Mis pedidos</a><i class="fas fa-chevron-right text-[10px] mx-2" aria-hidden="true"></i><span class="text-emerald-300">Pedido #@Model.Id</span></nav>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5"><div><p class="text-xs text-emerald-300 uppercase tracking-widest font-semibold mb-2">Tu compra · Alda Joyeros</p><h1 class="font-serif text-3xl sm:text-4xl">Pedido #@Model.Id</h1><p class="text-sm text-gray-300 mt-3">@(Model.Fecha?.ToString("dd MMM yyyy, HH:mm") ?? "Fecha no disponible") · @totalItems @(totalItems == 1 ? "artículo" : "artículos")</p></div><div class="self-start"><partial name="_PedidoEstado" model="estado" /></div></div>
    </div>
</div>
<div class="bg-gray-50 py-6 sm:py-10 pb-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-emerald-700 mb-6"><i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>Volver a mis pedidos</a>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
            <div class="lg:col-span-2 min-w-0 space-y-5">
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6">
                    <div class="flex items-start gap-3"><span class="w-10 h-10 shrink-0 rounded-xl flex items-center justify-center @estado.Color"><i class="fas @estado.Icono" aria-hidden="true"></i></span><div><h2 class="font-semibold text-lg text-gray-900">@estado.Etiqueta</h2><p class="text-sm text-gray-500 mt-1">@estado.Descripcion</p></div></div>
                    @if (estado.Paso >= 0)
                    {
                        <ol aria-label="Seguimiento del pedido" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
                            @for (var index = 0; index < pasos.Length; index++)
                            {
                                var actual = index == estado.Paso;
                                var completo = index < estado.Paso;
                                <li aria-current="@(actual ? "step" : null)" class="rounded-xl p-3 border @(actual ? "border-emerald-200 bg-emerald-50" : "border-gray-100 bg-gray-50")"><span class="flex items-center justify-center w-8 h-8 rounded-full mb-3 @(actual || completo ? "bg-emerald-600 text-white" : "bg-gray-200 text-gray-500")"><i class="fas @(completo ? "fa-check" : pasos[index].Item2) text-xs" aria-hidden="true"></i></span><span class="block text-xs font-medium @(actual || completo ? "text-gray-900" : "text-gray-500")">@pasos[index].Item1</span><span class="block text-[11px] mt-1 text-gray-500">@(actual ? "Estado actual" : completo ? "Completado" : "Pendiente")</span></li>
                            }
                        </ol>
                    }
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 pt-5 border-t border-gray-100 text-sm"><div><dt class="text-xs text-gray-500 mb-1">Fecha del pedido</dt><dd class="font-medium text-gray-900">@(Model.Fecha?.ToString("dd/MM/yyyy") ?? "No disponible")</dd></div>@if (estado.Paso >= 0) { <div><dt class="text-xs text-gray-500 mb-1">Entrega estimada</dt><dd class="font-medium text-gray-900">@(Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "Por confirmar")</dd></div><div><dt class="text-xs text-gray-500 mb-1">Fecha de entrega</dt><dd class="font-medium text-gray-900">@(Model.FechaEntregaReal?.ToString("dd/MM/yyyy") ?? (estado.Paso == 3 ? "Sin fecha registrada" : "Pendiente"))</dd></div> }</dl>
                </section>
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="p-5 sm:p-6 border-b border-gray-100 flex items-center justify-between gap-3"><h2 class="font-semibold text-lg text-gray-900">Tus artículos</h2><span class="text-xs text-gray-500">@totalItems unidades</span></div>
                    <div class="divide-y divide-gray-100">
                        @foreach (var linea in Model.LineasPedido)
                        {
                            <div class="p-4 sm:p-6 flex items-start gap-3 sm:gap-4">
                                <div class="w-16 h-20 sm:w-20 sm:h-24 shrink-0 rounded-xl border border-gray-100 bg-gray-50 overflow-hidden">@if (linea.Producto?.TieneImagenes == true) { <img src="@linea.Producto.ImagenPrincipal" alt="@linea.ProductoNombre" class="w-full h-full object-contain p-1" /> } else { <div class="w-full h-full flex items-center justify-center"><i class="fas fa-gem text-gray-300 text-xl" aria-hidden="true"></i></div> }</div>
                                <div class="min-w-0 flex-1"><p class="text-sm sm:text-base font-medium text-gray-900 break-words">@linea.ProductoNombre</p><p class="text-xs text-gray-500 mt-2">Cantidad: @linea.Cantidad · @linea.Precio.ToString("C") / unidad</p><p class="font-semibold text-gray-900 mt-3 sm:hidden">@linea.Subtotal.ToString("C")</p></div><p class="hidden sm:block text-sm font-semibold text-gray-900 shrink-0">@linea.Subtotal.ToString("C")</p>
                            </div>
                        }
                        @if (!Model.LineasPedido.Any()) { <p class="p-5 sm:p-6 text-sm text-gray-500">No hay artículos registrados para este pedido.</p> }
                    </div>
                    <div class="p-5 sm:p-6 bg-gray-50 border-t border-gray-100 flex items-center justify-between gap-4"><span class="font-semibold text-gray-900">Total del pedido</span><span class="text-2xl font-semibold text-gray-900">@Model.Total.ToString("C")</span></div>
                </section>
            </div>
            <aside aria-label="Información del pedido" class="min-w-0 lg:sticky lg:top-24 space-y-5">
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6"><h2 class="font-semibold text-lg text-gray-900 mb-4">Dirección de entrega</h2>@if (Model.Direccion != null) { <div class="text-sm break-words"><p class="font-medium text-gray-900">@Model.Direccion.Calle, @Model.Direccion.Numero @if (!string.IsNullOrEmpty(Model.Direccion.Piso)) { <span>— @Model.Direccion.Piso</span> }</p><p class="text-gray-500 mt-2">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad</p><p class="text-gray-500">@Model.Direccion.Provincia</p></div> } else { <p class="text-sm text-gray-500">No hay una dirección registrada para este pedido.</p> }</section>
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6"><h2 class="font-semibold text-lg text-gray-900">Tu factura</h2><p class="text-sm text-gray-500 mt-2 mb-5">Descarga una copia o recíbela en el email de tu cuenta.</p>@Html.AntiForgeryToken()<div class="space-y-3"><a href="/Pedidos/@Model.Id/Factura" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-gray-900 hover:bg-gray-800 text-white rounded-xl font-semibold text-sm"><i class="fas fa-download" aria-hidden="true"></i>Descargar PDF</a><button type="button" id="btnEnviarFactura" data-invoice-url="/Pedidos/@Model.Id/EnviarFactura" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 border border-gray-200 text-gray-700 hover:bg-gray-50 rounded-xl font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed"><i class="fas fa-envelope" aria-hidden="true"></i>Enviar por email</button><p id="invoice-feedback" role="status" aria-live="polite" class="text-sm hidden"></p></div></section>
                <section class="bg-emerald-50 rounded-2xl border border-emerald-100 p-5 sm:p-6"><h2 class="font-semibold text-gray-900">Estamos para ayudarte</h2><p class="text-sm text-gray-600 mt-2 mb-4">Si tienes alguna duda, llámanos e indica tu número de pedido #@Model.Id.</p><a href="tel:+34925541227" class="inline-flex items-center gap-2 text-emerald-800 font-semibold text-sm"><i class="fas fa-phone" aria-hidden="true"></i>925 54 12 27</a></section>
            </aside>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/pedido-detalle.js" asp-append-version="true"></script> }