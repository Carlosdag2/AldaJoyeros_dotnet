@model AldaJoyeros.DTOs.PedidoDto
@{
    ViewData["Title"] = "Pedido confirmado";
    var articulos = Model.LineasPedido.Select(x => new AldaJoyeros.DTOs.CarritoItemDto { ProductoNombre = x.ProductoNombre ?? "Producto", Producto = x.Producto, Cantidad = x.Cantidad, Precio = x.Precio, Subtotal = x.Subtotal });
}
<partial name="_CompraCabecera" model='new AldaJoyeros.DTOs.CompraCabeceraViewModel(5, "Gracias por elegirnos", "Tu pedido está confirmado. Puedes consultar todos sus detalles desde tu cuenta.")' />
<div class="bg-gray-50 pb-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <section class="rounded-2xl bg-emerald-50 border border-emerald-200 p-5 sm:p-6 mb-6 flex items-start gap-4" aria-label="Pedido confirmado">
            <span class="w-12 h-12 shrink-0 rounded-full bg-emerald-600 text-white flex items-center justify-center"><i class="fas fa-check text-lg" aria-hidden="true"></i></span>
            <div class="min-w-0"><h2 class="text-lg font-semibold text-gray-900">Pedido #@Model.Id confirmado</h2><p class="text-sm text-emerald-800 mt-1">@Model.Fecha?.ToString("dd MMM yyyy, HH:mm")</p><p class="text-xs text-emerald-800 mt-2">Estado: @Model.Estado</p></div>
        </section>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
            <div class="lg:col-span-2 min-w-0 space-y-5">
                @if (Model.Direccion != null)
                {
                    <section class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6"><h2 class="text-lg font-semibold text-gray-900 mb-4">Dirección de entrega</h2><div class="flex items-start gap-3"><span class="w-10 h-10 shrink-0 flex items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas fa-truck" aria-hidden="true"></i></span><div class="text-sm min-w-0 break-words"><p class="font-medium text-gray-900">@Model.Direccion.Calle, @Model.Direccion.Numero @if (!string.IsNullOrEmpty(Model.Direccion.Piso)) { <span>— @Model.Direccion.Piso</span> }</p><p class="text-gray-500 mt-1">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad, @Model.Direccion.Provincia</p>@if (Model.FechaEntregaEstimada.HasValue) { <p class="text-gray-500 mt-3">Entrega estimada: @Model.FechaEntregaEstimada.Value.ToString("dd MMM yyyy")</p> }</div></div></section>
                }
                <section class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6"><h2 class="text-lg font-semibold text-gray-900 mb-3">¿Qué ocurre ahora?</h2><p class="text-sm leading-relaxed text-gray-500">Prepararemos tu pedido. Desde «Mis pedidos» puedes consultar su estado y volver a revisar los artículos y los datos de entrega.</p><div class="flex flex-col sm:flex-row gap-3 mt-5"><a asp-action="Detalle" asp-route-id="@Model.Id" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl"><i class="fas fa-receipt" aria-hidden="true"></i>Ver mi pedido</a><a asp-action="Index" class="inline-flex items-center justify-center px-5 py-3 border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50">Mis pedidos</a></div></section>
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-2"><a asp-controller="Productos" asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-emerald-700"><i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>Seguir comprando</a><a href="tel:+34925541227" class="text-sm text-emerald-700 hover:underline">¿Necesitas ayuda? Llámanos</a></div>
            </div>
            <aside aria-label="Resumen del pedido" class="min-w-0 lg:sticky lg:top-24"><partial name="_CompraResumen" model='new AldaJoyeros.DTOs.CompraResumenViewModel(articulos, (decimal)Model.Total, "Artículos e importe de tu pedido confirmado.")' /></aside>
        </div>
    </div>
</div>
