@model AldaJoyeros.DTOs.CheckoutConfirmacionViewModel
@{ ViewData["Title"] = "Confirma tu pedido"; }
<partial name="_CompraCabecera" model='new AldaJoyeros.DTOs.CompraCabeceraViewModel(4, "Todo listo para tu pedido", "Comprueba la dirección, los artículos y el método de pago antes de confirmar.")' />
<div class="bg-gray-50 pb-8">
    <form asp-action="FinalizarPedido" method="post" class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" role="alert" class="text-sm text-red-700 mb-4"></div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
            <div class="lg:col-span-2 min-w-0 space-y-5">
                <section class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6">
                    <div class="flex items-center justify-between gap-3 mb-4"><h2 class="text-lg font-semibold text-gray-900">Dirección de entrega</h2><a asp-action="Checkout" class="text-sm font-semibold text-emerald-700 hover:underline">Editar</a></div>
                    <div class="flex items-start gap-3"><span class="w-10 h-10 shrink-0 flex items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><div class="text-sm min-w-0 break-words"><p class="font-medium text-gray-900">@Model.Direccion.Calle, @Model.Direccion.Numero @if (!string.IsNullOrEmpty(Model.Direccion.Piso)) { <span>— @Model.Direccion.Piso</span> }</p><p class="text-gray-500 mt-1">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad, @Model.Direccion.Provincia</p></div></div>
                </section>
                <section class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6">
                    <div class="flex items-center justify-between gap-3 mb-4"><h2 class="text-lg font-semibold text-gray-900">Método de pago</h2><a asp-action="CheckoutPago" class="text-sm font-semibold text-emerald-700 hover:underline">Cambiar</a></div>
                    <div class="flex items-start gap-3"><span class="w-10 h-10 shrink-0 flex items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas @(Model.PagoConTarjeta ? "fa-credit-card" : "fa-money-bill-wave")" aria-hidden="true"></i></span><div class="text-sm"><p class="font-medium text-gray-900">@Model.MetodoPagoDisplay</p>@if (Model.PagoConTarjeta) { <p class="text-emerald-700 mt-1"><i class="fas fa-check-circle mr-1" aria-hidden="true"></i>Pago confirmado con Stripe</p><p class="text-gray-500 text-xs mt-2">Confirmar el pedido no volverá a cobrar tu tarjeta.</p> } else { <p class="text-gray-500 mt-1">Pagarás al recibir el pedido.</p> }</div></div>
                </section>
                <section class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6"><h2 class="font-semibold text-gray-900 mb-3">Última comprobación</h2><p class="text-sm leading-relaxed text-gray-500">Revisa la información de entrega y tu selección. Al confirmar se registrará tu pedido y podrás consultar sus detalles desde tu cuenta.</p></section>
            </div>
            <aside aria-label="Resumen del pedido" class="min-w-0 lg:sticky lg:top-24 space-y-4">
                <partial name="_CompraResumen" model="new AldaJoyeros.DTOs.CompraResumenViewModel(Model.CarritoItems, Model.Total)" />
                <button type="submit" class="w-full inline-flex items-center justify-center gap-3 px-5 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"><i class="fas fa-check" aria-hidden="true"></i>Confirmar pedido</button>
                <a asp-action="CheckoutPago" class="block text-center py-2 text-sm font-medium text-gray-500 hover:text-gray-900"><i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>Volver al pago</a>
            </aside>
        </div>
    </form>
</div>