@model AldaJoyeros.DTOs.CheckoutConfirmacionViewModel
@{ViewData["Title"]="Checkout - Confirmación";}

<div class="container mx-auto px-6 py-8">
<!-- Header -->
<div class="mb-8 text-center">
<h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center justify-center gap-3">
<div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg"><i class="fas fa-clipboard-check text-white text-2xl"></i></div>
Confirmar Pedido
</h1>
<p class="text-gray-600 text-lg">Paso 3 de 3: Revisa y confirma tu pedido</p>
</div>

<!-- Progress Steps -->
<div class="max-w-3xl mx-auto mb-12">
<div class="flex items-center justify-between relative">
<div class="absolute top-5 left-0 right-0 h-1 bg-gray-200 -z-10"></div>
<div class="absolute top-5 left-0 h-1 bg-emerald-500 -z-10" style="width: 100%;"></div>

<div class="flex flex-col items-center">
<div class="w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg mb-2"><i class="fas fa-check"></i></div>
<div class="text-center"><div class="text-sm font-bold text-emerald-600">Dirección</div></div>
</div>

<div class="flex flex-col items-center">
<div class="w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg mb-2"><i class="fas fa-check"></i></div>
<div class="text-center"><div class="text-sm font-bold text-emerald-600">Pago</div></div>
</div>

<div class="flex flex-col items-center">
<div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold shadow-lg mb-2 ring-4 ring-emerald-100">3</div>
<div class="text-center"><div class="text-sm font-bold text-emerald-600">Confirmación</div></div>
</div>
</div>
</div>

<div class="max-w-4xl mx-auto">
<form asp-action="FinalizarPedido" method="post">
@Html.AntiForgeryToken()

<!-- Resumen del Pedido -->
<div class="bg-white rounded-2xl shadow-lg p-6 mb-6 border border-gray-100">
<h2 class="font-serif text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
<div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center"><i class="fas fa-shopping-bag text-emerald-600"></i></div>
Productos
</h2>

<div class="space-y-4">
@foreach(var item in Model.CarritoItems){
<div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
<div class="w-20 h-20 bg-white rounded-xl overflow-hidden shadow-sm flex-shrink-0">
@if(item.Producto?.TieneImagenes == true){
<img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-cover"/>
}else{
<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-50 to-green-50">
<i class="fas fa-gem text-emerald-300 text-2xl"></i>
</div>
}
</div>
<div class="flex-1">
<h3 class="font-bold text-gray-900">@item.ProductoNombre</h3>
<p class="text-gray-600 text-sm">Cantidad: @item.Cantidad × @item.Precio.ToString("C")</p>
</div>
<div class="text-right">
<div class="text-xl font-bold text-emerald-600">@item.Subtotal.ToString("C")</div>
</div>
</div>
}
</div>
</div>

<!-- Dirección y Pago -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
<!-- Dirección -->
<div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
<div class="flex items-center justify-between mb-4">
<h3 class="font-serif text-xl font-bold text-gray-900 flex items-center gap-2">
<div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-map-marker-alt text-blue-600"></i></div>
Dirección de envío
</h3>
<a asp-action="Checkout" class="text-blue-600 hover:text-blue-700 text-sm font-medium"><i class="fas fa-edit mr-1"></i>Editar</a>
</div>
<div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
<div class="font-bold text-gray-900">@Model.Direccion.Calle, @Model.Direccion.Numero</div>
@if(!string.IsNullOrEmpty(Model.Direccion.Piso)){
<div class="text-gray-700">@Model.Direccion.Piso</div>
}
<div class="text-gray-600">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad</div>
<div class="text-gray-600">@Model.Direccion.Provincia</div>
</div>
</div>

<!-- Método de Pago -->
<div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
<div class="flex items-center justify-between mb-4">
<h3 class="font-serif text-xl font-bold text-gray-900 flex items-center gap-2">
<div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-credit-card text-indigo-600"></i></div>
Método de pago
</h3>
<a asp-action="CheckoutPago" class="text-indigo-600 hover:text-indigo-700 text-sm font-medium"><i class="fas fa-edit mr-1"></i>Cambiar</a>
</div>
<div class="@(Model.PagoConTarjeta ? "bg-indigo-50 border-indigo-100" : "bg-green-50 border-green-100") rounded-xl p-4 border">
<div class="flex items-center gap-3">
@if(Model.PagoConTarjeta){
<div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center">
<i class="fab fa-stripe-s text-white text-xl"></i>
</div>
<div>
<div class="font-bold text-gray-900">Tarjeta de Crédito/Débito</div>
<div class="text-sm text-green-600 font-medium"><i class="fas fa-check-circle mr-1"></i>Pago confirmado</div>
</div>
}else{
<div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center">
<i class="fas fa-money-bill-wave text-white text-xl"></i>
</div>
<div>
<div class="font-bold text-gray-900">Contra Reembolso</div>
<div class="text-sm text-gray-600">Pagarás al recibir el pedido</div>
</div>
}
</div>
</div>
</div>
</div>

<!-- Total y Botón -->
<div class="bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-2xl shadow-xl p-6 text-white">
<div class="flex flex-col md:flex-row justify-between items-center gap-6">
<div>
<div class="text-emerald-100 text-sm mb-1">Total a pagar</div>
<div class="text-4xl font-bold">@Model.Total.ToString("C")</div>
<div class="text-emerald-200 text-sm mt-1"><i class="fas fa-truck mr-1"></i>Envío gratuito incluido</div>
</div>

<div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
<a asp-action="CheckoutPago" class="inline-flex items-center justify-center px-6 py-3 bg-white/20 hover:bg-white/30 rounded-xl font-semibold transition-all">
<i class="fas fa-arrow-left mr-2"></i>Volver
</a>
<button type="submit" class="inline-flex items-center justify-center bg-white text-emerald-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-emerald-50 hover:shadow-lg transition-all">
<i class="fas fa-check-circle mr-2"></i>Confirmar Pedido
</button>
</div>
</div>
</div>

<!-- Información adicional -->
<div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
<div class="flex items-center gap-3 bg-white rounded-xl p-4 shadow-sm border border-gray-100">
<div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
<i class="fas fa-truck text-blue-600"></i>
</div>
<div>
<div class="font-bold text-gray-900 text-sm">Envío en 3-5 días</div>
<div class="text-gray-500 text-xs">Laborables</div>
</div>
</div>
<div class="flex items-center gap-3 bg-white rounded-xl p-4 shadow-sm border border-gray-100">
<div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
<i class="fas fa-undo text-purple-600"></i>
</div>
<div>
<div class="font-bold text-gray-900 text-sm">30 días devolución</div>
<div class="text-gray-500 text-xs">Sin preguntas</div>
</div>
</div>
<div class="flex items-center gap-3 bg-white rounded-xl p-4 shadow-sm border border-gray-100">
<div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
<i class="fas fa-gift text-emerald-600"></i>
</div>
<div>
<div class="font-bold text-gray-900 text-sm">Empaquetado premium</div>
<div class="text-gray-500 text-xs">Caja de regalo</div>
</div>
</div>
</div>
</form>
</div>
</div>
