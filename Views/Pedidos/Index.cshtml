@model IEnumerable<AldaJoyeros.DTOs.PedidoDto>

@{
    ViewData["Title"] = "Mis Pedidos";
    var pedidos = Model?.ToList() ?? new List<AldaJoyeros.DTOs.PedidoDto>();
}

<!-- Header -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 py-10">
    <div class="container mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">
                <i class="fas fa-home"></i>
            </a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <span class="text-emerald-400">Mis Pedidos</span>
        </nav>
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white">Mis Pedidos</h1>
                <p class="text-gray-400 mt-1">@pedidos.Count @(pedidos.Count == 1 ? "pedido" : "pedidos") en total</p>
            </div>
            <a asp-controller="Productos" asp-action="Index" 
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-shopping-bag"></i>
                <span>Seguir comprando</span>
            </a>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto px-4 sm:px-6">
        @if (pedidos.Any())
        {
            <!-- Quick Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-box text-gray-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@pedidos.Count</div>
                            <div class="text-xs text-gray-500">Total</div>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-clock text-amber-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@pedidos.Count(p => p.Estado == "PENDIENTE" || p.Estado == "EN_PROCESO")</div>
                            <div class="text-xs text-gray-500">En proceso</div>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-truck text-blue-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@pedidos.Count(p => p.Estado == "ENVIADO")</div>
                            <div class="text-xs text-gray-500">Enviados</div>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-check text-emerald-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@pedidos.Count(p => p.Estado == "ENTREGADO")</div>
                            <div class="text-xs text-gray-500">Entregados</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orders List -->
            <div class="space-y-4">
                @foreach (var pedido in pedidos)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
                        <!-- Header -->
                        <div class="px-6 py-4 border-b border-gray-100 flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-4">
                                <div>
                                    <div class="text-sm text-gray-500">Pedido</div>
                                    <div class="font-bold text-gray-900">#@pedido.Id</div>
                                </div>
                                <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
                                <div class="hidden sm:block">
                                    <div class="text-sm text-gray-500">Fecha</div>
                                    <div class="font-medium text-gray-900">@pedido.Fecha?.ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                @{
                                    var (bgColor, textColor, icon, label) = pedido.Estado switch
                                    {
                                        "PENDIENTE" => ("bg-amber-100", "text-amber-700", "fa-clock", "Pendiente"),
                                        "EN_PROCESO" => ("bg-blue-100", "text-blue-700", "fa-sync-alt", "En proceso"),
                                        "ENVIADO" => ("bg-purple-100", "text-purple-700", "fa-truck", "Enviado"),
                                        "ENTREGADO" => ("bg-emerald-100", "text-emerald-700", "fa-check-circle", "Entregado"),
                                        "CANCELADO" => ("bg-red-100", "text-red-700", "fa-times-circle", "Cancelado"),
                                        _ => ("bg-gray-100", "text-gray-700", "fa-circle", pedido.Estado ?? "")
                                    };
                                }
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium @bgColor @textColor">
                                    <i class="fas @icon text-xs"></i>
                                    @label
                                </span>
                                <div class="text-right">
                                    <div class="text-sm text-gray-500">Total</div>
                                    <div class="font-bold text-emerald-600">@pedido.Total.ToString("C")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Products -->
                        <div class="px-6 py-4">
                            <div class="flex items-center gap-4 overflow-x-auto pb-2">
                                @foreach (var linea in pedido.LineasPedido.Take(4))
                                {
                                    <div class="relative flex-shrink-0">
                                        <div class="w-16 h-16 bg-gray-100 rounded-lg overflow-hidden">
                                            @if (linea.Producto?.TieneImagenes == true)
                                            {
                                                <img src="@linea.Producto.ImagenPrincipal" alt="@linea.ProductoNombre" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full flex items-center justify-center">
                                                    <i class="fas fa-gem text-gray-300"></i>
                                                </div>
                                            }
                                        </div>
                                        @if (linea.Cantidad > 1)
                                        {
                                            <span class="absolute -top-1 -right-1 w-5 h-5 bg-gray-700 text-white text-xs rounded-full flex items-center justify-center">
                                                @linea.Cantidad
                                            </span>
                                        }
                                    </div>
                                }
                                @if (pedido.LineasPedido.Count > 4)
                                {
                                    <div class="flex-shrink-0 w-16 h-16 bg-gray-100 rounded-lg flex items-center justify-center text-gray-500 text-sm font-medium">
                                        +@(pedido.LineasPedido.Count - 4)
                                    </div>
                                }
                                
                                <!-- Spacer -->
                                <div class="flex-1"></div>
                                
                                <!-- Actions -->
                                <a asp-action="Detalle" asp-route-id="@pedido.Id" 
                                   class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 hover:bg-gray-800 text-white font-medium rounded-lg transition-colors">
                                    <span>Ver detalle</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Shipping Info (collapsed) -->
                        @if (pedido.Direccion != null)
                        {
                            <div class="px-6 py-3 bg-gray-50 border-t border-gray-100 text-sm text-gray-500">
                                <i class="fas fa-map-marker-alt text-gray-400 mr-2"></i>
                                @pedido.Direccion.Calle, @pedido.Direccion.Numero - @pedido.Direccion.Ciudad
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="max-w-md mx-auto text-center py-16">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-box-open text-4xl text-gray-300"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">No tienes pedidos</h2>
                <p class="text-gray-500 mb-8">
                    Cuando realices una compra, podrás ver aquí el estado de tus pedidos
                </p>
                <a asp-controller="Productos" asp-action="Index" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-full transition-colors">
                    <i class="fas fa-shopping-bag"></i>
                    <span>Explorar productos</span>
                </a>
            </div>
        }
    </div>
</div>
