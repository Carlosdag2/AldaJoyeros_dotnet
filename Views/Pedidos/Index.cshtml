@model IEnumerable<AldaJoyeros.DTOs.PedidoDto>
@using AldaJoyeros.Helpers
@{
    ViewData["Title"] = "Mis pedidos";
    var pedidos = Model?.OrderByDescending(x => x.Fecha).ToList() ?? new List<AldaJoyeros.DTOs.PedidoDto>();
    var preparacion = pedidos.Count(x => PedidoPresentacion.Desde(x.Estado).Grupo == "preparacion");
    var enviados = pedidos.Count(x => PedidoPresentacion.Desde(x.Estado).Grupo == "enviados");
    var entregados = pedidos.Count(x => PedidoPresentacion.Desde(x.Estado).Grupo == "entregados");
    var cancelados = pedidos.Count(x => PedidoPresentacion.Desde(x.Estado).Grupo == "cancelados");
}
<div class="bg-gray-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <nav aria-label="Ruta de navegación" class="text-xs text-gray-400 mb-4"><a asp-controller="Home" asp-action="Index" class="hover:text-white">Inicio</a><i class="fas fa-chevron-right text-[10px] mx-2" aria-hidden="true"></i><span class="text-emerald-300">Mis pedidos</span></nav>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5"><div><p class="text-xs text-emerald-300 uppercase tracking-widest font-semibold mb-2">Tu cuenta · Alda Joyeros</p><h1 class="font-serif text-3xl sm:text-4xl">Mis pedidos</h1><p class="text-sm text-gray-300 mt-3">Consulta tus compras, su estado y todos los detalles de entrega.</p></div><a asp-controller="Productos" asp-action="Index" class="inline-flex items-center justify-center gap-2 self-start px-4 py-3 rounded-xl border border-gray-600 text-sm font-medium hover:bg-gray-800">Explorar el catálogo<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a></div>
    </div>
</div>
<div class="bg-gray-50 py-6 sm:py-10 pb-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        @if (pedidos.Any())
        {
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6" aria-label="Resumen de pedidos">
                @foreach (var dato in new[] { (pedidos.Count, "Pedidos", "fa-shopping-bag"), (preparacion, "En preparación", "fa-box"), (enviados, "Enviados", "fa-truck"), (entregados, "Entregados", "fa-check-circle") })
                {
                    <div class="bg-white rounded-2xl border border-gray-200 p-4 sm:p-5"><div class="flex items-center justify-between gap-2"><span class="text-2xl font-semibold text-gray-900">@dato.Item1</span><i class="fas @dato.Item3 text-emerald-700" aria-hidden="true"></i></div><p class="text-xs sm:text-sm text-gray-500 mt-2">@dato.Item2</p></div>
                }
            </div>
            <section x-data="{ filtro: 'todos' }" aria-label="Historial de pedidos">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5"><h2 class="text-lg font-semibold text-gray-900">Tu historial</h2><p class="text-xs text-gray-500">Del más reciente al más antiguo</p></div>
                <div role="group" aria-label="Filtrar por estado" class="flex flex-wrap gap-2 mb-5">
                    @foreach (var filtro in new[] { ("todos", "Todos", pedidos.Count), ("preparacion", "En preparación", preparacion), ("enviados", "Enviados", enviados), ("entregados", "Entregados", entregados), ("cancelados", "Cancelados", cancelados) })
                    {
                        <button type="button" x-on:click="filtro = '@filtro.Item1'" x-bind:aria-pressed="filtro === '@filtro.Item1'" x-bind:class="filtro === '@filtro.Item1' ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-400'" class="px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-medium focus-visible:ring-2 focus-visible:ring-emerald-600">@filtro.Item2 <span class="ml-1 opacity-70">@filtro.Item3</span></button>
                    }
                </div>
                <div class="space-y-4">
                    @foreach (var pedido in pedidos)
                    {
                        var estado = PedidoPresentacion.Desde(pedido.Estado);
                        var unidades = pedido.LineasPedido.Sum(x => x.Cantidad);
                        <article x-show="filtro === 'todos' || filtro === '@estado.Grupo'" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                            <div class="px-4 sm:px-6 py-4 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3"><div><a asp-action="Detalle" asp-route-id="@pedido.Id" class="font-semibold text-gray-900 hover:text-emerald-700">Pedido #@pedido.Id</a><p class="text-xs text-gray-500 mt-1">@(pedido.Fecha?.ToString("dd MMM yyyy") ?? "Fecha no disponible") · @unidades @(unidades == 1 ? "artículo" : "artículos")</p></div><partial name="_PedidoEstado" model="estado" /></div>
                            <div class="p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-5">
                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                    @if (pedido.LineasPedido.FirstOrDefault() is { } primera)
                                    {
                                        <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-xl border border-gray-100 bg-gray-50 overflow-hidden">@if (primera.Producto?.TieneImagenes == true) { <img src="@primera.Producto.ImagenPrincipal" alt="@primera.ProductoNombre" class="w-full h-full object-contain p-1" /> } else { <div class="flex w-full h-full items-center justify-center"><i class="fas fa-gem text-gray-300 text-xl" aria-hidden="true"></i></div> }</div>
                                        <div class="min-w-0"><p class="text-sm font-medium text-gray-900 break-words">@primera.ProductoNombre</p>@if (pedido.LineasPedido.Count > 1) { <p class="text-xs text-gray-500 mt-1">Y @(pedido.LineasPedido.Count - 1) @(pedido.LineasPedido.Count == 2 ? "producto más" : "productos más")</p> }<p class="text-xs text-gray-500 mt-2">@estado.Descripcion</p></div>
                                    }
                                    else { <p class="text-sm text-gray-500">Consulta el detalle de este pedido.</p> }
                                </div>
                                <div class="flex items-center justify-between sm:justify-end gap-5 w-full sm:w-auto shrink-0"><div><p class="text-xs text-gray-500 mb-1">Total del pedido</p><p class="font-semibold text-lg text-gray-900">@pedido.Total.ToString("C")</p></div><a asp-action="Detalle" asp-route-id="@pedido.Id" aria-label="Ver detalle del pedido @pedido.Id" class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold">Ver detalle<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a></div>
                            </div>
                            @if (pedido.Direccion != null) { <p class="px-4 sm:px-6 py-3 bg-gray-50 border-t border-gray-100 text-xs text-gray-500 break-words"><i class="fas fa-map-marker-alt mr-2" aria-hidden="true"></i>@pedido.Direccion.Calle, @pedido.Direccion.Numero · @pedido.Direccion.Ciudad</p> }
                        </article>
                    }
                </div>
                <div x-show="(filtro === 'preparacion' && @preparacion === 0) || (filtro === 'enviados' && @enviados === 0) || (filtro === 'entregados' && @entregados === 0) || (filtro === 'cancelados' && @cancelados === 0)" style="display:none" role="status" class="bg-white rounded-2xl border border-gray-200 p-8 text-center"><i class="fas fa-box-open text-gray-300 text-2xl mb-4" aria-hidden="true"></i><h3 class="font-semibold text-gray-900">No hay pedidos con este estado</h3><button type="button" x-on:click="filtro = 'todos'" class="text-sm text-emerald-700 font-semibold mt-4">Ver todos los pedidos</button></div>
            </section>
        }
        else
        {
            <section class="max-w-xl mx-auto rounded-2xl bg-white border border-gray-200 p-8 sm:p-12 text-center my-6"><span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 text-2xl mb-6"><i class="fas fa-box-open" aria-hidden="true"></i></span><h2 class="font-serif text-2xl sm:text-3xl text-gray-900">Tu historia empieza aquí</h2><p class="text-sm text-gray-500 mt-3 mb-7">Todavía no tienes pedidos. Cuando realices una compra, podrás consultarla en este apartado.</p><a asp-controller="Productos" asp-action="Index" class="inline-flex items-center justify-center gap-3 px-6 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl">Descubrir la colección<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a></section>
        }
    </div>
</div>