@model IEnumerable<AldaJoyeros.DTOs.PedidoDto>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<!-- Header -->
<div class="mb-8">
    <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-900 mb-2">
        <i class="fas fa-box text-yellow-600"></i> Mis Pedidos
    </h1>
    <p class="text-gray-600">Consulta el estado de todos tus pedidos</p>
</div>

@if (Model != null && Model.Any())
{
    <div class="space-y-6">
        @foreach (var pedido in Model)
        {
            <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
                <!-- Header -->
                <div class="bg-gradient-to-r from-gray-900 to-gray-800 p-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-white">
                        <div>
                            <div class="text-sm text-gray-400 mb-1">Número de Pedido</div>
                            <div class="font-bold text-xl">#@pedido.Id</div>
                        </div>
                        <div>
                            <div class="text-sm text-gray-400 mb-1">Fecha</div>
                            <div class="font-semibold">
                                <i class="fas fa-calendar mr-2"></i>
                                @pedido.Fecha?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        <div>
                            <div class="text-sm text-gray-400 mb-1">Estado</div>
                            <div>
                                @switch (pedido.Estado)
                                {
                                    case "PENDIENTE":
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-500 text-white">
                                            <i class="fas fa-clock mr-1"></i> Pendiente
                                        </span>
                                        break;
                                    case "EN_PROCESO":
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-500 text-white">
                                            <i class="fas fa-sync-alt mr-1 animate-spin"></i> En Proceso
                                        </span>
                                        break;
                                    case "ENVIADO":
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-500 text-white">
                                            <i class="fas fa-shipping-fast mr-1"></i> Enviado
                                        </span>
                                        break;
                                    case "ENTREGADO":
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-500 text-white">
                                            <i class="fas fa-check-circle mr-1"></i> Entregado
                                        </span>
                                        break;
                                    case "CANCELADO":
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-500 text-white">
                                            <i class="fas fa-times-circle mr-1"></i> Cancelado
                                        </span>
                                        break;
                                }
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm text-gray-400 mb-1">Total</div>
                            <div class="text-2xl font-bold text-yellow-400">@pedido.Total.ToString("C")</div>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Products -->
                        <div>
                            <h3 class="font-bold text-gray-900 mb-3 flex items-center">
                                <i class="fas fa-shopping-bag text-yellow-600 mr-2"></i>
                                Productos (@pedido.LineasPedido.Count)
                            </h3>
                            <div class="space-y-2">
                                @foreach (var linea in pedido.LineasPedido.Take(3))
                                {
                                    <div class="flex items-center justify-between bg-gray-50 rounded-lg p-3">
                                        <div class="flex items-center">
                                            <i class="fas fa-gem text-yellow-600 mr-3"></i>
                                            <div>
                                                <div class="font-semibold text-gray-900 text-sm">@linea.ProductoNombre</div>
                                                <div class="text-xs text-gray-600">@linea.Cantidad x @linea.Precio.ToString("C")</div>
                                            </div>
                                        </div>
                                        <div class="font-bold text-gradient">
                                            @linea.Subtotal.ToString("C")
                                        </div>
                                    </div>
                                }
                                @if (pedido.LineasPedido.Count > 3)
                                {
                                    <div class="text-sm text-gray-500 text-center">
                                        +@(pedido.LineasPedido.Count - 3) productos más
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Shipping Address -->
                        <div>
                            <h3 class="font-bold text-gray-900 mb-3 flex items-center">
                                <i class="fas fa-map-marker-alt text-yellow-600 mr-2"></i>
                                Dirección de Envío
                            </h3>
                            @if (pedido.Direccion != null)
                            {
                                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg p-4">
                                    <address class="not-italic text-sm text-gray-700">
                                        <div class="font-semibold text-gray-900 mb-1">
                                            @pedido.Direccion.Calle, @pedido.Direccion.Numero
                                        </div>
                                        @if (!string.IsNullOrEmpty(pedido.Direccion.Piso))
                                        {
                                            <div>@pedido.Direccion.Piso</div>
                                        }
                                        <div>@pedido.Direccion.CodigoPostal - @pedido.Direccion.Ciudad</div>
                                        <div>@pedido.Direccion.Provincia</div>
                                    </address>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="mt-6 pt-6 border-t border-gray-200 flex justify-end">
                        <a asp-action="Detalle" asp-route-id="@pedido.Id" 
                           class="inline-flex items-center px-6 py-3 gradient-gold text-gray-900 rounded-lg font-semibold hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                            <i class="fas fa-eye mr-2"></i>
                            Ver Detalle Completo
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="text-center py-20">
        <div class="bg-white rounded-3xl p-12 shadow-xl max-w-2xl mx-auto">
            <i class="fas fa-box-open text-gray-300 mb-6" style="font-size: 8rem;"></i>
            <h2 class="font-display text-3xl font-bold text-gray-900 mb-4">No tienes pedidos</h2>
            <p class="text-gray-600 mb-8 text-lg">
                Cuando realices una compra, aparecerá aquí con toda la información
            </p>
            <a asp-controller="Productos" asp-action="Index" 
               class="inline-flex items-center gradient-gold text-gray-900 px-8 py-4 rounded-full font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                <i class="fas fa-shopping-bag mr-3"></i>
                Explorar Productos
            </a>
        </div>
    </div>
}
