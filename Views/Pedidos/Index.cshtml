@model IEnumerable<AldaJoyeros.DTOs.PedidoDto>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<div class="container mx-auto px-6 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-box text-white text-2xl"></i>
            </div>
            Mis Pedidos
        </h1>
        <p class="text-gray-600 text-lg">Consulta el estado y detalles de todos tus pedidos</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Stats Summary -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Total Pedidos</p>
                        <p class="text-3xl font-bold text-emerald-600">@Model.Count()</p>
                    </div>
                    <div class="w-12 h-12 bg-emerald-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-shopping-bag text-white text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">En Proceso</p>
                        <p class="text-3xl font-bold text-blue-600">@Model.Count(p => p.Estado == "EN_PROCESO" || p.Estado == "PENDIENTE")</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-sync-alt text-white text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Enviados</p>
                        <p class="text-3xl font-bold text-purple-600">@Model.Count(p => p.Estado == "ENVIADO")</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-shipping-fast text-white text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-6 border border-green-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Entregados</p>
                        <p class="text-3xl font-bold text-green-600">@Model.Count(p => p.Estado == "ENTREGADO")</p>
                    </div>
                    <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-check-circle text-white text-xl"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders List -->
        <div class="space-y-6">
            @foreach (var pedido in Model)
            {
                <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
                    <!-- Header -->
                    <div class="bg-gradient-to-r from-emerald-900 to-emerald-800 p-6 relative overflow-hidden">
                        <!-- Decorative Elements -->
                        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-700 rounded-full opacity-20 -mr-16 -mt-16"></div>
                        
                        <div class="relative grid grid-cols-1 md:grid-cols-4 gap-4 text-white">
                            <div>
                                <div class="text-xs text-emerald-300 mb-2 font-semibold uppercase tracking-wider">Número de Pedido</div>
                                <div class="font-bold text-2xl">#@pedido.Id</div>
                            </div>
                            <div>
                                <div class="text-xs text-emerald-300 mb-2 font-semibold uppercase tracking-wider">Fecha</div>
                                <div class="font-semibold flex items-center gap-2">
                                    <i class="fas fa-calendar-alt"></i>
                                    <span>@pedido.Fecha?.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="text-xs text-emerald-200 mt-1">@pedido.Fecha?.ToString("HH:mm")</div>
                            </div>
                            <div>
                                <div class="text-xs text-emerald-300 mb-2 font-semibold uppercase tracking-wider">Estado</div>
                                <div>
                                    @switch (pedido.Estado)
                                    {
                                        case "PENDIENTE":
                                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-yellow-500 text-white shadow-lg">
                                                <i class="fas fa-clock mr-2"></i> Pendiente
                                            </span>
                                            break;
                                        case "EN_PROCESO":
                                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-blue-500 text-white shadow-lg">
                                                <i class="fas fa-sync-alt mr-2 animate-spin"></i> En Proceso
                                            </span>
                                            break;
                                        case "ENVIADO":
                                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-purple-500 text-white shadow-lg">
                                                <i class="fas fa-shipping-fast mr-2"></i> Enviado
                                            </span>
                                            break;
                                        case "ENTREGADO":
                                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-green-500 text-white shadow-lg">
                                                <i class="fas fa-check-circle mr-2"></i> Entregado
                                            </span>
                                            break;
                                        case "CANCELADO":
                                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-red-500 text-white shadow-lg">
                                                <i class="fas fa-times-circle mr-2"></i> Cancelado
                                            </span>
                                            break;
                                    }
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-xs text-emerald-300 mb-2 font-semibold uppercase tracking-wider">Total</div>
                                <div class="text-3xl font-bold text-emerald-300">@pedido.Total.ToString("C")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="p-6">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Products -->
                            <div>
                                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-lg">
                                    <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-shopping-bag text-emerald-600"></i>
                                    </div>
                                    Productos (@pedido.LineasPedido.Count)
                                </h3>
                                <div class="space-y-3">
                                    @foreach (var linea in pedido.LineasPedido.Take(3))
                                    {
                                        <div class="flex items-center justify-between bg-gradient-to-r from-gray-50 to-emerald-50 rounded-xl p-4 hover:shadow-md transition-shadow duration-200 border border-gray-100">
                                            <div class="flex items-center gap-3 flex-1">
                                                <!-- Product Image -->
                                                <div class="w-16 h-16 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg overflow-hidden flex items-center justify-center flex-shrink-0 shadow-sm">
                                                    @if (linea.Producto?.TieneImagenes == true)
                                                    {
                                                        <img src="@linea.Producto.ImagenPrincipal" 
                                                             alt="@linea.ProductoNombre" 
                                                             class="w-full h-full object-cover"
                                                             onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'fas fa-gem text-2xl text-emerald-600\'></i>';" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-gem text-2xl text-emerald-600"></i>
                                                    }
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="font-semibold text-gray-900 truncate">@linea.ProductoNombre</div>
                                                    <div class="text-xs text-gray-600 mt-1">
                                                        <span class="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-semibold">@linea.Cantidad unidades</span>
                                                        <span class="text-gray-400 mx-2">•</span>
                                                        <span>@linea.Precio.ToString("C")</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="font-bold text-emerald-600 text-lg ml-3">
                                                @linea.Subtotal.ToString("C")
                                            </div>
                                        </div>
                                    }
                                    @if (pedido.LineasPedido.Count > 3)
                                    {
                                        <div class="text-sm text-gray-500 text-center bg-gray-50 rounded-lg py-2">
                                            <i class="fas fa-ellipsis-h mr-2"></i>
                                            +@(pedido.LineasPedido.Count - 3) productos más
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Shipping Address -->
                            <div>
                                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-lg">
                                    <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-map-marker-alt text-blue-600"></i>
                                    </div>
                                    Dirección de Envío
                                </h3>
                                @if (pedido.Direccion != null)
                                {
                                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-200">
                                        <address class="not-italic">
                                            <div class="flex items-start gap-3 mb-3">
                                                <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                                                    <i class="fas fa-home text-white text-sm"></i>
                                                </div>
                                                <div>
                                                    <div class="font-bold text-gray-900 text-lg mb-1">
                                                        @pedido.Direccion.Calle, @pedido.Direccion.Numero
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(pedido.Direccion.Piso))
                                                    {
                                                        <div class="text-gray-700 text-sm">@pedido.Direccion.Piso</div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="ml-11 space-y-1 text-sm text-gray-700">
                                                <div class="flex items-center gap-2">
                                                    <i class="fas fa-map-pin text-blue-600 w-4"></i>
                                                    <span>@pedido.Direccion.CodigoPostal - @pedido.Direccion.Ciudad</span>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <i class="fas fa-map text-blue-600 w-4"></i>
                                                    <span>@pedido.Direccion.Provincia</span>
                                                </div>
                                            </div>
                                        </address>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="mt-6 pt-6 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                            <div class="text-sm text-gray-500">
                                <i class="fas fa-info-circle mr-2"></i>
                                Pedido realizado el @pedido.Fecha?.ToString("dd 'de' MMMM 'de' yyyy")
                            </div>
                            <a asp-action="Detalle" asp-route-id="@pedido.Id" 
                               class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl font-bold hover:from-emerald-600 hover:to-emerald-700 hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                                <i class="fas fa-eye mr-2"></i>
                                Ver Detalle Completo
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-20">
            <div class="bg-white rounded-3xl p-12 shadow-xl max-w-2xl mx-auto border border-gray-100">
                <div class="w-32 h-32 bg-gradient-to-br from-emerald-100 to-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-box-open text-emerald-600 text-6xl"></i>
                </div>
                <h2 class="font-serif text-3xl font-bold text-gray-900 mb-4">No tienes pedidos</h2>
                <p class="text-gray-600 mb-8 text-lg leading-relaxed">
                    Cuando realices una compra, aparecerá aquí con toda la información<br/>
                    y podrás hacer seguimiento de tu pedido en tiempo real
                </p>
                <a asp-controller="Productos" asp-action="Index" 
                   class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                    <i class="fas fa-shopping-bag mr-3"></i>
                    Explorar Productos
                </a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Smooth animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .space-y-6 > div {
            animation: fadeInUp 0.6s ease-out;
            animation-fill-mode: both;
        }

        .space-y-6 > div:nth-child(1) { animation-delay: 0.1s; }
        .space-y-6 > div:nth-child(2) { animation-delay: 0.2s; }
        .space-y-6 > div:nth-child(3) { animation-delay: 0.3s; }
        .space-y-6 > div:nth-child(4) { animation-delay: 0.4s; }
        .space-y-6 > div:nth-child(5) { animation-delay: 0.5s; }

        /* Pulse animation for status badges */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.8;
            }
        }

        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
}
