@model AldaJoyeros.DTOs.CheckoutViewModel
@{ViewData["Title"]="Finalizar Compra";}

<div class="container mx-auto px-6 py-8">
<div class="mb-8 text-center">
<h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center justify-center gap-3"><div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg"><i class="fas fa-credit-card text-white text-2xl"></i></div>Finalizar Compra</h1>
<p class="text-gray-600 text-lg">Estás a un paso de completar tu pedido</p>
</div>

<!-- Progress Steps -->
<div class="max-w-4xl mx-auto mb-12">
<div class="flex items-center justify-between relative">
<div class="absolute top-5 left-0 right-0 h-1 bg-gray-200 -z-10"></div>
<div class="absolute top-5 left-0 h-1 bg-emerald-500 -z-10" style="width: 50%;"></div>

<div class="flex flex-col items-center">
<div class="w-10 h-10 bg-emerald-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg mb-2"><i class="fas fa-check"></i></div>
<div class="text-center"><div class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Paso 1</div><div class="text-xs text-gray-600">Carrito</div></div>
</div>

<div class="flex flex-col items-center">
<div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold shadow-lg mb-2">2</div>
<div class="text-center"><div class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Paso 2</div><div class="text-xs text-gray-600">Dirección</div></div>
</div>

<div class="flex flex-col items-center">
<div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold shadow-md mb-2">3</div>
<div class="text-center"><div class="text-xs font-bold text-gray-400 uppercase tracking-wide">Paso 3</div><div class="text-xs text-gray-400">Confirmación</div></div>
</div>
</div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<div class="lg:col-span-2 space-y-8">
<!-- Resumen del Pedido -->
<div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
<h2 class="font-serif text-3xl font-bold text-gray-900 mb-6 flex items-center gap-2"><div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center"><i class="fas fa-shopping-cart text-emerald-600"></i></div>Resumen del Pedido</h2>

<div class="space-y-4">
@foreach(var item in Model.CarritoItems){
<div class="flex items-center gap-4 bg-gradient-to-br from-gray-50 to-emerald-50 rounded-xl p-4 border border-emerald-100">
<div class="flex-shrink-0"><div class="w-20 h-20 bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl overflow-hidden shadow-md">
@if(item.Producto?.TieneImagenes==true){<img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-cover"/>}else{<div class="w-full h-full flex items-center justify-center"><i class="fas fa-gem text-2xl text-emerald-600 opacity-30"></i></div>}
</div></div>
<div class="flex-1"><h3 class="font-bold text-gray-900 mb-1">@item.ProductoNombre</h3>
<p class="text-sm text-gray-600">Cantidad: <span class="font-bold text-emerald-600">@item.Cantidad</span> × @item.Precio.ToString("C")</p></div>
<div class="text-right"><div class="text-xl font-bold text-emerald-600">@item.Subtotal.ToString("C")</div></div>
</div>
}
</div>

<div class="mt-6 pt-6 border-t-2 border-gray-200 bg-gradient-to-r from-emerald-50 to-green-50 -mx-8 px-8 py-4 rounded-b-xl">
<div class="flex justify-between items-center"><span class="text-2xl font-bold text-gray-900">Total:</span><span class="text-4xl font-bold text-emerald-600">@Model.Total.ToString("C")</span></div>
</div>
</div>

<!-- Formulario de Checkout -->
<div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
<h2 class="font-serif text-3xl font-bold text-gray-900 mb-6 flex items-center gap-2"><div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center"><i class="fas fa-map-marker-alt text-blue-600"></i></div>Dirección de Envío</h2>

<form id="checkout-form" asp-action="Checkout" method="post" class="space-y-6">
<input type="hidden" asp-for="PaymentIntentId" id="payment-intent-id" />
<div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl mb-6 hidden"><div class="flex items-center"><i class="fas fa-exclamation-circle text-red-500 mr-3"></i><span class="text-red-800 text-sm"></span></div></div>

<!-- Campos de Dirección -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
<div class="md:col-span-3">
<label asp-for="Direccion.Calle" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-road text-blue-600 text-xs"></i></div>Calle</label>
<input asp-for="Direccion.Calle" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Nombre de la calle"/>
<span asp-validation-for="Direccion.Calle" class="text-red-500 text-sm mt-1 block"></span>
</div>
<div class="md:col-span-1">
<label asp-for="Direccion.Numero" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-purple-100 rounded-lg flex items-center justify-center"><i class="fas fa-hashtag text-purple-600 text-xs"></i></div>Número</label>
<input asp-for="Direccion.Numero" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Núm."/>
<span asp-validation-for="Direccion.Numero" class="text-red-500 text-sm mt-1 block"></span>
</div>
</div>

<div>
<label asp-for="Direccion.Piso" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-building text-indigo-600 text-xs"></i></div>Piso / Puerta (opcional)</label>
<input asp-for="Direccion.Piso" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Ej: 2º A"/>
<span asp-validation-for="Direccion.Piso" class="text-red-500 text-sm mt-1 block"></span>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div>
<label asp-for="Direccion.CodigoPostal" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-green-100 rounded-lg flex items-center justify-center"><i class="fas fa-mail-bulk text-green-600 text-xs"></i></div>Código Postal</label>
<input asp-for="Direccion.CodigoPostal" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="28001"/>
<span asp-validation-for="Direccion.CodigoPostal" class="text-red-500 text-sm mt-1 block"></span>
</div>
<div>
<label asp-for="Direccion.Ciudad" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-yellow-100 rounded-lg flex items-center justify-center"><i class="fas fa-city text-yellow-600 text-xs"></i></div>Ciudad</label>
<input asp-for="Direccion.Ciudad" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Madrid"/>
<span asp-validation-for="Direccion.Ciudad" class="text-red-500 text-sm mt-1 block"></span>
</div>
<div>
<label asp-for="Direccion.Provincia" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-map text-red-600 text-xs"></i></div>Provincia</label>
<input asp-for="Direccion.Provincia" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Madrid"/>
<span asp-validation-for="Direccion.Provincia" class="text-red-500 text-sm mt-1 block"></span>
</div>
</div>

<!-- Métodos de Pago -->
<div class="border-t border-gray-200 pt-8 mt-8">
<h3 class="font-serif text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2"><div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center"><i class="fas fa-credit-card text-emerald-600"></i></div>Método de Pago</h3>

<div class="space-y-3">
<!-- Contra Reembolso -->
<label class="payment-method-option flex items-center p-5 bg-gradient-to-r from-green-50 to-emerald-50 border-2 border-green-300 rounded-xl hover:border-green-500 hover:shadow-md cursor-pointer transition-all" data-method="Contra Reembolso">
<input type="radio" asp-for="MetodoPago" value="Contra Reembolso" checked class="w-5 h-5 text-green-600 focus:ring-green-500"/>
<div class="ml-4 flex-1"><div class="flex items-center gap-3"><div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center shadow-md"><i class="fas fa-money-bill-wave text-white text-xl"></i></div>
<div><div class="font-bold text-gray-900 text-lg">Contra Reembolso</div><div class="text-sm text-gray-600">Paga cuando recibas tu pedido en efectivo</div></div></div></div>
</label>

<!-- Tarjeta con Stripe -->
<label class="payment-method-option flex items-center p-5 bg-gradient-to-r from-indigo-50 to-purple-50 border-2 border-indigo-200 rounded-xl hover:border-indigo-400 hover:shadow-md cursor-pointer transition-all" data-method="Tarjeta">
<input type="radio" asp-for="MetodoPago" value="Tarjeta" class="w-5 h-5 text-indigo-600 focus:ring-indigo-500"/>
<div class="ml-4 flex-1"><div class="flex items-center gap-3"><div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-md"><i class="fab fa-stripe-s text-white text-xl"></i></div>
<div><div class="font-bold text-gray-900 text-lg">Tarjeta de Crédito/Débito</div><div class="text-sm text-gray-600">Pago seguro con <span class="text-indigo-600 font-semibold">Stripe</span></div></div></div></div>
</label>
</div>

<!-- Formulario de Stripe (oculto por defecto) -->
<div id="stripe-payment-section" class="hidden mt-6 p-6 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl border-2 border-indigo-200">
<div class="flex items-center gap-2 mb-4">
<i class="fab fa-stripe text-indigo-600 text-2xl"></i>
<span class="font-bold text-gray-900">Pago seguro con Stripe</span>
<span class="ml-auto px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-bold">MODO TEST</span>
</div>

<!-- Stripe Elements Container -->
<div id="payment-element" class="bg-white p-4 rounded-xl border-2 border-gray-200 min-h-[150px]">
<!-- Stripe Elements se montará aquí -->
</div>

<!-- Mensajes de error de Stripe -->
<div id="payment-errors" class="hidden mt-4 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
<div class="flex items-center"><i class="fas fa-exclamation-circle text-red-500 mr-3"></i><span id="error-message" class="text-red-800 text-sm"></span></div>
</div>

<!-- Tarjetas de prueba -->
<div class="mt-4 bg-white rounded-xl p-4 border border-indigo-100">
<div class="text-xs font-bold text-indigo-600 mb-2"><i class="fas fa-info-circle mr-1"></i>Tarjetas de prueba de Stripe:</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
<div class="flex items-center gap-2 bg-green-50 px-3 py-2 rounded-lg"><i class="fas fa-check-circle text-green-500"></i><span><strong>4242 4242 4242 4242</strong> - Éxito</span></div>
<div class="flex items-center gap-2 bg-red-50 px-3 py-2 rounded-lg"><i class="fas fa-times-circle text-red-500"></i><span><strong>4000 0000 0000 0002</strong> - Rechazada</span></div>
</div>
<div class="text-xs text-gray-500 mt-2">Usa cualquier fecha futura y CVC de 3 dígitos</div>
</div>
</div>

<span asp-validation-for="MetodoPago" class="text-red-500 text-sm mt-2 block"></span>
</div>

<hr class="border-gray-200 my-8"/>

<div class="flex flex-col sm:flex-row justify-between gap-4">
<a asp-controller="Carrito" asp-action="Index" class="inline-flex items-center justify-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all font-semibold"><i class="fas fa-arrow-left mr-2"></i>Volver al Carrito</a>
<button type="submit" id="submit-button" class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
<span id="button-text"><i class="fas fa-check mr-2"></i>Confirmar Pedido</span>
<span id="button-spinner" class="hidden"><i class="fas fa-spinner fa-spin mr-2"></i>Procesando...</span>
</button>
</div>
</form>
</div>
</div>

<!-- Sidebar -->
<div class="lg:col-span-1">
<div class="bg-white rounded-3xl shadow-xl p-6 space-y-6 sticky top-24 border border-gray-100">
<div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
<h3 class="font-serif text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center"><i class="fas fa-receipt text-white"></i></div>Total del Pedido</h3>
<div class="space-y-3 text-sm">
<div class="flex justify-between bg-white rounded-lg p-3"><span class="text-gray-600 font-medium">Productos:</span><span class="font-bold text-gray-900">@Model.CarritoItems.Count()</span></div>
<div class="flex justify-between bg-white rounded-lg p-3"><span class="text-gray-600 font-medium">Subtotal:</span><span class="font-bold text-gray-900">@Model.Total.ToString("C")</span></div>
<div class="flex justify-between bg-white rounded-lg p-3"><span class="text-gray-600 font-medium">Envío:</span><span class="font-bold text-green-600">GRATIS</span></div>
<div class="flex justify-between bg-gradient-to-r from-emerald-100 to-green-100 rounded-lg p-4 border-2 border-emerald-300"><span class="text-lg font-bold text-gray-900">Total:</span><span class="text-2xl font-bold text-emerald-600">@Model.Total.ToString("C")</span></div>
</div>
</div>

<div class="border-t border-gray-200 pt-6">
<h3 class="font-serif text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-info-circle text-blue-600"></i></div>Información de Envío</h3>
<div class="space-y-3">
<div class="flex items-start gap-3 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-3 border border-green-200">
<i class="fas fa-truck text-green-600 mt-1 text-lg"></i>
<div class="text-sm"><div class="font-bold text-gray-900">Envío en 3-5 días</div><div class="text-gray-600">Laborables a toda España</div></div>
</div>
<div class="flex items-start gap-3 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-3 border border-blue-200">
<i class="fas fa-shield-alt text-blue-600 mt-1 text-lg"></i>
<div class="text-sm"><div class="font-bold text-gray-900">100% Seguro</div><div class="text-gray-600">Compra protegida</div></div>
</div>
<div class="flex items-start gap-3 bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 border border-purple-200">
<i class="fas fa-undo text-purple-600 mt-1 text-lg"></i>
<div class="text-sm"><div class="font-bold text-gray-900">30 días devolución</div><div class="text-gray-600">Sin preguntas</div></div>
</div>
<div class="flex items-start gap-3 bg-gradient-to-r from-yellow-50 to-orange-50 rounded-lg p-3 border border-yellow-200">
<i class="fas fa-gift text-yellow-600 mt-1 text-lg"></i>
<div class="text-sm"><div class="font-bold text-gray-900">Empaquetado premium</div><div class="text-gray-600">Caja de regalo incluida</div></div>
</div>
</div>
</div>

<div class="border-t border-gray-200 pt-6">
<h3 class="font-serif text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center"><i class="fas fa-credit-card text-green-600"></i></div>Métodos de Pago</h3>
<div class="space-y-2 text-sm">
<div class="flex items-center gap-2 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-3 border border-green-200">
<i class="fas fa-check-circle text-green-600"></i>
<span class="font-medium text-gray-700">Contra reembolso</span>
</div>
<div class="flex items-center gap-2 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-3 border border-green-200">
<i class="fas fa-check-circle text-green-600"></i>
<span class="font-medium text-gray-700">Transferencia bancaria</span>
</div>
</div>
</div>

<div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-4 border border-blue-200">
<h4 class="font-bold text-gray-900 mb-2 flex items-center gap-2"><i class="fas fa-headset text-blue-600"></i>¿Necesitas ayuda?</h4>
<p class="text-xs text-gray-600 mb-3">Nuestro equipo está disponible</p>
<a href="#" class="text-blue-600 hover:text-blue-700 font-bold text-sm flex items-center group">Contactar soporte<i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></a>
</div>
</div>
</div>
</div>
</div>

@section Scripts{
<partial name="_ValidationScriptsPartial"/>
<!-- Stripe JS -->
<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripePublishableKey = '@Model.StripePublishableKey';
    let stripe = null;
    let elements = null;
    let paymentElement = null;

    // Inicializar Stripe cuando se selecciona pago con tarjeta
    document.querySelectorAll('input[name="MetodoPago"]').forEach(radio => {
        radio.addEventListener('change', async function() {
            const stripeSection = document.getElementById('stripe-payment-section');
            
            if (this.value === 'Tarjeta') {
                stripeSection.classList.remove('hidden');
                await initializeStripe();
            } else {
                stripeSection.classList.add('hidden');
            }
        });
    });

    async function initializeStripe() {
        if (!stripe) {
            stripe = Stripe(stripePublishableKey);
        }

        // Crear PaymentIntent en el servidor
        const response = await fetch('/Pedidos/CreatePaymentIntent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        
        if (!data.success) {
            showError(data.error || 'Error al inicializar el pago');
            return;
        }

        // Guardar el PaymentIntentId
        document.getElementById('payment-intent-id').value = data.paymentIntentId;

        // Crear Elements
        elements = stripe.elements({
            clientSecret: data.clientSecret,
            appearance: {
                theme: 'stripe',
                variables: {
                    colorPrimary: '#10b981',
                    colorBackground: '#ffffff',
                    colorText: '#1f2937',
                    colorDanger: '#ef4444',
                    fontFamily: 'system-ui, sans-serif',
                    borderRadius: '12px'
                }
            }
        });

        // Crear y montar el Payment Element
        paymentElement = elements.create('payment');
        paymentElement.mount('#payment-element');

        paymentElement.on('change', function(event) {
            if (event.error) {
                showError(event.error.message);
            } else {
                hideError();
            }
        });
    }

    function showError(message) {
        const errorDiv = document.getElementById('payment-errors');
        const errorMessage = document.getElementById('error-message');
        errorDiv.classList.remove('hidden');
        errorMessage.textContent = message;
    }

    function hideError() {
        document.getElementById('payment-errors').classList.add('hidden');
    }

    function setLoading(isLoading) {
        const submitBtn = document.getElementById('submit-button');
        const buttonText = document.getElementById('button-text');
        const buttonSpinner = document.getElementById('button-spinner');

        submitBtn.disabled = isLoading;
        buttonText.classList.toggle('hidden', isLoading);
        buttonSpinner.classList.toggle('hidden', !isLoading);
    }

    // Manejar envío del formulario
    document.getElementById('checkout-form').addEventListener('submit', async function(e) {
        const metodoPago = document.querySelector('input[name="MetodoPago"]:checked').value;

        if (metodoPago !== 'Tarjeta') {
            // Contra reembolso - enviar formulario normalmente
            return true;
        }

        // Pago con tarjeta - procesar con Stripe
        e.preventDefault();
        setLoading(true);
        hideError();

        try {
            const { error, paymentIntent } = await stripe.confirmPayment({
                elements,
                confirmParams: {
                    return_url: window.location.href, // No se usará realmente
                },
                redirect: 'if_required'
            });

            if (error) {
                showError(error.message);
                setLoading(false);
                return;
            }

            if (paymentIntent && paymentIntent.status === 'succeeded') {
                // Pago exitoso - enviar formulario
                document.getElementById('payment-intent-id').value = paymentIntent.id;
                this.submit();
            } else {
                showError('El pago no se completó correctamente');
                setLoading(false);
            }
        } catch (err) {
            showError('Error al procesar el pago: ' + err.message);
            setLoading(false);
        }
    });
</script>
}
