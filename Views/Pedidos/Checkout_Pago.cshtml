@model AldaJoyeros.DTOs.CheckoutPagoViewModel
@{
    ViewData["Title"] = "Método de pago";
    var totalItems = Model.CarritoItems.Sum(x => x.Cantidad);
    var isTestMode = Model.StripePublishableKey?.StartsWith("pk_test_", StringComparison.Ordinal) == true;
}

<div class="bg-gray-50 pb-8">
    <partial name="_CompraCabecera" model='new AldaJoyeros.DTOs.CompraCabeceraViewModel(3, "Elige cómo pagar", "Selecciona tu método de pago para continuar con el pedido.")' />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
            <form id="payment-form" asp-action="ConfirmarPago" method="post" class="lg:col-span-2 min-w-0 space-y-5"
                  data-stripe-key="@Model.StripePublishableKey" data-intent-url="@Url.Action("CreatePaymentIntent", "Pedidos")" data-total="@Model.Total.ToString("C")">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PaymentIntentId" id="payment-intent-id" />
                <div asp-validation-summary="All" class="text-sm text-red-700" role="alert"></div>
                <section class="bg-white rounded-2xl border border-gray-200 p-4 sm:p-6">
                    <div class="flex items-start gap-3">
                        <span class="w-10 h-10 shrink-0 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-700"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
                        <div class="flex-1 min-w-0">
                            <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Dirección de entrega</h2>
                            <p class="font-medium text-gray-900 break-words">@Model.Direccion.Calle, @Model.Direccion.Numero @if (!string.IsNullOrEmpty(Model.Direccion.Piso)) { <span>— @Model.Direccion.Piso</span> }</p>
                            <p class="text-sm text-gray-500 mt-1 break-words">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad, @Model.Direccion.Provincia</p>
                        </div>
                        <a asp-action="Checkout" class="text-xs sm:text-sm font-semibold text-emerald-700 hover:underline shrink-0">Cambiar</a>
                    </div>
                </section>
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="p-4 sm:p-6 border-b border-gray-100">
                        <h2 class="text-lg font-semibold text-gray-900">Método de pago</h2>
                        <p class="text-sm text-gray-500 mt-1">Selecciona la opción que prefieras.</p>
                    </div>
                    <div class="p-4 sm:p-6 space-y-4">
                        <fieldset class="space-y-3">
                            <legend class="sr-only">Elige un método de pago</legend>
                            <label class="payment-option flex items-start gap-3 p-4 border-2 border-emerald-600 bg-emerald-50 rounded-xl cursor-pointer transition-colors focus-within:ring-2 focus-within:ring-emerald-600 focus-within:ring-offset-2" data-method="Contra Reembolso">
                                <input type="radio" name="MetodoPago" value="Contra Reembolso" checked class="mt-1 w-4 h-4 shrink-0 accent-emerald-600" />
                                <span class="flex-1 min-w-0"><span class="block font-semibold text-gray-900">Contra reembolso</span><span class="block text-sm text-gray-500 mt-1">Paga en efectivo al recibir tu pedido.</span></span>
                                <i class="fas fa-money-bill-wave text-emerald-700 mt-1" aria-hidden="true"></i>
                            </label>
                            <label class="payment-option flex items-start gap-3 p-4 border-2 border-gray-200 rounded-xl cursor-pointer transition-colors hover:border-gray-300 focus-within:ring-2 focus-within:ring-emerald-600 focus-within:ring-offset-2" data-method="Tarjeta">
                                <input type="radio" name="MetodoPago" value="Tarjeta" class="mt-1 w-4 h-4 shrink-0 accent-emerald-600" />
                                <span class="flex-1 min-w-0"><span class="block font-semibold text-gray-900">Tarjeta de crédito o débito</span><span class="block text-sm text-gray-500 mt-1">Introduce tus datos en el formulario seguro de Stripe.</span><span class="flex items-center gap-3 mt-3 text-xl text-gray-600"><i class="fab fa-cc-visa" aria-label="Visa"></i><i class="fab fa-cc-mastercard" aria-label="Mastercard"></i><span class="text-xs font-medium text-gray-500">Stripe</span></span></span>
                                <i class="fas fa-credit-card text-gray-500 mt-1" aria-hidden="true"></i>
                            </label>
                        </fieldset>
                        <div id="stripe-section" class="hidden pt-2 space-y-4">
                            @if (isTestMode)
                            {
                                <div class="rounded-xl bg-amber-50 border border-amber-200 p-4 text-sm text-amber-900"><p class="font-semibold"><i class="fas fa-flask mr-2" aria-hidden="true"></i>Estás en modo de prueba</p><p class="mt-1">No se realizarán cargos reales.</p></div>
                            }
                            <div class="rounded-xl border border-gray-200 p-4 sm:p-5">
                                <div class="flex items-center justify-between gap-3 mb-4"><h3 class="font-semibold text-sm text-gray-900">Datos de pago</h3><span class="text-xs text-gray-500"><i class="fas fa-lock mr-1" aria-hidden="true"></i>Stripe</span></div>
                                <div id="payment-loading" role="status" class="flex items-center justify-center gap-3 py-8 text-sm text-gray-500"><i class="fas fa-circle-notch fa-spin text-emerald-600" aria-hidden="true"></i>Preparando el formulario seguro…</div>
                                <div id="payment-element" class="min-w-0" aria-busy="true"></div>
                            </div>
                            <div id="payment-errors" role="alert" tabindex="-1" class="hidden rounded-xl bg-red-50 border border-red-200 p-4 text-sm text-red-800"><div class="flex items-start gap-2"><i class="fas fa-exclamation-circle mt-0.5" aria-hidden="true"></i><span id="error-message" class="flex-1"></span></div><button type="button" id="payment-retry" class="hidden mt-3 font-semibold underline underline-offset-4">Volver a cargar el formulario</button></div>
                            <p class="text-xs leading-relaxed text-gray-500">Stripe gestiona los datos de tu tarjeta. Al pulsar «Pagar y continuar» se realizará el pago y pasarás a la confirmación del pedido.</p>
                            @if (isTestMode)
                            {
                                <details class="text-xs text-gray-500 rounded-xl bg-gray-50 border border-gray-100 p-4"><summary class="cursor-pointer font-medium">Datos para probar el pago</summary><div class="mt-3 space-y-2"><code class="block text-gray-800 tracking-wide">4242 4242 4242 4242</code><p>Utiliza una fecha futura y un CVC de tres cifras.</p></div></details>
                            }
                        </div>
                    </div>
                </section>
                <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-5">
                    <div class="flex flex-col sm:flex-row-reverse sm:items-center justify-between gap-4">
                        <button type="submit" id="submit-btn" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-5 sm:px-7 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold shadow-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed"><span id="btn-text">Continuar a confirmación</span><span id="btn-loading" class="hidden"><i class="fas fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>Procesando pago…</span><i class="fas fa-arrow-right text-xs" id="btn-arrow" aria-hidden="true"></i></button>
                        <a asp-action="Checkout" class="text-sm text-center font-medium text-gray-500 hover:text-gray-900"><i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>Volver a dirección</a>
                    </div>
                </div>
            </form>
            <aside aria-label="Resumen del pedido" class="min-w-0 lg:sticky lg:top-24">
                <partial name="_CompraResumen" model="new AldaJoyeros.DTOs.CompraResumenViewModel(Model.CarritoItems, Model.Total)" />
                <a asp-controller="Carrito" asp-action="Index" class="block text-center text-xs font-medium text-gray-500 hover:text-emerald-700 mt-4">Volver al carrito</a>
</aside>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/checkout-pago.js" asp-append-version="true"></script>
}