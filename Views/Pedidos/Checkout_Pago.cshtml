@model AldaJoyeros.DTOs.CheckoutPagoViewModel
@{
    ViewData["Title"] = "Checkout - Pago";
    var totalItems = Model.CarritoItems.Sum(x => x.Cantidad);
}

<!-- Header -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 py-10">
    <div class="container mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">
                <i class="fas fa-home"></i>
            </a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <a asp-controller="Carrito" asp-action="Index" class="hover:text-white transition-colors">Carrito</a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <span class="text-emerald-400">Pago</span>
        </nav>
        <h1 class="text-3xl font-bold text-white">Método de pago</h1>
    </div>
</div>

<!-- Progress Steps -->
<div class="bg-white border-b border-gray-100 sticky top-16 z-40">
    <div class="container mx-auto px-4 sm:px-6 py-4">
        <div class="flex items-center justify-center gap-4 md:gap-8">
            <!-- Step 1 - Completed -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center text-white text-sm">
                    <i class="fas fa-check"></i>
                </div>
                <span class="hidden sm:block text-sm font-medium text-emerald-600">Dirección</span>
            </div>
            <div class="w-8 md:w-16 h-0.5 bg-emerald-500"></div>
            <!-- Step 2 - Active -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center text-white text-sm font-bold">2</div>
                <span class="hidden sm:block text-sm font-medium text-emerald-600">Pago</span>
            </div>
            <div class="w-8 md:w-16 h-0.5 bg-gray-200"></div>
            <!-- Step 3 -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 text-sm font-bold">3</div>
                <span class="hidden sm:block text-sm font-medium text-gray-400">Confirmación</span>
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Formulario -->
            <div class="lg:col-span-2 space-y-6">
                <form id="payment-form" asp-action="ConfirmarPago" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PaymentIntentId" id="payment-intent-id" />

                    <!-- Dirección de envío -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-map-marker-alt text-emerald-600"></i>
                                </div>
                                <div>
                                    <div class="text-sm text-gray-500 mb-1">Enviar a</div>
                                    <div class="font-medium text-gray-900">
                                        @Model.Direccion.Calle, @Model.Direccion.Numero
                                        @if (!string.IsNullOrEmpty(Model.Direccion.Piso))
                                        {
                                            <span>- @Model.Direccion.Piso</span>
                                        }
                                    </div>
                                    <div class="text-sm text-gray-500">@Model.Direccion.CodigoPostal @Model.Direccion.Ciudad, @Model.Direccion.Provincia</div>
                                </div>
                            </div>
                            <a asp-action="Checkout" class="text-emerald-600 hover:text-emerald-700 text-sm font-medium">
                                Cambiar
                            </a>
                        </div>
                    </div>

                    <!-- Métodos de pago -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100">
                            <h2 class="font-bold text-gray-900 flex items-center gap-2">
                                <i class="fas fa-credit-card text-emerald-500"></i>
                                Selecciona método de pago
                            </h2>
                        </div>

                        <div class="p-6 space-y-4">
                            <!-- Contra Reembolso -->
                            <label class="payment-option flex items-center gap-4 p-4 border-2 border-emerald-500 bg-emerald-50 rounded-xl cursor-pointer transition-all" data-method="Contra Reembolso">
                                <input type="radio" name="MetodoPago" value="Contra Reembolso" checked 
                                       class="w-5 h-5 text-emerald-500 border-gray-300 focus:ring-emerald-500" />
                                <div class="w-12 h-12 bg-emerald-500 rounded-xl flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-money-bill-wave text-white text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="font-semibold text-gray-900">Contra Reembolso</div>
                                    <div class="text-sm text-gray-500">Paga en efectivo al recibir tu pedido</div>
                                </div>
                                <i class="fas fa-check-circle text-emerald-500 text-xl"></i>
                            </label>

                            <!-- Tarjeta -->
                            <label class="payment-option flex items-center gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer transition-all hover:border-gray-300" data-method="Tarjeta">
                                <input type="radio" name="MetodoPago" value="Tarjeta" 
                                       class="w-5 h-5 text-indigo-500 border-gray-300 focus:ring-indigo-500" />
                                <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0">
                                    <i class="fab fa-stripe-s text-white text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="font-semibold text-gray-900">Tarjeta de crédito/débito</div>
                                    <div class="text-sm text-gray-500 flex items-center gap-2">
                                        <span>Pago seguro con Stripe</span>
                                        <i class="fab fa-cc-visa text-blue-600"></i>
                                        <i class="fab fa-cc-mastercard text-orange-500"></i>
                                    </div>
                                </div>
                                <i class="fas fa-check-circle text-indigo-500 text-xl opacity-0 check-icon"></i>
                            </label>

                            <!-- Stripe Elements -->
                            <div id="stripe-section" class="hidden pl-16 space-y-4">
                                <!-- Test mode badge -->
                                <div class="flex items-center gap-2 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-700">
                                    <i class="fas fa-flask"></i>
                                    <span>Modo de prueba - No se realizarán cargos reales</span>
                                </div>

                                <!-- Payment element -->
                                <div id="payment-element" class="p-4 bg-gray-50 rounded-xl border border-gray-200 min-h-[100px]">
                                    <div class="flex items-center justify-center h-20 text-gray-400">
                                        <i class="fas fa-spinner fa-spin mr-2"></i>Cargando formulario...
                                    </div>
                                </div>

                                <!-- Error -->
                                <div id="payment-errors" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
                                    <i class="fas fa-exclamation-circle mr-1"></i>
                                    <span id="error-message"></span>
                                </div>

                                <!-- Test cards -->
                                <div class="p-3 bg-gray-50 rounded-lg">
                                    <div class="text-xs font-medium text-gray-500 mb-2">Tarjetas de prueba:</div>
                                    <div class="flex flex-wrap gap-2 text-xs">
                                        <code class="px-2 py-1 bg-white border border-gray-200 rounded text-gray-600">4242 4242 4242 4242</code>
                                        <span class="text-gray-400">? Éxito</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4">
                        <a asp-action="Checkout" class="inline-flex items-center justify-center gap-2 px-6 py-3 text-gray-600 hover:text-gray-900 font-medium transition-colors">
                            <i class="fas fa-arrow-left"></i>
                            <span>Volver</span>
                        </a>
                        <button type="submit" id="submit-btn" 
                                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl transition-all shadow-lg shadow-emerald-500/20 disabled:opacity-50 disabled:cursor-not-allowed">
                            <span id="btn-text">Confirmar pedido</span>
                            <span id="btn-loading" class="hidden">
                                <i class="fas fa-spinner fa-spin mr-1"></i>Procesando...
                            </span>
                            <i class="fas fa-arrow-right" id="btn-arrow"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Resumen -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden sticky top-36">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <h3 class="font-bold text-gray-900">Resumen del pedido</h3>
                    </div>

                    <!-- Items -->
                    <div class="p-4 space-y-3 max-h-48 overflow-y-auto">
                        @foreach (var item in Model.CarritoItems)
                        {
                            <div class="flex items-center gap-3">
                                <div class="relative flex-shrink-0">
                                    <div class="w-12 h-12 bg-gray-100 rounded-lg overflow-hidden">
                                        @if (item.Producto?.TieneImagenes == true)
                                        {
                                            <img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="fas fa-gem text-gray-300"></i>
                                            </div>
                                        }
                                    </div>
                                    <span class="absolute -top-1 -right-1 w-5 h-5 bg-gray-700 text-white text-xs rounded-full flex items-center justify-center">
                                        @item.Cantidad
                                    </span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-medium text-gray-900 truncate">@item.ProductoNombre</div>
                                </div>
                                <div class="text-sm font-bold text-gray-900">@item.Subtotal.ToString("C")</div>
                            </div>
                        }
                    </div>

                    <!-- Totales -->
                    <div class="p-6 border-t border-gray-100 space-y-3">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Subtotal (@totalItems artículos)</span>
                            <span class="font-medium">@Model.Total.ToString("C")</span>
                        </div>
                        <div class="flex justify-between pt-3 border-t border-gray-100">
                            <span class="font-bold text-gray-900">Total</span>
                            <span class="text-xl font-bold text-emerald-600">@Model.Total.ToString("C")</span>
                        </div>
                    </div>

                    <!-- Security -->
                    <div class="px-6 pb-6 space-y-2">
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            <i class="fas fa-lock text-emerald-500"></i>
                            <span>Pago seguro y encriptado</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            <i class="fas fa-shield-alt text-emerald-500"></i>
                            <span>Protección al comprador</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripeKey = '@Model.StripePublishableKey';
        let stripe = null;
        let elements = null;
        let paymentElement = null;
        let stripeReady = false;

        // Payment option selection
        document.querySelectorAll('.payment-option').forEach(option => {
            const radio = option.querySelector('input[type="radio"]');
            
            radio.addEventListener('change', async function() {
                // Reset all options
                document.querySelectorAll('.payment-option').forEach(o => {
                    o.classList.remove('border-emerald-500', 'border-indigo-500', 'bg-emerald-50', 'bg-indigo-50');
                    o.classList.add('border-gray-200');
                    const check = o.querySelector('.check-icon');
                    if (check) check.classList.add('opacity-0');
                });
                
                // Apply selected state
                const method = option.dataset.method;
                if (method === 'Tarjeta') {
                    option.classList.remove('border-gray-200');
                    option.classList.add('border-indigo-500', 'bg-indigo-50');
                    option.querySelector('.check-icon').classList.remove('opacity-0');
                    document.getElementById('stripe-section').classList.remove('hidden');
                    await initStripe();
                } else {
                    option.classList.remove('border-gray-200');
                    option.classList.add('border-emerald-500', 'bg-emerald-50');
                    document.getElementById('stripe-section').classList.add('hidden');
                }
            });
            
            // Initialize default selection
            if (radio.checked) {
                if (option.dataset.method === 'Contra Reembolso') {
                    option.classList.add('border-emerald-500', 'bg-emerald-50');
                }
            }
        });

        async function initStripe() {
            if (stripeReady) return;
            
            stripe = Stripe(stripeKey);
            
            const response = await fetch('/Pedidos/CreatePaymentIntent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            
            const data = await response.json();
            
            if (!data.success) {
                showError(data.error || 'Error al inicializar el pago');
                return;
            }
            
            document.getElementById('payment-intent-id').value = data.paymentIntentId;
            
            elements = stripe.elements({
                clientSecret: data.clientSecret,
                appearance: {
                    theme: 'stripe',
                    variables: {
                        colorPrimary: '#6366f1',
                        colorBackground: '#ffffff',
                        borderRadius: '8px'
                    }
                }
            });
            
            paymentElement = elements.create('payment');
            document.getElementById('payment-element').innerHTML = '';
            paymentElement.mount('#payment-element');
            
            paymentElement.on('change', (e) => {
                if (e.error) showError(e.error.message);
                else hideError();
            });
            
            stripeReady = true;
        }

        function showError(msg) {
            const errorDiv = document.getElementById('payment-errors');
            errorDiv.classList.remove('hidden');
            document.getElementById('error-message').textContent = msg;
        }

        function hideError() {
            document.getElementById('payment-errors').classList.add('hidden');
        }

        function setLoading(loading) {
            const btn = document.getElementById('submit-btn');
            btn.disabled = loading;
            document.getElementById('btn-text').classList.toggle('hidden', loading);
            document.getElementById('btn-arrow').classList.toggle('hidden', loading);
            document.getElementById('btn-loading').classList.toggle('hidden', !loading);
        }

        document.getElementById('payment-form').addEventListener('submit', async function(e) {
            const method = document.querySelector('input[name="MetodoPago"]:checked').value;
            
            if (method !== 'Tarjeta') return true;
            
            e.preventDefault();
            setLoading(true);
            hideError();
            
            try {
                const { error, paymentIntent } = await stripe.confirmPayment({
                    elements,
                    confirmParams: { return_url: window.location.href },
                    redirect: 'if_required'
                });
                
                if (error) {
                    showError(error.message);
                    setLoading(false);
                    return;
                }
                
                if (paymentIntent?.status === 'succeeded') {
                    document.getElementById('payment-intent-id').value = paymentIntent.id;
                    this.submit();
                } else {
                    showError('El pago no se completó correctamente');
                    setLoading(false);
                }
            } catch (err) {
                showError(err.message);
                setLoading(false);
            }
        });
    </script>
}
