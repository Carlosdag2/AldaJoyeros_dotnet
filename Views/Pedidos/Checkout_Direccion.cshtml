@model AldaJoyeros.DTOs.CheckoutDireccionViewModel
@{
    ViewData["Title"] = "Checkout - Dirección";
    var direccionesGuardadas = Model.DireccionesGuardadas.ToList();
    var tieneDirecciones = direccionesGuardadas.Any();
    var totalItems = Model.CarritoItems.Sum(x => x.Cantidad);
}

<!-- Header -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 py-10">
    <div class="container mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">
                <i class="fas fa-home"></i>
            </a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <a asp-controller="Carrito" asp-action="Index" class="hover:text-white transition-colors">Carrito</a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <span class="text-emerald-400">Checkout</span>
        </nav>
        <h1 class="text-3xl font-bold text-white">Finalizar compra</h1>
    </div>
</div>

<!-- Progress Steps -->
<div class="bg-white border-b border-gray-100 sticky top-16 z-40">
    <div class="container mx-auto px-4 sm:px-6 py-4">
        <div class="flex items-center justify-center gap-4 md:gap-8">
            <!-- Step 1 -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center text-white text-sm font-bold">1</div>
                <span class="hidden sm:block text-sm font-medium text-emerald-600">Dirección</span>
            </div>
            <div class="w-8 md:w-16 h-0.5 bg-gray-200"></div>
            <!-- Step 2 -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 text-sm font-bold">2</div>
                <span class="hidden sm:block text-sm font-medium text-gray-400">Pago</span>
            </div>
            <div class="w-8 md:w-16 h-0.5 bg-gray-200"></div>
            <!-- Step 3 -->
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 text-sm font-bold">3</div>
                <span class="hidden sm:block text-sm font-medium text-gray-400">Confirmación</span>
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Formulario -->
            <div class="lg:col-span-2">
                <form asp-action="GuardarDireccion" method="post" class="space-y-6" id="direccionForm">
                    @Html.AntiForgeryToken()

                    @if (tieneDirecciones)
                    {
                        <!-- Direcciones Guardadas -->
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                            <div class="px-6 py-4 border-b border-gray-100">
                                <h2 class="font-bold text-gray-900 flex items-center gap-2">
                                    <i class="fas fa-bookmark text-emerald-500"></i>
                                    Direcciones guardadas
                                </h2>
                            </div>
                            <div class="p-4 space-y-3">
                                @foreach (var dir in direccionesGuardadas)
                                {
                                    <label class="direccion-option flex items-start gap-4 p-4 border-2 border-gray-100 rounded-xl cursor-pointer transition-all hover:border-emerald-300 hover:bg-emerald-50/50">
                                        <input type="radio" name="DireccionSeleccionadaId" value="@dir.Id" 
                                               class="mt-1 w-5 h-5 text-emerald-500 border-gray-300 focus:ring-emerald-500" 
                                               onclick="seleccionarDireccionGuardada(this)" />
                                        <div class="flex-1">
                                            <div class="font-medium text-gray-900">
                                                @dir.Calle, @dir.Numero
                                                @if (!string.IsNullOrEmpty(dir.Piso))
                                                {
                                                    <span class="text-gray-500">- @dir.Piso</span>
                                                }
                                            </div>
                                            <div class="text-sm text-gray-500 mt-1">
                                                @dir.CodigoPostal @dir.Ciudad, @dir.Provincia
                                            </div>
                                        </div>
                                        <i class="fas fa-check-circle text-emerald-500 text-lg opacity-0 check-icon"></i>
                                    </label>
                                }
                            </div>
                            <div class="px-4 pb-4">
                                <button type="button" onclick="mostrarFormularioNueva()" 
                                        class="w-full flex items-center justify-center gap-2 p-3 border-2 border-dashed border-gray-200 rounded-xl text-gray-500 hover:border-emerald-400 hover:text-emerald-600 hover:bg-emerald-50 transition-all">
                                    <i class="fas fa-plus"></i>
                                    <span>Usar otra dirección</span>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Nueva Dirección -->
                    <div id="nueva-direccion-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden @(tieneDirecciones ? "hidden" : "")">
                        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                            <h2 class="font-bold text-gray-900 flex items-center gap-2">
                                <i class="fas fa-map-marker-alt text-emerald-500"></i>
                                @(tieneDirecciones ? "Nueva dirección" : "Dirección de envío")
                            </h2>
                            @if (tieneDirecciones)
                            {
                                <button type="button" onclick="ocultarFormularioNueva()" class="text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                        </div>
                        
                        <input type="hidden" name="UsarNuevaDireccion" value="@(!tieneDirecciones ? "true" : "false")" id="usar-nueva-hidden" />

                        <div class="p-6 space-y-4">
                            <!-- Calle y Número -->
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                <div class="md:col-span-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Calle *</label>
                                    <input asp-for="NuevaDireccion.Calle" 
                                           class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" 
                                           placeholder="Nombre de la calle" />
                                    <span asp-validation-for="NuevaDireccion.Calle" class="text-red-500 text-sm"></span>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Número *</label>
                                    <input asp-for="NuevaDireccion.Numero" 
                                           class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" 
                                           placeholder="Nº" />
                                    <span asp-validation-for="NuevaDireccion.Numero" class="text-red-500 text-sm"></span>
                                </div>
                            </div>

                            <!-- Piso -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Piso / Puerta <span class="text-gray-400">(opcional)</span></label>
                                <input asp-for="NuevaDireccion.Piso" 
                                       class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" 
                                       placeholder="Ej: 2º A" />
                            </div>

                            <!-- CP, Provincia, Ciudad -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                        Código Postal *
                                        <span id="cp-loading" class="hidden ml-2">
                                            <i class="fas fa-spinner fa-spin text-emerald-500"></i>
                                        </span>
                                    </label>
                                    <div class="relative">
                                        <input asp-for="NuevaDireccion.CodigoPostal" 
                                               id="codigoPostalInput"
                                               class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" 
                                               placeholder="28001"
                                               maxlength="5"
                                               pattern="[0-9]{5}" />
                                        <div id="cp-check" class="absolute right-3 top-1/2 -translate-y-1/2 hidden">
                                            <i class="fas fa-check-circle text-emerald-500"></i>
                                        </div>
                                    </div>
                                    <span asp-validation-for="NuevaDireccion.CodigoPostal" class="text-red-500 text-sm"></span>
                                    <p id="cp-hint" class="text-xs text-gray-400 mt-1">Al introducir el CP se rellenará automáticamente la provincia y ciudad</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Provincia *</label>
                                    <div class="relative">
                                        <select name="NuevaDireccion.Provincia" 
                                                id="provinciaSelect"
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none appearance-none bg-white cursor-pointer">
                                            <option value="">Selecciona provincia</option>
                                        </select>
                                        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
                                            <i class="fas fa-chevron-down text-gray-400"></i>
                                        </div>
                                    </div>
                                    <span id="provincia-error" class="text-red-500 text-sm hidden">La provincia es obligatoria</span>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Ciudad *</label>
                                    <div class="relative">
                                        <select name="NuevaDireccion.Ciudad" 
                                                id="ciudadSelect"
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none appearance-none bg-white cursor-pointer"
                                                disabled>
                                            <option value="">Primero selecciona provincia</option>
                                        </select>
                                        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
                                            <i class="fas fa-chevron-down text-gray-400"></i>
                                        </div>
                                    </div>
                                    <span id="ciudad-error" class="text-red-500 text-sm hidden">La ciudad es obligatoria</span>
                                    <p id="ciudad-otra-hint" class="text-xs text-gray-400 mt-1 hidden">
                                        <i class="fas fa-info-circle mr-1"></i>Si tu ciudad no aparece, puedes escribirla directamente
                                    </p>
                                </div>
                            </div>

                            <!-- Input para ciudad personalizada -->
                            <div id="ciudad-custom-container" class="hidden">
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    <i class="fas fa-edit text-emerald-500 mr-1"></i>
                                    Escribe tu ciudad
                                </label>
                                <input type="text" 
                                       id="ciudadCustomInput"
                                       class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" 
                                       placeholder="Nombre de tu ciudad o localidad" />
                            </div>

                            <!-- Guardar dirección -->
                            <div class="pt-2">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" name="GuardarDireccion" value="true" 
                                           class="w-5 h-5 text-emerald-500 border-gray-300 rounded focus:ring-emerald-500" />
                                    <div>
                                        <span class="font-medium text-gray-900">Guardar esta dirección</span>
                                        <p class="text-sm text-gray-500">Para futuras compras</p>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="flex flex-col sm:flex-row justify-between gap-4">
                        <a asp-controller="Carrito" asp-action="Index" 
                           class="inline-flex items-center justify-center gap-2 px-6 py-3 text-gray-600 hover:text-gray-900 font-medium transition-colors">
                            <i class="fas fa-arrow-left"></i>
                            <span>Volver al carrito</span>
                        </a>
                        <button type="submit" 
                                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl transition-all shadow-lg shadow-emerald-500/20">
                            <span>Continuar al pago</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Resumen -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden sticky top-36">
                    <div class="px-6 py-4 border-b border-gray-100">
                        <h3 class="font-bold text-gray-900">Resumen del pedido</h3>
                    </div>

                    <!-- Items -->
                    <div class="p-4 space-y-3 max-h-64 overflow-y-auto">
                        @foreach (var item in Model.CarritoItems)
                        {
                            <div class="flex items-center gap-3">
                                <div class="relative flex-shrink-0">
                                    <div class="w-14 h-14 bg-gray-100 rounded-lg overflow-hidden">
                                        @if (item.Producto?.TieneImagenes == true)
                                        {
                                            <img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="fas fa-gem text-gray-300"></i>
                                            </div>
                                        }
                                    </div>
                                    <span class="absolute -top-1 -right-1 w-5 h-5 bg-gray-700 text-white text-xs rounded-full flex items-center justify-center">
                                        @item.Cantidad
                                    </span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-medium text-gray-900 truncate">@item.ProductoNombre</div>
                                    <div class="text-sm text-gray-500">@item.Precio.ToString("C")</div>
                                </div>
                                <div class="text-sm font-bold text-gray-900">@item.Subtotal.ToString("C")</div>
                            </div>
                        }
                    </div>

                    <!-- Totales -->
                    <div class="p-6 border-t border-gray-100 space-y-3">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Subtotal (@totalItems artículos)</span>
                            <span class="font-medium">@Model.Total.ToString("C")</span>
                        </div>
                        <div class="flex justify-between pt-3 border-t border-gray-100">
                            <span class="font-bold text-gray-900">Total</span>
                            <span class="text-xl font-bold text-emerald-600">@Model.Total.ToString("C")</span>
                        </div>
                    </div>

                    <!-- Security badges -->
                    <div class="px-6 pb-6">
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            <i class="fas fa-lock text-emerald-500"></i>
                            <span>Pago seguro garantizado</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Variables globales
        let provinciasData = [];
        let ciudadesCache = {};
        let debounceTimer;

        // Inicialización
        document.addEventListener('DOMContentLoaded', async function() {
            await cargarProvincias();
            setupEventListeners();
            setupFormValidation();
        });

        // Cargar provincias desde la API
        async function cargarProvincias() {
            try {
                const response = await fetch('/api/ubicacion/provincias');
                if (response.ok) {
                    provinciasData = await response.json();
                    poblarSelectProvincias();
                }
            } catch (error) {
                console.error('Error cargando provincias:', error);
            }
        }

        // Poblar el select de provincias
        function poblarSelectProvincias() {
            const select = document.getElementById('provinciaSelect');
            const currentValue = select.value;
            
            select.innerHTML = '<option value="">Selecciona provincia</option>';
            
            provinciasData.forEach(prov => {
                const option = document.createElement('option');
                option.value = prov.nombre;
                option.textContent = prov.nombre;
                if (prov.nombre === currentValue) {
                    option.selected = true;
                }
                select.appendChild(option);
            });
        }

        // Cargar ciudades por provincia
        async function cargarCiudades(provincia) {
            const select = document.getElementById('ciudadSelect');
            
            if (!provincia) {
                select.innerHTML = '<option value="">Primero selecciona provincia</option>';
                select.disabled = true;
                return;
            }

            // Verificar caché
            if (ciudadesCache[provincia]) {
                poblarSelectCiudades(ciudadesCache[provincia], provincia);
                return;
            }

            select.innerHTML = '<option value="">Cargando...</option>';
            select.disabled = true;

            try {
                const response = await fetch(`/api/ubicacion/ciudades/${encodeURIComponent(provincia)}`);
                if (response.ok) {
                    const ciudades = await response.json();
                    ciudadesCache[provincia] = ciudades;
                    poblarSelectCiudades(ciudades, provincia);
                }
            } catch (error) {
                console.error('Error cargando ciudades:', error);
                select.innerHTML = '<option value="">Error al cargar</option>';
            }
        }

        // Poblar el select de ciudades
        function poblarSelectCiudades(ciudades, provincia) {
            const select = document.getElementById('ciudadSelect');
            const currentValue = select.value || select.getAttribute('data-pending-value');
            
            select.innerHTML = '<option value="">Selecciona ciudad</option>';
            
            ciudades.forEach(ciudad => {
                const option = document.createElement('option');
                option.value = ciudad;
                option.textContent = ciudad;
                if (ciudad === currentValue) {
                    option.selected = true;
                }
                select.appendChild(option);
            });

            // Añadir opción "Otra"
            const otraOption = document.createElement('option');
            otraOption.value = "__otra__";
            otraOption.textContent = "?? Otra ciudad (escribir)";
            select.appendChild(otraOption);

            select.disabled = false;
            select.removeAttribute('data-pending-value');
            
            document.getElementById('ciudad-otra-hint').classList.remove('hidden');
            
            // Limpiar error si hay valor
            if (select.value && select.value !== '__otra__') {
                clearFieldError('ciudad');
            }
        }

        // Buscar por código postal
        async function buscarPorCodigoPostal(cp) {
            if (cp.length !== 5) return;

            const loading = document.getElementById('cp-loading');
            const check = document.getElementById('cp-check');
            
            loading.classList.remove('hidden');
            check.classList.add('hidden');

            try {
                const response = await fetch(`/api/ubicacion/codigopostal/${cp}`);
                if (response.ok) {
                    const data = await response.json();
                    
                    // Establecer provincia
                    const provinciaSelect = document.getElementById('provinciaSelect');
                    provinciaSelect.value = data.provincia;
                    clearFieldError('provincia');
                    
                    // Cargar ciudades y establecer la ciudad
                    const ciudadSelect = document.getElementById('ciudadSelect');
                    ciudadSelect.setAttribute('data-pending-value', data.ciudad);
                    await cargarCiudades(data.provincia);
                    
                    // Si la ciudad no está en la lista, mostrar input personalizado
                    if (ciudadSelect.value !== data.ciudad) {
                        ciudadSelect.value = data.ciudad;
                        if (!ciudadSelect.value) {
                            // La ciudad no está en la lista, mostrar campo personalizado
                            mostrarCiudadCustom(data.ciudad);
                        }
                    }
                    
                    clearFieldError('ciudad');
                    check.classList.remove('hidden');
                    
                    // Animación de éxito
                    provinciaSelect.classList.add('ring-2', 'ring-emerald-500/50');
                    ciudadSelect.classList.add('ring-2', 'ring-emerald-500/50');
                    setTimeout(() => {
                        provinciaSelect.classList.remove('ring-2', 'ring-emerald-500/50');
                        ciudadSelect.classList.remove('ring-2', 'ring-emerald-500/50');
                    }, 1500);
                }
            } catch (error) {
                console.error('Error buscando código postal:', error);
            } finally {
                loading.classList.add('hidden');
            }
        }

        // Mostrar campo de ciudad personalizada
        function mostrarCiudadCustom(ciudadInicial = '') {
            const container = document.getElementById('ciudad-custom-container');
            const input = document.getElementById('ciudadCustomInput');
            const select = document.getElementById('ciudadSelect');
            
            container.classList.remove('hidden');
            input.value = ciudadInicial;
            
            // Función para actualizar el select
            function updateSelectFromInput() {
                const customOption = select.querySelector('#custom-ciudad-option');
                if (customOption) {
                    customOption.value = input.value;
                    customOption.textContent = input.value;
                } else {
                    const opt = document.createElement('option');
                    opt.value = input.value;
                    opt.textContent = input.value;
                    opt.id = 'custom-ciudad-option';
                    select.appendChild(opt);
                }
                select.value = input.value;
                
                if (input.value) {
                    clearFieldError('ciudad');
                }
            }
            
            // Remover listener anterior si existe
            input.removeEventListener('input', updateSelectFromInput);
            input.addEventListener('input', updateSelectFromInput);
            
            if (ciudadInicial) {
                updateSelectFromInput();
            }
        }

        // Ocultar campo de ciudad personalizada
        function ocultarCiudadCustom() {
            document.getElementById('ciudad-custom-container').classList.add('hidden');
        }

        // Validación personalizada del formulario
        function setupFormValidation() {
            const form = document.getElementById('direccionForm');
            
            form.addEventListener('submit', function(e) {
                // Solo validar si se está usando nueva dirección
                const usarNueva = document.getElementById('usar-nueva-hidden').value === 'true';
                
                if (usarNueva) {
                    let isValid = true;
                    
                    // Validar provincia
                    const provincia = document.getElementById('provinciaSelect');
                    if (!provincia.value) {
                        showFieldError('provincia', 'La provincia es obligatoria');
                        isValid = false;
                    } else {
                        clearFieldError('provincia');
                    }
                    
                    // Validar ciudad
                    const ciudad = document.getElementById('ciudadSelect');
                    const ciudadCustom = document.getElementById('ciudadCustomInput');
                    const ciudadValue = ciudad.value || ciudadCustom.value;
                    
                    if (!ciudadValue || ciudadValue === '__otra__') {
                        showFieldError('ciudad', 'La ciudad es obligatoria');
                        isValid = false;
                    } else {
                        clearFieldError('ciudad');
                    }
                    
                    if (!isValid) {
                        e.preventDefault();
                        // Scroll al primer error
                        const firstError = document.querySelector('.text-red-500:not(.hidden)');
                        if (firstError) {
                            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                }
            });
        }
        
        // Mostrar error en campo
        function showFieldError(field, message) {
            const errorSpan = document.getElementById(`${field}-error`);
            const select = document.getElementById(`${field}Select`);
            
            if (errorSpan) {
                errorSpan.textContent = message;
                errorSpan.classList.remove('hidden');
            }
            
            if (select) {
                select.classList.add('border-red-500');
                select.classList.remove('border-gray-200');
            }
        }
        
        // Limpiar error de campo
        function clearFieldError(field) {
            const errorSpan = document.getElementById(`${field}-error`);
            const select = document.getElementById(`${field}Select`);
            
            if (errorSpan) {
                errorSpan.classList.add('hidden');
            }
            
            if (select) {
                select.classList.remove('border-red-500');
                select.classList.add('border-gray-200');
            }
        }

        // Configurar event listeners
        function setupEventListeners() {
            // Código postal - búsqueda automática con debounce
            const cpInput = document.getElementById('codigoPostalInput');
            cpInput.addEventListener('input', function(e) {
                // Solo permitir números
                this.value = this.value.replace(/[^0-9]/g, '');
                
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    if (this.value.length === 5) {
                        buscarPorCodigoPostal(this.value);
                    }
                }, 300);
            });

            // Cambio de provincia
            document.getElementById('provinciaSelect').addEventListener('change', function() {
                ocultarCiudadCustom();
                cargarCiudades(this.value);
                
                if (this.value) {
                    clearFieldError('provincia');
                }
            });

            // Cambio de ciudad - detectar "Otra"
            document.getElementById('ciudadSelect').addEventListener('change', function() {
                if (this.value === '__otra__') {
                    mostrarCiudadCustom();
                    this.value = '';
                } else {
                    ocultarCiudadCustom();
                    if (this.value) {
                        clearFieldError('ciudad');
                    }
                }
            });
        }

        function seleccionarDireccionGuardada(radio) {
            document.getElementById('nueva-direccion-form').classList.add('hidden');
            document.getElementById('usar-nueva-hidden').value = 'false';
            
            // Update visual state
            document.querySelectorAll('.direccion-option').forEach(opt => {
                opt.classList.remove('border-emerald-500', 'bg-emerald-50');
                opt.querySelector('.check-icon').classList.add('opacity-0');
            });
            
            const parent = radio.closest('.direccion-option');
            parent.classList.add('border-emerald-500', 'bg-emerald-50');
            parent.querySelector('.check-icon').classList.remove('opacity-0');
        }

        function mostrarFormularioNueva() {
            document.getElementById('nueva-direccion-form').classList.remove('hidden');
            document.getElementById('usar-nueva-hidden').value = 'true';
            
            // Deselect saved addresses
            document.querySelectorAll('input[name="DireccionSeleccionadaId"]').forEach(r => r.checked = false);
            document.querySelectorAll('.direccion-option').forEach(opt => {
                opt.classList.remove('border-emerald-500', 'bg-emerald-50');
                opt.querySelector('.check-icon').classList.add('opacity-0');
            });
            
            // Focus first input
            document.querySelector('input[name="NuevaDireccion.Calle"]')?.focus();
        }

        function ocultarFormularioNueva() {
            document.getElementById('nueva-direccion-form').classList.add('hidden');
            document.getElementById('usar-nueva-hidden').value = 'false';
        }
    </script>
}

@section Styles {
    <style>
        .direccion-option.border-emerald-500 {
            border-color: #10b981;
            background-color: rgb(236 253 245);
        }
        
        /* Estilos para los selects */
        select:focus {
            outline: none;
        }
        
        select option {
            padding: 8px;
        }
        
        /* Animación suave para los campos */
        input, select {
            transition: all 0.2s ease;
        }
        
        /* Error state para selects */
        select.border-red-500 {
            border-color: #ef4444 !important;
        }
    </style>
}
