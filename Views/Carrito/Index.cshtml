@model IEnumerable<AldaJoyeros.DTOs.CarritoItemDto>
@{
    ViewData["Title"] = "Tu carrito";
    var items = Model?.ToList() ?? new List<AldaJoyeros.DTOs.CarritoItemDto>();
    var total = ViewBag.Total as double? ?? 0;
    var totalUnidades = items.Sum(x => x.Cantidad);
}
<partial name="_CompraCabecera" model='new AldaJoyeros.DTOs.CompraCabeceraViewModel(1, "Tu selección", "Revisa tus artículos antes de continuar con la compra.")' />
<div class="bg-gray-50 pb-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        @if (items.Any())
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
                <section aria-label="Artículos del carrito" class="lg:col-span-2 min-w-0 space-y-4">
                    @foreach (var item in items)
                    {
                        <article class="bg-white rounded-2xl border border-gray-200 shadow-sm p-4 sm:p-6">
                            <div class="flex items-start gap-4">
                                <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@item.ProductoId" class="shrink-0 w-20 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden border border-gray-100 bg-gray-50">
                                    @if (item.Producto?.TieneImagenes == true) { <img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-contain p-2" /> }
                                    else { <div class="w-full h-full flex items-center justify-center"><i class="fas fa-gem text-gray-300 text-2xl" aria-hidden="true"></i></div> }
                                </a>
                                <div class="flex-1 min-w-0">
                                    @if (!string.IsNullOrEmpty(item.Producto?.CategoriaNombre)) { <p class="text-xs text-emerald-700 font-medium mb-2 break-words">@item.Producto.CategoriaNombre</p> }
                                    <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@item.ProductoId" class="block font-semibold text-sm sm:text-base text-gray-900 hover:text-emerald-700 break-words">@item.ProductoNombre</a>
                                    <p class="text-sm text-gray-500 mt-2">@item.Precio.ToString("C") <span class="text-xs">/ unidad</span></p>
                                </div>
                            </div>
                            <div class="mt-5 pt-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                                <div class="inline-flex items-center border border-gray-200 rounded-xl overflow-hidden" data-item-id="@item.Id">
                                    <button type="button" onclick="carritoAjax.decrementar(@item.Id, this)" aria-label="Reducir cantidad de @item.ProductoNombre" class="btn-cantidad w-10 h-11 text-gray-600 hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-600 disabled:opacity-50"><i class="fas fa-minus text-xs" aria-hidden="true"></i></button>
                                    <input type="number" id="cantidad-@item.Id" value="@item.Cantidad" min="1" max="99" aria-label="Cantidad de @item.ProductoNombre" onchange="carritoAjax.actualizarCantidad(@item.Id, this.value)" class="w-10 h-11 text-center text-sm font-semibold text-gray-900 bg-white focus:ring-2 focus:ring-inset focus:ring-emerald-600 outline-none" />
                                    <button type="button" onclick="carritoAjax.incrementar(@item.Id, this)" aria-label="Aumentar cantidad de @item.ProductoNombre" class="btn-cantidad w-10 h-11 text-gray-600 hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-600 disabled:opacity-50"><i class="fas fa-plus text-xs" aria-hidden="true"></i></button>
                                </div>
                                <div class="flex items-center gap-3"><span id="subtotal-@item.Id" aria-live="polite" class="text-lg font-semibold text-gray-900">@item.Subtotal.ToString("C")</span><button type="button" data-product-name="@item.ProductoNombre" onclick="carritoAjax.eliminar(@item.Id, this.dataset.productName)" aria-label="Eliminar @item.ProductoNombre" class="btn-eliminar w-10 h-11 rounded-xl text-gray-400 hover:bg-red-50 hover:text-red-700 focus-visible:ring-2 focus-visible:ring-red-600"><i class="fas fa-trash-alt text-sm" aria-hidden="true"></i></button></div>
                            </div>
                        </article>
                    }
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-3">
                        <a asp-controller="Productos" asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-emerald-700"><i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>Seguir comprando</a>
                        <button type="button" onclick="carritoAjax.vaciar()" class="text-sm text-gray-500 hover:text-red-700 px-4 py-2">Vaciar carrito</button>
                    </div>
                </section>
                <aside aria-label="Resumen del carrito" class="min-w-0 lg:sticky lg:top-24">
                    <div class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
                        <div class="p-5 sm:p-6 border-b border-gray-100"><h2 class="text-lg font-semibold text-gray-900">Resumen de tu compra</h2><p class="text-sm text-gray-500 mt-1"><span id="totalUnidades" aria-live="polite">@totalUnidades</span> artículos en tu selección</p></div>
                        <div class="p-5 sm:p-6 space-y-5">
                            <div class="flex justify-between text-sm gap-3"><span class="text-gray-500">Subtotal</span><span id="subtotalGeneral" class="font-medium text-gray-900">@total.ToString("C")</span></div>
                            <div class="border-t border-gray-100 pt-5 flex justify-between items-center gap-3"><span class="font-semibold text-gray-900">Total</span><span id="totalCarrito" aria-live="polite" class="text-2xl font-semibold text-gray-900">@total.ToString("C")</span></div>
                            <partial name="_AvisoPrecios" />
                            <a asp-controller="Pedidos" asp-action="Checkout" class="flex items-center justify-center gap-3 w-full px-4 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">Continuar con la compra<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a>
                            <p class="text-xs leading-relaxed text-gray-500">En el siguiente paso podrás elegir la dirección de entrega y después el método de pago.</p>
                        </div>
                        <div class="p-5 bg-gray-50 border-t border-gray-100 flex items-center justify-center gap-3 text-gray-500 text-sm"><i class="fab fa-cc-visa text-xl" aria-label="Visa"></i><i class="fab fa-cc-mastercard text-xl" aria-label="Mastercard"></i><span class="text-xs">Tarjeta o contra reembolso</span></div>
                    </div>
                </aside>
            </div>
        }
        else
        {
            <section class="max-w-xl mx-auto bg-white border border-gray-200 rounded-2xl p-8 sm:p-12 text-center my-6">
                <span class="inline-flex w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 items-center justify-center text-2xl mb-6"><i class="fas fa-shopping-bag" aria-hidden="true"></i></span>
                <h2 class="font-serif text-2xl sm:text-3xl text-gray-900">Tu carrito está vacío</h2>
                <p class="text-sm text-gray-500 mt-3 mb-7">Descubre nuestra colección y añade las piezas que más te gusten.</p>
                <a asp-controller="Productos" asp-action="Index" class="inline-flex items-center justify-center gap-3 px-6 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl">Explorar el catálogo<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a>
            </section>
        }
    </div>
</div>
@section Styles {
    <style>
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        input[type=number] { -moz-appearance: textfield; }

        /* Modal animations */
        #confirmModal.show #modalContent {
            transform: scale(1);
            opacity: 1;
        }
        #modalContent {
            transition: transform 0.2s ease-out, opacity 0.2s ease-out;
        }
    </style>
}

@section Scripts {
    <script>
        // ========================================
        // CARRITO CON AJAX
        // ========================================
        const carritoAjax = {
            procesando: false,

            // Incrementar cantidad
            async incrementar(itemId, btn) {
                const input = document.getElementById(`cantidad-${itemId}`);
                const nuevaCantidad = parseInt(input.value) + 1;
                if (nuevaCantidad <= 99) {
                    input.value = nuevaCantidad;
                    await this.actualizarCantidad(itemId, nuevaCantidad);
                }
            },

            // Decrementar cantidad
            async decrementar(itemId, btn) {
                const input = document.getElementById(`cantidad-${itemId}`);
                const nuevaCantidad = parseInt(input.value) - 1;
                if (nuevaCantidad >= 1) {
                    input.value = nuevaCantidad;
                    await this.actualizarCantidad(itemId, nuevaCantidad);
                }
            },

            // Actualizar cantidad via AJAX
            async actualizarCantidad(itemId, cantidad) {
                if (this.procesando) return;
                this.procesando = true;

                // Deshabilitar botones temporalmente
                this.setItemLoading(itemId, true);

                try {
                    const response = await fetch('/Carrito/ActualizarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `itemId=${itemId}&cantidad=${cantidad}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Actualizar subtotal del item
                        const subtotalEl = document.getElementById(`subtotal-${itemId}`);
                        if (subtotalEl) {
                            subtotalEl.textContent = data.subtotalFormateado;
                            subtotalEl.classList.add('scale-110', 'text-emerald-600');
                            setTimeout(() => subtotalEl.classList.remove('scale-110', 'text-emerald-600'), 300);
                        }

                        // Actualizar totales generales
                        this.actualizarTotales(data.totalFormateado, data.totalItems);

                        // Actualizar contador del header
                        this.actualizarContadorHeader(data.totalItems);

                        AldaToast.success('Cantidad actualizada');
                    } else {
                        AldaToast.error(data.message || 'Error al actualizar');
                        // Revertir el input
                        location.reload();
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                } finally {
                    this.procesando = false;
                    this.setItemLoading(itemId, false);
                }
            },

            // Eliminar item
            async eliminar(itemId, nombreProducto) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar producto?',
                    message: `¿Estás seguro de eliminar "${nombreProducto}" del carrito?`,
                    type: 'danger',
                    confirmText: 'Eliminar'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/Carrito/EliminarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `itemId=${itemId}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Animar y eliminar el elemento
                        const itemEl = document.querySelector(`[data-item-id="${itemId}"]`)?.closest('.bg-white.rounded-2xl');
                        if (itemEl) {
                            itemEl.style.transition = 'all 0.3s ease';
                            itemEl.style.transform = 'translateX(100%)';
                            itemEl.style.opacity = '0';
                            setTimeout(() => itemEl.remove(), 300);
                        }

                        // Actualizar totales
                        this.actualizarTotales(data.totalFormateado, data.totalItems);
                        this.actualizarContadorHeader(data.totalItems);

                        AldaToast.success('Producto eliminado');

                        // Si el carrito quedó vacío, recargar
                        if (data.carritoVacio) {
                            setTimeout(() => location.reload(), 500);
                        }
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Vaciar carrito
            async vaciar() {
                const confirmar = await AldaConfirm.show({
                    title: '¿Vaciar carrito?',
                    message: 'Se eliminarán todos los productos. Esta acción no se puede deshacer.',
                    type: 'danger',
                    confirmText: 'Vaciar todo'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/Carrito/VaciarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                    });

                    const data = await response.json();

                    if (data.success) {
                        AldaToast.success('Carrito vaciado');
                        this.actualizarContadorHeader(0);
                        setTimeout(() => location.reload(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Actualizar totales en la vista
            actualizarTotales(totalFormateado, totalItems) {
                const totalEl = document.getElementById('totalCarrito');
                const subtotalEl = document.getElementById('subtotalGeneral');
                const unidadesEl = document.getElementById('totalUnidades');

                if (totalEl) {
                    totalEl.textContent = totalFormateado;
                    totalEl.classList.add('scale-110');
                    setTimeout(() => totalEl.classList.remove('scale-110'), 300);
                }
                if (subtotalEl) subtotalEl.textContent = totalFormateado;
                if (unidadesEl) unidadesEl.textContent = totalItems;
            },

            // Actualizar contador en el header
            actualizarContadorHeader(totalItems) {
                const contador = document.querySelector('[data-carrito-count]');
                if (contador) {
                    contador.textContent = totalItems;
                    contador.classList.toggle('hidden', totalItems === 0);
                    contador.classList.add('animate-bounce');
                    setTimeout(() => contador.classList.remove('animate-bounce'), 500);
                }
            },

            // Mostrar/ocultar loading en un item
            setItemLoading(itemId, loading) {
                const container = document.querySelector(`[data-item-id="${itemId}"]`);
                if (!container) return;

                const buttons = container.querySelectorAll('.btn-cantidad');
                buttons.forEach(btn => {
                    btn.disabled = loading;
                    if (loading) {
                        btn.classList.add('opacity-50');
                    } else {
                        btn.classList.remove('opacity-50');
                    }
                });
            }
        };

        // Exponer globalmente
        window.carritoAjax = carritoAjax;
    </script>
}
