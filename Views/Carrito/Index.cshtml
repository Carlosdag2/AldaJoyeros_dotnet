@model IEnumerable<AldaJoyeros.DTOs.CarritoItemDto>
@{
    ViewData["Title"] = "Carrito de Compras";
    var total = ViewBag.Total as double? ?? 0;
    var itemCount = Model?.Count() ?? 0;
    var totalUnidades = Model?.Sum(x => x.Cantidad) ?? 0;
}

<!-- Hero Header -->
<div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 py-12">
    <div class="container mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">
                <i class="fas fa-home"></i>
            </a>
            <i class="fas fa-chevron-right text-xs text-gray-600"></i>
            <span class="text-emerald-400">Carrito</span>
        </nav>
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-emerald-500/20 rounded-2xl flex items-center justify-center">
                <i class="fas fa-shopping-bag text-emerald-400 text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Mi Carrito</h1>
                @if (itemCount > 0)
                {
                    <p class="text-gray-400">@totalUnidades @(totalUnidades == 1 ? "artículo" : "artículos")</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto px-4 sm:px-6">
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
                <!-- Cart Items -->
                <div class="xl:col-span-2 space-y-4">
                    <!-- Table Header (Desktop) -->
                    <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <div class="col-span-6">Producto</div>
                        <div class="col-span-2 text-center">Cantidad</div>
                        <div class="col-span-2 text-right">Precio</div>
                        <div class="col-span-2 text-right">Subtotal</div>
                    </div>

                    @foreach (var item in Model)
                    {
                        <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 overflow-hidden group">
                            <div class="p-5 md:p-6">
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-center">
                                    <!-- Product Info -->
                                    <div class="md:col-span-6">
                                        <div class="flex gap-4">
                                            <!-- Image -->
                                            <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@item.ProductoId" 
                                               class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-50 group-hover:shadow-lg transition-shadow">
                                                @if (item.Producto?.TieneImagenes == true)
                                                {
                                                    <img src="@item.Producto.ImagenPrincipal" 
                                                         alt="@item.ProductoNombre" 
                                                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center">
                                                        <i class="fas fa-gem text-2xl text-emerald-300"></i>
                                                    </div>
                                                }
                                            </a>

                                            <!-- Details -->
                                            <div class="flex-1 min-w-0">
                                                <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@item.ProductoId"
                                                   class="font-semibold text-gray-900 hover:text-emerald-600 transition-colors line-clamp-2 text-sm md:text-base">
                                                    @item.ProductoNombre
                                                </a>
                                                @if (!string.IsNullOrEmpty(item.Producto?.CategoriaNombre))
                                                {
                                                    <span class="inline-block mt-2 px-2.5 py-0.5 bg-emerald-100 text-emerald-700 text-xs font-medium rounded-full">
                                                        @item.Producto.CategoriaNombre
                                                    </span>
                                                }
                                                <!-- Mobile price -->
                                                <p class="md:hidden text-emerald-600 font-bold mt-2">@item.Precio.ToString("C")</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quantity con AJAX -->
                                    <div class="md:col-span-2">
                                        <div class="flex items-center justify-center" data-item-id="@item.Id">
                                            <div class="inline-flex items-center bg-gray-100 rounded-full p-1">
                                                <button type="button" 
                                                        onclick="carritoAjax.decrementar(@item.Id, this)"
                                                        class="btn-cantidad w-8 h-8 rounded-full text-gray-600 hover:bg-white hover:shadow-sm transition-all flex items-center justify-center disabled:opacity-50">
                                                    <i class="fas fa-minus text-xs"></i>
                                                </button>
                                                <input type="number" 
                                                       id="cantidad-@item.Id"
                                                       value="@item.Cantidad" 
                                                       min="1" 
                                                       max="99" 
                                                       onchange="carritoAjax.actualizarCantidad(@item.Id, this.value)"
                                                       class="w-10 h-8 text-center bg-transparent text-sm font-bold text-gray-900 focus:outline-none" />
                                                <button type="button" 
                                                        onclick="carritoAjax.incrementar(@item.Id, this)"
                                                        class="btn-cantidad w-8 h-8 rounded-full text-gray-600 hover:bg-white hover:shadow-sm transition-all flex items-center justify-center disabled:opacity-50">
                                                    <i class="fas fa-plus text-xs"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Price (Desktop) -->
                                    <div class="hidden md:block md:col-span-2 text-right">
                                        <span class="text-gray-600">@item.Precio.ToString("C")</span>
                                    </div>

                                    <!-- Subtotal & Delete -->
                                    <div class="md:col-span-2">
                                        <div class="flex items-center justify-between md:justify-end gap-4">
                                            <span id="subtotal-@item.Id" class="text-lg font-bold text-gray-900">@item.Subtotal.ToString("C")</span>
                                            <button type="button" 
                                                    onclick="carritoAjax.eliminar(@item.Id, '@item.ProductoNombre.Replace("'", "\\'")')"
                                                    class="btn-eliminar w-9 h-9 rounded-full bg-gray-100 text-gray-400 hover:bg-red-100 hover:text-red-500 transition-all flex items-center justify-center disabled:opacity-50">
                                                <i class="fas fa-trash-alt text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Actions Bar -->
                    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-6 pb-4">
                        <a asp-controller="Productos" asp-action="Index" 
                           class="group inline-flex items-center gap-2 text-gray-600 hover:text-emerald-600 transition-colors font-medium">
                            <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                            <span>Seguir comprando</span>
                        </a>
                        <button type="button" 
                                onclick="carritoAjax.vaciar()"
                                class="inline-flex items-center gap-2 px-4 py-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors text-sm font-medium">
                            <i class="fas fa-trash-alt"></i>
                            <span>Vaciar carrito</span>
                        </button>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="xl:col-span-1">
                    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden sticky top-24">
                        <!-- Header -->
                        <div class="bg-gradient-to-r from-gray-900 to-gray-800 px-6 py-5">
                            <h2 class="font-bold text-lg text-white flex items-center gap-2">
                                <i class="fas fa-receipt text-emerald-400"></i>
                                Resumen del pedido
                            </h2>
                        </div>

                        <div class="p-6">
                            <!-- Line Items -->
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Subtotal (<span id="totalUnidades">@totalUnidades</span> artículos)</span>
                                    <span id="subtotalGeneral" class="font-semibold text-gray-900">@total.ToString("C")</span>
                                </div>
                            </div>

                            <!-- Total -->
                            <div class="mt-6 pt-5 border-t-2 border-dashed border-gray-200">
                                <div class="flex justify-between items-baseline">
                                    <span class="text-gray-700 font-semibold">Total a pagar</span>
                                    <div class="text-right">
                                        <span id="totalCarrito" class="text-3xl font-bold text-emerald-600">
                                            @total.ToString("C")
                                        </span>
                                        <p class="text-xs text-gray-400 mt-1">IVA incluido</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Checkout Button -->
                            <a asp-controller="Pedidos" asp-action="Checkout" 
                               class="group w-full mt-6 inline-flex items-center justify-center gap-3 px-6 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/40 hover:scale-[1.02]">
                                <i class="fas fa-lock text-emerald-200"></i>
                                <span>Finalizar compra</span>
                                <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                            </a>

                            <!-- Payment Methods -->
                            <div class="mt-5 flex items-center justify-center gap-3">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" class="h-6 opacity-60">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="Mastercard" class="h-6 opacity-60">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b5/PayPal.svg" alt="PayPal" class="h-5 opacity-60">
                            </div>
                        </div>

                        <!-- Trust Badges -->
                        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100">
                            <div class="grid grid-cols-3 gap-2 text-center">
                                <div class="p-2">
                                    <i class="fas fa-shield-alt text-emerald-500 text-lg mb-1"></i>
                                    <p class="text-xs text-gray-500 leading-tight">Pago<br>seguro</p>
                                </div>
                                <div class="p-2">
                                    <i class="fas fa-undo text-emerald-500 text-lg mb-1"></i>
                                    <p class="text-xs text-gray-500 leading-tight">30 días<br>devolución</p>
                                </div>
                                <div class="p-2">
                                    <i class="fas fa-certificate text-emerald-500 text-lg mb-1"></i>
                                    <p class="text-xs text-gray-500 leading-tight">Garantía<br>de por vida</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty Cart -->
            <div class="max-w-lg mx-auto text-center py-16">
                <div class="relative">
                    <div class="w-32 h-32 bg-gradient-to-br from-emerald-100 to-teal-100 rounded-full flex items-center justify-center mx-auto mb-8 shadow-lg shadow-emerald-100">
                        <i class="fas fa-shopping-bag text-5xl text-emerald-400"></i>
                    </div>
                    <div class="absolute top-0 right-1/3 w-6 h-6 bg-amber-200 rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
                    <div class="absolute bottom-4 left-1/3 w-4 h-4 bg-emerald-200 rounded-full animate-bounce" style="animation-delay: 0.5s;"></div>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 mb-3">Tu carrito está vacío</h2>
                <p class="text-gray-500 mb-8 text-lg">
                    ¡Es el momento perfecto para descubrir nuestras joyas exclusivas!
                </p>
                <a asp-controller="Productos" asp-action="Index" 
                   class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold rounded-full transition-all shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/40 hover:scale-105">
                    <i class="fas fa-gem"></i>
                    <span>Explorar colección</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        input[type=number] { -moz-appearance: textfield; }
        
        /* Modal animations */
        #confirmModal.show #modalContent {
            transform: scale(1);
            opacity: 1;
        }
        #modalContent {
            transition: transform 0.2s ease-out, opacity 0.2s ease-out;
        }
    </style>
}

@section Scripts {
    <script>
        // ========================================
        // CARRITO CON AJAX
        // ========================================
        const carritoAjax = {
            procesando: false,

            // Incrementar cantidad
            async incrementar(itemId, btn) {
                const input = document.getElementById(`cantidad-${itemId}`);
                const nuevaCantidad = parseInt(input.value) + 1;
                if (nuevaCantidad <= 99) {
                    input.value = nuevaCantidad;
                    await this.actualizarCantidad(itemId, nuevaCantidad);
                }
            },

            // Decrementar cantidad
            async decrementar(itemId, btn) {
                const input = document.getElementById(`cantidad-${itemId}`);
                const nuevaCantidad = parseInt(input.value) - 1;
                if (nuevaCantidad >= 1) {
                    input.value = nuevaCantidad;
                    await this.actualizarCantidad(itemId, nuevaCantidad);
                }
            },

            // Actualizar cantidad via AJAX
            async actualizarCantidad(itemId, cantidad) {
                if (this.procesando) return;
                this.procesando = true;

                // Deshabilitar botones temporalmente
                this.setItemLoading(itemId, true);

                try {
                    const response = await fetch('/Carrito/ActualizarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `itemId=${itemId}&cantidad=${cantidad}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Actualizar subtotal del item
                        const subtotalEl = document.getElementById(`subtotal-${itemId}`);
                        if (subtotalEl) {
                            subtotalEl.textContent = data.subtotalFormateado;
                            subtotalEl.classList.add('scale-110', 'text-emerald-600');
                            setTimeout(() => subtotalEl.classList.remove('scale-110', 'text-emerald-600'), 300);
                        }

                        // Actualizar totales generales
                        this.actualizarTotales(data.totalFormateado, data.totalItems);
                        
                        // Actualizar contador del header
                        this.actualizarContadorHeader(data.totalItems);

                        AldaToast.success('Cantidad actualizada');
                    } else {
                        AldaToast.error(data.message || 'Error al actualizar');
                        // Revertir el input
                        location.reload();
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                } finally {
                    this.procesando = false;
                    this.setItemLoading(itemId, false);
                }
            },

            // Eliminar item
            async eliminar(itemId, nombreProducto) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar producto?',
                    message: `¿Estás seguro de eliminar "${nombreProducto}" del carrito?`,
                    type: 'danger',
                    confirmText: 'Eliminar'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/Carrito/EliminarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `itemId=${itemId}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Animar y eliminar el elemento
                        const itemEl = document.querySelector(`[data-item-id="${itemId}"]`)?.closest('.bg-white.rounded-2xl');
                        if (itemEl) {
                            itemEl.style.transition = 'all 0.3s ease';
                            itemEl.style.transform = 'translateX(100%)';
                            itemEl.style.opacity = '0';
                            setTimeout(() => itemEl.remove(), 300);
                        }

                        // Actualizar totales
                        this.actualizarTotales(data.totalFormateado, data.totalItems);
                        this.actualizarContadorHeader(data.totalItems);

                        AldaToast.success('Producto eliminado');

                        // Si el carrito quedó vacío, recargar
                        if (data.carritoVacio) {
                            setTimeout(() => location.reload(), 500);
                        }
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Vaciar carrito
            async vaciar() {
                const confirmar = await AldaConfirm.show({
                    title: '¿Vaciar carrito?',
                    message: 'Se eliminarán todos los productos. Esta acción no se puede deshacer.',
                    type: 'danger',
                    confirmText: 'Vaciar todo'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/Carrito/VaciarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                    });

                    const data = await response.json();

                    if (data.success) {
                        AldaToast.success('Carrito vaciado');
                        this.actualizarContadorHeader(0);
                        setTimeout(() => location.reload(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Actualizar totales en la vista
            actualizarTotales(totalFormateado, totalItems) {
                const totalEl = document.getElementById('totalCarrito');
                const subtotalEl = document.getElementById('subtotalGeneral');
                const unidadesEl = document.getElementById('totalUnidades');

                if (totalEl) {
                    totalEl.textContent = totalFormateado;
                    totalEl.classList.add('scale-110');
                    setTimeout(() => totalEl.classList.remove('scale-110'), 300);
                }
                if (subtotalEl) subtotalEl.textContent = totalFormateado;
                if (unidadesEl) unidadesEl.textContent = totalItems;
            },

            // Actualizar contador en el header
            actualizarContadorHeader(totalItems) {
                const contador = document.querySelector('[data-carrito-count]');
                if (contador) {
                    contador.textContent = totalItems;
                    contador.classList.toggle('hidden', totalItems === 0);
                    contador.classList.add('animate-bounce');
                    setTimeout(() => contador.classList.remove('animate-bounce'), 500);
                }
            },

            // Mostrar/ocultar loading en un item
            setItemLoading(itemId, loading) {
                const container = document.querySelector(`[data-item-id="${itemId}"]`);
                if (!container) return;

                const buttons = container.querySelectorAll('.btn-cantidad');
                buttons.forEach(btn => {
                    btn.disabled = loading;
                    if (loading) {
                        btn.classList.add('opacity-50');
                    } else {
                        btn.classList.remove('opacity-50');
                    }
                });
            }
        };

        // Exponer globalmente
        window.carritoAjax = carritoAjax;
    </script>
}
