@model IEnumerable<AldaJoyeros.DTOs.CarritoItemDto>
@{
    ViewData["Title"] = "Carrito de Compras";
    var total = ViewBag.Total as double? ?? 0;
}

<div class="container mx-auto px-6 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-shopping-cart text-white text-2xl"></i>
            </div>
            Mi Carrito
        </h1>
        <p class="text-gray-600 text-lg">Revisa tus productos antes de finalizar la compra</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-span-2 space-y-4">
                @foreach (var item in Model)
                {
                    <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                        <div class="p-6">
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                                <!-- Product Image -->
                                <div class="md:col-span-3">
                                    <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl overflow-hidden shadow-md" style="aspect-ratio:1/1;">
                                        @if (item.Producto?.TieneImagenes == true)
                                        {
                                            <img src="@item.Producto.ImagenPrincipal" alt="@item.ProductoNombre" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><i class=\'fas fa-gem text-6xl text-emerald-600 opacity-30\'></i></div>';" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center p-6">
                                                <i class="fas fa-gem text-6xl text-emerald-600 opacity-30"></i>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Product Info -->
                                <div class="md:col-span-4">
                                    <h3 class="font-serif text-xl font-bold text-gray-900 mb-3">@item.ProductoNombre</h3>
                                    <div class="space-y-2">
                                        <p class="text-gray-600 flex items-center gap-2">
                                            <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-sm font-semibold"><i class="fas fa-tag mr-1"></i>@item.Precio.ToString("C")</span>
                                            <span class="text-sm text-gray-500">por unidad</span>
                                        </p>
                                        @if (!string.IsNullOrEmpty(item.Producto?.CategoriaNombre))
                                        {
                                            <p class="text-sm text-gray-500"><i class="fas fa-folder-open mr-1"></i>@item.Producto.CategoriaNombre</p>
                                        }
                                    </div>
                                </div>

                                <!-- Quantity -->
                                <div class="md:col-span-2">
                                    <form asp-action="Actualizar" method="post" class="space-y-2">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <label class="text-sm text-gray-600 font-semibold block">Cantidad:</label>
                                        <div class="flex items-center gap-2">
                                            <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="10" onchange="this.form.submit()" class="w-20 px-3 py-2 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all text-center font-bold outline-none" />
                                            <button type="button" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.form.submit();" class="w-8 h-8 bg-emerald-100 hover:bg-emerald-500 text-emerald-600 hover:text-white rounded-lg transition-all duration-200 flex items-center justify-center"><i class="fas fa-plus text-sm"></i></button>
                                            <button type="button" onclick="this.previousElementSibling.previousElementSibling.stepDown(); this.previousElementSibling.previousElementSibling.form.submit();" class="w-8 h-8 bg-gray-100 hover:bg-gray-300 text-gray-600 hover:text-gray-800 rounded-lg transition-all duration-200 flex items-center justify-center"><i class="fas fa-minus text-sm"></i></button>
                                        </div>
                                    </form>
                                </div>

                                <!-- Subtotal & Delete -->
                                <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-4">
                                    <div class="text-right">
                                        <div class="text-xs text-gray-500 mb-1">Subtotal</div>
                                        <div class="text-2xl font-bold text-emerald-600">@item.Subtotal.ToString("C")</div>
                                    </div>
                                    <form asp-action="Eliminar" method="post">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" onclick="return confirm('¿Eliminar este producto del carrito?')" class="w-10 h-10 bg-red-100 hover:bg-red-500 text-red-600 hover:text-white rounded-xl transition-all duration-200 flex items-center justify-center shadow-sm hover:shadow-md"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4">
                    <a asp-controller="Productos" asp-action="Index" class="inline-flex items-center justify-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all duration-200 font-semibold"><i class="fas fa-arrow-left mr-2"></i>Seguir Comprando</a>
                    <form asp-action="Vaciar" method="post" class="inline">
                        <button type="submit" onclick="return confirm('¿Vaciar todo el carrito?')" class="w-full inline-flex items-center justify-center px-8 py-3 bg-red-100 text-red-600 rounded-xl hover:bg-red-500 hover:text-white transition-all duration-200 font-semibold shadow-sm hover:shadow-md"><i class="fas fa-trash-alt mr-2"></i>Vaciar Carrito</button>
                    </form>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-xl p-6 sticky top-24 border border-gray-100">
                    <h2 class="font-serif text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-receipt text-emerald-600"></i>
                        </div>
                        Resumen
                    </h2>

                    <div class="space-y-4 mb-6">
                        <div class="flex justify-between text-gray-700">
                            <span class="font-medium">Productos:</span>
                            <span class="font-semibold">@Model.Count()</span>
                        </div>
                        <div class="flex justify-between text-gray-700">
                            <span class="font-medium">Subtotal:</span>
                            <span class="font-semibold">@total.ToString("C")</span>
                        </div>
                        <div class="flex justify-between text-gray-700">
                            <span class="font-medium">Envío:</span>
                            <span class="font-semibold @(total > 50 ? "text-green-600" : "")">
                                @if (total > 50)
                                {
                                    <span class="flex items-center gap-1">
                                        <i class="fas fa-check-circle"></i>
                                        GRATIS
                                    </span>
                                }
                                else
                                {
                                    <span>5,00 €</span>
                                }
                            </span>
                        </div>
                        <hr class="border-gray-200" />
                        <div class="flex justify-between items-baseline bg-gradient-to-r from-emerald-50 to-green-50 -mx-6 px-6 py-4 rounded-xl">
                            <span class="text-lg font-bold text-gray-900">Total:</span>
                            <span class="text-3xl font-bold text-emerald-600">
                                @((total > 50 ? total : total + 5).ToString("C"))
                            </span>
                        </div>
                    </div>

                    @if (total < 50)
                    {
                        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 p-4 rounded-r-xl mb-6 shadow-sm">
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-info-circle text-white"></i>
                                </div>
                                <div class="text-sm text-blue-800">
                                    <p class="font-bold mb-1">¡Solo faltan @((50 - total).ToString("C"))!</p>
                                    <p>Añade más productos y consigue <span class="font-semibold">envío gratis</span></p>
                                </div>
                            </div>
                            <!-- Progress Bar -->
                            <div class="mt-3 w-full bg-blue-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-blue-600 h-full rounded-full transition-all duration-500" style="width:@((total / 50 * 100).ToString("0"))%"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 p-4 rounded-r-xl mb-6 shadow-sm">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-check-circle text-white"></i>
                                </div>
                                <div class="text-sm text-green-800 font-bold">¡Felicidades! Tienes envío gratis</div>
                            </div>
                        </div>
                    }

                    <!-- Checkout Button -->
                    <a asp-controller="Pedidos" asp-action="Checkout" class="w-full bg-gradient-to-r from-emerald-500 to-emerald-600 text-white py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all duration-200 transform hover:scale-105 flex items-center justify-center mb-6">
                        <i class="fas fa-credit-card mr-2"></i>Proceder al Pago
                    </a>

                    <!-- Badges -->
                    <div class="space-y-3 pt-6 border-t border-gray-200">
                        <h3 class="text-sm font-semibold text-gray-700 mb-3">Compra con confianza:</h3>
                        <div class="flex items-center gap-3 text-sm text-gray-600 bg-green-50 p-3 rounded-lg">
                            <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-shield-alt text-white"></i>
                            </div>
                            <span class="font-medium">Compra 100% segura</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-gray-600 bg-blue-50 p-3 rounded-lg">
                            <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-lock text-white"></i>
                            </div>
                            <span class="font-medium">Datos protegidos</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-gray-600 bg-purple-50 p-3 rounded-lg">
                            <div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-undo text-white"></i>
                            </div>
                            <span class="font-medium">Devoluciones en 30 días</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart Message -->
        <div class="text-center py-20">
            <div class="bg-white rounded-3xl p-12 shadow-xl max-w-2xl mx-auto border border-gray-100">
                <div class="w-32 h-32 bg-gradient-to-br from-emerald-100 to-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-shopping-cart text-emerald-600 text-6xl"></i>
                </div>
                <h2 class="font-serif text-3xl font-bold text-gray-900 mb-4">Tu carrito está vacío</h2>
                <p class="text-gray-600 mb-8 text-lg leading-relaxed">
                    Añade productos increíbles para empezar tu compra<br />
                    y disfruta de nuestras joyas exclusivas
                </p>
                <a asp-controller="Productos" asp-action="Index" class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                    <i class="fas fa-shopping-bag mr-3"></i>Explorar Productos
                </a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .space-y-4>div {
            animation: fadeInUp .6s ease-out both;
        }

        .space-y-4>div:nth-child(1) {
            animation-delay: .1s
        }

        .space-y-4>div:nth-child(2) {
            animation-delay: .2s
        }

        .space-y-4>div:nth-child(3) {
            animation-delay: .3s
        }

        .space-y-4>div:nth-child(4) {
            animation-delay: .4s
        }

        .space-y-4>div:nth-child(5) {
            animation-delay: .5s
        }

        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0
        }

        input[type=number] {
            -moz-appearance: textfield
        }
    </style>
}
