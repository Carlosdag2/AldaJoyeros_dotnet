@if (!AldaJoyeros.Helpers.VisitorConsent.HasChoice(Context.Request))
{
    <section aria-labelledby="cookies-title" class="fixed bottom-0 inset-x-0 z-[100] border-t border-gray-200 bg-white text-gray-800 shadow-2xl p-5 sm:p-6 max-h-[70vh] overflow-y-auto">
        <div class="max-w-5xl mx-auto">
            <h2 id="cookies-title" class="text-lg font-bold">Tú decides sobre las cookies</h2>
            <p class="text-sm mt-2">Usamos cookies necesarias para la sesión y el carrito. Solo si lo permites, utilizaremos una cookie para nuestras estadísticas de visitas. Puedes cambiar tu elección en <a asp-controller="Home" asp-action="Cookies" class="underline">Cookies</a>.</p>
            <partial name="_CookieChoices" />
        </div>
    </section>
}
