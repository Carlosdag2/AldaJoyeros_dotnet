@{var offers=ViewBag.HomeOffers as IReadOnlyList<AldaJoyeros.DTOs.ProductoDto>??Array.Empty<AldaJoyeros.DTOs.ProductoDto>();}
@if(offers.Count>0){<section id="ofertas" class="border-y border-stone-200 bg-emerald-50 py-14 sm:py-20" aria-labelledby="home-offers-title"><div class="container mx-auto px-4 sm:px-6"><div class="mb-8 flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Una selección especial</p><h2 id="home-offers-title" class="mt-3 font-serif text-3xl text-stone-900 sm:text-4xl">Piezas que ahora apetecen más.</h2><p class="mt-3 text-sm text-stone-600">Descubre nuestras ofertas y encuentra tu próxima joya.</p></div><a href="~/catalogo?descuentos=si" class="text-sm font-semibold text-emerald-800 underline underline-offset-4">Ver todas las ofertas</a></div><div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">@foreach(var product in offers){var link=AldaJoyeros.Helpers.PublicUrls.ProductLink(Context.Request,product);<article data-home-offer="@product.Id" class="min-w-0 rounded-xl border border-stone-200 bg-white p-3 sm:p-5"><partial name="_ProductCardImage" model='(product,link,"product-media relative block aspect-square overflow-hidden rounded-lg bg-white p-2")'/><p class="mt-4 text-xs text-stone-500">@product.CategoriaNombre</p><h3 class="mt-2 break-words text-sm font-semibold text-stone-900"><a href="@link">@product.Nombre</a></h3><partial name="_ProductPrice" model="product"/><a href="@link" class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-emerald-800 underline">@(product.TieneTallas?"Ver tallas y oferta":"Descubrir oferta")</a></article>}</div></div></section>}
