@* Componente de notificaciones/alertas reutilizable *@
@* Usa TempData["Success"], TempData["Error"], TempData["Warning"], TempData["Info"] *@

<div id="notifications-container" class="fixed top-24 right-4 z-50 space-y-3 max-w-md w-full pointer-events-none">
    
    @* Mensaje de Éxito *@
    @if (TempData["Success"] != null)
    {
        <div class="notification notification-success pointer-events-auto animate-slide-in-right bg-gradient-to-r from-emerald-500 to-green-600 text-white p-4 rounded-2xl shadow-2xl shadow-emerald-500/30 border border-emerald-400/30 backdrop-blur-sm"
             x-data="{ show: true }" 
             x-show="show" 
             x-init="setTimeout(() => show = false, 5000)"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-x-8"
             x-transition:enter-end="opacity-100 translate-x-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-8">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-check-circle text-xl"></i>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm">¡Éxito!</p>
                    <p class="text-sm text-emerald-100 mt-0.5">@TempData["Success"]</p>
                </div>
                <button @@click="show = false" class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="mt-3 h-1 bg-white/20 rounded-full overflow-hidden">
                <div class="h-full bg-white/60 rounded-full animate-shrink-width"></div>
            </div>
        </div>
    }

    @* Mensaje de Error *@
    @if (TempData["Error"] != null)
    {
        <div class="notification notification-error pointer-events-auto animate-slide-in-right bg-gradient-to-r from-red-500 to-rose-600 text-white p-4 rounded-2xl shadow-2xl shadow-red-500/30 border border-red-400/30 backdrop-blur-sm"
             x-data="{ show: true }" 
             x-show="show"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-x-8"
             x-transition:enter-end="opacity-100 translate-x-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-8">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-exclamation-circle text-xl"></i>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm">¡Error!</p>
                    <p class="text-sm text-red-100 mt-0.5">@TempData["Error"]</p>
                </div>
                <button @@click="show = false" class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
        </div>
    }

    @* Mensaje de Advertencia *@
    @if (TempData["Warning"] != null)
    {
        <div class="notification notification-warning pointer-events-auto animate-slide-in-right bg-gradient-to-r from-amber-500 to-orange-500 text-white p-4 rounded-2xl shadow-2xl shadow-amber-500/30 border border-amber-400/30 backdrop-blur-sm"
             x-data="{ show: true }" 
             x-show="show" 
             x-init="setTimeout(() => show = false, 6000)"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-x-8"
             x-transition:enter-end="opacity-100 translate-x-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-8">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-exclamation-triangle text-xl"></i>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm">¡Atención!</p>
                    <p class="text-sm text-amber-100 mt-0.5">@TempData["Warning"]</p>
                </div>
                <button @@click="show = false" class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="mt-3 h-1 bg-white/20 rounded-full overflow-hidden">
                <div class="h-full bg-white/60 rounded-full animate-shrink-width-slow"></div>
            </div>
        </div>
    }

    @* Mensaje Informativo *@
    @if (TempData["Info"] != null)
    {
        <div class="notification notification-info pointer-events-auto animate-slide-in-right bg-gradient-to-r from-blue-500 to-indigo-600 text-white p-4 rounded-2xl shadow-2xl shadow-blue-500/30 border border-blue-400/30 backdrop-blur-sm"
             x-data="{ show: true }" 
             x-show="show" 
             x-init="setTimeout(() => show = false, 5000)"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-x-8"
             x-transition:enter-end="opacity-100 translate-x-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-8">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-info-circle text-xl"></i>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm">Información</p>
                    <p class="text-sm text-blue-100 mt-0.5">@TempData["Info"]</p>
                </div>
                <button @@click="show = false" class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="mt-3 h-1 bg-white/20 rounded-full overflow-hidden">
                <div class="h-full bg-white/60 rounded-full animate-shrink-width"></div>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes slide-in-right {
        from {
            opacity: 0;
            transform: translateX(100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    @@keyframes shrink-width {
        from { width: 100%; }
        to { width: 0%; }
    }
    
    .animate-slide-in-right {
        animation: slide-in-right 0.4s ease-out;
    }
    
    .animate-shrink-width {
        animation: shrink-width 5s linear forwards;
    }
    
    .animate-shrink-width-slow {
        animation: shrink-width 6s linear forwards;
    }
</style>
