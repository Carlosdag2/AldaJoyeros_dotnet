@{
    var notices = new[] {
        (Key: "Success", Kind: "success", Title: "Hecho", Icon: "fa-check", Duration: 8000),
        (Key: "Error", Kind: "error", Title: "No se ha podido completar", Icon: "fa-exclamation", Duration: 0),
        (Key: "Warning", Kind: "warning", Title: "Revisa este aviso", Icon: "fa-exclamation-triangle", Duration: 0),
        (Key: "Info", Kind: "info", Title: "Información", Icon: "fa-info", Duration: 8000)
    };
}
<div id="notifications-container">
    @foreach (var notice in notices)
    {
        if (TempData[notice.Key] is string message && !string.IsNullOrWhiteSpace(message))
        {
            <div class="alda-notice notification notification-@notice.Kind" data-kind="@notice.Kind" data-duration="@notice.Duration" role="@(notice.Kind is "error" or "warning" ? "alert" : "status")" aria-atomic="true">
                <span class="alda-notice-icon" aria-hidden="true"><i class="fas @notice.Icon"></i></span>
                <div class="alda-notice-body"><p class="alda-notice-title">@notice.Title</p><p class="alda-notice-message">@message</p></div>
                <button type="button" class="alda-notice-close" data-notice-close aria-label="Cerrar notificación"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
        }
    }
</div>
