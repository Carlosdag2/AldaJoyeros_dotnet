@model AldaJoyeros.DTOs.ProductoDto
<section data-product-promotion data-product-id="@Model.Id" data-state-url="@Url.Action("Producto","AdminDescuentos",new{id=Model.Id})" data-rule-url="@Url.Action("DescuentoProducto","AdminDescuentos")" data-home-url="@Url.Action("InicioProducto","AdminDescuentos")" class="container mx-auto mb-6 px-4 md:px-8">
<div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4"><div><p class="text-sm font-semibold text-emerald-900"><i class="fas fa-tags mr-2" aria-hidden="true"></i>Oferta de este producto</p><p data-product-promotion-status role="status" class="mt-1 text-xs leading-relaxed text-stone-600">Cargando oferta…</p></div><div class="flex flex-wrap gap-2"><button type="button" data-edit-product-discount disabled class="min-h-11 rounded-lg border border-emerald-800 px-4 py-3 text-sm font-semibold text-emerald-800">Cambiar descuento</button><button type="button" data-product-offer-home disabled class="min-h-11 rounded-lg bg-emerald-800 px-4 py-3 text-sm font-semibold text-white">Ofertas del inicio</button></div></div>
<dialog data-product-discount-dialog class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-6 text-stone-900 shadow-xl" aria-labelledby="product-discount-title"><div class="flex items-start justify-between gap-3"><h2 id="product-discount-title" class="font-serif text-2xl">Descuento de @Model.Nombre</h2><button type="button" data-product-promotion-close aria-label="Cerrar descuento" class="rounded-lg border px-3 py-2">✕</button></div><form data-product-discount-form class="mt-5 space-y-5">@Html.AntiForgeryToken()<div><label for="product-discount-percent" class="mb-2 block text-sm font-semibold">Porcentaje de descuento</label><input id="product-discount-percent" name="percent" type="number" min="0" max="99.99" step="0.01" required class="w-full rounded-lg border border-stone-300 p-3"/><p class="mt-2 text-xs text-stone-600">0 retira el descuento individual. Si hay una oferta de categoría, se aplicará la más favorable. En productos con tallas se aplica a todas ellas.</p></div><label class="flex items-start gap-3 text-sm"><input type="checkbox" name="showHome" class="mt-1 h-5 w-5 accent-emerald-800"/><span>Mostrar también en las ofertas del inicio. Al añadirlo se activa esa sección.</span></label><label class="flex items-start gap-3 text-xs leading-relaxed"><input type="checkbox" name="confirmed" value="true" class="mt-1 h-5 w-5 shrink-0 accent-emerald-800"/><span>He comprobado que los precios de referencia son los menores aplicados durante los 30 días anteriores. La web registra los cambios desde que se activó esta función.</span></label><p data-product-discount-feedback role="alert" class="text-sm text-red-700"></p><div class="flex flex-wrap gap-3"><button type="submit" class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Guardar descuento</button><button type="button" data-product-promotion-close class="min-h-11 rounded-lg border border-stone-300 px-5 py-3 text-sm">Cancelar</button></div></form></dialog>
<dialog data-product-offer-replace class="promotion-dialog rounded-2xl border border-stone-200 bg-white p-6 text-stone-900 shadow-xl" aria-labelledby="offer-replace-title"><h2 id="offer-replace-title" class="font-serif text-2xl">¿Qué oferta quieres reemplazar?</h2><p class="mt-3 text-sm text-stone-600">El inicio tiene 8 ofertas. Elige cuál sustituir por @Model.Nombre.</p><form data-product-offer-replace-form><div data-product-offer-options class="mt-5 grid gap-3 sm:grid-cols-2"></div><p data-replace-feedback role="alert" class="mt-4 text-sm text-red-700"></p><div class="mt-5 flex flex-wrap gap-3"><button type="submit" class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white">Reemplazar y mostrar</button><button type="button" data-product-promotion-close class="min-h-11 rounded-lg border border-stone-300 px-5 py-3 text-sm">Cancelar</button></div></form></dialog>
</section><script src="~/js/product-promotion-admin.js" asp-append-version="true" defer></script>
