<label class="theme-picker relative inline-flex shrink-0 items-center rounded-full border border-gray-200 bg-gray-100 text-gray-700">
    <span class="sr-only">Apariencia de la web</span>
    <svg class="pointer-events-none absolute left-3" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" /></svg>
    <select data-theme-select aria-label="Apariencia de la web" class="min-h-[44px] min-w-[44px] w-10 cursor-pointer appearance-none rounded-full bg-transparent pl-10 text-sm text-transparent focus:outline-none sm:w-auto sm:py-2 sm:pl-9 sm:pr-4 sm:text-gray-700">
        <option value="system">Sistema</option>
        <option value="light">Claro</option>
        <option value="dark">Oscuro</option>
        <option value="high-contrast">Alto contraste</option>
    </select>
</label>
