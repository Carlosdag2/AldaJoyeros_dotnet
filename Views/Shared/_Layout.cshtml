<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ALDA JOYEROS 1962</title>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="~/js/site.js"></script>
    <link href="~/css/site.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#F0FDF4',
                            100: '#DCFCE7',
                            200: '#BBF7D0',
                            300: '#86EFAC',
                            400: '#4ADE80',
                            500: '#22C55E',
                            600: '#16A34A',
                            700: '#15803D',
                            800: '#166534',
                            900: '#14532D',
                        },
                        dark: {
                            800: '#1A1A1A',
                            900: '#111111',
                        },
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Scrollbar invisible para elegancia */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #22C55E;
            border-radius: 4px;
        }

        .luxury-text-shadow {
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                left: 0;
                width: 0;
                height: 2px;
                background: linear-gradient(90deg, #22C55E, #16A34A);
                transition: width 0.3s ease;
            }

            .nav-link:hover::after {
                width: 100%;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans text-gray-800 antialiased">

    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50" x-data="{ mobileOpen: false }">
        <div class="container mx-auto px-6">
            <div class="flex items-center justify-between h-16 lg:h-20">

                <!-- Mobile Menu Button -->
                <button @@click="mobileOpen = !mobileOpen" class="lg:hidden w-10 h-10 flex items-center justify-center text-gray-700">
                    <i class="fas" :class="mobileOpen ? 'fa-times' : 'fa-bars'"></i>
                </button>

                <!-- Left Navigation -->
                <nav class="hidden lg:flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-sm tracking-wide text-gray-600 hover:text-gray-900 transition-colors">
                        Inicio
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="nav-link text-sm tracking-wide text-gray-600 hover:text-gray-900 transition-colors">
                        Catálogo
                    </a>
                    @if (ViewBag.IsAdmin == true)
                    {
                        <a asp-controller="Admin" asp-action="Index" class="text-sm tracking-wide text-gray-900 font-medium">
                            Admin
                        </a>
                    }
                </nav>

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="absolute left-1/2 -translate-x-1/2 lg:static lg:translate-x-0">
                    <img src="~/images/logo.png" alt="Alda Joyeros" class="h-16 lg:h-20 w-auto" />
                </a>

                <!-- Right Navigation -->
                <div class="flex items-center gap-5">
                    <!-- Botón de Alto Contraste -->
                    <button id="theme-toggle-btn"
                            class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full"
                            aria-pressed="false"
                            aria-label="Alternar modo de alto contraste">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22ZM12 20V4C16.4183 4 20 7.58172 20 12C20 16.4183 16.4183 20 12 20Z"></path>
                        </svg>
                        <span class="hidden lg:inline text-sm font-medium">Contraste</span>
                    </button>

                    @if (ViewBag.IsAuthenticated == true)
                    {
                        var currentUser = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;

                        <!-- Cart -->
                        <a asp-controller="Carrito" asp-action="Index" class="relative text-gray-600 hover:text-gray-900 transition-colors" data-carrito-link>
                            <i class="fas fa-shopping-bag" data-carrito-icon></i>
                            <span data-carrito-count 
                                  class="absolute -top-2 -right-2 w-4 h-4 bg-emerald-600 text-white text-[10px] font-medium rounded-full flex items-center justify-center @(ViewBag.CarritoCount > 0 ? "" : "hidden")">
                                @(ViewBag.CarritoCount ?? 0)
                            </span>
                        </a>

                        <!-- Account Dropdown -->
                        <div x-data="{ open: false }" class="relative">
                            <button @@click="open = !open" class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                                <i class="fas fa-user"></i>
                                <span class="hidden lg:inline text-sm">@currentUser?.Email?.Split('@')[0]</span>
                                <i class="fas fa-chevron-down text-[10px] hidden lg:inline transition-transform duration-200" :class="open && 'rotate-180'"></i>
                            </button>

                            <div x-show="open"
                                 @@click.away="open = false"
                                 x-transition:enter="transition ease-out duration-150"
                                 x-transition:enter-start="opacity-0 translate-y-1"
                                 x-transition:enter-end="opacity-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-100"
                                 x-transition:leave-start="opacity-100 translate-y-0"
                                 x-transition:leave-end="opacity-0 translate-y-1"
                                 class="absolute right-0 mt-3 w-52 bg-white border border-gray-200 shadow-lg py-1 rounded hc-dropdown"
                                 x-cloak>

                                <div class="px-4 py-3 border-b border-gray-100">
                                    <p class="text-sm font-medium text-gray-900">@currentUser?.Email?.Split('@')[0]</p>
                                    <p class="text-xs text-gray-500 truncate">@currentUser?.Email</p>
                                </div>

                                @if (ViewBag.IsAdmin == true)
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                        Panel de Admin
                                    </a>
                                    <div class="border-t border-gray-100 my-1"></div>
                                }

                                <a asp-controller="Pedidos" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                    Mis Pedidos
                                </a>

                                <a asp-controller="Carrito" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                    Mi Carrito
                                    <span data-carrito-count-menu class="text-gray-400 @(ViewBag.CarritoCount > 0 ? "" : "hidden")">(<span data-carrito-count-value>@(ViewBag.CarritoCount ?? 0)</span>)</span>
                                </a>

                                <div class="border-t border-gray-100 my-1"></div>

                                <a asp-controller="Auth" asp-action="Logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                    Cerrar sesión
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="hidden lg:inline text-sm text-gray-600 hover:text-gray-900 transition-colors">
                            Acceder
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="hidden lg:inline text-sm bg-gray-900 text-white px-4 py-2 hover:bg-gray-800 transition-colors rounded">
                            Registrarse
                        </a>
                        <a asp-controller="Auth" asp-action="Login" class="lg:hidden text-gray-600">
                            <i class="fas fa-user"></i>
                        </a>
                    }
                </div>

            </div>
        </div>

        <!-- Mobile Menu -->
        <div x-show="mobileOpen"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="lg:hidden border-t border-gray-200 bg-white"
             x-cloak>
            <div class="container mx-auto px-6 py-4 space-y-1">
                @if (ViewBag.IsAuthenticated == true)
                {
                    var currentUserMobile = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;
                    <div class="pb-3 mb-3 border-b border-gray-100">
                        <p class="text-sm font-medium text-gray-900">@currentUserMobile?.Email?.Split('@')[0]</p>
                        <p class="text-xs text-gray-500">@currentUserMobile?.Email</p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Index" class="block py-2 text-gray-700 hover:text-gray-900">
                    Inicio
                </a>
                <a asp-controller="Productos" asp-action="Index" class="block py-2 text-gray-700 hover:text-gray-900">
                    Catálogo
                </a>

                @if (ViewBag.IsAuthenticated == true)
                {
                    <a asp-controller="Carrito" asp-action="Index" class="block py-2 text-gray-700 hover:text-gray-900">
                        Carrito
                        @if (ViewBag.CarritoCount > 0)
                        {
                            <span class="ml-1 text-xs bg-emerald-600 text-white px-1.5 py-0.5 rounded">@ViewBag.CarritoCount</span>
                        }
                    </a>
                    <a asp-controller="Pedidos" asp-action="Index" class="block py-2 text-gray-700 hover:text-gray-900">
                        Mis Pedidos
                    </a>

                    @if (ViewBag.IsAdmin == true)
                    {
                        <a asp-controller="Admin" asp-action="Index" class="block py-2 text-gray-900 font-medium">
                            Panel Admin
                        </a>
                    }

                    <div class="pt-3 mt-3 border-t border-gray-100">
                        <a asp-controller="Auth" asp-action="Logout" class="block py-2 text-red-600">
                            Cerrar sesión
                        </a>
                    </div>
                }
                else
                {
                    <div class="pt-4 space-y-2">
                        <a asp-controller="Auth" asp-action="Login" class="block py-2 text-center border border-gray-300 text-gray-700 rounded">
                            Acceder
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="block py-2 text-center bg-gray-900 text-white rounded">
                            Registrarse
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <main class="min-h-screen">
        @* Sistema de notificaciones global *@
        <partial name="_Notifications" />

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-gradient-to-b from-dark-900 to-black text-white pt-16 pb-8">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
                <!-- Brand -->
                <div class="space-y-5">
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-emerald-500">ALDA JOYEROS</h2>
                        <p class="text-xs text-gray-500 tracking-widest mt-1">DESDE 1962</p>
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed">Más de 60 años creando piezas atemporales que capturan la esencia de la elegancia.</p>
                    <div class="flex gap-3">
                        <a href="https://www.facebook.com/p/Alda-Joyeros-1962-100063636367531" target="_blank" class="w-10 h-10 bg-white/5 hover:bg-emerald-500 rounded-xl flex items-center justify-center transition-all border border-white/10 hover:border-emerald-500 group">
                            <i class="fab fa-facebook-f text-gray-400 group-hover:text-white transition-colors"></i>
                        </a>
                        <a href="https://www.instagram.com/aldajoyeros1962" target="_blank" class="w-10 h-10 bg-white/5 hover:bg-gradient-to-br hover:from-purple-500 hover:to-pink-500 rounded-xl flex items-center justify-center transition-all border border-white/10 hover:border-transparent group">
                            <i class="fab fa-instagram text-gray-400 group-hover:text-white transition-colors"></i>
                        </a>
                        <a href="https://wa.me/34925541227" target="_blank" class="w-10 h-10 bg-white/5 hover:bg-green-500 rounded-xl flex items-center justify-center transition-all border border-white/10 hover:border-green-500 group">
                            <i class="fab fa-whatsapp text-gray-400 group-hover:text-white transition-colors"></i>
                        </a>
                    </div>
                </div>

                <!-- Links -->
                <div>
                    <h4 class="text-white font-bold mb-5 flex items-center gap-2"><div class="w-2 h-2 bg-emerald-500 rounded-full"></div>Navegación</h4>
                    <ul class="space-y-3 text-sm">
                        <li><a asp-controller="Home" asp-action="Index" class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-xs text-emerald-500"></i>Inicio</a></li>
                        <li><a asp-controller="Productos" asp-action="Index" class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-xs text-emerald-500"></i>Catálogo</a></li>
                        <li><a asp-controller="Carrito" asp-action="Index" class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-xs text-emerald-500"></i>Mi Carrito</a></li>
                        <li><a asp-controller="Pedidos" asp-action="Index" class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-xs text-emerald-500"></i>Mis Pedidos</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h4 class="text-white font-bold mb-5 flex items-center gap-2"><div class="w-2 h-2 bg-emerald-500 rounded-full"></div>Contacto</h4>
                    <ul class="space-y-4 text-sm">
                        <li class="flex items-start gap-3">
                            <div class="w-9 h-9 bg-emerald-500/10 rounded-lg flex items-center justify-center flex-shrink-0 border border-emerald-500/20">
                                <i class="fas fa-map-marker-alt text-emerald-500 text-sm"></i>
                            </div>
                            <div class="text-gray-400">C/ Sor Livia Alcorta, 24<br />45200 Illescas, Toledo</div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="w-9 h-9 bg-emerald-500/10 rounded-lg flex items-center justify-center flex-shrink-0 border border-emerald-500/20">
                                <i class="fas fa-phone text-emerald-500 text-sm"></i>
                            </div>
                            <a href="tel:+34925541227" class="text-gray-400 hover:text-emerald-400 transition-colors">+34 925 54 12 27</a>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="w-9 h-9 bg-emerald-500/10 rounded-lg flex items-center justify-center flex-shrink-0 border border-emerald-500/20">
                                <i class="fas fa-envelope text-emerald-500 text-sm"></i>
                            </div>
                            <a href="mailto:aldajoyeros1962@gmail.com" class="text-gray-400 hover:text-emerald-400 transition-colors break-all">aldajoyeros1962@gmail.com</a>
                        </li>
                    </ul>
                </div>

                <!-- Schedule -->
                <div>
                    <h4 class="text-white font-bold mb-5 flex items-center gap-2"><div class="w-2 h-2 bg-emerald-500 rounded-full"></div>Horario</h4>
                    <div class="bg-white/5 rounded-xl p-4 border border-white/10 space-y-3 text-sm">
                        <div class="flex justify-between"><span class="text-gray-400">Lun - Vie</span><span class="text-white text-xs">10:15-13:30 / 17:00-20:00</span></div>
                        <div class="border-t border-white/10"></div>
                        <div class="flex justify-between"><span class="text-gray-400">Sábados</span><span class="text-white">10:15 - 13:30</span></div>
                        <div class="border-t border-white/10"></div>
                        <div class="flex justify-between"><span class="text-gray-400">Domingos</span><span class="text-red-400">Cerrado</span></div>
                    </div>
                    <a href="tel:+34925541227" class="mt-4 flex items-center justify-center gap-2 w-full py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl font-semibold transition-all shadow-lg">
                        <i class="fas fa-phone-alt"></i><span>Llámanos</span>
                    </a>
                </div>
            </div>

            <!-- Copyright -->
            <div class="pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
                <p>&copy; @DateTime.Now.Year Alda Joyeros 1962. Todos los derechos reservados.</p>
                <div class="flex gap-4">
                    <a href="#" class="hover:text-emerald-400 transition-colors">Privacidad</a>
                    <span>•</span>
                    <a href="#" class="hover:text-emerald-400 transition-colors">Términos</a>
                    <span>•</span>
                    <a href="#" class="hover:text-emerald-400 transition-colors">Cookies</a>
                </div>
            </div>
        </div>

        </footer>

    <!-- Back to Top -->
    <div x-data="{ show: false }"
         x-init="window.addEventListener('scroll', () => { show = window.pageYOffset > 500 })"
         x-show="show"
         x-transition
         class="fixed bottom-6 right-6 z-30"
         style="display: none;">
        <button @@click="window.scrollTo({ top: 0, behavior: 'smooth' })"
                class="w-12 h-12 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 transition-all flex items-center justify-center group"
                aria-label="Volver arriba">
            <i class="fas fa-arrow-up group-hover:-translate-y-1 transition-transform"></i>
        </button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/alda-ajax.js"></script>
    <script src="~/js/carrito-ajax.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>