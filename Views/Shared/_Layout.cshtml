<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ALDA JOYEROS</title>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#F0FDF4',
                            100: '#DCFCE7',
                            200: '#BBF7D0',
                            300: '#86EFAC',
                            400: '#4ADE80',
                            500: '#22C55E',
                            600: '#16A34A',
                            700: '#15803D',
                            800: '#166534',
                            900: '#14532D',
                        },
                        dark: {
                            800: '#1A1A1A',
                            900: '#111111',
                        }
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Scrollbar invisible para elegancia */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #22C55E;
            border-radius: 4px;
        }

        .luxury-text-shadow {
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #22C55E, #16A34A);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans text-gray-800 antialiased selection:bg-emerald-200 selection:text-black">

    <header x-data="{ scrolled: false, mobileMenuOpen: false }"
            @@scroll.window="scrolled = (window.pageYOffset > 20)"
            :class="scrolled ? 'py-3 shadow-lg glass-nav' : 'py-5 bg-white'"
            class="fixed w-full top-0 z-50 transition-all duration-500 ease-out">
        <nav class="container mx-auto px-6">
            <div class="flex justify-between items-center">
                <!-- Left Navigation (Desktop) -->
                <div class="hidden lg:flex items-center space-x-8">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-sm uppercase tracking-[0.15em] text-gray-700 hover:text-emerald-600 font-medium">
                        <i class="fas fa-home mr-2 text-xs"></i>Inicio
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="nav-link text-sm uppercase tracking-[0.15em] text-gray-700 hover:text-emerald-600 font-medium">
                        <i class="fas fa-gem mr-2 text-xs"></i>Colecciones
                    </a>
                    
                    @* Admin Panel Link - Solo visible para administradores *@
                    @if (ViewBag.IsAdmin == true)
                    {
                        <a asp-controller="Admin" asp-action="Index" class="nav-link text-sm uppercase tracking-[0.15em] text-purple-600 hover:text-purple-700 font-semibold flex items-center gap-2">
                            <i class="fas fa-shield-alt mr-2 text-xs"></i>Panel Admin
                            <span class="bg-purple-100 text-purple-700 text-xs px-2 py-0.5 rounded-full font-bold">ADMIN</span>
                        </a>
                    }
                </div>

                <!-- Logo (Center) -->
                <a asp-controller="Home" asp-action="Index" class="flex flex-col items-center gap-1 transform hover:scale-105 transition-transform duration-500 group">
                    <div class="flex items-center">
                        <img src="~/images/logo.png" alt="Alda Joyeros" class="h-20 w-auto object-contain group-hover:brightness-110 transition-all duration-500" />
                    </div>
                </a>

                <!-- Right Navigation (Desktop) -->
                <div class="hidden lg:flex items-center space-x-4">
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        var currentUser = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;
                        
                        <!-- Shopping Cart -->
                        <a asp-controller="Carrito" asp-action="Index" class="relative group">
                            <div class="flex items-center gap-2 px-4 py-2 rounded-lg hover:bg-emerald-50 transition-colors duration-200">
                                <i class="fas fa-shopping-bag text-xl text-gray-700 group-hover:text-emerald-600 transition-colors"></i>
                                @if (ViewBag.CarritoCount > 0)
                                {
                                    <span class="absolute -top-1 -right-1 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center shadow-lg animate-pulse">
                                        @ViewBag.CarritoCount
                                    </span>
                                }
                            </div>
                        </a>

                        <!-- User Dropdown -->
                        <div x-data="{ open: false }" class="relative">
                            <button @@click="open = !open" class="flex items-center gap-3 px-4 py-2 rounded-lg hover:bg-emerald-50 transition-colors duration-200 group">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-md">
                                        @if (!string.IsNullOrEmpty(currentUser?.Email))
                                        {
                                            @currentUser.Email.Substring(0, 1).ToUpper()
                                        }
                                        else
                                        {
                                            <text>U</text>
                                        }
                                    </div>
                                    <div class="text-left">
                                        <div class="text-sm font-semibold text-gray-700 group-hover:text-emerald-600">
                                            @if (!string.IsNullOrEmpty(currentUser?.Email))
                                            {
                                                @currentUser.Email
                                            }
                                            else
                                            {
                                                <text>Usuario</text>
                                            }
                                        </div>
                                        @if (ViewBag.IsAdmin == true)
                                        {
                                            <div class="text-xs text-purple-600 font-semibold uppercase">Administrador</div>
                                        }
                                        else
                                        {
                                            <div class="text-xs text-gray-500">Cliente</div>
                                        }
                                    </div>
                                </div>
                                <i class="fas fa-chevron-down text-xs text-gray-500 group-hover:text-emerald-600 transition-transform" :class="open && 'rotate-180'"></i>
                            </button>
                            
                            <div x-show="open" 
                                 @@click.away="open = false"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 translate-y-2"
                                 x-transition:enter-end="opacity-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 translate-y-0"
                                 x-transition:leave-end="opacity-0 translate-y-2"
                                 class="absolute right-0 mt-3 w-64 bg-white rounded-xl shadow-2xl border border-gray-100 py-2 z-50 overflow-hidden">
                                
                                <!-- User Info Header -->
                                <div class="px-4 py-3 bg-gradient-to-br from-emerald-50 to-green-50 border-b border-gray-100">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold shadow-md">
                                            @if (!string.IsNullOrEmpty(currentUser?.Email))
                                            {
                                                @currentUser.Email.Substring(0, 1).ToUpper()
                                            }
                                        </div>
                                        <div>
                                            <div class="font-semibold text-gray-900">@currentUser?.Email</div>
                                            <div class="text-xs text-gray-600">@currentUser?.Email</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Admin Panel Link -->
                                @if (ViewBag.IsAdmin == true)
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-sm text-purple-600 hover:bg-purple-50 transition-colors font-semibold">
                                        <i class="fas fa-shield-alt w-5"></i>
                                        <span>Panel de Administración</span>
                                        <span class="ml-auto bg-purple-100 text-purple-700 text-xs px-2 py-0.5 rounded-full font-bold">ADMIN</span>
                                    </a>
                                    <div class="border-t border-gray-100 my-1"></div>
                                }

                                <!-- Menu Items -->
                                <a asp-controller="Pedidos" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-600 transition-colors">
                                    <i class="fas fa-box-open w-5"></i>
                                    <span>Mis Pedidos</span>
                                </a>
                                
                                <div class="border-t border-gray-100 my-1"></div>
                                
                                <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-3 px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                    <i class="fas fa-sign-out-alt w-5"></i>
                                    <span>Cerrar Sesión</span>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Login Button -->
                        <a asp-controller="Auth" asp-action="Login" class="flex items-center gap-2 px-6 py-2 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-lg font-semibold hover:from-emerald-600 hover:to-emerald-700 transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Iniciar Sesión</span>
                        </a>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button @@click="mobileMenuOpen = !mobileMenuOpen" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors">
                    <i class="fas text-xl text-gray-700 transition-transform duration-300" :class="mobileMenuOpen ? 'fa-times rotate-90' : 'fa-bars'"></i>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div x-show="mobileMenuOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 -translate-y-4"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 -translate-y-4"
                 class="lg:hidden mt-4 pt-4 border-t border-gray-200">
                <div class="space-y-2">
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        var currentUserMobile = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;
                        
                        <!-- User Info Mobile -->
                        <div class="px-4 py-3 bg-gradient-to-br from-emerald-50 to-green-50 rounded-lg mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold shadow-md">
                                    @if (!string.IsNullOrEmpty(currentUserMobile?.Email))
                                    {
                                        @currentUserMobile.Email.Substring(0, 1).ToUpper()
                                    }
                                </div>
                                <div>
                                    <div class="font-semibold text-gray-900">@currentUserMobile?.Email</div>
                                    @if (ViewBag.IsAdmin == true)
                                    {
                                        <div class="text-xs text-purple-600 font-semibold uppercase">Administrador</div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-gray-600">Cliente</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-colors">
                        <i class="fas fa-home w-5"></i>
                        <span class="font-medium">Inicio</span>
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-colors">
                        <i class="fas fa-gem w-5"></i>
                        <span class="font-medium">Colecciones</span>
                    </a>
                    
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        @if (ViewBag.IsAdmin == true)
                        {
                            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-purple-50 text-purple-600 hover:bg-purple-100 transition-colors">
                                <i class="fas fa-shield-alt w-5"></i>
                                <span class="font-semibold">Panel Admin</span>
                                <span class="ml-auto bg-purple-200 text-purple-700 text-xs px-2 py-0.5 rounded-full font-bold">ADMIN</span>
                            </a>
                        }
                        
                        <a asp-controller="Carrito" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-colors">
                            <i class="fas fa-shopping-bag w-5"></i>
                            <span class="font-medium">Carrito</span>
                            @if (ViewBag.CarritoCount > 0)
                            {
                                <span class="ml-auto bg-emerald-500 text-white text-xs font-bold px-2 py-1 rounded-full">@ViewBag.CarritoCount</span>
                            }
                        </a>
                        <a asp-controller="Pedidos" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-colors">
                            <i class="fas fa-box-open w-5"></i>
                            <span class="font-medium">Mis Pedidos</span>
                        </a>
                        <div class="border-t border-gray-200 my-2"></div>
                        <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-50 text-red-600 transition-colors">
                            <i class="fas fa-sign-out-alt w-5"></i>
                            <span class="font-medium">Cerrar Sesión</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-lg font-semibold shadow-md">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Iniciar Sesión</span>
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="min-h-screen pt-28">
        @RenderBody()
    </main>

    <footer class="bg-dark-900 text-white py-20 border-t border-gray-800">
        <div class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-6">
                    <img src="~/images/logo.png" alt="Alda Joyeros" class="h-14 w-auto object-contain brightness-200" />
                    <h2 class="font-serif text-2xl tracking-widest">ALDA JOYEROS</h2>
                </div>
                <p class="text-gray-400 font-light max-w-md leading-relaxed">
                    Desde 1962, creando piezas atemporales que capturan la esencia de la elegancia eterna. Cada diamante cuenta una historia.
                </p>
            </div>
            <div>
                <h4 class="text-emerald-400 text-xs tracking-[0.2em] mb-6 uppercase font-semibold">Servicio al Cliente</h4>
                <ul class="space-y-3 text-sm font-light text-gray-300">
                    <li>
                        <a href="#" class="flex items-center gap-2 hover:text-emerald-400 transition-colors">
                            <i class="fas fa-envelope text-xs"></i>
                            <span>Contactar</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center gap-2 hover:text-emerald-400 transition-colors">
                            <i class="fas fa-shipping-fast text-xs"></i>
                            <span>Envíos y Devoluciones</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center gap-2 hover:text-emerald-400 transition-colors">
                            <i class="fas fa-shield-alt text-xs"></i>
                            <span>Cuidado de las Joyas</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div>
                <h4 class="text-emerald-400 text-xs tracking-[0.2em] mb-6 uppercase font-semibold">Newsletter</h4>
                <p class="text-gray-400 text-sm mb-4">Recibe nuestras últimas novedades</p>
                <div class="flex gap-2">
                    <input type="email" placeholder="tu@email.com" class="flex-1 bg-white/10 border border-gray-700 text-white px-4 py-2 rounded-lg text-sm placeholder-gray-500 focus:border-emerald-400 focus:outline-none transition-colors" />
                    <button class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg font-semibold transition-colors">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="container mx-auto px-6 mt-16 pt-8 border-t border-gray-800 text-center">
            <p class="text-xs text-gray-600 uppercase tracking-widest">
                &copy; 2025 Alda Joyeros. Made with Excellence.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>