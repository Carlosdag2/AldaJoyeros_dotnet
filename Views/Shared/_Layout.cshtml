@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="language" content="Spanish" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ALDA JOYEROS 1962</title>
    <partial name="_SeoHead" />
    <meta name="cart-csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <partial name="_Favicons" />
    @if (AldaJoyeros.Helpers.TrafficPages.Resolve(Context.Request.Path) != null && Context.Response.StatusCode == 200 && !AldaJoyeros.Helpers.TrafficPages.IsAutomated(Context.Request))
    {
        <meta name="traffic-pulse-url" data-analytics="@AldaJoyeros.Helpers.VisitorConsent.AllowsAnalytics(Context.Request).ToString().ToLowerInvariant()" content="@Url.Action("Latido", "Trafico")" />
        <script src="~/js/live-traffic.js" asp-append-version="true" defer></script>
    }

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <link href="~/css/tailwind.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/high-contrast.css" rel="stylesheet" asp-append-version="true" />


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Scrollbar invisible para elegancia */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #22C55E;
            border-radius: 4px;
        }

        .luxury-text-shadow {
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

    </style>
    <link href="~/css/site-chrome.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/notifications.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-layout font-sans text-gray-800 antialiased">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-5 focus:py-3 focus:text-emerald-900">Ir al contenido</a>
    <partial name="_SiteHeader" />

    <main id="main-content" tabindex="-1">
        @* Sistema de notificaciones global *@
        <partial name="_Notifications" />

        @if (ViewBag.EcommerceEnabled != true)
        {
            <div class="bg-emerald-50 border-b border-emerald-100 px-6 py-3 text-center text-sm text-emerald-900">
                Descubre nuestro catálogo y consulta disponibilidad en la tienda.
                <a href="tel:+34925541227" class="font-semibold underline underline-offset-4 ml-2">Contactar</a>
            </div>
        }
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <!-- Back to Top -->
    <div x-data="{ show: false }"
         x-init="window.addEventListener('scroll', () => { show = window.pageYOffset > 500 })"
         x-show="show"
         x-transition
         class="fixed bottom-6 right-6 z-30"
         style="display: none;">
        <button @@click="window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })"
                class="h-11 w-11 min-h-[44px] min-w-[44px] bg-emerald-800 hover:bg-emerald-900 text-white rounded-full shadow-lg transition-colors flex items-center justify-center group"
                aria-label="Volver arriba">
            <i class="fas fa-arrow-up group-hover:-translate-y-1 transition-transform"></i>
        </button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/alda-ajax.js" asp-append-version="true"></script>
    <script src="~/js/carrito-ajax.js" asp-append-version="true"></script>
    <script src="~/js/paginacion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_CookieNotice" />
    <script src="~/js/cookie-consent.js" asp-append-version="true"></script>
</body>
</html>
