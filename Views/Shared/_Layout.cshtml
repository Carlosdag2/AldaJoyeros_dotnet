<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ALDA JOYEROS 1962</title>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#F0FDF4',
                            100: '#DCFCE7',
                            200: '#BBF7D0',
                            300: '#86EFAC',
                            400: '#4ADE80',
                            500: '#22C55E',
                            600: '#16A34A',
                            700: '#15803D',
                            800: '#166534',
                            900: '#14532D',
                        },
                        dark: {
                            800: '#1A1A1A',
                            900: '#111111',
                        }
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Scrollbar invisible para elegancia */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #22C55E;
            border-radius: 4px;
        }

        .luxury-text-shadow {
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #22C55E, #16A34A);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans text-gray-800 antialiased selection:bg-emerald-200 selection:text-black">

    <header x-data="{ scrolled: false, mobileMenuOpen: false, searchOpen: false }"
            @@scroll.window="scrolled = (window.pageYOffset > 20)"
            :class="scrolled ? 'py-2 shadow-2xl' : 'py-4'"
            class="fixed w-full top-0 z-50 transition-all duration-500 ease-out bg-white/95 backdrop-blur-xl border-b border-gray-100/50">
        
        
        <nav class="container mx-auto px-4 lg:px-8">
            <div class="flex justify-between items-center">
                
                <!-- Left Navigation (Desktop) -->
                <div class="hidden lg:flex items-center space-x-1">
                    <a asp-controller="Home" asp-action="Index" class="group relative px-5 py-3 rounded-xl text-sm font-medium text-gray-600 hover:text-emerald-600 transition-all duration-300 hover:bg-emerald-50/80">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-100 to-emerald-50 flex items-center justify-center group-hover:from-emerald-200 group-hover:to-emerald-100 transition-all duration-300 group-hover:scale-110">
                                <i class="fas fa-home text-emerald-600 text-sm"></i>
                            </div>
                            <span class="uppercase tracking-wider">Inicio</span>
                        </div>
                    </a>
                    
                    <a asp-controller="Productos" asp-action="Index" class="group relative px-5 py-3 rounded-xl text-sm font-medium text-gray-600 hover:text-emerald-600 transition-all duration-300 hover:bg-emerald-50/80">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-100 to-emerald-50 flex items-center justify-center group-hover:from-emerald-200 group-hover:to-emerald-100 transition-all duration-300 group-hover:scale-110">
                                <i class="fas fa-gem text-emerald-600 text-sm"></i>
                            </div>
                            <span class="uppercase tracking-wider">Colecciones</span>
                        </div>
                    </a>
                    
                    @* Admin Panel Link - Solo visible para administradores *@
                    @if (ViewBag.IsAdmin == true)
                    {
                        <a asp-controller="Admin" asp-action="Index" class="group relative px-5 py-3 rounded-xl text-sm font-medium transition-all duration-300 bg-gradient-to-r from-purple-50 to-violet-50 hover:from-purple-100 hover:to-violet-100 border border-purple-200/50">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-violet-600 flex items-center justify-center shadow-lg shadow-purple-500/25">
                                    <i class="fas fa-crown text-white text-sm"></i>
                                </div>
                                <span class="uppercase tracking-wider text-purple-700">Admin</span>
                                <span class="absolute -top-1 -right-1 flex h-3 w-3">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-3 w-3 bg-purple-500"></span>
                                </span>
                            </div>
                        </a>
                    }
                </div>

                <!-- Logo (Center) -->
                <a asp-controller="Home" asp-action="Index" class="relative group">
                    <div class="absolute inset-0 bg-gradient-to-r from-emerald-400/20 to-emerald-600/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="relative flex flex-col items-center gap-0 transform hover:scale-105 transition-all duration-500">
                        <img src="~/images/logo.png" alt="Alda Joyeros" 
                             :class="scrolled ? 'h-14' : 'h-16'"
                             class="w-auto object-contain transition-all duration-500 drop-shadow-sm" />
                    </div>
                </a>

                <!-- Right Navigation (Desktop) -->
                <div class="hidden lg:flex items-center space-x-2">
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        var currentUser = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;
                        
                        <!-- Shopping Cart -->
                        <a asp-controller="Carrito" asp-action="Index" class="relative group">
                            <div class="flex items-center gap-2 px-4 py-3 rounded-xl hover:bg-emerald-50/80 transition-all duration-300">
                                <div class="relative">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all duration-300 group-hover:scale-110">
                                        <i class="fas fa-shopping-bag text-lg text-gray-600 group-hover:text-emerald-600 transition-colors"></i>
                                    </div>
                                    @if (ViewBag.CarritoCount > 0)
                                    {
                                        <span class="absolute -top-2 -right-2 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white text-xs font-bold min-w-[22px] h-[22px] rounded-full flex items-center justify-center shadow-lg shadow-emerald-500/40 border-2 border-white">
                                            @ViewBag.CarritoCount
                                        </span>
                                    }
                                </div>
                                <span class="text-sm font-medium text-gray-600 group-hover:text-emerald-600">Carrito</span>
                            </div>
                        </a>

                        <!-- Divider -->
                        <div class="h-8 w-px bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>

                        <!-- User Dropdown -->
                        <div x-data="{ open: false }" class="relative">
                            <button @@click="open = !open" class="flex items-center gap-3 px-4 py-2 rounded-xl hover:bg-gray-50 transition-all duration-300 group">
                                <div class="flex items-center gap-3">
                                    <div class="relative">
                                        <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 via-emerald-600 to-emerald-700 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-emerald-500/30 group-hover:shadow-emerald-500/50 transition-shadow ring-2 ring-white">
                                            @if (!string.IsNullOrEmpty(currentUser?.Email))
                                            {
                                                @currentUser.Email.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <text>U</text>
                                            }
                                        </div>
                                        <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-white"></div>
                                    </div>
                                    <div class="text-left hidden xl:block">
                                        <div class="text-sm font-semibold text-gray-700 group-hover:text-emerald-600 transition-colors max-w-[140px] truncate">
                                            @if (!string.IsNullOrEmpty(currentUser?.Email))
                                            {
                                                @currentUser.Email.Split('@')[0]
                                            }
                                            else
                                            {
                                                <text>Usuario</text>
                                            }
                                        </div>
                                        @if (ViewBag.IsAdmin == true)
                                        {
                                            <div class="text-xs text-purple-600 font-semibold flex items-center gap-1">
                                                <i class="fas fa-crown text-[10px]"></i>
                                                <span>Administrador</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-xs text-gray-400">Cliente Premium</div>
                                        }
                                    </div>
                                </div>
                                <i class="fas fa-chevron-down text-xs text-gray-400 group-hover:text-emerald-600 transition-all duration-300" :class="open && 'rotate-180'"></i>
                            </button>
                            
                            <div x-show="open" 
                                 @@click.away="open = false"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                                 x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                                 class="absolute right-0 mt-3 w-72 bg-white rounded-2xl shadow-2xl shadow-gray-200/50 border border-gray-100 py-2 z-50 overflow-hidden">
                                
                                <!-- User Info Header -->
                                <div class="px-5 py-4 bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 border-b border-gray-100">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 via-emerald-600 to-emerald-700 rounded-2xl flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-emerald-500/30 ring-4 ring-white">
                                            @if (!string.IsNullOrEmpty(currentUser?.Email))
                                            {
                                                @currentUser.Email.Substring(0, 1).ToUpper()
                                            }
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="font-bold text-gray-900 truncate">@currentUser?.Email?.Split('@')[0]</div>
                                            <div class="text-xs text-gray-500 truncate">@currentUser?.Email</div>
                                            @if (ViewBag.IsAdmin == true)
                                            {
                                                <div class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 bg-purple-100 text-purple-700 rounded-full text-xs font-semibold">
                                                    <i class="fas fa-crown text-[10px]"></i>
                                                    <span>Admin</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Admin Panel Link -->
                                @if (ViewBag.IsAdmin == true)
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-4 px-5 py-3 text-sm text-purple-700 hover:bg-purple-50 transition-colors font-semibold group">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-violet-600 flex items-center justify-center shadow-md shadow-purple-500/25 group-hover:scale-110 transition-transform">
                                            <i class="fas fa-cog text-white"></i>
                                        </div>
                                        <span>Panel de Administración</span>
                                        <i class="fas fa-arrow-right ml-auto text-purple-400 group-hover:translate-x-1 transition-transform"></i>
                                    </a>
                                    <div class="border-t border-gray-100 my-2 mx-4"></div>
                                }

                                <!-- Menu Items -->
                                <a asp-controller="Pedidos" asp-action="Index" class="flex items-center gap-4 px-5 py-3 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-600 transition-all group">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all group-hover:scale-110">
                                        <i class="fas fa-box-open text-gray-500 group-hover:text-emerald-600"></i>
                                    </div>
                                    <span>Mis Pedidos</span>
                                    <i class="fas fa-chevron-right ml-auto text-gray-300 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"></i>
                                </a>
                                
                                <div class="border-t border-gray-100 my-2 mx-4"></div>
                                
                                <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-4 px-5 py-3 text-sm text-red-600 hover:bg-red-50 transition-all group">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-100 to-red-50 flex items-center justify-center group-hover:from-red-200 group-hover:to-red-100 transition-all group-hover:scale-110">
                                        <i class="fas fa-sign-out-alt text-red-500"></i>
                                    </div>
                                    <span class="font-medium">Cerrar Sesión</span>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Login & Register Buttons -->
                        <a asp-controller="Auth" asp-action="Login" class="group flex items-center gap-2 px-5 py-2.5 text-gray-600 hover:text-emerald-600 font-medium transition-all duration-300 rounded-xl hover:bg-gray-50">
                            <i class="fas fa-user text-sm"></i>
                            <span>Acceder</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="relative group overflow-hidden flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-emerald-500 via-emerald-600 to-emerald-700 text-white rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40">
                            <span class="absolute inset-0 bg-gradient-to-r from-emerald-600 via-emerald-700 to-emerald-800 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                            <i class="fas fa-sparkles text-sm relative z-10"></i>
                            <span class="relative z-10">Comenzar</span>
                        </a>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button @@click="mobileMenuOpen = !mobileMenuOpen" class="lg:hidden relative w-12 h-12 rounded-xl bg-gray-50 hover:bg-emerald-50 transition-all duration-300 flex items-center justify-center group">
                    <div class="w-6 h-5 flex flex-col justify-between items-center">
                        <span class="w-6 h-0.5 bg-gray-600 rounded-full transition-all duration-300 origin-center group-hover:bg-emerald-600" :class="mobileMenuOpen && 'rotate-45 translate-y-2'"></span>
                        <span class="w-4 h-0.5 bg-gray-600 rounded-full transition-all duration-300 group-hover:bg-emerald-600" :class="mobileMenuOpen && 'opacity-0 scale-0'"></span>
                        <span class="w-6 h-0.5 bg-gray-600 rounded-full transition-all duration-300 origin-center group-hover:bg-emerald-600" :class="mobileMenuOpen && '-rotate-45 -translate-y-2'"></span>
                    </div>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div x-show="mobileMenuOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 -translate-y-4"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 -translate-y-4"
                 class="lg:hidden mt-4 pt-6 border-t border-gray-100">
                <div class="space-y-2">
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        var currentUserMobile = ViewBag.CurrentUser as AldaJoyeros.DTOs.UsuarioDto;
                        
                        <!-- User Info Mobile -->
                        <div class="px-4 py-4 bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 rounded-2xl mb-4 border border-emerald-100/50">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 via-emerald-600 to-emerald-700 rounded-2xl flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-emerald-500/30 ring-4 ring-white">
                                    @if (!string.IsNullOrEmpty(currentUserMobile?.Email))
                                    {
                                        @currentUserMobile.Email.Substring(0, 1).ToUpper()
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-gray-900 truncate">@currentUserMobile?.Email?.Split('@')[0]</div>
                                    <div class="text-xs text-gray-500 truncate">@currentUserMobile?.Email</div>
                                    @if (ViewBag.IsAdmin == true)
                                    {
                                        <div class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 bg-purple-100 text-purple-700 rounded-full text-xs font-semibold">
                                            <i class="fas fa-crown text-[10px]"></i>
                                            <span>Administrador</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-emerald-600 font-medium mt-1">Cliente Premium ✨</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-4 px-4 py-3.5 rounded-xl hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-all group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all">
                            <i class="fas fa-home text-gray-500 group-hover:text-emerald-600"></i>
                        </div>
                        <span class="font-medium">Inicio</span>
                        <i class="fas fa-chevron-right ml-auto text-gray-300 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"></i>
                    </a>
                    
                    <a asp-controller="Productos" asp-action="Index" class="flex items-center gap-4 px-4 py-3.5 rounded-xl hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-all group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all">
                            <i class="fas fa-gem text-gray-500 group-hover:text-emerald-600"></i>
                        </div>
                        <span class="font-medium">Colecciones</span>
                        <i class="fas fa-chevron-right ml-auto text-gray-300 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"></i>
                    </a>
                    
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        @if (ViewBag.IsAdmin == true)
                        {
                            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-4 px-4 py-3.5 rounded-xl bg-gradient-to-r from-purple-50 to-violet-50 text-purple-700 hover:from-purple-100 hover:to-violet-100 transition-all border border-purple-200/50 group">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-violet-600 flex items-center justify-center shadow-md shadow-purple-500/25">
                                    <i class="fas fa-crown text-white"></i>
                                </div>
                                <span class="font-semibold">Panel Admin</span>
                                <span class="ml-auto flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-purple-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
                                </span>
                            </a>
                        }
                        
                        <a asp-controller="Carrito" asp-action="Index" class="flex items-center gap-4 px-4 py-3.5 rounded-xl hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-all group">
                            <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all">
                                <i class="fas fa-shopping-bag text-gray-500 group-hover:text-emerald-600"></i>
                                @if (ViewBag.CarritoCount > 0)
                                {
                                    <span class="absolute -top-1 -right-1 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white text-xs font-bold min-w-[18px] h-[18px] rounded-full flex items-center justify-center border-2 border-white">@ViewBag.CarritoCount</span>
                                }
                            </div>
                            <span class="font-medium">Carrito</span>
                            <i class="fas fa-chevron-right ml-auto text-gray-300 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"></i>
                        </a>
                        
                        <a asp-controller="Pedidos" asp-action="Index" class="flex items-center gap-4 px-4 py-3.5 rounded-xl hover:bg-emerald-50 text-gray-700 hover:text-emerald-600 transition-all group">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center group-hover:from-emerald-100 group-hover:to-emerald-50 transition-all">
                                <i class="fas fa-box-open text-gray-500 group-hover:text-emerald-600"></i>
                            </div>
                            <span class="font-medium">Mis Pedidos</span>
                            <i class="fas fa-chevron-right ml-auto text-gray-300 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"></i>
                        </a>
                        
                        <div class="border-t border-gray-100 my-3"></div>
                        
                        <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-4 px-4 py-3.5 rounded-xl hover:bg-red-50 text-red-600 transition-all group">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-100 to-red-50 flex items-center justify-center group-hover:from-red-200 group-hover:to-red-100 transition-all">
                                <i class="fas fa-sign-out-alt text-red-500"></i>
                            </div>
                            <span class="font-medium">Cerrar Sesión</span>
                        </a>
                    }
                    else
                    {
                        <div class="pt-4 space-y-3">
                            <a asp-controller="Auth" asp-action="Login" class="flex items-center justify-center gap-2 px-4 py-3.5 border-2 border-gray-200 text-gray-700 rounded-xl font-semibold hover:border-emerald-400 hover:text-emerald-600 transition-all">
                                <i class="fas fa-user"></i>
                                <span>Acceder</span>
                            </a>
                            <a asp-controller="Auth" asp-action="Login" class="flex items-center justify-center gap-2 px-4 py-3.5 bg-gradient-to-r from-emerald-500 via-emerald-600 to-emerald-700 text-white rounded-xl font-semibold shadow-lg shadow-emerald-500/25">
                                <i class="fas fa-sparkles"></i>
                                <span>Comenzar Ahora</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
