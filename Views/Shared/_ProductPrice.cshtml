@model AldaJoyeros.DTOs.ProductoDto
<div class="product-price mt-2" data-price-product="@Model.Id">
 @if(Model.DescuentoPorcentaje > 0 && Model.PrecioSinDescuento > Model.Precio){
 <div class="mb-1 flex flex-wrap items-center gap-2 text-xs"><span class="text-stone-500">PVP sin descuento: <s>@Model.PrecioSinDescuento.Value.ToString("C")</s></span><span data-discount-percent="@Model.DescuentoPorcentaje" class="rounded-full bg-emerald-100 px-2 py-1 font-semibold text-emerald-900">−@Model.DescuentoPorcentaje.ToString("0.##") % sobre PVP</span></div>
 }else if(Model.TieneDescuento&&Model.TieneTallas&&!Model.ProductoSeleccionadoId.HasValue){<span class="mb-1 inline-block rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-900">Tallas con descuento</span>}
 <span class="font-serif text-xl text-emerald-800">@(Model.PrecioDesde?"Desde ":"")@Model.Precio.ToString("C")</span>
 @if(Model.DescuentoPorcentaje>0 && Model.PrecioAnterior.HasValue && Model.PrecioAnterior!=Model.PrecioSinDescuento){<p data-price-reference class="mt-1 text-xs leading-relaxed text-stone-500">Menor precio previo registrado (30 días): @Model.PrecioAnterior.Value.ToString("C")</p>}
</div>
