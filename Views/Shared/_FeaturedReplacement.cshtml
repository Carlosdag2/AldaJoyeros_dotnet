<dialog id="featuredReplacement" class="featured-dialog rounded-2xl border border-slate-200 bg-white p-5 text-slate-900 shadow-xl sm:p-6"
        data-selection-url="@Url.Action("Seleccion", "AdminDestacados")" data-change-url="@Url.Action("Cambiar", "AdminDestacados")" aria-labelledby="featuredReplacementTitle" aria-describedby="featuredReplacementHelp">
    <h2 id="featuredReplacementTitle" class="text-xl font-semibold">¿Qué producto quieres reemplazar?</h2>
    <p id="featuredReplacementHelp" class="mt-2 text-sm leading-relaxed text-slate-600">Elige un destacado actual. El nuevo producto ocupará su misma posición en el inicio.</p>
    <p data-featured-dialog-status role="status" aria-live="polite" class="my-4 text-sm text-slate-600"></p>
    <form data-featured-replacement-form>
        <div data-featured-options role="radiogroup" aria-label="Producto que se reemplaza" class="grid gap-3 sm:grid-cols-2"></div>
        <div class="mt-5 flex flex-wrap justify-end gap-3"><button type="button" data-featured-cancel class="min-h-11 rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold">Cancelar</button><button type="submit" data-featured-confirm disabled class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50">Reemplazar y guardar</button></div>
    </form>
</dialog>
