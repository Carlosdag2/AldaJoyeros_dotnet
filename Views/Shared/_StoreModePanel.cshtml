@{ var ecommerce = ViewBag.EcommerceEnabled == true; }
<section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6" aria-labelledby="modoTiendaTitulo">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-center">
        <div><h2 id="modoTiendaTitulo" class="text-lg font-semibold text-slate-800">Modo de la web</h2><span class="mt-2 inline-flex rounded-lg px-3 py-1 text-xs font-semibold @(ecommerce ? "bg-emerald-50 text-emerald-800" : "bg-amber-50 text-amber-800")">@(ecommerce ? "Tienda online activa" : "Escaparate activo")</span><p class="mt-3 max-w-2xl text-sm text-slate-500">@(ecommerce ? "Los visitantes pueden añadir productos al carrito y completar sus compras." : "Los visitantes pueden consultar el catálogo y contactar contigo. El carrito y la compra están desactivados.")</p></div>
        <form asp-controller="AdminTienda" asp-action="Cambiar" method="post" class="flex shrink-0 flex-wrap gap-2">
            <button name="ecommerce" value="false" disabled="@(!ecommerce)" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40">Usar escaparate</button>
            <button name="ecommerce" value="true" disabled="@(ecommerce)" class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800 disabled:opacity-40">Activar tienda online</button>
        </form>
    </div>
    <p class="mt-4 text-xs text-slate-400">El cambio se aplica a toda la web. Los productos, carritos y pedidos guardados se conservan.</p>
</section>
