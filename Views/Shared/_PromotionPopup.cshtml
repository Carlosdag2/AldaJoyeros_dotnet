<dialog data-promotion-popup data-url="@Url.Action("Aviso","Promociones")" aria-labelledby="promotion-popup-title" aria-describedby="promotion-popup-description" class="promotion-dialog promotion-spotlight text-stone-900">
    <button type="button" data-promotion-dismiss aria-label="Cerrar promoción" class="spotlight-close"><i class="fas fa-times" aria-hidden="true"></i></button>
    <div class="spotlight-visual">
        <span class="spotlight-visual-label">ALDA JOYEROS 1962</span>
        <span class="spotlight-orbit" aria-hidden="true"></span>
        <div data-promotion-badge class="spotlight-badge"><span data-promotion-badge-prefix class="spotlight-badge-prefix"></span><strong data-promotion-badge-value></strong><span class="spotlight-badge-caption">sobre PVP</span></div>
        <div data-promotion-art class="spotlight-art" aria-hidden="true"><i class="far fa-gem"></i><span>Un detalle que lo cambia todo.</span></div>
        <img data-promotion-image hidden alt="" class="spotlight-product"/>
        <div data-promotion-previews class="spotlight-previews" hidden></div>
        <span class="spotlight-visual-note">Piezas elegidas para ti</span>
    </div>
    <div class="spotlight-copy">
        <p class="spotlight-eyebrow"><span aria-hidden="true"></span>UNA SELECCIÓN CON DESCUENTO</p>
        <h2 id="promotion-popup-title" data-promotion-title class="spotlight-title"></h2>
        <p id="promotion-popup-description" data-promotion-name class="spotlight-description"></p>
        <div data-promotion-pricing class="spotlight-pricing"><p class="spotlight-base">PVP sin descuento: <s data-promotion-previous></s></p><strong data-promotion-price class="spotlight-price"></strong></div>
        <p data-promotion-percent class="sr-only"></p><p data-promotion-reference class="spotlight-reference"></p>
        <a data-promotion-link class="spotlight-cta"><span data-promotion-link-label>Descubrir ofertas</span><i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        <button type="button" data-promotion-dismiss class="spotlight-later">Ahora no, seguir explorando</button>
    </div>
</dialog><script src="~/js/promotion-popup.js" asp-append-version="true" defer></script>
