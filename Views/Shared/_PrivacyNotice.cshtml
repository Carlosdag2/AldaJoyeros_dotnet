@inject Microsoft.Extensions.Options.IOptions<AldaJoyeros.Configuration.PublicationOptions> Publication
@inject Microsoft.Extensions.Options.IOptions<AldaJoyeros.Configuration.EmpresaSettings> Empresa
<p class="text-xs leading-relaxed text-stone-600">Responsable: @Publication.Value.EffectiveLegalOwner (@Empresa.Value.Nombre). @if (Context.Items[AldaJoyeros.Services.StoreModeStore.ContextKey] is true) { <text>Tus datos se utilizan para atender la cuenta, la solicitud o el pedido que realizas y cumplir las obligaciones legales correspondientes.</text> } else { <text>Tus datos se utilizan para gestionar la cuenta y las consultas y, cuando corresponda, atender pedidos anteriores y obligaciones legales. No se realizan nuevos pedidos ni pagos por la web en modo escaparate.</text> } Puedes ejercer tus derechos en @Empresa.Value.Email. <a asp-controller="Home" asp-action="Privacy" class="font-semibold underline underline-offset-4">Información completa de privacidad</a>.</p>
