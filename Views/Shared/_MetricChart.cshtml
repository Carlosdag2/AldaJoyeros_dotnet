@model AldaJoyeros.DTOs.MetricChartViewModel
@using System.Globalization
@using System.Text.Json
@{
    var points = Model.Points.Count > 0 ? Model.Points : new[] { new AldaJoyeros.DTOs.MetricChartPoint("Sin datos", "Sin datos", 0) };
    var scale = AldaJoyeros.Helpers.MetricChartScale.Create(points.Select(p=>p.Value),Model.Unit=="integer");
    var selected = points.Count - 1;
    string N(double value) => value.ToString("0.###",CultureInfo.InvariantCulture);
    string Value(double value) => Model.Unit=="currency" ? value.ToString("C2") : value.ToString("N0");
    string Axis(double value) => Model.Unit=="currency" ? value.ToString(scale.Step != Math.Truncate(scale.Step) ? "C2" : "C0") : value.ToString("N0");
    double X(int index) => 8+index*584d/Math.Max(1,points.Count-1);
    double Y(double value) => 188-Math.Max(0,value)/scale.Maximum*176;
    var line = string.Join(" ",points.Select((p,i)=>$"{N(X(i))},{N(Y(p.Value))}"));
}
<div data-number-chart="@Model.Id" data-chart-unit="@Model.Unit" data-chart-ceiling="@N(scale.Maximum)" class="min-w-0">
    <script type="application/json" data-chart-data>@Html.Raw(JsonSerializer.Serialize(points))</script>
    <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-2">
        <div class="relative @(Model.Compact ? "h-36" : "h-48") text-right text-xs text-slate-500" aria-label="Escala numérica">
            @for(var i=0;i<5;i++) { var value=scale.Step*(4-i); <span data-chart-tick="@i" class="absolute right-0 -translate-y-1/2 whitespace-nowrap" style="top:@N(6+i*22)%" title="@Value(value)">@Axis(value)</span> }
        </div>
        <div data-chart-plot class="relative min-w-0 @(Model.Compact ? "h-36" : "h-48") text-emerald-700" style="touch-action:pan-y">
            <svg viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label="@Model.Title" class="h-full w-full overflow-visible">
                @for(var i=0;i<5;i++) { <line x1="8" y1="@(12+i*44)" x2="592" y2="@(12+i*44)" stroke="currentColor" opacity=".15" /> }
                <polyline data-chart-line fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="@line" />
                <line data-chart-cursor x1="@N(X(selected))" x2="@N(X(selected))" y1="12" y2="188" stroke="currentColor" stroke-dasharray="4 4" opacity=".45" />
                <circle data-chart-dot cx="@N(X(selected))" cy="@N(Y(points[selected].Value))" r="4" fill="currentColor" />
            </svg>
        </div>
    </div>
    <div class="ml-20 flex justify-between gap-2 text-[11px] text-slate-500"><span data-chart-first>@points[0].AxisLabel</span><span data-chart-middle>@points[points.Count/2].AxisLabel</span><span data-chart-last>@points[^1].AxisLabel</span></div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2" aria-live="polite"><span data-chart-label class="text-xs text-slate-600">@points[selected].Label</span><strong data-chart-value class="text-sm font-semibold text-slate-900">@Value(points[selected].Value)</strong></div>
    <label for="chart-@Model.Id" class="mt-3 block text-[11px] text-slate-500">Elige un punto para ver su valor exacto</label>
    <input id="chart-@Model.Id" data-chart-selector type="range" min="0" max="@(points.Count-1)" value="@selected" step="1" disabled="@(points.Count<2)" aria-label="Seleccionar un punto de @Model.Title" class="mt-2 block h-10 w-full accent-emerald-700" />
</div>
