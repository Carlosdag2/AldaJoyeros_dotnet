@using System.Text.Json
@using AldaJoyeros.DTOs
@inject Microsoft.Extensions.Options.IOptions<AldaJoyeros.Configuration.PublicationOptions> Publication
@inject Microsoft.Extensions.Options.IOptions<AldaJoyeros.Configuration.EmpresaSettings> Empresa
@{
    var publication = Publication.Value;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var product = ViewData.Model as ProductoDto;
    var description = product != null ? (product.DescripcionCompleta ?? product.Descripcion ?? $"{product.CategoriaNombre}, referencia {product.Nombre}. Disponible en 72 horas.")
        : ViewData["Description"]?.ToString() ?? "Descubre la colección de joyería y relojería de Alda Joyeros 1962 en Illescas. Encuentra la pieza para tus momentos especiales.";
    description = System.Text.RegularExpressions.Regex.Replace(description, "<[^>]*>", " ");
    if (description.Length > 170) description = description[..167] + "…";
    var publicPage = (controller == "Home" && action is "Index" or "Privacy" or "Cookies" or "Terminos" or "AvisoLegal")
        || (controller == "Productos" && action is "Index" or "Detalle" && string.IsNullOrWhiteSpace(Context.Request.Query["busqueda"]));
    var priceFiltered = controller == "Productos" && action == "Index" && (!string.IsNullOrWhiteSpace(Context.Request.Query["precioMin"]) || !string.IsNullOrWhiteSpace(Context.Request.Query["precioMax"]));
    var index = publication.CanIndex && publicPage && !priceFiltered && Context.Response.StatusCode == 200;
    var origin = publication.PublicOrigin;
    string? path = null;
    if (product != null) path = AldaJoyeros.Helpers.PublicUrls.ProductPath(product);
    else if (controller == "Home") AldaJoyeros.Helpers.PublicUrls.HomePaths.TryGetValue(action, out path);
    else if (controller == "Productos" && action == "Index")
    {
        var page = (ViewData.Model as AldaJoyeros.Helpers.PagedResult<ProductoDto>)?.PageNumber ?? 1;
        string? category = ViewData["CategoriaSlug"]?.ToString();
        if (!string.IsNullOrWhiteSpace(Context.Request.Query["busqueda"])) category = null;
        path = AldaJoyeros.Helpers.PublicUrls.CatalogPath(category, page);
    }
    var canonical = path == null ? null : AldaJoyeros.Helpers.PublicUrls.Canonical(publication, path);
    var e = Empresa.Value;
    object? structured = null;
    if (origin != null && controller == "Home" && action == "Index")
        structured = new Dictionary<string, object?> {
            ["@context"] = "https://schema.org", ["@type"] = "JewelryStore", ["name"] = e.Nombre,
            ["url"] = origin + "/", ["telephone"] = e.Telefono, ["email"] = e.Email,
            ["address"] = new Dictionary<string, object?> { ["@type"] = "PostalAddress", ["streetAddress"] = e.Direccion, ["postalCode"] = e.CodigoPostal, ["addressLocality"] = e.Ciudad, ["addressRegion"] = e.Provincia, ["addressCountry"] = "ES" }
        };
    if (origin != null && product != null && publicPage && Context.Response.StatusCode == 200)
        structured = new Dictionary<string, object?> {
            ["@context"] = "https://schema.org", ["@type"] = "Product", ["name"] = product.CategoriaNombre + " · " + product.Nombre,
            ["sku"] = product.Nombre, ["description"] = description, ["url"] = canonical,
            ["image"] = product.Imagenes.Select(i => origin + "/CatalogoImagen/Foto/" + i.Id).ToArray()
        };
}
<meta name="description" content="@description" />
<meta name="robots" content="@(index ? "index, follow" : "noindex, nofollow")" data-public-indexing="@publication.CanIndex.ToString().ToLowerInvariant()" />
<meta property="og:title" content="@ViewData["Title"] | Alda Joyeros 1962" />
<meta property="og:description" content="@description" />
<meta property="og:type" content="@(product == null ? "website" : "product")" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="Alda Joyeros 1962" />
@if (canonical != null && publicPage)
{
    <link rel="canonical" href="@canonical" data-catalog-base="@(controller == "Productos" && action == "Index" ? origin + "/catalogo" : null)" />
    <meta property="og:url" content="@canonical" />
}
@if (origin != null && product?.Imagenes.FirstOrDefault() is { } photo && publicPage)
{
    <meta property="og:image" content="@(origin + "/CatalogoImagen/Foto/" + photo.Id)" />
    <meta property="og:image:alt" content="@product.CategoriaNombre, referencia @product.Nombre" />
}
@if (structured != null)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(structured))</script>
}
