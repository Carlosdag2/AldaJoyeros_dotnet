@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Colección Exclusiva";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as long?;
    var busqueda = ViewBag.Busqueda as string ?? "";
    var categoriaActual = categorias?.FirstOrDefault(c => c.Id == categoriaSeleccionada);
}

<div class="min-h-screen bg-stone-50 font-sans text-stone-800 selection:bg-emerald-900 selection:text-white"
     x-data="carritoNotificacion()">

    <!-- Elemento que vuela al carrito -->
    <div x-show="animando"
         x-ref="flyingItem"
         class="fixed z-[9999] pointer-events-none"
         style="display: none;">
        <div class="w-12 h-12 bg-emerald-900 rounded-full flex items-center justify-center shadow-xl">
            <i class="fas fa-gem text-white text-lg"></i>
        </div>
    </div>

    <!-- Notificación de producto añadido -->
    <div x-show="mostrarNotificacion"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-2"
         class="fixed bottom-6 right-6 z-50 bg-emerald-900 text-white px-6 py-4 rounded-sm shadow-2xl flex items-center gap-4 max-w-sm"
         x-cloak>
        <div class="w-10 h-10 bg-emerald-800 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fas fa-check text-lg"></i>
        </div>
        <div class="flex-1">
            <p class="font-serif text-sm" x-text="mensajeNotificacion"></p>
            <a href="/Carrito" class="text-xs text-emerald-200 hover:text-white transition-colors mt-1 inline-block">
                Ver carrito <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
        <button @@click="mostrarNotificacion = false" class="text-emerald-300 hover:text-white transition-colores">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 bg-emerald-950">
        <div class="absolute inset-0 z-0 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1573408301185-9146fe634ad0?q=80&w=2075&auto=format&fit=crop"
                 alt="Background"
                 class="w-full h-full object-cover opacity-20" />
            <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/80 via-emerald-950/60 to-emerald-950"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 text-center">
            <nav class="flex items-center justify-center gap-3 text-xs uppercase tracking-[0.2em] text-stone-400 mb-8 font-medium">
                <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">Inicio</a>
                <span>/</span>
                <span class="text-white">Catálogo</span>
                @if (categoriaActual != null)
                {
                    <span>/</span>
                    <span class="text-emerald-200">@categoriaActual.Nombre</span>
                }
            </nav>

            <h1 class="font-serif text-5xl md:text-7xl text-white mb-6 leading-tight">
                @if (categoriaActual != null)
                {
                    @categoriaActual.Nombre
                }
                else
                {
                    <span>Todos los <i class="font-light italic text-emerald-200">Productos</i></span>
                }
            </h1>

            <p class="text-stone-300 text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed">
                Descubre la excelencia en cada detalle. Piezas diseñadas para capturar la esencia de tus momentos más preciados.
            </p>

            <div class="max-w-xl mx-auto relative"
                 x-data="buscadorProductos('@categoriaSeleccionada')"
                 x-on:click.away="cerrarSugerencias()"
                 style="z-index: 100;">

                <form asp-action="Index" method="get" class="relative group">
                    <input type="hidden" name="categoriaId" value="@categoriaSeleccionada" />

                    <div class="relative flex items-center">
                        <input type="text"
                               name="busqueda"
                               value="@busqueda"
                               x-model="consulta"
                               x-on:input.debounce.300ms="buscar()"
                               x-on:focus="mostrarSugerencias = sugerencias.length > 0"
                               x-on:keydown.arrow-down.prevent="navegarAbajo()"
                               x-on:keydown.arrow-up.prevent="navegarArriba()"
                               x-on:keydown.enter="seleccionarActual($event)"
                               x-on:keydown.escape="cerrarSugerencias()"
                               placeholder="Buscar anillos, collares..."
                               autocomplete="off"
                               class="w-full bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-stone-400 px-6 py-4 rounded-sm focus:outline-none focus:bg-white/15 focus:border-emerald-400 transition-all font-light tracking-wide text-lg" />

                        <button type="submit" class="absolute right-2 p-3 text-stone-300 hover:text-white transition-colors">
                            <i class="fas fa-search" x-show="!cargando"></i>
                            <i class="fas fa-circle-notch fa-spin" x-show="cargando" x-cloak></i>
                        </button>
                    </div>

                    <div x-show="mostrarSugerencias && sugerencias.length > 0"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         x-cloak
                         class="absolute left-0 right-0 top-full mt-2 bg-white rounded-sm shadow-2xl overflow-visible z-50 text-left border border-stone-200 max-h-96">

                        <div class="px-4 py-3 bg-stone-50 border-b border-stone-100 text-xs font-bold uppercase tracking-widest text-stone-500">
                            Resultados Sugeridos
                        </div>

                        <ul class="max-h-80 overflow-y-auto">
                            <template x-for="(producto, index) in sugerencias" :key="producto.id">
                                <li>
                                    <a :href="'/Productos/Detalle/' + producto.id"
                                       class="flex items-center gap-4 px-4 py-3 transition-colors group border-b border-stone-100 last:border-b-0"
                                       :class="indiceActivo === index ? 'bg-stone-100' : 'hover:bg-stone-50'"
                                       x-on:mouseenter="indiceActivo = index"
                                       x-on:click="seleccionarProducto(producto)">

                                        <div class="w-12 h-12 bg-stone-100 flex-shrink-0 flex items-center justify-center overflow-hidden">
                                            <template x-if="producto.tieneImagen">
                                                <img :src="producto.imagen" class="w-full h-full object-cover mix-blend-multiply" :alt="producto.nombre">
                                            </template>
                                            <template x-if="!producto.tieneImagen">
                                                <i class="fas fa-gem text-stone-300"></i>
                                            </template>
                                        </div>

                                        <div class="flex-1 min-w-0">
                                            <div class="text-stone-900 font-serif truncate group-hover:text-emerald-900 transition-colores" x-text="producto.nombre"></div>
                                            <div class="text-xs text-stone-500 uppercase tracking-wide" x-text="producto.categoria"></div>
                                        </div>

                                        <div class="font-serif text-emerald-800 font-medium whitespace-nowrap" x-text="producto.precioFormateado"></div>
                                    </a>
                                </li>
                            </template>
                        </ul>

                        <a href="#" @@click.prevent="$el.closest('form').submit()" class="block w-full text-center py-3 bg-stone-50 text-xs uppercase tracking-widest font-bold text-stone-600 hover:text-emerald-900 border-t border-stone-100 transition-colors">
                            Ver todos los resultados
                        </a>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(busqueda))
                {
                    <div class="absolute -bottom-12 left-0 right-0 flex justify-center">
                        <div class="inline-flex items-center gap-3 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/10">
                            <span class="text-stone-300 text-sm">Resultados para: <span class="text-white font-serif italic">"@busqueda"</span></span>
                            <a asp-action="Index" asp-route-categoriaId="@categoriaSeleccionada" class="text-stone-400 hover:text-white transition-colors">
                                <i class="fas fa-times"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="container mx-auto px-6 py-16" x-data="{ viewMode: localStorage.getItem('viewMode') || 'grid' }" x-init="$watch('viewMode', val => localStorage.setItem('viewMode', val))">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">

            <aside class="lg:col-span-1 space-y-12">

                <div class="hidden lg:block sticky top-24">
                    <h3 class="font-serif text-2xl text-stone-900 mb-6">Colecciones</h3>
                    <ul class="space-y-4">
                        <li>
                            <a asp-action="Index" asp-route-busqueda="@busqueda"
                               class="group flex items-center justify-between text-sm uppercase tracking-widest transition-all duration-300 @(categoriaSeleccionada == null ? "text-emerald-900 font-bold pl-2 border-l-2 border-emerald-900" : "text-stone-500 hover:text-stone-900 hover:pl-2 hover:border-l-2 hover:border-stone-300 border-l-2 border-transparent")">
                                <span>Todas</span>
                                <span class="text-xs text-stone-300 group-hover:text-emerald-900">(@Model.TotalItems)</span>
                            </a>
                        </li>
                        @if (categorias != null)
                        {
                            @foreach (var cat in categorias)
                            {
                                var isActive = categoriaSeleccionada == cat.Id;
                                <li>
                                    <a asp-action="Index" asp-route-categoriaId="@cat.Id" asp-route-busqueda="@busqueda"
                                       class="group flex items-center justify-between text-sm uppercase tracking-widest transition-all duration-300 @(isActive ? "text-emerald-900 font-bold pl-2 border-l-2 border-emerald-900" : "text-stone-500 hover:text-stone-900 hover:pl-2 hover:border-l-2 hover:border-stone-300 border-l-2 border-transparent")">
                                        <span>@cat.Nombre</span>
                                        <span class="text-xs text-stone-300 group-hover:text-emerald-900">(@cat.CantidadProductos)</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="mt-12 p-8 bg-stone-100 text-center">
                        <i class="fas fa-shipping-fast text-2xl text-stone-400 mb-4"></i>
                        <h4 class="font-serif text-lg text-stone-900 mb-2">Envío Gratuito</h4>
                        <p class="text-xs text-stone-500 leading-relaxed mb-4">Disfruta de envío asegurado sin coste en pedidos superiores a 50€.</p>
                    </div>
                </div>

                <div x-data="{ open: false }" class="lg:hidden">
                    <button @@click="open = !open" class="w-full flex items-center justify-between px-6 py-4 bg-white border border-stone-200 uppercase tracking-widest text-xs font-bold">
                        <span>Filtrar Colección</span>
                        <i class="fas fa-chevron-down transition-transform" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" class="bg-white border-x border-b border-stone-200 p-6 space-y-4" x-collapse>
                        <a asp-action="Index" class="block text-sm text-stone-600">Todas las joyas</a>
                        @if (categorias != null)
                        {
                            @foreach (var cat in categorias)
                            {
                                <a asp-action="Index" asp-route-categoriaId="@cat.Id" class="block text-sm text-stone-600">@cat.Nombre</a>
                            }
                        }
                    </div>
                </div>
            </aside>

            <div class="lg:col-span-3">

                <div class="flex flex-col sm:flex-row justify-between items-center mb-10 pb-4 border-b border-stone-200">
                    <p class="text-stone-500 text-sm italic mb-4 sm:mb-0">
                        Mostrando <span class="font-bold text-stone-900">@Model.StartItem-@Model.EndItem</span> de @Model.TotalItems joyas
                    </p>

                    <div class="flex items-center gap-4">
                        <span class="text-xs uppercase tracking-widest text-stone-400">Vista:</span>
                        <button @@click="viewMode = 'grid'" :class="viewMode === 'grid' ? 'text-emerald-900' : 'text-stone-300 hover:text-stone-500'" class="transition-colors"><i class="fas fa-th-large text-lg"></i></button>
                        <button @@click="viewMode = 'list'" :class="viewMode === 'list' ? 'text-emerald-900' : 'text-stone-300 hover:text-stone-500'" class="transition-colores"><i class="fas fa-list text-lg"></i></button>
                    </div>
                </div>

                @if (Model.Items != null && Model.Items.Any())
                {
                    <div x-show="viewMode === 'grid'"
                         class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-12"
                         x-transition:enter="transition ease-out duration-500"
                         x-transition:enter-start="opacity-0 translate-y-4"
                         x-transition:enter-end="opacity-100 translate-y-0">

                        @foreach (var producto in Model.Items)
                        {
                            <div class="group relative flex flex-col">
                                <div class="relative aspect-[4/5] bg-white overflow-hidden mb-4 border border-stone-100">
                                    <a asp-action="Detalle" asp-route-id="@producto.Id" class="block w-full h-full">
                                        @if (producto.TieneImagenes)
                                        {
                                            <img src="@producto.ImagenPrincipal"
                                                 alt="@producto.Nombre"
                                                 loading="lazy"
                                                 class="w-full h-full object-cover object-center transform transition-transform duration-700 group-hover:scale-105" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center bg-stone-50 text-stone-200">
                                                <i class="fas fa-gem text-4xl"></i>
                                            </div>
                                        }
                                    </a>

                                    <div class="absolute inset-x-0 bottom-0 p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-gradient-to-t from-white/90 to-transparent">
                                        <button type="button" 
                                                @@click.stop="agregarAlCarrito(@producto.Id, '@producto.Nombre.Replace("'", "\\'").Replace("\"", "\\\"")', $event)"
                                                class="w-full py-3 bg-emerald-900 text-white text-xs uppercase tracking-widest font-bold hover:bg-black transition-colores disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                                                :disabled="cargandoProducto === @producto.Id">
                                            <span x-show="cargandoProducto !== @producto.Id">Añadir al carrito</span>
                                            <span x-show="cargandoProducto === @producto.Id" class="flex items-center gap-2">
                                                <i class="fas fa-circle-notch fa-spin"></i> Añadiendo...
                                            </span>
                                        </button>
                                    </div>

                                    <div class="absolute top-3 left-3 flex flex-col gap-2">
                                        <span class="px-2 py-1 bg-white/90 backdrop-blur text-[10px] uppercase tracking-wider font-bold text-stone-900">
                                            @producto.CategoriaNombre
                                        </span>
                                    </div>
                                </div>

                                <div class="text-center space-y-1">
                                    <h3 class="font-serif text-lg text-stone-900 group-hover:text-emerald-800 transition-colors">
                                        <a asp-action="Detalle" asp-route-id="@producto.Id">@producto.Nombre</a>
                                    </h3>
                                    <div class="font-serif text-emerald-800">@producto.Precio.ToString("C")</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div x-show="viewMode === 'list'" class="space-y-6" x-cloak>
                        @foreach (var producto in Model.Items)
                        {
                            <div class="group flex flex-col sm:flex-row bg-white border border-stone-100 hover:border-emerald-900/20 transition-all duration-300">
                                <div class="w-full sm:w-48 aspect-square flex-shrink-0 bg-stone-50 relative overflow-hidden">
                                    <a asp-action="Detalle" asp-route-id="@producto.Id">
                                        @if (producto.TieneImagenes)
                                        {
                                            <img src="@producto.ImagenPrincipal" alt="@producto.Nombre" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-stone-300"><i class="fas fa-gem text-3xl"></i></div>
                                        }
                                    </a>
                                </div>
                                <div class="p-6 flex-1 flex flex-col justify-center">
                                    <div class="text-xs uppercase tracking-widest text-emerald-800 mb-2">@producto.CategoriaNombre</div>
                                    <h3 class="font-serif text-xl text-stone-900 mb-2">
                                        <a asp-action="Detalle" asp-route-id="@producto.Id">@producto.Nombre</a>
                                    </h3>
                                    <p class="text-sm text-stone-500 mb-4 line-clamp-2">@producto.Descripcion</p>
                                    <div class="flex items-center justify-between mt-auto gap-4">
                                        <span class="font-serif text-2xl text-stone-900">@producto.Precio.ToString("C")</span>
                                        <div class="flex items-center gap-3">
                                            <button type="button"
                                                    @@click="agregarAlCarrito(@producto.Id, '@producto.Nombre.Replace("'", "\\'").Replace("\"", "\\\"")', $event)"
                                                    class="px-4 py-2 bg-emerald-900 text-white text-xs uppercase tracking-widest font-bold hover:bg-black transition-colores disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                                                    :disabled="cargandoProducto === @producto.Id">
                                                <i class="fas fa-shopping-bag" x-show="cargandoProducto !== @producto.Id"></i>
                                                <i class="fas fa-circle-notch fa-spin" x-show="cargandoProducto === @producto.Id"></i>
                                                <span class="hidden sm:inline" x-show="cargandoProducto !== @producto.Id">Añadir</span>
                                            </button>
                                            <a asp-action="Detalle" asp-route-id="@producto.Id" class="text-xs uppercase tracking-widest font-bold text-stone-900 border-b border-stone-900 pb-0.5 hover:text-emerald-800 hover:border-emerald-800 transition-colors">
                                                Ver Detalles
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <div class="flex justify-center items-center gap-2 mt-16">
                            @if (Model.HasPreviousPage)
                            {
                                <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-categoriaId="@categoriaSeleccionada" asp-route-busqueda="@busqueda"
                                   class="w-10 h-10 flex items-center justify-center border border-stone-200 text-stone-500 hover:border-emerald-900 hover:text-emerald-900 transition-colors">
                                    <i class="fas fa-chevron-left text-xs"></i>
                                </a>
                            }

                            @for (var i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <span class="w-10 h-10 flex items-center justify-center bg-emerald-900 text-white font-serif">@i</span>
                                }
                                else
                                {
                                    <a asp-action="Index" asp-route-page="@i" asp-route-categoriaId="@categoriaSeleccionada" asp-route-busqueda="@busqueda"
                                       class="w-10 h-10 flex items-center justify-center border border-stone-200 text-stone-500 hover:border-emerald-900 hover:text-emerald-900 transition-colors font-serif">
                                        @i
                                    </a>
                                }
                            }

                            @if (Model.HasNextPage)
                            {
                                <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-categoriaId="@categoriaSeleccionada" asp-route-busqueda="@busqueda"
                                   class="w-10 h-10 flex items-center justify-center border border-stone-200 text-stone-500 hover:border-emerald-900 hover:text-emerald-900 transition-colors">
                                    <i class="fas fa-chevron-right text-xs"></i>
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-24 px-6 border border-stone-200 bg-white">
                        <i class="far fa-gem text-5xl text-stone-200 mb-6"></i>
                        <h3 class="font-serif text-2xl text-stone-900 mb-3">Sin resultados</h3>
                        <p class="text-stone-500 font-light mb-8 max-w-md mx-auto">
                            No hemos encontrado joyas que coincidan con tu búsqueda. Prueba a explorar nuestras categorías principales.
                        </p>
                        <a asp-action="Index" class="inline-block px-8 py-3 bg-stone-900 text-white text-xs uppercase tracking-widest font-bold hover:bg-emerald-900 transition-colors">
                            Ver todo el catálogo
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Fuentes */
        .font-serif {
            font-family: 'Playfair Display', serif;
        }

        .font-sans {
            font-family: 'Inter', sans-serif;
        }

        /* Utilidad para truncar texto */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        [x-cloak] {
            display: none !important;
        }
    </style>
}

@section Scripts {
    <script>
        function buscadorProductos(categoriaId) {
            return {
                consulta: '@busqueda',
                sugerencias: [],
                mostrarSugerencias: false,
                cargando: false,
                indiceActivo: -1,
                categoriaId: categoriaId || null,
                controlador: null,

                async buscar() {
                    const q = this.consulta.trim();
                    console.log('🔍 Buscando:', q);
                    
                    if (q.length < 2) {
                        this.sugerencias = [];
                        this.mostrarSugerencias = false;
                        console.log('❌ Búsqueda muy corta');
                        return;
                    }
                    
                    if (this.controlador) this.controlador.abort();
                    this.controlador = new AbortController();
                    this.cargando = true;

                    try {
                        let url = `/Productos/Buscar?q=${encodeURIComponent(q)}`;
                        if (this.categoriaId) url += `&categoriaId=${this.categoriaId}`;

                        console.log('📡 Llamando a:', url);
                        
                        const response = await fetch(url, { signal: this.controlador.signal });
                        
                        console.log('📥 Response status:', response.status);
                        
                        if (response.ok) {
                            const data = await response.json();
                            console.log('📦 Datos recibidos:', data);
                            console.log('🔢 Número de sugerencias:', data.sugerencias?.length || 0);
                            

                            this.sugerencias = data.sugerencias || [];
                            this.mostrarSugerencias = this.sugerencias.length > 0;
                            this.indiceActivo = -1;
                            
                            console.log('✅ Mostrar sugerencias:', this.mostrarSugerencias);
                            console.log('📋 Sugerencias array:', this.sugerencias);
                        }
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            console.error('❌ Error en búsqueda:', error);
                        }
                    } finally {
                        this.cargando = false;
                    }
                },
                cerrarSugerencias() {
                    this.mostrarSugerencias = false;
                    this.indiceActivo = -1;
                },
                navegarAbajo() {
                    if (!this.mostrarSugerencias) return;
                    if (this.indiceActivo < this.sugerencias.length - 1) this.indiceActivo++;
                    else this.indiceActivo = 0;
                },
                navegarArriba() {
                    if (!this.mostrarSugerencias) return;
                    if (this.indiceActivo > 0) this.indiceActivo--;
                    else this.indiceActivo = this.sugerencias.length - 1;
                },
                seleccionarActual(event) {
                    if (this.indiceActivo >= 0 && this.indiceActivo < this.sugerencias.length) {
                        event.preventDefault();
                        this.seleccionarProducto(this.sugerencias[this.indiceActivo]);
                    }
                },
                seleccionarProducto(producto) {
                    window.location.href = `/Productos/Detalle/${producto.id}`;
                }
            };
        }

        function carritoNotificacion() {
            return {
                mostrarNotificacion: false,
                mensajeNotificacion: '',
                cargandoProducto: null,
                animando: false,

                async agregarAlCarrito(productoId, nombreProducto, event) {
                    this.cargandoProducto = productoId;
                    
                    try {
                        const response = await fetch('/Carrito/AgregarAjax', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: `productoId=${productoId}&cantidad=1`
                        });

                        const data = await response.json();

                        if (data.success) {
                            // Ejecutar animación de vuelo al carrito
                            await this.animarVueloAlCarrito(event);
                            
                            // Actualizar todos los contadores del carrito
                            this.actualizarContadorCarrito(data.totalItems);
                            
                            this.activarNotificacion(`'${nombreProducto}' añadido al carrito`);
                        } else if (data.requiresLogin) {
                            window.location.href = '/Auth/Login';
                        } else {
                            alert(data.message || 'Error al añadir al carrito');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Error al añadir al carrito');
                    } finally {
                        this.cargandoProducto = null;
                    }
                },

                actualizarContadorCarrito(totalItems) {
                    // Actualizar el badge principal del carrito
                    const carritoContador = document.querySelector('[data-carrito-count]');
                    if (carritoContador) {
                        carritoContador.textContent = totalItems;
                        if (totalItems > 0) {
                            carritoContador.classList.remove('hidden');
                        } else {
                            carritoContador.classList.add('hidden');
                        }
                        // Animación de rebote
                        carritoContador.classList.add('animate-bounce');
                        setTimeout(() => carritoContador.classList.remove('animate-bounce'), 500);
                    }

                    // Actualizar el contador en el menú dropdown
                    const carritoContadorMenu = document.querySelector('[data-carrito-count-menu]');
                    const carritoContadorValue = document.querySelector('[data-carrito-count-value]');
                    if (carritoContadorMenu && carritoContadorValue) {
                        carritoContadorValue.textContent = totalItems;
                        if (totalItems > 0) {
                            carritoContadorMenu.classList.remove('hidden');
                        } else {
                            carritoContadorMenu.classList.add('hidden');
                        }
                    }

                    // Animar el icono del carrito
                    const carritoIcono = document.querySelector('[data-carrito-icon]');
                    if (carritoIcono) {
                        carritoIcono.classList.add('animate-bounce');
                        setTimeout(() => carritoIcono.classList.remove('animate-bounce'), 600);
                    }
                },

                async animarVueloAlCarrito(event) {
                    return new Promise((resolve) => {
                        const flyingItem = this.$refs.flyingItem;
                        if (!flyingItem) {
                            resolve();
                            return;
                        }

                        // Obtener posición del botón clickeado
                        const button = event.target.closest('button');
                        const buttonRect = button.getBoundingClientRect();
                        
                        // Buscar el icono del carrito en el header
                        const carritoLink = document.querySelector('[data-carrito-link]') || document.querySelector('a[href*="Carrito"]');
                        let endX, endY;
                        
                        if (carritoLink) {
                            const carritoRect = carritoLink.getBoundingClientRect();
                            endX = carritoRect.left + carritoRect.width / 2;
                            endY = carritoRect.top + carritoRect.height / 2;
                        } else {
                            // Si no encuentra el carrito, volar hacia arriba a la derecha
                            endX = window.innerWidth - 60;
                            endY = 30;
                        }

                        // Posición inicial (centro del botón)
                        const startX = buttonRect.left + buttonRect.width / 2;
                        const startY = buttonRect.top + buttonRect.height / 2;

                        // Configurar posición inicial
                        flyingItem.style.left = startX + 'px';
                        flyingItem.style.top = startY + 'px';
                        flyingItem.style.transform = 'translate(-50%, -50%) scale(1)';
                        flyingItem.style.opacity = '1';
                        flyingItem.style.display = 'block';
                        this.animando = true;

                        // Animar con una curva parabólica
                        const duration = 600;
                        const startTime = performance.now();

                        const animate = (currentTime) => {
                            const elapsed = currentTime - startTime;
                            const progress = Math.min(elapsed / duration, 1);
                            
                            // Función de easing (ease-out cubic)
                            const easeOut = 1 - Math.pow(1 - progress, 3);
                            
                            // Calcular posición con curva parabólica
                            const currentX = startX + (endX - startX) * easeOut;
                            const arcHeight = -100 * Math.sin(progress * Math.PI); // Arco hacia arriba
                            const currentY = startY + (endY - startY) * easeOut + arcHeight;
                            
                            // Escala que disminuye
                            const scale = 1 - (progress * 0.5);
                            
                            flyingItem.style.left = currentX + 'px';
                            flyingItem.style.top = currentY + 'px';
                            flyingItem.style.transform = `translate(-50%, -50%) scale(${scale}) rotate(${progress * 360}deg)`;
                            flyingItem.style.opacity = 1 - (progress * 0.3);

                            if (progress < 1) {
                                requestAnimationFrame(animate);
                            } else {
                                // Finalizar animación
                                flyingItem.style.display = 'none';
                                this.animando = false;
                                resolve();
                            }
                        };

                        requestAnimationFrame(animate);
                    });
                },

                activarNotificacion(mensaje) {
                    this.mensajeNotificacion = mensaje;
                    this.mostrarNotificacion = true;

                    setTimeout(() => {
                        this.mostrarNotificacion = false;
                    }, 4000);
                }
            };
        }
    </script>
}