@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>

@{
    ViewData["Title"] = "Colección Exclusiva";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as long?;
    var busqueda = ViewBag.Busqueda as string ?? "";
    var precioMin = ViewBag.PrecioMin as string ?? "";
    var precioMax = ViewBag.PrecioMax as string ?? "";
    var categoriaActual = categorias?.FirstOrDefault(c => c.Id == categoriaSeleccionada);
}

<div class="min-h-screen bg-stone-50 font-sans text-stone-800 selection:bg-emerald-900 selection:text-white"
 x-data="carritoNotificacion()">

@if (ViewBag.EcommerceEnabled == true)
{
    <partial name="_CarritoNotificacion" />
}

<div x-data="productosApp()">
<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 bg-emerald-950">
        <div class="absolute inset-0 z-0 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1573408301185-9146fe634ad0?q=80&w=2075&auto=format&fit=crop"
                 alt="Background"
                 class="w-full h-full object-cover opacity-20" />
            <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/80 via-emerald-950/60 to-emerald-950"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 text-center">
            <nav class="flex items-center justify-center gap-3 text-xs uppercase tracking-[0.2em] text-stone-400 mb-8 font-medium">
                <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">Inicio</a>
                <span>/</span>
                <span class="text-white">Catálogo</span>
                <span x-show="nombreCategoria" class="inline-flex items-center gap-3" style="@(categoriaActual == null ? "display: none;" : null)">
                    <span>/</span>
                    <span class="text-emerald-200" x-text="nombreCategoria">@categoriaActual?.Nombre</span>
                </span>
            </nav>

            <h1 class="font-serif text-5xl md:text-7xl text-white mb-6 leading-tight">
                <span x-show="nombreCategoria" x-text="nombreCategoria" style="@(categoriaActual == null ? "display: none;" : null)">@categoriaActual?.Nombre</span>
                <span x-show="!nombreCategoria" style="@(categoriaActual != null ? "display: none;" : null)">Todos los <i class="font-light italic text-emerald-200">Productos</i></span>
            </h1>

            <p class="text-stone-300 text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed">
                Descubre la excelencia en cada detalle. Piezas diseñadas para capturar la esencia de tus momentos más preciados.
            </p>

            <div class="max-w-xl mx-auto relative"
                 x-data="buscadorProductos()"
                 x-on:catalogo-busqueda.window="restablecer($event.detail)"
                 x-on:click.away="cerrarSugerencias()"
                 style="z-index: 100;">

                <form asp-action="Index" method="get" class="relative group">

                    <div class="relative flex items-center">
                        <input type="text"
                               name="busqueda"
                               value="@busqueda"
                               x-model="consulta"
                               x-on:input.debounce.300ms="buscar()"
                               x-on:focus="mostrarSugerencias = sugerencias.length > 0"
                               x-on:keydown.arrow-down.prevent="navegarAbajo()"
                               x-on:keydown.arrow-up.prevent="navegarArriba()"
                               x-on:keydown.enter="seleccionarActual($event)"
                               x-on:keydown.escape="cerrarSugerencias()"
                               placeholder="Buscar anillos, collares..."
                               autocomplete="off"
                               class="w-full bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-stone-400 px-6 py-4 rounded-sm focus:outline-none focus:bg-white/15 focus:border-emerald-400 transition-all font-light tracking-wide text-lg" />

                        <button type="submit" class="absolute right-2 p-3 text-stone-300 hover:text-white transition-colors">
                            <i class="fas fa-search" x-show="!cargando"></i>
                            <i class="fas fa-circle-notch fa-spin" x-show="cargando" x-cloak></i>
                        </button>
                    </div>

                    <div x-show="mostrarSugerencias && sugerencias.length > 0"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         x-cloak
                         class="absolute left-0 right-0 top-full mt-2 bg-white rounded-sm shadow-2xl overflow-visible z-50 text-left border border-stone-200 max-h-96">

                        <div class="px-4 py-3 bg-stone-50 border-b border-stone-100 text-xs font-bold uppercase tracking-widest text-stone-500">
                            Resultados Sugeridos
                        </div>

                        <ul class="max-h-80 overflow-y-auto">
                            <template x-for="(producto, index) in sugerencias" :key="producto.id">
                                <li>
                                    <a :href="producto.url"
                                       class="flex items-center gap-4 px-4 py-3 transition-colors group border-b border-stone-100 last:border-b-0"
                                       :class="indiceActivo === index ? 'bg-stone-100' : 'hover:bg-stone-50'"
                                       x-on:mouseenter="indiceActivo = index"
                                       x-on:click="seleccionarProducto(producto)">

                                        <div class="w-12 h-12 bg-stone-100 flex-shrink-0 flex items-center justify-center overflow-hidden">
                                            <template x-if="producto.tieneImagen">
                                                <img :src="producto.imagen" class="w-full h-full object-cover mix-blend-multiply" :alt="producto.nombre">
                                            </template>
                                            <template x-if="!producto.tieneImagen">
                                                <i class="fas fa-gem text-stone-300"></i>
                                            </template>
                                        </div>

                                        <div class="flex-1 min-w-0">
                                            <div class="text-stone-900 font-serif truncate group-hover:text-emerald-900 transition-colores" x-text="producto.nombre"></div>
                                            <div class="text-xs text-stone-500 uppercase tracking-wide" x-text="producto.categoria"></div>
                                        </div>

                                        <div class="font-serif text-emerald-800 font-medium whitespace-nowrap" x-text="producto.precioFormateado"></div>
                                    </a>
                                </li>
                            </template>
                        </ul>

                        <a href="#" @@click.prevent="$el.closest('form').submit()" class="block w-full text-center py-3 bg-stone-50 text-xs uppercase tracking-widest font-bold text-stone-600 hover:text-emerald-900 border-t border-stone-100 transition-colors">
                            Ver todos los resultados
                        </a>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(busqueda))
                {
                    <div class="absolute -bottom-12 left-0 right-0 flex justify-center">
                        <div class="inline-flex items-center gap-3 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/10">
                            <span class="text-stone-300 text-sm">Resultados para: <span class="text-white font-serif italic">"@busqueda"</span></span>
                            <a asp-action="Index" asp-route-categoria="@categoriaActual?.UrlSlug" class="text-stone-400 hover:text-white transition-colors">
                                <i class="fas fa-times"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="container mx-auto px-6 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">

            <aside class="lg:col-span-1 space-y-12">

                <form method="get" action="@(Context.Request.PathBase + AldaJoyeros.Helpers.PublicUrls.CatalogPath(categoriaActual?.UrlSlug))"
                      x-on:submit.prevent="aplicarPrecio()" class="border-b border-stone-200 pb-8" aria-labelledby="tituloFiltroPrecio">
                    <input type="hidden" name="busqueda" :value="busquedaActual" value="@busqueda" />
                    <h2 id="tituloFiltroPrecio" class="font-serif text-2xl text-stone-900 mb-6">Precio</h2>
                    <div class="catalog-price-slider relative mx-3 h-10 text-emerald-800" x-on:pointerdown="elegirPrecioEnBarra($event)">
                        <div class="catalog-price-track pointer-events-none absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-stone-200"></div>
                        <div class="catalog-price-selection pointer-events-none absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-emerald-800"
                             :style="estiloSeleccionPrecio"></div>
                        <input id="precioMinBarra" type="range" min="0" max="10000" step="1" :value="Math.round(posicionPrecio(precioInferior) * 10000)"
                               :aria-valuemax="Math.round(posicionPrecio(precioSuperior) * 10000)" :aria-valuetext="formatearPrecio(precioInferior)"
                               aria-label="Precio mínimo" class="catalog-price-handle"
                               x-on:input="moverTiradorPrecio('min', $event)" x-on:keydown="tecladoPrecio('min', $event)" x-on:change="aplicarBarraPrecio()" />
                        <input id="precioMaxBarra" type="range" min="0" max="10000" step="1" :value="Math.round(posicionPrecio(precioSuperior) * 10000)"
                               :aria-valuemin="Math.round(posicionPrecio(precioInferior) * 10000)" :aria-valuetext="formatearPrecio(precioSuperior)"
                               aria-label="Precio máximo" class="catalog-price-handle catalog-price-handle-max"
                               x-on:input="moverTiradorPrecio('max', $event)" x-on:keydown="tecladoPrecio('max', $event)" x-on:change="aplicarBarraPrecio()" />
                    </div>
                    <div class="mt-1 flex flex-wrap items-center justify-between gap-2 text-xs text-stone-500">
                        <span x-text="formatearPrecio(0)"></span>
                        <span x-text="formatearPrecio(precioTope)"></span>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-3">
                        <label for="precioMin" class="min-w-0 text-xs text-stone-600">Desde (€)
                            <input id="precioMin" name="precioMin" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"
                                   value="@precioMin" x-model="precioMinEntrada" x-on:change="aplicarPrecio()"
                                   class="mt-2 block w-full min-w-0 rounded-sm border border-stone-300 bg-white px-3 py-3 text-sm text-stone-900 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700" />
                        </label>
                        <label for="precioMax" class="min-w-0 text-xs text-stone-600">Hasta (€)
                            <input id="precioMax" name="precioMax" type="number" min="0" step="0.01" inputmode="decimal" :placeholder="precioTope"
                                   value="@precioMax" x-model="precioMaxEntrada" x-on:change="aplicarPrecio()"
                                   class="mt-2 block w-full min-w-0 rounded-sm border border-stone-300 bg-white px-3 py-3 text-sm text-stone-900 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700" />
                        </label>
                    </div>
                    <p class="mt-3 text-xs leading-relaxed text-stone-500">La barra da más espacio a tu rango. Sus extremos siempre permiten volver a 0 € y al precio máximo. En artículos con tallas se usa el precio «Desde».</p>
                    <p x-show="errorPrecio" x-text="errorPrecio" x-cloak role="alert" class="mt-3 text-sm text-red-700"></p>
                    <div x-show="precioMinActual !== '' || precioMaxActual !== ''" x-cloak class="mt-4 space-y-2">
                        <p x-text="resumenPrecio" aria-live="polite" class="text-sm font-medium text-emerald-900"></p>
                        <button type="button" x-on:click="quitarPrecio()" class="text-sm text-stone-600 underline hover:text-emerald-900">Quitar filtro de precio</button>
                    </div>
                </form>

                <div class="hidden lg:block">
                    <h3 class="font-serif text-2xl text-stone-900 mb-6">Categorías</h3>
                    <ul class="space-y-4" id="listaCategorias">
                        <li>
                            <button type="button" 
                                    @@click="filtrarCategoria(null)" :aria-pressed="categoriaActual === null"
                                    class="categoria-link group w-full text-left flex items-center justify-between text-sm uppercase tracking-widest transition-all duration-300"
                                    :class="categoriaActual === null ? 'text-emerald-900 font-bold pl-2 border-l-2 border-emerald-900' : 'text-stone-500 hover:text-stone-900 hover:pl-2 hover:border-l-2 hover:border-stone-300 border-l-2 border-transparent'">
                                <span>Todas</span>
                                <span class="text-xs text-stone-300 group-hover:text-emerald-900">(@(ViewBag.TotalCatalogProducts ?? 0))</span>
                            </button>
                        </li>
                        @if (categorias != null)
                        {
                            <partial name="_CategoriasCatalogo" model="categorias" />
                        }
                    </ul>

                    <div class="mt-12 p-8 bg-stone-100 text-center">
                        <i class="fas fa-shipping-fast text-2xl text-stone-400 mb-4"></i>
                        <h4 class="font-serif text-lg text-stone-900 mb-2">@(ViewBag.EcommerceEnabled == true ? "Envío Gratuito" : "Visítanos en Illescas")</h4>
                        <p class="text-xs text-stone-500 leading-relaxed mb-4">@(ViewBag.EcommerceEnabled == true ? "Disfruta de envío asegurado sin coste en pedidos superiores a 50€." : "Consulta disponibilidad y recibe asesoramiento personalizado en nuestra tienda.")</p>
                    </div>
                </div>

                <div x-data="{ open: false }" x-on:catalogo-categoria-seleccionada.window="open = false" class="lg:hidden">
                    <button @@click="open = !open" class="w-full flex items-center justify-between px-6 py-4 bg-white border border-stone-200 uppercase tracking-widest text-xs font-bold">
                        <span>Filtrar por categoría</span>
                        <i class="fas fa-chevron-down transition-transform" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" class="bg-white border-x border-b border-stone-200 p-6 space-y-4 max-h-96 overflow-y-auto" x-collapse>
                        <button type="button" @@click="filtrarCategoria(null); open = false" class="block text-sm text-stone-600 w-full text-left hover:text-emerald-900">Todas las joyas</button>
                        @if (categorias != null)
                        {
                            <ul class="space-y-2"><partial name="_CategoriasCatalogo" model="categorias" /></ul>
                        }
                    </div>
                </div>
            </aside>

            <div class="lg:col-span-3">
                <!-- Loading overlay -->
                <div x-show="cargando" class="fixed inset-0 bg-white/80 z-40 flex items-center justify-center" x-cloak>
                    <div class="text-center">
                        <i class="fas fa-circle-notch fa-spin text-4xl text-emerald-900 mb-4"></i>
                        <p class="text-stone-600 font-serif">Cargando productos...</p>
                    </div>
                </div>

                <div class="mb-4">
                    <partial name="_AvisoPrecios" />
                </div>

                <!-- Contenedor de productos (se actualiza con AJAX) -->
                <div id="productosContainer" x-ref="productosContainer">
                    @await Html.PartialAsync("_ProductosGrid", Model)
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@section Styles {
    <style>
        /* Both native ranges share one rail; only their thumbs receive pointer input. */
        .catalog-price-handle {
            position: absolute; top: 0; left: 0; width: calc(100% - 32px); height: 40px; margin: 0;
            appearance: none; -webkit-appearance: none; background: transparent;
            pointer-events: none; color: inherit; outline: none;
        }
        .catalog-price-track { left: 14px; right: 14px; }
        .catalog-price-handle-max { left: 32px; }
        .catalog-price-handle::-webkit-slider-runnable-track { height: 4px; background: transparent; }
        .catalog-price-handle::-moz-range-track { height: 4px; background: transparent; }
        .catalog-price-handle::-webkit-slider-thumb {
            appearance: none; -webkit-appearance: none; margin-top: -12px;
            width: 28px; height: 28px; border-radius: 6px; border: 2px solid currentColor;
            background: var(--theme-surface, #fff); pointer-events: auto; cursor: ew-resize; touch-action: none;
        }
        .catalog-price-handle::-moz-range-thumb {
            width: 24px; height: 24px; border-radius: 6px; border: 2px solid currentColor;
            background: var(--theme-surface, #fff); pointer-events: auto; cursor: ew-resize; touch-action: none;
        }
        .catalog-price-handle:focus-visible::-webkit-slider-thumb { outline: 3px solid currentColor; outline-offset: 4px; }
        .catalog-price-handle:focus-visible::-moz-range-thumb { outline: 3px solid currentColor; outline-offset: 4px; }
        html[data-theme="high-contrast"] .catalog-price-slider { color: #ffff00 !important; }
        html[data-theme="high-contrast"] .catalog-price-track { background: #fff !important; }
        html[data-theme="high-contrast"] .catalog-price-handle { border: 0 !important; background: transparent !important; color: #ffff00 !important; }
        html[data-theme="high-contrast"] .catalog-price-handle::-webkit-slider-thumb { background: #000 !important; border-color: #ffff00 !important; }
        html[data-theme="high-contrast"] .catalog-price-handle::-moz-range-thumb { background: #000 !important; border-color: #ffff00 !important; }
        html[data-theme="high-contrast"] .catalog-price-selection { background: #ffff00 !important; }

        /* Fuentes */
        .font-serif {
            font-family: 'Playfair Display', serif;
        }

        .font-sans {
            font-family: 'Inter', sans-serif;
        }

        /* Utilidad para truncar texto */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        [x-cloak] {
            display: none !important;
        }
    </style>
}

@section Scripts {
    <script>
        function buscadorProductos() {
            return {
                consulta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(busqueda)),
                sugerencias: [],
                mostrarSugerencias: false,
                cargando: false,
                indiceActivo: -1,
                controlador: null,

                restablecer(consulta) {
                    if (this.controlador) this.controlador.abort();
                    this.controlador = null;
                    this.consulta = consulta || '';
                    this.sugerencias = [];
                    this.mostrarSugerencias = false;
                    this.indiceActivo = -1;
                    this.cargando = false;
                },

                async buscar() {
                    const q = this.consulta.trim();
                    if (this.controlador) this.controlador.abort();
                    
                    if (q.length < 2) {
                        this.sugerencias = [];
                        this.mostrarSugerencias = false;
                        this.cargando = false;
                        return;
                    }
                    
                    const requestController = new AbortController();
                    this.controlador = requestController;
                    this.cargando = true;

                    try {
                        const url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Buscar", "Productos"))) + `?q=${encodeURIComponent(q)}`;
                        
                        const response = await fetch(url, { signal: requestController.signal });
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (this.controlador !== requestController || this.consulta.trim() !== q) return;

                            this.sugerencias = data.sugerencias || [];
                            this.mostrarSugerencias = this.sugerencias.length > 0;
                            this.indiceActivo = -1;
                        }
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            console.error('Error en búsqueda:', error);
                        }
                    } finally {
                        if (this.controlador === requestController) this.cargando = false;
                    }
                },
                cerrarSugerencias() {
                    this.mostrarSugerencias = false;
                    this.indiceActivo = -1;
                },
                navegarAbajo() {
                    if (!this.mostrarSugerencias) return;
                    if (this.indiceActivo < this.sugerencias.length - 1) this.indiceActivo++;
                    else this.indiceActivo = 0;
                },
                navegarArriba() {
                    if (!this.mostrarSugerencias) return;
                    if (this.indiceActivo > 0) this.indiceActivo--;
                    else this.indiceActivo = this.sugerencias.length - 1;
                },
                seleccionarActual(event) {
                    if (this.indiceActivo >= 0 && this.indiceActivo < this.sugerencias.length) {
                        event.preventDefault();
                        this.seleccionarProducto(this.sugerencias[this.indiceActivo]);
                    }
                },
                seleccionarProducto(producto) {
                    window.location.href = producto.url;
                }
            };
        }

        // ========================================
        // APP PRINCIPAL DE PRODUCTOS CON AJAX
        // ========================================
        function productosApp() {
            return {
                // Estado
                viewMode: localStorage.getItem('viewMode') || 'grid',
                cargando: false,
                categoriaActual: @(categoriaSeleccionada.HasValue ? categoriaSeleccionada.Value.ToString() : "null"),
                categorias: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categorias?.Select(c => new { id = c.Id, nombre = c.Nombre, slug = c.UrlSlug, url = (Context.Request.PathBase + AldaJoyeros.Helpers.PublicUrls.CatalogPath(c.UrlSlug)).ToString() }) ?? Enumerable.Empty<object>())),
                get nombreCategoria() {
                    return this.categorias.find(c => String(c.id) === String(this.categoriaActual))?.nombre || '';
                },
                busquedaActual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(busqueda)),
                precioMinEntrada: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precioMin)),
                precioMaxEntrada: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precioMax)),
                precioMinActual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precioMin)),
                precioMaxActual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precioMax)),
                precioTopeCatalogo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((double)(ViewBag.PrecioTope ?? 1d))),
                escalaPrecioMin: 0,
                escalaPrecioMax: 1,
                get estiloSeleccionPrecio() {
                    const min = this.posicionPrecio(this.precioInferior);
                    const max = Math.max(min, this.posicionPrecio(this.precioSuperior));
                    // Separate tracks reserve 32px between thumbs, even for identical prices.
                    return { left: `calc(${min * 100}% + ${14 - 60 * min}px)`, right: `calc(${(1 - max) * 100}% + ${60 * max - 46}px)` };
                },
                ajustarEscalaPrecio(forzar = false) {
                    if (this.precioMinActual === '' && this.precioMaxActual === '') {
                        this.escalaPrecioMin = 0;
                        this.escalaPrecioMax = this.precioTope;
                        return;
                    }
                    let min = this.precioInferior;
                    let max = Math.max(min, this.precioSuperior);
                    // With one open side, magnify the remaining bound rather than shrinking it against the edge.
                    if (max === this.precioTope && min > 0) {
                        const padding = Math.max(5, min * 0.2);
                        max = Math.min(this.precioTope, min + padding);
                        min = Math.max(0, min - padding);
                    } else if (min === 0 && max > this.precioTope * 0.6 && max < this.precioTope) {
                        const padding = Math.max(5, (this.precioTope - max) * 0.2);
                        min = Math.max(0, max - padding);
                        max = Math.min(this.precioTope, max + padding);
                    }
                    const span = Math.max(1, max - min);
                    const outside = min < this.escalaPrecioMin || max > this.escalaPrecioMax;
                    if (!forzar && !outside && span >= (this.escalaPrecioMax - this.escalaPrecioMin) * 0.6) return;
                    const padding = Math.max(5, span * 0.2);
                    this.escalaPrecioMin = Math.max(0, Math.floor((min - padding) * 100) / 100);
                    this.escalaPrecioMax = Math.min(this.precioTope, Math.ceil((max + padding) * 100) / 100);
                    if (this.escalaPrecioMax <= this.escalaPrecioMin) this.escalaPrecioMin = Math.max(0, this.escalaPrecioMax - 1);
                },
                get tramosPrecio() {
                    // Magnify the chosen interval while reserving both tails to reach 0 and the catalog maximum.
                    return {
                        precios: [0, this.escalaPrecioMin, this.escalaPrecioMax, this.precioTope],
                        posiciones: [0, this.escalaPrecioMin > 0 ? 0.15 : 0, this.escalaPrecioMax < this.precioTope ? 0.85 : 1, 1]
                    };
                },
                interpolarPrecio(value, origen, destino) {
                    if (value <= origen[0]) return destino[0];
                    for (let i = 1; i < origen.length; i++) {
                        if (origen[i] > origen[i - 1] && value <= origen[i])
                            return destino[i - 1] + (value - origen[i - 1]) / (origen[i] - origen[i - 1]) * (destino[i] - destino[i - 1]);
                    }
                    return destino[destino.length - 1];
                },
                posicionPrecio(price) {
                    const tramos = this.tramosPrecio;
                    return this.interpolarPrecio(price, tramos.precios, tramos.posiciones);
                },
                precioDesdePosicion(position) {
                    const tramos = this.tramosPrecio;
                    return this.interpolarPrecio(position, tramos.posiciones, tramos.precios);
                },
                moverTiradorPrecio(extremo, event) {
                    const price = this.precioDesdePosicion(Number(event.target.value) / 10000);
                    const clamped = this.moverPrecio(extremo, price);
                    // Reset the actual native thumb too when it reaches the other price.
                    event.target.value = Math.round(this.posicionPrecio(clamped) * 10000);
                },
                async tecladoPrecio(extremo, event) {
                    const current = extremo === 'min' ? this.precioInferior : this.precioSuperior;
                    const step = event.shiftKey ? 1 : 0.01;
                    const values = {
                        ArrowLeft: current - step, ArrowDown: current - step,
                        ArrowRight: current + step, ArrowUp: current + step,
                        PageDown: current - 10, PageUp: current + 10,
                        Home: 0, End: this.precioTope
                    };
                    if (!(event.key in values)) return;
                    event.preventDefault();
                    const price = this.moverPrecio(extremo, values[event.key]);
                    event.target.value = Math.round(this.posicionPrecio(price) * 10000);
                    await this.aplicarBarraPrecio();
                },
                get precioTope() {
                    return Math.max(this.precioTopeCatalogo, Number(this.precioMinActual) || 0, Number(this.precioMaxActual) || 0);
                },
                get precioInferior() {
                    return Math.min(this.precioTope, Math.max(0, Number(this.precioMinEntrada) || 0));
                },
                get precioSuperior() {
                    return this.precioMaxEntrada === '' || this.precioMaxEntrada === null ? this.precioTope : Math.min(this.precioTope, Math.max(0, Number(this.precioMaxEntrada) || 0));
                },
                formatearPrecio(value) {
                    return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(value);
                },
                moverPrecio(extremo, value) {
                    const number = Math.round(Number(value) * 100) / 100;
                    const clamped = extremo === 'min'
                        ? Math.max(0, Math.min(number, this.precioSuperior))
                        : Math.min(this.precioTope, Math.max(number, this.precioInferior));
                    if (extremo === 'min') this.precioMinEntrada = String(clamped);
                    else this.precioMaxEntrada = String(clamped);
                    this.errorPrecio = '';
                    return clamped;
                },
                async aplicarBarraPrecio() {
                    if (Number(this.precioMinEntrada) === 0) this.precioMinEntrada = '';
                    if (Number(this.precioMaxEntrada) === this.precioTope) this.precioMaxEntrada = '';
                    await this.aplicarPrecio();
                },
                async elegirPrecioEnBarra(event) {
                    if (event.target.matches('input')) return;
                    const rect = event.currentTarget.getBoundingClientRect();
                    const position = Math.max(0, Math.min(1, (event.clientX - rect.left - 14) / Math.max(1, rect.width - 28)));
                    const value = this.precioDesdePosicion(position);
                    this.moverPrecio(Math.abs(value - this.precioInferior) <= Math.abs(value - this.precioSuperior) ? 'min' : 'max', value);
                    await this.aplicarBarraPrecio();
                },
                errorPrecio: '',
                controladorCatalogo: null,
                get resumenPrecio() {
                    const euro = value => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(Number(value));
                    if (this.precioMinActual !== '' && this.precioMaxActual !== '') return `De ${euro(this.precioMinActual)} a ${euro(this.precioMaxActual)}`;
                    if (this.precioMinActual !== '') return `Desde ${euro(this.precioMinActual)}`;
                    return this.precioMaxActual !== '' ? `Hasta ${euro(this.precioMaxActual)}` : '';
                },
                async aplicarPrecio() {
                    const min = String(this.precioMinEntrada ?? '').trim().replace(',', '.');
                    const max = String(this.precioMaxEntrada ?? '').trim().replace(',', '.');
                    if ([min, max].some(v => v !== '' && (!Number.isFinite(Number(v)) || Number(v) < 0)) || min !== '' && max !== '' && Number(min) > Number(max)) {
                        this.errorPrecio = 'El precio mínimo no puede superar al máximo. Indica importes válidos.';
                        return;
                    }
                    this.errorPrecio = '';
                    this.precioMinActual = min;
                    this.precioMaxActual = max;
                    this.ajustarEscalaPrecio();
                    this.paginaActual = 1;
                    await this.cargarProductos();
                },
                async quitarPrecio() {
                    this.precioMinEntrada = this.precioMaxEntrada = '';
                    await this.aplicarPrecio();
                },
                paginaActual: @Model.PageNumber,
                totalItems: @Model.TotalItems,
                totalPages: @Model.TotalPages,

                // Inicialización
                init() {
                    // Guardar referencia global para los botones del partial
                    window.productosApp = this;
                    this.ajustarEscalaPrecio(true);
                    
                    // Watch para guardar preferencia de vista
                    this.$watch('viewMode', val => localStorage.setItem('viewMode', val));

                    // Manejar navegación con botón atrás del navegador
                    window.addEventListener('popstate', (event) => {
                        if (event.state) {
                            this.categoriaActual = event.state.categoria;
                            this.busquedaActual = event.state.busqueda || '';
                            this.precioMinEntrada = this.precioMinActual = event.state.precioMin ?? '';
                            this.precioMaxEntrada = this.precioMaxActual = event.state.precioMax ?? '';
                            this.ajustarEscalaPrecio(true);
                            this.errorPrecio = '';
                            window.dispatchEvent(new CustomEvent('catalogo-busqueda', { detail: this.busquedaActual }));
                            this.paginaActual = event.state.pagina || 1;
                            this.cargarProductos(false); // No actualizar URL
                        }
                    });

                    // Guardar estado inicial
                    this.guardarEstadoEnHistorial(true);
                },

                // Filtrar por categoría
                async filtrarCategoria(categoriaId) {
                    this.categoriaActual = categoriaId;
                    window.dispatchEvent(new CustomEvent('catalogo-categoria-seleccionada'));
                    this.busquedaActual = '';
                    window.dispatchEvent(new CustomEvent('catalogo-busqueda', { detail: '' }));
                    this.paginaActual = 1;
                    await this.cargarProductos();
                },

                // Cambiar página
                async cambiarPagina(pagina) {
                    this.paginaActual = pagina;
                    await this.cargarProductos();
                    // Scroll suave hacia arriba del contenedor
                    document.getElementById('productosContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                },

                // Limpiar filtros
                async limpiarFiltros() {
                    this.precioMinEntrada = this.precioMaxEntrada = this.precioMinActual = this.precioMaxActual = '';
                    this.ajustarEscalaPrecio();
                    this.errorPrecio = '';
                    this.categoriaActual = null;
                    this.busquedaActual = '';
                    window.dispatchEvent(new CustomEvent('catalogo-busqueda', { detail: '' }));
                    this.paginaActual = 1;
                    await this.cargarProductos();
                },

                // Cargar productos con AJAX
                async cargarProductos(actualizarUrl = true) {
                    if (this.busquedaActual.trim()) this.categoriaActual = null;
                    if (this.controladorCatalogo) this.controladorCatalogo.abort();
                    const controller = new AbortController();
                    this.controladorCatalogo = controller;
                    this.cargando = true;

                    try {
                        // Construir URL
                        let url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Filtrar", "Productos"))) + `?page=${this.paginaActual}`;
                        if (this.categoriaActual) url += `&categoriaId=${this.categoriaActual}`;
                        if (this.busquedaActual) url += `&busqueda=${encodeURIComponent(this.busquedaActual)}`;

                        if (this.precioMinActual !== '') url += `&precioMin=${encodeURIComponent(this.precioMinActual)}`;
                        if (this.precioMaxActual !== '') url += `&precioMax=${encodeURIComponent(this.precioMaxActual)}`;
                        const response = await fetch(url, { signal: controller.signal });
                        const data = await response.json();

                        if (this.controladorCatalogo !== controller) return;
                        if (!response.ok || !data.success) throw new Error(data.message || 'No se han podido cargar los productos. Vuelve a intentarlo.');
                        this.errorPrecio = '';
                        if (data.success) {
                            // Actualizar contenedor con animación
                            const container = this.$refs.productosContainer;
                            container.style.opacity = '0';
                            container.style.transform = 'translateY(10px)';
                            
                            setTimeout(() => {
                                if (this.controladorCatalogo !== controller) return;
                                container.innerHTML = data.html;
                                container.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                                container.style.opacity = '1';
                                container.style.transform = 'translateY(0)';
                            }, 150);

                            // Actualizar estado
                            this.totalItems = data.totalItems;
                            this.totalPages = data.totalPages;
                            this.paginaActual = data.currentPage;

                            // Actualizar URL sin recargar
                            if (actualizarUrl) {
                                this.guardarEstadoEnHistorial();
                            }
                        }
                    } catch (error) {
                        if (error.name !== 'AbortError') this.errorPrecio = error.message;
                    } finally {
                        if (this.controladorCatalogo === controller) this.cargando = false;
                    }
                },

                // Guardar estado en el historial del navegador
                guardarEstadoEnHistorial(reemplazar = false) {
                    let url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/catalogo")));
                    if (this.categoriaActual && !this.busquedaActual.trim()) url = this.categorias.find(c => String(c.id) === String(this.categoriaActual))?.url || url;
                    const params = new URLSearchParams();
                    

                    if (this.precioMinActual !== '') params.set('precioMin', this.precioMinActual);
                    if (this.precioMaxActual !== '') params.set('precioMax', this.precioMaxActual);
                    if (this.busquedaActual) params.set('busqueda', this.busquedaActual);
                    if (this.paginaActual > 1) params.set('page', this.paginaActual);
                    
                    if (params.toString()) url += '?' + params.toString();

                    const state = {
                        categoria: this.categoriaActual,
                        busqueda: this.busquedaActual,
                        pagina: this.paginaActual,
                        precioMin: this.precioMinActual,
                        precioMax: this.precioMaxActual
                    };

                    if (reemplazar) {
                        history.replaceState(state, '', url);
                    } else {
                        history.pushState(state, '', url);
                    }
                    const robots = document.querySelector('meta[name="robots"]');
                    if (robots) robots.content = robots.dataset.publicIndexing === 'true' && !this.busquedaActual.trim() && this.precioMinActual === '' && this.precioMaxActual === '' ? 'index, follow' : 'noindex, nofollow';
                    const canonical = document.querySelector('link[rel="canonical"][data-catalog-base]');
                    if (canonical && canonical.dataset.catalogBase) {
                        const categorySlug = this.categoriaActual && !this.busquedaActual.trim() ? this.categorias.find(c => String(c.id) === String(this.categoriaActual))?.slug : null;
                        const canonicalUrl = new URL(canonical.dataset.catalogBase + (categorySlug ? "/" + categorySlug : ""));

                        if (this.paginaActual > 1) canonicalUrl.searchParams.set('page', this.paginaActual);
                        canonical.href = canonicalUrl.href;
                        const ogUrl = document.querySelector('meta[property="og:url"]');
                        if (ogUrl) ogUrl.content = canonical.href;
                    }
                }
            };
        }
    </script>
}
