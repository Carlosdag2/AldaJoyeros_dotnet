@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 pb-4">
    <p class="text-sm text-stone-600" aria-live="polite">Mostrando <span class="font-semibold text-stone-900" id="rangoProductos">@Model.StartItem–@Model.EndItem</span> de <span class="font-semibold text-stone-900" id="totalProductos">@Model.TotalItems</span> productos</p>
    <div class="flex items-center gap-2" role="group" aria-label="Presentación de los productos"><span class="mr-1 text-xs text-stone-500">Vista</span>
        <button type="button" @@click="viewMode = 'grid'" :aria-pressed="viewMode === 'grid'" aria-label="Vista de cuadrícula" title="Cuadrícula" :class="viewMode === 'grid' ? 'bg-emerald-50 text-emerald-900 border-emerald-200' : 'bg-white text-stone-500 border-stone-200 hover:text-emerald-800'" class="flex h-11 w-11 items-center justify-center rounded-lg border"><i class="fas fa-th-large" aria-hidden="true"></i></button>
        <button type="button" @@click="viewMode = 'list'" :aria-pressed="viewMode === 'list'" aria-label="Vista de lista" title="Lista" :class="viewMode === 'list' ? 'bg-emerald-50 text-emerald-900 border-emerald-200' : 'bg-white text-stone-500 border-stone-200 hover:text-emerald-800'" class="flex h-11 w-11 items-center justify-center rounded-lg border"><i class="fas fa-list" aria-hidden="true"></i></button>
    </div>
</div>
@if (Model.Items != null && Model.Items.Any())
{
    <div x-show="viewMode === 'grid'" class="grid grid-cols-2 gap-x-4 gap-y-7 sm:gap-x-6 sm:gap-y-9 xl:grid-cols-3" data-catalog-grid>
        @foreach (var producto in Model.Items)
        {
            var link = AldaJoyeros.Helpers.PublicUrls.ProductLink(Context.Request, producto);
            <article class="producto-card group flex min-w-0 flex-col" data-producto-id="@producto.Id">
                <a href="@link" class="product-media relative block aspect-square overflow-hidden rounded-xl border border-stone-200 bg-white p-3 sm:p-5" aria-label="Ver @producto.CategoriaNombre, referencia @producto.Nombre">
                    @if (producto.TieneImagenes)
                    {
                        <img src="@producto.ImagenPrincipal" alt="@producto.CategoriaNombre, referencia @producto.Nombre" width="400" height="400" decoding="async" loading="lazy" class="h-full w-full object-contain transition-transform duration-500 motion-safe:group-hover:scale-105" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                        <span hidden class="absolute inset-0 p-4 text-center text-xs text-stone-500">Imagen no disponible</span>
                    }
                    else
                    { <span class="flex h-full items-center justify-center text-stone-300"><i class="fas fa-gem text-4xl" aria-hidden="true"></i></span> }
                </a>
                <div class="flex flex-1 flex-col pt-3 sm:pt-4">
                    <p class="mb-2 break-words text-xs leading-relaxed text-stone-500">@producto.CategoriaNombre</p>
                    <h2 class="break-words text-sm font-semibold text-stone-900"><a href="@link" class="hover:underline">@producto.Nombre</a></h2>
                    <p class="mt-2 font-serif text-xl text-emerald-800">@(producto.PrecioDesde ? "Desde " : "")@producto.Precio.ToString("C")</p>
                    <div class="mt-auto pt-4">
                        @if (ViewBag.EcommerceEnabled == true && !producto.TieneTallas)
                        {
                            <button type="button" data-product-name="@producto.Nombre" onclick="window.carritoApp?.agregarAlCarrito(@producto.Id, this.dataset.productName, event)" class="btn-agregar-carrito inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-emerald-800 px-2 py-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-50"><span class="btn-texto">Añadir al carrito</span><span class="btn-loading hidden"><i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i> Añadiendo…</span></button>
                        }
                        else
                        { <a href="@link" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-stone-300 px-2 py-3 text-xs font-semibold text-stone-700 hover:border-emerald-700 hover:text-emerald-800">@(ViewBag.EcommerceEnabled == true && producto.TieneTallas ? "Elegir talla" : "Ver detalles")<i class="fas fa-arrow-right hidden sm:inline" aria-hidden="true"></i></a> }
                    </div>
                </div>
            </article>
        }
    </div>
    <div x-show="viewMode === 'list'" class="space-y-4" x-cloak data-catalog-list>
        @foreach (var producto in Model.Items)
        {
            var link = AldaJoyeros.Helpers.PublicUrls.ProductLink(Context.Request, producto);
            <article class="producto-card flex min-w-0 gap-3 rounded-xl border border-stone-200 bg-white p-3 sm:gap-6 sm:p-5" data-producto-id="@producto.Id">
                <a href="@link" class="product-media relative block aspect-square h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-white p-2 sm:h-40 sm:w-40" aria-label="Ver @producto.CategoriaNombre, referencia @producto.Nombre">
                    @if (producto.TieneImagenes)
                    { <img src="@producto.ImagenPrincipal" alt="@producto.CategoriaNombre, referencia @producto.Nombre" decoding="async" loading="lazy" width="200" height="200" class="h-full w-full object-contain" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" /><span hidden class="absolute inset-0 p-2 text-xs text-stone-500">Imagen no disponible</span> }
                    else
                    { <span class="flex h-full items-center justify-center text-stone-300"><i class="fas fa-gem text-3xl" aria-hidden="true"></i></span> }
                </a>
                <div class="flex min-w-0 flex-1 flex-col justify-center">
                    <p class="mb-2 break-words text-xs text-stone-500">@producto.CategoriaNombre</p><h2 class="break-words text-sm font-semibold text-stone-900 sm:text-base"><a href="@link" class="hover:underline">@producto.Nombre</a></h2>
                    <div class="hidden sm:block"><p class="mt-2 text-sm leading-relaxed text-stone-600 line-clamp-2">@producto.Descripcion</p></div>
                    <div class="mt-3 flex flex-wrap items-center justify-between gap-3"><p class="font-serif text-xl text-emerald-800">@(producto.PrecioDesde ? "Desde " : "")@producto.Precio.ToString("C")</p>
                        <div class="flex flex-wrap items-center gap-3">
                            @if (ViewBag.EcommerceEnabled == true && !producto.TieneTallas)
                            { <button type="button" data-product-name="@producto.Nombre" onclick="window.carritoApp?.agregarAlCarrito(@producto.Id, this.dataset.productName, event)" class="btn-agregar-carrito min-h-11 rounded-lg bg-emerald-800 px-4 py-3 text-xs font-semibold text-white hover:bg-emerald-900"><span class="btn-texto">Añadir al carrito</span><span class="btn-loading hidden">Añadiendo…</span></button> }
                            <a href="@link" class="py-2 text-xs font-semibold text-emerald-800 underline underline-offset-4">@(ViewBag.EcommerceEnabled == true && producto.TieneTallas ? "Elegir talla" : "Ver detalles")</a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
    @if (Model.TotalPages > 1) { @await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, "window.productosApp.cambiarPagina", "paginacion", true)) }
}
else
{
    <div class="rounded-2xl border border-stone-200 bg-white px-6 py-16 text-center"><i class="far fa-gem mb-5 text-4xl text-stone-300" aria-hidden="true"></i><h2 class="font-serif text-2xl text-stone-900">No hemos encontrado tu pieza</h2><p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-stone-600">Prueba otra búsqueda o amplía el rango de precio. También puedes empezar de nuevo y explorar toda la colección.</p><button type="button" onclick="window.productosApp?.limpiarFiltros()" class="mt-6 rounded-lg bg-emerald-800 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-900">Ver todo el catálogo</button></div>
}
