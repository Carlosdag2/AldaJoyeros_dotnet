@model AldaJoyeros.DTOs.ProductoDto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="pt-8">
    <!-- Breadcrumb -->
    <nav class="container mx-auto px-6 mb-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li><a asp-controller="Home" asp-action="Index" class="hover:text-emerald-600 transition-colors">Inicio</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li><a asp-controller="Productos" asp-action="Index" class="hover:text-emerald-600 transition-colors">Productos</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li><a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.CategoriaId" class="hover:text-emerald-600 transition-colors">@Model.CategoriaNombre</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li class="text-gray-900 font-semibold">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
            <!-- Galería de Imágenes -->
            <div x-data="{ currentImage: '@Model.ImagenPrincipal' }">
                <!-- Imagen Principal -->
                <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-3xl overflow-hidden shadow-2xl mb-6 relative group" style="aspect-ratio: 1 / 1;">
                    @if (Model.TieneImagenes)
                    {
                        <img x-bind:src="currentImage" 
                             alt="@Model.Nombre" 
                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                             onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><i class=\'fas fa-gem text-9xl text-emerald-600 opacity-20\'></i></div>';" />
                        
                        <!-- Zoom Icon -->
                        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm rounded-full p-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <i class="fas fa-search-plus text-emerald-600"></i>
                        </div>
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center">
                            <i class="fas fa-gem text-9xl text-emerald-600 opacity-20"></i>
                        </div>
                    }
                    
                    <!-- Badge de Stock -->
                    <div class="absolute top-4 left-4">
                        <span class="inline-flex items-center px-4 py-2 bg-emerald-500 text-white rounded-full text-sm font-semibold shadow-lg">
                            <i class="fas fa-check-circle mr-2"></i>
                            En Stock
                        </span>
                    </div>
                </div>

                <!-- Miniaturas -->
                @if (Model.Imagenes.Count > 1)
                {
                    <div class="grid grid-cols-4 gap-3">
                        @foreach (var imagen in Model.Imagenes.OrderBy(i => i.Orden))
                        {
                            <button type="button" 
                                    @@click="currentImage = '@imagen.ImagenBase64'"
                                    class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-200 border-2 hover:border-emerald-500"
                                    :class="currentImage === '@imagen.ImagenBase64' ? 'border-emerald-500 ring-2 ring-emerald-200' : 'border-transparent'"
                                    style="aspect-ratio: 1 / 1;">
                                <img src="@imagen.ImagenBase64" 
                                     alt="@Model.Nombre - Imagen @(imagen.Orden + 1)" 
                                     class="w-full h-full object-cover hover:scale-110 transition-transform duration-300"
                                     onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><i class=\'fas fa-gem text-2xl text-emerald-600 opacity-20\'></i></div>';" />
                            </button>
                        }
                    </div>
                }
                else if (Model.TieneImagenes)
                {
                    <div class="text-center text-sm text-gray-500 italic bg-gray-50 rounded-lg py-3">
                        <i class="fas fa-image mr-2"></i>Vista única disponible
                    </div>
                }
            </div>

            <!-- Información del Producto -->
            <div>
                <!-- Categoría Badge -->
                <div class="mb-6">
                    <a asp-action="Index" asp-route-categoriaId="@Model.CategoriaId" 
                       class="inline-flex items-center px-4 py-2 bg-emerald-100 text-emerald-800 rounded-full text-sm font-semibold hover:bg-emerald-200 transition-all duration-200 hover:scale-105">
                        <i class="fas fa-tag mr-2"></i>
                        @Model.CategoriaNombre
                    </a>
                </div>

                <!-- Nombre -->
                <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
                    @Model.Nombre
                </h1>

                <!-- Rating (Opcional - puedes agregar funcionalidad después) -->
                <div class="flex items-center gap-3 mb-6">
                    <div class="flex items-center text-yellow-400">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="text-sm text-gray-600">(4.8 de 5 estrellas)</span>
                </div>

                <!-- Precio -->
                <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 mb-8 border border-emerald-200">
                    <div class="flex items-baseline justify-between">
                        <div>
                            <p class="text-sm text-gray-600 mb-1">Precio</p>
                            <div class="text-5xl font-bold text-emerald-600">
                                @Model.Precio.ToString("C")
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-500">IVA incluido</p>
                            <p class="text-xs text-emerald-600 font-semibold mt-1">
                                <i class="fas fa-truck mr-1"></i>Envío gratis
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="bg-white rounded-2xl p-6 mb-8 shadow-md border border-gray-100">
                    <h2 class="font-serif text-2xl font-bold text-gray-900 mb-4 flex items-center">
                        <i class="fas fa-info-circle text-emerald-600 mr-3"></i>
                        Descripción
                    </h2>
                    <p class="text-gray-700 leading-relaxed">
                        @Model.Descripcion
                    </p>
                </div>

                <!-- Características -->
                <div class="grid grid-cols-2 gap-4 mb-8">
                    <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 border border-emerald-100">
                        <div class="flex items-center mb-2">
                            <div class="w-10 h-10 bg-emerald-500 rounded-full flex items-center justify-center mr-3">
                                <i class="fas fa-shield-alt text-white"></i>
                            </div>
                            <span class="font-semibold text-gray-900">Garantía</span>
                        </div>
                        <p class="text-sm text-gray-600 ml-13">2 años de garantía</p>
                    </div>

                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 border border-blue-100">
                        <div class="flex items-center mb-2">
                            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center mr-3">
                                <i class="fas fa-truck text-white"></i>
                            </div>
                            <span class="font-semibold text-gray-900">Envío</span>
                        </div>
                        <p class="text-sm text-gray-600 ml-13">Gratis en 24-48h</p>
                    </div>

                    <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 border border-yellow-100">
                        <div class="flex items-center mb-2">
                            <div class="w-10 h-10 bg-yellow-500 rounded-full flex items-center justify-center mr-3">
                                <i class="fas fa-certificate text-white"></i>
                            </div>
                            <span class="font-semibold text-gray-900">Autenticidad</span>
                        </div>
                        <p class="text-sm text-gray-600 ml-13">100% certificada</p>
                    </div>

                    <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 border border-purple-100">
                        <div class="flex items-center mb-2">
                            <div class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center mr-3">
                                <i class="fas fa-undo text-white"></i>
                            </div>
                            <span class="font-semibold text-gray-900">Devolución</span>
                        </div>
                        <p class="text-sm text-gray-600 ml-13">30 días gratis</p>
                    </div>
                </div>

                <!-- Acciones -->
                <form asp-controller="Carrito" asp-action="Agregar" method="post" class="space-y-4">
                    <input type="hidden" name="productoId" value="@Model.Id" />
                    
                    <button type="submit" 
                            class="w-full flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-5 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                        <i class="fas fa-cart-plus mr-3 text-xl"></i>
                        Añadir al Carrito
                    </button>

                    <div class="grid grid-cols-2 gap-4">
                        <a asp-controller="Productos" asp-action="Index" 
                           class="flex items-center justify-center border-2 border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-semibold hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all duration-200">
                            <i class="fas fa-arrow-left mr-2"></i>
                            Volver
                        </a>
                        
                        <button type="button" 
                                class="flex items-center justify-center border-2 border-emerald-500 text-emerald-600 px-6 py-3 rounded-xl font-semibold hover:bg-emerald-50 transition-all duration-200">
                            <i class="fas fa-heart mr-2"></i>
                            Favorito
                        </button>
                    </div>
                </form>

                <!-- Trust Badges -->
                <div class="mt-8 pt-8 border-t border-gray-200">
                    <div class="grid grid-cols-3 gap-4 text-center">
                        <div class="group cursor-pointer">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-emerald-100 transition-colors duration-200">
                                <i class="fas fa-lock text-2xl text-gray-400 group-hover:text-emerald-600 transition-colors duration-200"></i>
                            </div>
                            <p class="text-xs text-gray-600 font-semibold">Pago<br/>Seguro</p>
                        </div>
                        <div class="group cursor-pointer">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-yellow-100 transition-colors duration-200">
                                <i class="fas fa-star text-2xl text-yellow-500 group-hover:scale-110 transition-transform duration-200"></i>
                            </div>
                            <p class="text-xs text-gray-600 font-semibold">Calidad<br/>Premium</p>
                        </div>
                        <div class="group cursor-pointer">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-blue-100 transition-colors duration-200">
                                <i class="fas fa-headset text-2xl text-gray-400 group-hover:text-blue-600 transition-colors duration-200"></i>
                            </div>
                            <p class="text-xs text-gray-600 font-semibold">Soporte<br/>24/7</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="mt-20 mb-16">
            <div class="bg-gradient-to-r from-emerald-900 to-emerald-800 rounded-3xl p-12 text-white text-center relative overflow-hidden">
                <!-- Decorative Elements -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-700 rounded-full opacity-20 -mr-32 -mt-32"></div>
                <div class="absolute bottom-0 left-0 w-96 h-96 bg-emerald-700 rounded-full opacity-10 -ml-48 -mb-48"></div>
                
                <div class="relative z-10">
                    <i class="fas fa-gem text-6xl text-emerald-300 mb-6 animate-pulse"></i>
                    <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4">Joyería de Calidad Excepcional</h2>
                    <p class="text-emerald-100 text-lg max-w-3xl mx-auto leading-relaxed">
                        Cada pieza es seleccionada cuidadosamente para garantizar la máxima calidad y elegancia. 
                        Certificamos la autenticidad de todos nuestros productos con garantía de por vida.
                    </p>
                    <div class="mt-8 flex flex-wrap justify-center gap-6">
                        <div class="flex items-center gap-2 text-emerald-100">
                            <i class="fas fa-check-circle text-emerald-400"></i>
                            <span>Materiales Premium</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-100">
                            <i class="fas fa-check-circle text-emerald-400"></i>
                            <span>Artesanía Experta</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-100">
                            <i class="fas fa-check-circle text-emerald-400"></i>
                            <span>Diseño Exclusivo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Productos Relacionados (Sección placeholder) -->
        <div class="mt-20 mb-16">
            <div class="text-center mb-12">
                <h2 class="font-serif text-3xl md:text-4xl font-bold text-gray-900 mb-3">
                    También te puede interesar
                </h2>
                <div class="w-20 h-1 bg-emerald-500 mx-auto"></div>
            </div>
            
            <div class="text-center text-gray-500 py-16 bg-gray-50 rounded-2xl">
                <i class="fas fa-shopping-bag text-5xl mb-4 text-gray-300"></i>
                <p class="text-lg">Descubre más productos en nuestro catálogo</p>
                <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.CategoriaId" 
                   class="inline-block mt-6 px-8 py-3 bg-emerald-500 text-white rounded-xl font-semibold hover:bg-emerald-600 transition-colors duration-200">
                    Ver más de @Model.CategoriaNombre
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Smooth transitions */
        * {
            transition-property: transform, box-shadow, background-color, border-color;
        }
        
        /* Image zoom effect on hover */
        .group:hover img {
            transform: scale(1.05);
        }
        
        /* Pulse animation for stock badge */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.8;
            }
        }
    </style>
}

@section Scripts {
    <script>
        function cambiarImagen(rutaImagen, elemento) {
            // Cambiar imagen principal
            document.getElementById('mainImage').src = rutaImagen;
            
            // Actualizar bordes de miniaturas
            document.querySelectorAll('.thumbnail-btn').forEach(btn => {
                btn.classList.remove('border-yellow-500');
                btn.classList.add('border-transparent');
            });
            
            elemento.classList.remove('border-transparent');
            elemento.classList.add('border-yellow-500');
        }
    </script>
}
