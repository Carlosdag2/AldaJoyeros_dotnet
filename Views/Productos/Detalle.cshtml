@model AldaJoyeros.DTOs.ProductoDto

@{
    ViewData["Title"] = Model.Nombre;
    var imagenes = Model.Imagenes ?? new List<AldaJoyeros.DTOs.ProductoImagenDto>();
    var productUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Productos/Detalle/{Model.Id}";
    var shareText = $"{Model.Nombre} - {Model.Precio.ToString("C")}";
    var encodedUrl = Uri.EscapeDataString(productUrl);
    var encodedText = Uri.EscapeDataString(shareText);
    var nombreProductoJs = Model.Nombre.Replace("'", "\\'").Replace("\"", "\\\"");
}

<div class="min-h-screen bg-white text-dark-800 animate-fade-in-up" x-data="carritoDetalle()">

    <!-- Elemento que vuela al carrito -->
    <div x-show="animando"
         x-ref="flyingItem"
         class="fixed z-[9999] pointer-events-none"
         style="display: none;">
        <div class="w-12 h-12 bg-emerald-900 rounded-full flex items-center justify-center shadow-xl">
            <i class="fas fa-gem text-white text-lg"></i>
        </div>
    </div>

    <!-- Notificación de producto añadido -->
    <div x-show="mostrarNotificacion"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-2"
         class="fixed bottom-6 right-6 z-50 bg-emerald-900 text-white px-6 py-4 rounded-sm shadow-2xl flex items-center gap-4 max-w-sm"
         x-cloak>
        <div class="w-10 h-10 bg-emerald-800 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fas fa-check text-lg"></i>
        </div>
        <div class="flex-1">
            <p class="font-serif text-sm" x-text="mensajeNotificacion"></p>
            <a href="/Carrito" class="text-xs text-emerald-200 hover:text-white transition-colors mt-1 inline-block">
                Ver carrito <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
        <button @@click="mostrarNotificacion = false" class="text-emerald-300 hover:text-white transition-colors">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="container mx-auto px-4 md:px-8 py-6">
        <nav class="flex items-center text-xs md:text-sm font-sans text-gray-400">
            <a asp-controller="Home" asp-action="Index" class="hover:text-emerald-700 transition-colors">Inicio</a>
            <span class="mx-2 text-gray-300">/</span>
            <a asp-controller="Productos" asp-action="Index" class="hover:text-emerald-700 transition-colors">Catálogo</a>
            <span class="mx-2 text-gray-300">/</span>
            <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.CategoriaId" class="hover:text-emerald-700 transition-colors">
                @Model.CategoriaNombre
            </a>
            <span class="mx-2 text-gray-300">/</span>
            <span class="text-dark-900 font-medium truncate">@Model.Nombre</span>
        </nav>
    </div>

    <div class="container mx-auto px-4 md:px-8 pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 xl:gap-20">

            <div class="lg:col-span-7" x-data="{ activeImage: 0 }">
                <div class="lg:sticky lg:top-8 space-y-6">

                    <div class="relative aspect-square md:aspect-[4/3] bg-gray-50 rounded-lg overflow-hidden border border-gray-100 group">
                        @if (imagenes.Any())
                        {
                            @foreach (var (imagen, index) in imagenes.Select((img, i) => (img, i)))
                            {
                                <img src="@imagen.ImagenBase64"
                                     alt="@Model.Nombre"
                                     class="absolute inset-0 w-full h-full object-contain p-8 md:p-12 transition-all duration-700"
                                     x-show="activeImage === @index"
                                     x-transition:enter="transition ease-out duration-500"
                                     x-transition:enter-start="opacity-0 scale-95"
                                     x-transition:enter-end="opacity-100 scale-100" />
                            }

                            @if (imagenes.Count > 1)
                            {
                                <div class="absolute inset-0 flex items-center justify-between px-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                    <button @@click="activeImage = activeImage === 0 ? @(imagenes.Count - 1) : activeImage - 1"
                                            class="w-10 h-10 rounded-full bg-white shadow-lg text-dark-900 hover:text-emerald-600 flex items-center justify-center transition-transform hover:scale-110">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                    <button @@click="activeImage = activeImage === @(imagenes.Count - 1) ? 0 : activeImage + 1"
                                            class="w-10 h-10 rounded-full bg-white shadow-lg text-dark-900 hover:text-emerald-600 flex items-center justify-center transition-transform hover:scale-110">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>

                                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white/80 backdrop-blur px-3 py-1 rounded-full text-xs font-medium text-dark-800 shadow-sm">
                                    <span x-text="activeImage + 1"></span> / @imagenes.Count
                                </div>
                            }
                        }
                        else
                        {
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-300">
                                <i class="fas fa-gem text-5xl mb-3 opacity-50"></i>
                                <span class="font-sans text-sm">Sin imagen</span>
                            </div>
                        }
                    </div>

                    @if (imagenes.Count > 1)
                    {
                        <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
                            @foreach (var (imagen, index) in imagenes.Select((img, i) => (img, i)))
                            {
                                <button @@click="activeImage = @index"
                                        class="relative w-20 h-20 md:w-24 md:h-24 flex-shrink-0 bg-gray-50 rounded-md border transition-all duration-300 overflow-hidden"
                                        :class="activeImage === @index ? 'border-emerald-600 ring-1 ring-emerald-600 ring-offset-2' : 'border-gray-200 hover:border-gray-300'">
                                    <img src="@imagen.ImagenBase64" class="w-full h-full object-contain p-2" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="lg:col-span-5 flex flex-col h-full pt-2">

                <div class="mb-8 border-b border-gray-100 pb-8">
                    <span class="inline-block text-emerald-700 font-bold text-xs tracking-widest uppercase mb-3 bg-emerald-50 px-2 py-1 rounded">
                        @Model.CategoriaNombre
                    </span>

                    <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl text-dark-900 leading-tight mb-4">
                        @Model.Nombre
                    </h1>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <span class="font-serif text-3xl text-dark-900">
                                @Model.Precio.ToString("C")
                            </span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-700 text-sm font-medium bg-emerald-50 px-3 py-1.5 rounded-full">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                            </span>
                            En Stock
                        </div>
                    </div>
                </div>

                <div class="prose prose-sm text-gray-600 font-sans leading-relaxed mb-8">
                    <p>
                        @(string.IsNullOrEmpty(Model.Descripcion)
                                                ? "Una pieza atemporal que combina elegancia y sofisticación. Diseñada con los materiales de la más alta calidad, esta joya es el complemento perfecto para momentos inolvidables." 
                                                        : Model.Descripcion)
                    </p>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wide text-gray-500 mb-2">Cantidad</label>
                        <div class="inline-flex items-center border border-gray-300 rounded hover:border-emerald-600 transition-colors bg-white">
                            <button type="button" @@click="cantidad = Math.max(1, cantidad - 1)"
                                    class="w-12 h-12 flex items-center justify-center text-gray-500 hover:text-emerald-700 hover:bg-gray-50 transition-colors">
                                <i class="fas fa-minus text-xs"></i>
                            </button>
                            <input type="number" x-model="cantidad" readonly
                                   class="w-12 h-12 text-center border-none p-0 text-dark-900 font-medium focus:ring-0 cursor-default" />
                            <button type="button" @@click="cantidad = Math.min(99, cantidad + 1)"
                                    class="w-12 h-12 flex items-center justify-center text-gray-500 hover:text-emerald-700 hover:bg-gray-50 transition-colors">
                                <i class="fas fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <button type="button"
                                @@click="agregarAlCarrito(@Model.Id, '@nombreProductoJs', $event)"
                                :disabled="cargando"
                                class="w-full bg-dark-900 text-white font-sans font-medium text-sm uppercase tracking-widest py-4 px-8 rounded hover:bg-emerald-800 transition-all duration-300 shadow-md hover:shadow-lg flex items-center justify-center gap-3 group disabled:opacity-50 disabled:cursor-not-allowed">
                            <span x-show="!cargando">Añadir al Carrito</span>
                            <span x-show="cargando" class="flex items-center gap-2">
                                <i class="fas fa-circle-notch fa-spin"></i> Añadiendo...
                            </span>
                            <i x-show="!cargando" class="fas fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </button>
                    </div>
                </div>

                <div class="mt-8 space-y-4 py-6 border-t border-gray-100">
                    <div class="flex items-start gap-4">
                        <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 flex-shrink-0 mt-1">
                            <i class="fas fa-truck text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-serif font-bold text-dark-900 text-sm">Envío Asegurado</h4>
                            <p class="text-xs text-gray-500 mt-1">Entrega gratuita y segura en 24-48h laborales.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 flex-shrink-0 mt-1">
                            <i class="fas fa-certificate text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-serif font-bold text-dark-900 text-sm">Autenticidad Garantizada</h4>
                            <p class="text-xs text-gray-500 mt-1">Incluye certificado oficial de calidad Alda Joyeros.</p>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-6 border-t border-gray-100" x-data="shareProduct()">
                    <div class="flex items-center gap-4">
                        <span class="text-xs font-bold uppercase tracking-wide text-gray-400">Compartir</span>
                        <div class="flex gap-2">
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank"
                               class="w-8 h-8 rounded-full border border-gray-200 text-gray-400 flex items-center justify-center hover:bg-[#1877F2] hover:border-transparent hover:text-white transition-all">
                                <i class="fab fa-facebook-f text-xs"></i>
                            </a>
                            <a href="https://x.com/intent/tweet?text=@encodedText&url=@encodedUrl" target="_blank"
                               class="w-8 h-8 rounded-full border border-gray-200 text-gray-400 flex items-center justify-center hover:bg-black hover:border-transparent hover:text-white transition-all">
                                <i class="fab fa-x text-xs"></i>
                            </a>
                            <a href="https://api.whatsapp.com/send?text=@encodedText%20@encodedUrl" target="_blank"
                               class="w-8 h-8 rounded-full border border-gray-200 text-gray-400 flex items-center justify-center hover:bg-[#25D366] hover:border-transparent hover:text-white transition-all">
                                <i class="fab fa-whatsapp text-sm"></i>
                            </a>
                            <button @@click="copyLink()" class="relative w-8 h-8 rounded-full border border-gray-200 text-gray-400 flex items-center justify-center hover:bg-emerald-600 hover:border-transparent hover:text-white transition-all" title="Copiar enlace">
                                <i class="fas" :class="copied ? 'fa-check' : 'fa-link'"></i>
                                <span x-show="copied" x-transition class="absolute bottom-full mb-2 bg-dark-900 text-white text-[10px] py-1 px-2 rounded whitespace-nowrap">Copiado</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="border-t border-gray-100 bg-gray-50/50 py-8">
        <div class="container mx-auto px-4">
            <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.CategoriaId"
               class="inline-flex items-center gap-2 text-gray-500 hover:text-emerald-700 font-medium transition-colors group">
                <i class="fas fa-arrow-left text-xs group-hover:-translate-x-1 transition-transform"></i>
                <span class="font-serif">Volver a @Model.CategoriaNombre</span>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type=number] {
            -moz-appearance: textfield;
        }

        [x-cloak] {
            display: none !important;
        }
    </style>
}

@section Scripts {
    <script>
        function carritoDetalle() {
            const base = carritoNotificacion();
            return {
                ...base,
                cantidad: 1,
                cargando: false,

                async agregarAlCarrito(productoId, nombreProducto, event) {
                    this.cargando = true;
                    
                    try {
                        const response = await fetch('/Carrito/AgregarAjax', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `productoId=${productoId}&cantidad=${this.cantidad}`
                        });

                        const data = await response.json();

                        if (data.success) {
                            await this.animarVueloAlCarrito(event);
                            this.actualizarContadorCarrito(data.totalItems);
                            this.activarNotificacion(`'${nombreProducto}' añadido al carrito`);
                        } else if (data.requiresLogin) {
                            window.location.href = '/Auth/Login';
                        } else {
                            this.activarNotificacion(data.message || 'Error al añadir al carrito');
                        }
                    } catch (error) {
                        console.error('Error al añadir al carrito:', error);
                        this.activarNotificacion('Error al añadir al carrito');
                    } finally {
                        this.cargando = false;
                    }
                }
            }
        }

        function shareProduct() {
            return {
                copied: false,
                productUrl: '@Html.Raw(productUrl)',

                async copyLink() {
                    try {
                        await navigator.clipboard.writeText(this.productUrl);
                        this.copied = true;
                        setTimeout(() => { this.copied = false; }, 2000);
                    } catch (err) {
                        const input = document.createElement('input');
                        input.value = this.productUrl;
                        document.body.appendChild(input);
                        input.select();
                        document.execCommand('copy');
                        document.body.removeChild(input);
                        this.copied = true;
                        setTimeout(() => { this.copied = false; }, 2000);
                    }
                }
            }
        }
    </script>
}