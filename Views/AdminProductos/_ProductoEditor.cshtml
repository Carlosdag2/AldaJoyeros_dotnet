@model AldaJoyeros.DTOs.ProductoUpdateDto
@{ var id = (long)ViewBag.ProductoId; var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto> ?? Array.Empty<AldaJoyeros.DTOs.CategoriaDto>(); }
<form asp-action="Guardar" method="post" data-admin-editor>
    <input type="hidden" name="id" value="@id" />
    <p class="mb-5 text-sm leading-relaxed text-slate-500">@(id == 0 ? "Añade los datos básicos. Después podrás subir las fotos desde Imágenes." : "Actualiza los datos de esta pieza. Al guardar conservarás los filtros y la página de la lista.")</p>
    <div data-editor-status role="alert" tabindex="-1" class="mb-4 text-sm text-red-700"></div>
    <fieldset data-editor-fields class="space-y-4">
        <div><label for="editProductName" class="mb-2 block text-sm font-semibold">Nombre o referencia</label><input id="editProductName" name="Nombre" value="@Model.Nombre" maxlength="200" required class="admin-input" /></div>
        <div class="grid gap-4 sm:grid-cols-2"><div><label for="editProductPrice" class="mb-2 block text-sm font-semibold">Precio de venta (€)</label><input id="editProductPrice" name="Precio" data-decimal-separator="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" value="@(Model.Precio > 0 ? Model.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" type="number" min="0.01" step="0.01" required inputmode="decimal" class="admin-input" /></div>
        <div><label for="editProductCategory" class="mb-2 block text-sm font-semibold">Categoría</label><select id="editProductCategory" name="CategoriaId" required class="admin-input"><option value="">Selecciona una categoría</option>@foreach(var c in categorias) { <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nombre</option> }</select></div></div>
        <div><label for="editProductDescription" class="mb-2 block text-sm font-semibold">Descripción <span class="font-normal text-slate-500">(opcional)</span></label><textarea id="editProductDescription" name="Descripcion" maxlength="1000" rows="4" class="admin-input">@Model.Descripcion</textarea></div>
    </fieldset>
    <div class="mt-6 flex flex-wrap justify-end gap-3"><button type="button" data-dialog-close class="admin-row-action border-slate-300 text-slate-600">Cancelar</button><button type="submit" class="min-h-11 rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50">@(id == 0 ? "Crear producto" : "Guardar cambios")</button></div>
</form>
