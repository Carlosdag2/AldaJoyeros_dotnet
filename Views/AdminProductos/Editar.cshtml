@model AldaJoyeros.DTOs.ProductoUpdateDto
@{ViewData["Title"]="Editar Producto";var categorias=ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;var productoId=ViewContext.RouteData.Values["id"];var imagenes=ViewBag.Imagenes as int?;}

<div class="container mx-auto px-6 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-edit text-white text-2xl"></i>
            </div>
            Editar Producto
        </h1>
        <p class="text-gray-600 text-lg">Modifica la información del producto #@productoId</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Form Section -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
                <form asp-action="Editar" method="post" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl mb-6">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                            <span class="text-red-800 text-sm"></span>
                        </div>
                    </div>

                    <!-- Nombre -->
                    <div>
                        <label asp-for="Nombre" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                            <div class="w-6 h-6 bg-emerald-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-gem text-emerald-600 text-xs"></i>
                            </div>
                            Nombre del Producto
                        </label>
                        <input asp-for="Nombre" 
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg"
                               placeholder="Ej: Anillo de Diamantes Solitario"/>
                        <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Descripción -->
                    <div>
                        <label asp-for="Descripcion" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                            <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-align-left text-blue-600 text-xs"></i>
                            </div>
                            Descripción
                        </label>
                        <textarea asp-for="Descripcion" 
                                  rows="4" 
                                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none"
                                  placeholder="Describe materiales, características y detalles..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Precio -->
                        <div>
                            <label asp-for="Precio" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                                <div class="w-6 h-6 bg-green-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-euro-sign text-green-600 text-xs"></i>
                                </div>
                                Precio (€)
                            </label>
                            <input asp-for="Precio" 
                                   type="number" 
                                   step="0.01"
                                   class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg font-bold"
                                   placeholder="99.99"/>
                            <span asp-validation-for="Precio" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Categoría -->
                        <div>
                            <label asp-for="CategoriaId" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                                <div class="w-6 h-6 bg-purple-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-tags text-purple-600 text-xs"></i>
                                </div>
                                Categoría
                            </label>
                            <select asp-for="CategoriaId" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg">
                                <option value="">Selecciona una categoría</option>
                                @if(categorias!=null){@foreach(var c in categorias){<option value="@c.Id">@c.Nombre</option>}}
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-red-500 text-sm mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Info Card -->
                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-200">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-info-circle text-white text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 mb-3">Información de Edición</h3>
                                <ul class="text-sm text-gray-700 space-y-2">
                                    <li class="flex items-start gap-2">
                                        <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                        <span>Los cambios se reflejarán inmediatamente</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                        <span>Pedidos existentes mantienen el precio original</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                        <span>Verifica que la información sea precisa</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200"/>

                    <div class="flex flex-col sm:flex-row justify-between gap-4">
                        <a asp-action="Index" class="inline-flex items-center justify-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all font-semibold">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </a>
                        <button type="submit" class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105">
                            <i class="fas fa-save mr-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Stats -->
            <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center">
                        <i class="fas fa-chart-bar text-white"></i>
                    </div>
                    Información
                </h3>
                <div class="space-y-3">
                    <div class="flex justify-between bg-white rounded-lg p-3">
                        <span class="text-sm text-gray-600 font-medium">ID:</span>
                        <span class="font-bold text-emerald-600">#@productoId</span>
                    </div>
                    <div class="flex justify-between bg-white rounded-lg p-3">
                        <span class="text-sm text-gray-600 font-medium">Estado:</span>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                            <i class="fas fa-check-circle mr-1"></i>Activo
                        </span>
                    </div>
                    <div class="flex justify-between bg-white rounded-lg p-3">
                        <span class="text-sm text-gray-600 font-medium">Imágenes:</span>
                        <span class="font-bold text-gray-900">@(imagenes??0)</span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-bolt text-purple-600"></i>
                    </div>
                    Acciones Rápidas
                </h3>
                <div class="space-y-2">
                    <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@productoId" target="_blank" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-700 rounded-lg hover:shadow-md transition-all font-bold border border-blue-200">
                        <i class="fas fa-external-link-alt"></i>Ver en Tienda
                    </a>
                    <a asp-controller="AdminImagenes" asp-action="Gestionar" asp-route-id="@productoId" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-purple-50 to-pink-50 text-purple-700 rounded-lg hover:shadow-md transition-all font-bold border border-purple-200">
                        <i class="fas fa-images"></i>Gestionar Imágenes
                    </a>
                </div>
            </div>

            <!-- Warning -->
            <div class="bg-gradient-to-br from-red-50 to-orange-50 rounded-2xl p-6 border border-red-200">
                <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center">
                        <i class="fas fa-exclamation-triangle text-white"></i>
                    </div>
                    Zona de Peligro
                </h3>
                <p class="text-sm text-gray-700 mb-4 leading-relaxed">
                    Eliminar este producto es permanente y no se puede deshacer.
                </p>
                <form asp-action="Eliminar" asp-route-id="@productoId" method="post" onsubmit="return confirm('¿Estás SEGURO de eliminar este producto? Esta acción NO se puede deshacer.')">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-red-600 to-red-700 text-white rounded-lg hover:from-red-700 hover:to-red-800 transition-all font-bold shadow-md hover:shadow-lg">
                        <i class="fas fa-trash"></i>Eliminar Producto
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{<partial name="_ValidationScriptsPartial"/>}
