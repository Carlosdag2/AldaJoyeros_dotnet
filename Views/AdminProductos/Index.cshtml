@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>
@{ViewData["Title"]="Gestión de Productos";var busqueda=ViewBag.Busqueda as string??"";}

<div class="container mx-auto px-6 py-8">
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
<div><h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3"><div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg"><i class="fas fa-gem text-white text-2xl"></i></div>Gestión de Productos</h1><p class="text-gray-600 text-lg">Administra el catálogo de productos</p></div>
<a asp-action="Crear" class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105"><i class="fas fa-plus-circle mr-2"></i>Nuevo Producto</a>
</div>

<div class="bg-white rounded-3xl shadow-xl p-8 mb-8 border border-gray-100">
<form asp-action="Index" method="get" class="mb-6">
<div class="relative max-w-2xl"><input type="text" name="busqueda" value="@busqueda" placeholder="Buscar por ID, nombre, descripción o categoría..." class="w-full px-6 py-4 pr-32 text-lg border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none shadow-sm"/>
<button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white px-6 py-2.5 rounded-lg font-bold transition-all"><i class="fas fa-search mr-2"></i>Buscar</button></div>
@if(!string.IsNullOrWhiteSpace(busqueda)){<div class="mt-3 flex items-center gap-3 flex-wrap"><span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-emerald-100 text-emerald-700"><i class="fas fa-search mr-2"></i>Buscando: "@busqueda"</span>
<a asp-action="Index" class="text-sm text-red-600 hover:text-red-700 font-bold flex items-center"><i class="fas fa-times-circle mr-1"></i>Limpiar</a>
<span class="text-sm text-gray-600">(@Model.TotalItems encontrado@(Model.TotalItems!=1?"s":""))</span></div>}
</form>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 border-t border-gray-200">
<div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-4 text-center border border-emerald-200"><div class="text-3xl font-bold text-emerald-600">@Model.TotalItems</div><div class="text-sm text-gray-600 font-medium">@(string.IsNullOrWhiteSpace(busqueda)?"Total Productos":"Encontrados")</div></div>
<div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4 text-center border border-blue-200"><div class="text-3xl font-bold text-blue-600">@ViewBag.TotalProductos</div><div class="text-sm text-gray-600 font-medium">En Stock</div></div>
<div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4 text-center border border-purple-200"><div class="text-3xl font-bold text-purple-600">@Model.PageNumber/@Model.TotalPages</div><div class="text-sm text-gray-600 font-medium">Página</div></div>
<div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-xl p-4 text-center border border-orange-200"><div class="text-3xl font-bold text-orange-600">@Model.PageSize</div><div class="text-sm text-gray-600 font-medium">Por Página</div></div>
</div>
</div>

@if(Model.Items!=null&&Model.Items.Any()){
<div class="bg-white rounded-3xl shadow-xl overflow-hidden mb-8 border border-gray-100">
<div class="overflow-x-auto">
<table class="w-full">
<thead class="bg-gradient-to-r from-emerald-600 to-green-600 text-white">
<tr><th class="px-6 py-4 text-left font-bold"><i class="fas fa-hashtag mr-2"></i>ID</th><th class="px-6 py-4 text-left font-bold"><i class="fas fa-gem mr-2"></i>Producto</th><th class="px-6 py-4 text-left font-bold"><i class="fas fa-tag mr-2"></i>Categoría</th><th class="px-6 py-4 text-left font-bold"><i class="fas fa-euro-sign mr-2"></i>Precio</th><th class="px-6 py-4 text-center font-bold"><i class="fas fa-cog mr-2"></i>Acciones</th></tr>
</thead>
<tbody class="divide-y divide-gray-200">
@foreach(var p in Model.Items){
<tr class="hover:bg-emerald-50 transition-colors">
<td class="px-6 py-4"><span class="font-mono font-bold text-gray-900">#@p.Id</span></td>
<td class="px-6 py-4"><div class="flex items-center gap-3">
<div class="w-16 h-16 bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl overflow-hidden flex items-center justify-center shadow-md relative">
@if(p.TieneImagenes){<img src="@p.ImagenPrincipal" alt="@p.Nombre" class="w-full h-full object-cover" onerror="this.onerror=null;this.parentElement.innerHTML='<i class=\'fas fa-gem text-2xl text-emerald-600 opacity-30\'></i>';"/>
@if(p.Imagenes.Count>1){<span class="absolute bottom-0 right-0 bg-emerald-600 text-white text-xs px-1.5 py-0.5 rounded-tl font-bold"><i class="fas fa-images"></i> @p.Imagenes.Count</span>}
}else{<i class="fas fa-gem text-2xl text-emerald-600 opacity-30"></i>}
</div>
<div class="min-w-0"><div class="font-bold text-gray-900 truncate">@p.Nombre</div><div class="text-sm text-gray-500 truncate">@p.Descripcion</div></div>
</div></td>
<td class="px-6 py-4"><span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-700"><i class="fas fa-tag mr-1"></i>@p.CategoriaNombre</span></td>
<td class="px-6 py-4"><span class="text-xl font-bold text-emerald-600">@p.Precio.ToString("C")</span></td>
<td class="px-6 py-4"><div class="flex items-center justify-center gap-2">
<a asp-controller="Productos" asp-action="Detalle" asp-route-id="@p.Id" target="_blank" class="w-9 h-9 bg-blue-100 hover:bg-blue-600 text-blue-600 hover:text-white rounded-lg transition-all flex items-center justify-center" title="Ver"><i class="fas fa-eye"></i></a>
<a asp-controller="AdminImagenes" asp-action="Gestionar" asp-route-id="@p.Id" class="w-9 h-9 bg-purple-100 hover:bg-purple-600 text-purple-600 hover:text-white rounded-lg transition-all flex items-center justify-center" title="Imágenes"><i class="fas fa-images"></i></a>
<a asp-action="Editar" asp-route-id="@p.Id" class="w-9 h-9 bg-emerald-100 hover:bg-emerald-600 text-emerald-600 hover:text-white rounded-lg transition-all flex items-center justify-center" title="Editar"><i class="fas fa-edit"></i></a>
<form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="inline" onsubmit="return confirm('¿Eliminar @p.Nombre?')"><button type="submit" class="w-9 h-9 bg-red-100 hover:bg-red-600 text-red-600 hover:text-white rounded-lg transition-all flex items-center justify-center" title="Eliminar"><i class="fas fa-trash"></i></button></form>
</div></td>
</tr>
}}
</tbody>
</table>
</div>
</div>

@if(Model.TotalPages>1){<div class="flex justify-center items-center space-x-2 flex-wrap gap-2">
@if(Model.HasPreviousPage){<a asp-action="Index" asp-route-page="@(Model.PageNumber-1)" asp-route-busqueda="@busqueda" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold"><i class="fas fa-chevron-left"></i></a>}else{<span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-xl cursor-not-allowed"><i class="fas fa-chevron-left"></i></span>}
@{var startPage=Math.Max(1,Model.PageNumber-2);var endPage=Math.Min(Model.TotalPages,Model.PageNumber+2);}
@if(startPage>1){<a asp-action="Index" asp-route-page="1" asp-route-busqueda="@busqueda" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">1</a>
@if(startPage>2){<span class="px-2 text-gray-500">...</span>}}
@for(var i=startPage;i<=endPage;i++){
@if(i==Model.PageNumber){<span class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl font-bold shadow-md">@i</span>}else{<a asp-action="Index" asp-route-page="@i" asp-route-busqueda="@busqueda" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">@i</a>}}
@if(endPage<Model.TotalPages){@if(endPage<Model.TotalPages-1){<span class="px-2 text-gray-500">...</span>}
<a asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-busqueda="@busqueda" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold">@Model.TotalPages</a>}
@if(Model.HasNextPage){<a asp-action="Index" asp-route-page="@(Model.PageNumber+1)" asp-route-busqueda="@busqueda" class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition-all font-semibold"><i class="fas fa-chevron-right"></i></a>}else{<span class="px-4 py-2 bg-gray-100 border-2 border-gray-200 text-gray-400 rounded-xl cursor-not-allowed"><i class="fas fa-chevron-right"></i></span>}
</div>}}else{
<div class="bg-white rounded-3xl p-12 text-center shadow-xl border border-gray-100"><div class="w-24 h-24 bg-gradient-to-br from-emerald-100 to-green-100 rounded-full flex items-center justify-center mx-auto mb-6"><i class="fas @(string.IsNullOrWhiteSpace(busqueda)?"fa-gem":"fa-search") text-emerald-600 text-5xl"></i></div>
<h3 class="font-serif text-3xl font-bold text-gray-900 mb-3">@(string.IsNullOrWhiteSpace(busqueda)?"No hay productos":"No se encontraron productos")</h3>
<p class="text-gray-600 mb-8 text-lg">@(string.IsNullOrWhiteSpace(busqueda)?"Comienza agregando tu primer producto":"Intenta con otros términos de búsqueda")</p>
@if(string.IsNullOrWhiteSpace(busqueda)){<a asp-action="Crear" class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105"><i class="fas fa-plus-circle mr-2"></i>Crear Primer Producto</a>}else{<a asp-action="Index" class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105"><i class="fas fa-times-circle mr-2"></i>Limpiar Búsqueda</a>}
</div>}

<div class="mt-8 flex gap-4">
<a asp-controller="Admin" asp-action="Index" class="inline-flex items-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all font-semibold group"><i class="fas fa-arrow-left mr-2 group-hover:-translate-x-2 transition-transform"></i>Volver al Panel</a>
<a asp-controller="AdminCategorias" asp-action="Index" class="inline-flex items-center px-8 py-3 border-2 border-purple-500 text-purple-600 rounded-xl hover:bg-purple-50 transition-all font-semibold"><i class="fas fa-tags mr-2"></i>Gestionar Categorías</a>
</div>
</div>
