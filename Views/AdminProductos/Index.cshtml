@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Productos";
    var filtro = ViewBag.Filtro as string ?? "activos";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto> ?? Array.Empty<AldaJoyeros.DTOs.CategoriaDto>();
}
<div class="min-h-screen bg-slate-50 pb-12" data-product-workspace>
    <header class="bg-slate-900 text-white"><div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <a asp-controller="Admin" asp-action="Index" class="mb-5 inline-flex min-h-11 items-center gap-2 text-sm text-slate-300 hover:text-white"><i class="fas fa-arrow-left" aria-hidden="true"></i>Panel de administración</a>
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-300">Tu catálogo</p><h1 class="text-3xl font-bold">Productos</h1><p class="mt-2 text-sm text-slate-300">Encuentra una pieza y gestiona sus datos sin perder el lugar.</p></div><a asp-action="Crear" data-product-editor="0" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800"><i class="fas fa-plus" aria-hidden="true"></i>Nuevo producto</a></div>
    </div></header>
    <div class="mx-auto max-w-7xl space-y-6 px-4 pt-6 sm:px-6 lg:px-8">
        <section aria-label="Buscar y filtrar productos" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
            <form asp-action="Index" method="get" data-product-search>
                <div class="mb-5 flex flex-wrap gap-2" aria-label="Estado de los productos">
                @foreach (var tab in new[] { (Key:"activos", Label:"Activos"), (Key:"eliminados", Label:"Papelera"), (Key:"todos", Label:"Todos") })
                { <button type="submit" name="filtro" value="@tab.Key" data-product-filter="@tab.Key" aria-pressed="@(filtro == tab.Key ? "true" : "false")" class="admin-filter min-h-11 rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600">@tab.Label @if(tab.Key != "todos") { <span class="ml-1" data-count="@tab.Key">@(tab.Key == "activos" ? ViewBag.TotalProductos : ViewBag.TotalEliminados)</span> }</button> }
                </div>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
                    <div class="min-w-0 lg:col-span-5"><label for="productSearch" class="mb-2 block text-sm font-semibold text-slate-700">Buscar producto</label><input id="productSearch" name="busqueda" value="@ViewBag.Busqueda" type="search" placeholder="Nombre, referencia o descripción" autocomplete="off" class="admin-input" /></div>
                    <div class="min-w-0 lg:col-span-3"><label for="productCategory" class="mb-2 block text-sm font-semibold text-slate-700">Categoría</label><select id="productCategory" name="categoriaId" class="admin-input"><option value="">Todas las categorías</option>@foreach(var c in categorias) { <option value="@c.Id" selected="@(ViewBag.CategoriaId != null && (long)ViewBag.CategoriaId == c.Id)">@c.Nombre</option> }</select></div>
                    <div class="lg:col-span-2"><label for="productSort" class="mb-2 block text-sm font-semibold text-slate-700">Ordenar por</label><select id="productSort" name="orden" class="admin-input">@foreach(var o in new[] { ("recientes","Más recientes"), ("nombre","Nombre"), ("precio-asc","Menor precio"), ("precio-desc","Mayor precio") }) { <option value="@o.Item1" selected="@((string)ViewBag.Orden == o.Item1)">@o.Item2</option> }</select></div>
                    <div class="lg:col-span-2"><label for="productSize" class="mb-2 block text-sm font-semibold text-slate-700">Por página</label><select id="productSize" name="tamano" class="admin-input">@foreach(var n in new[]{10,20,50}) { <option value="@n" selected="@((int)ViewBag.Tamano == n)">@n productos</option> }</select></div>
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-3"><button type="submit" class="min-h-11 rounded-lg bg-emerald-800 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-900"><i class="fas fa-search mr-2" aria-hidden="true"></i>Buscar</button><a asp-action="Index" data-product-clear class="inline-flex min-h-11 items-center px-2 text-sm font-semibold text-slate-600 underline underline-offset-4">Limpiar filtros</a><p data-product-status role="status" class="text-sm text-slate-500">@Model.TotalItems productos encontrados</p></div>
            </form>
        </section>
        <div data-product-results aria-busy="false"><partial name="_ProductosList" model="Model" /></div>
        <p class="text-xs leading-relaxed text-slate-500">La papelera permite retirar un producto y recuperarlo más adelante. La eliminación definitiva solo está disponible desde la papelera.</p>
    </div>
</div>
<partial name="_AdminWorkDialog" />
@section Styles { <link href="~/css/admin-workspace.css" rel="stylesheet" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-workspace.js" asp-append-version="true"></script><script src="~/js/admin-products.js" asp-append-version="true"></script> }
