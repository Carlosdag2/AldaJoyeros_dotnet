@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Gestión de Productos";
    var busqueda = ViewBag.Busqueda as string ?? "";
    var filtro = ViewBag.Filtro as string ?? "activos";
    var totalEliminados = (int)(ViewBag.TotalEliminados ?? 0);
    var totalProductos = (int)(ViewBag.TotalProductos ?? 0);
}

<partial name="_AdminConfirmModal" />

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Productos</span>
            </nav>
            
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-2xl flex items-center justify-center shadow-xl shadow-emerald-500/25">
                        <i class="fas fa-gem text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-white">Gestión de Productos</h1>
                        <p class="text-slate-400 text-sm mt-1">Administra el catálogo de productos</p>
                    </div>
                </div>
                <a asp-action="Crear" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-emerald-500/25">
                    <i class="fas fa-plus"></i>Nuevo Producto
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 -mt-6 relative z-10 pb-12">
        <!-- Filters & Search -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
            <!-- Filter Tabs AJAX -->
            <div class="flex flex-wrap gap-2 mb-5" id="filtrosProductos">
                <button type="button" onclick="adminProductos.filtrar('activos')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(filtro == "activos" ? "bg-emerald-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-filtro="activos">
                    <i class="fas fa-check-circle"></i>Activos (<span id="countActivos">@totalProductos</span>)
                </button>
                <button type="button" onclick="adminProductos.filtrar('eliminados')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(filtro == "eliminados" ? "bg-red-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-filtro="eliminados">
                    <i class="fas fa-trash"></i>Papelera (<span id="countEliminados">@totalEliminados</span>)
                </button>
                <button type="button" onclick="adminProductos.filtrar('todos')" 
                        class="filtro-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm transition-all @(filtro == "todos" ? "bg-blue-500 text-white shadow-md" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-filtro="todos">
                    <i class="fas fa-list"></i>Todos
                </button>
            </div>

            <!-- Search AJAX -->
            <div class="relative max-w-2xl">
                <input type="text" id="busquedaProductos" value="@busqueda" placeholder="Buscar por ID, nombre, descripción o categoría..." 
                       onkeypress="if(event.key==='Enter') adminProductos.buscar()"
                       class="w-full px-4 py-3 pr-28 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none"/>
                <button type="button" onclick="adminProductos.buscar()" class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg font-medium text-sm transition-all">
                    <i class="fas fa-search mr-1"></i>Buscar
                </button>
            </div>
            <div id="busquedaInfo" class="mt-3 flex items-center gap-3 flex-wrap @(string.IsNullOrWhiteSpace(busqueda) ? "hidden" : "")">
                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-emerald-100 text-emerald-700">
                    <i class="fas fa-search mr-2 text-xs"></i>"<span id="busquedaTexto">@busqueda</span>"
                </span>
                <button type="button" onclick="adminProductos.limpiarBusqueda()" class="text-sm text-red-500 hover:text-red-600 font-medium flex items-center gap-1">
                    <i class="fas fa-times-circle"></i>Limpiar
                </button>
                <span class="text-sm text-slate-500">(<span id="resultadosCount">@Model.TotalItems</span> resultado<span id="resultadosPlural">@(Model.TotalItems!=1?"s":"")</span>)</span>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-5 mt-5 border-t border-slate-100" id="statsProductos">
                <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-3 text-center border border-emerald-100">
                    <div id="statActivos" class="text-2xl font-bold text-emerald-600">@totalProductos</div>
                    <div class="text-xs text-slate-500">Activos</div>
                </div>
                <div class="bg-gradient-to-br from-red-50 to-rose-50 rounded-xl p-3 text-center border border-red-100">
                    <div id="statEliminados" class="text-2xl font-bold text-red-500">@totalEliminados</div>
                    <div class="text-xs text-slate-500">Papelera</div>
                </div>
                <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-xl p-3 text-center border border-violet-100">
                    <div id="statPagina" class="text-2xl font-bold text-violet-600">@Model.PageNumber/@Model.TotalPages</div>
                    <div class="text-xs text-slate-500">Página</div>
                </div>
                <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl p-3 text-center border border-amber-100">
                    <div id="statMostrando" class="text-2xl font-bold text-amber-600">@Model.TotalItems</div>
                    <div class="text-xs text-slate-500">Mostrando</div>
                </div>
            </div>
        </div>

        <!-- Contenedor dinámico para la lista de productos -->
        <div id="productosContainer">
            <partial name="_ProductosList" model="Model" />
        </div>

        <!-- Navigation -->
        <div class="mt-8 flex flex-wrap gap-3">
            <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-slate-300 rounded-xl transition-all font-medium">
                <i class="fas fa-arrow-left"></i>Volver al Panel
            </a>
            <a asp-controller="AdminCategorias" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 text-slate-600 hover:border-violet-300 hover:text-violet-600 rounded-xl transition-all font-medium">
                <i class="fas fa-tags"></i>Categorías
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminProductos = {
            filtroActual: '@filtro',
            busquedaActual: '@busqueda',
            paginaActual: @Model.PageNumber,
            cargando: false,

            // Filtrar por estado
            async filtrar(filtro) {
                if (this.cargando) return;
                this.filtroActual = filtro;
                this.paginaActual = 1;
                await this.cargarDatos();
                this.actualizarBotonesFiltro(filtro);
                this.actualizarURL();
            },

            // Buscar
            async buscar() {
                if (this.cargando) return;
                this.busquedaActual = document.getElementById('busquedaProductos').value;
                this.paginaActual = 1;
                await this.cargarDatos();
                this.actualizarInfoBusqueda();
                this.actualizarURL();
            },

            // Limpiar búsqueda
            async limpiarBusqueda() {
                document.getElementById('busquedaProductos').value = '';
                this.busquedaActual = '';
                this.paginaActual = 1;
                await this.cargarDatos();
                this.actualizarInfoBusqueda();
                this.actualizarURL();
            },

            // Cargar página específica
            async cargarPagina(pagina) {
                if (this.cargando) return;
                this.paginaActual = pagina;
                await this.cargarDatos();
                this.actualizarURL();
                
                const container = document.getElementById('productosContainer');
                if (container) {
                    container.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            },

            // Cargar datos via AJAX
            async cargarDatos() {
                this.cargando = true;
                const container = document.getElementById('productosContainer');
                
                if (!container) {
                    console.error('Contenedor de productos no encontrado');
                    this.cargando = false;
                    return;
                }
                
                container.style.opacity = '0.5';
                container.style.pointerEvents = 'none';

                try {
                    const params = new URLSearchParams();
                    params.append('filtro', this.filtroActual);
                    if (this.busquedaActual) params.append('busqueda', this.busquedaActual);
                    params.append('page', this.paginaActual);

                    const response = await fetch(`/AdminProductos/Index?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.ok) {
                        const html = await response.text();
                        container.innerHTML = html;
                        container.style.opacity = '1';
                        container.style.pointerEvents = '';
                        
                        // Actualizar estadísticas desde los headers
                        this.actualizarEstadisticas(response);
                    } else {
                        throw new Error(`Error ${response.status}: ${response.statusText}`);
                    }
                } catch (error) {
                    console.error('Error al cargar productos:', error);
                    if (typeof AldaToast !== 'undefined') {
                        AldaToast.error('Error al cargar los productos');
                    }
                    container.style.opacity = '1';
                    container.style.pointerEvents = '';
                } finally {
                    this.cargando = false;
                }
            },

            // Actualizar estadísticas desde response headers
            actualizarEstadisticas(response) {
                const activos = response.headers.get('X-Stats-Activos');
                const eliminados = response.headers.get('X-Stats-Eliminados');
                const total = response.headers.get('X-Stats-Total');
                const pagina = response.headers.get('X-Stats-Pagina');

                if (activos) {
                    const elemActivos = document.getElementById('statActivos');
                    const elemCountActivos = document.getElementById('countActivos');
                    if (elemActivos) elemActivos.textContent = activos;
                    if (elemCountActivos) elemCountActivos.textContent = activos;
                }
                if (eliminados) {
                    const elemEliminados = document.getElementById('statEliminados');
                    const elemCountEliminados = document.getElementById('countEliminados');
                    if (elemEliminados) elemEliminados.textContent = eliminados;
                    if (elemCountEliminados) elemCountEliminados.textContent = eliminados;
                }
                if (total) {
                    const elemMostrando = document.getElementById('statMostrando');
                    const elemResultados = document.getElementById('resultadosCount');
                    const elemPlural = document.getElementById('resultadosPlural');
                    if (elemMostrando) elemMostrando.textContent = total;
                    if (elemResultados) elemResultados.textContent = total;
                    if (elemPlural) elemPlural.textContent = total !== '1' ? 's' : '';
                }
                if (pagina) {
                    const elemPagina = document.getElementById('statPagina');
                    if (elemPagina) elemPagina.textContent = pagina;
                }
            },

            // Actualizar botones de filtro
            actualizarBotonesFiltro(filtroActivo) {
                const botones = document.querySelectorAll('#filtrosProductos .filtro-btn');
                const colores = {
                    'activos': { activo: 'bg-emerald-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'eliminados': { activo: 'bg-red-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' },
                    'todos': { activo: 'bg-blue-500 text-white shadow-md', inactivo: 'bg-slate-100 text-slate-600 hover:bg-slate-200' }
                };

                botones.forEach(btn => {
                    const filtro = btn.dataset.filtro;
                    const esActivo = filtro === filtroActivo;
                    
                    // Remover clases de color/estado previas
                    btn.classList.remove(
                        'bg-emerald-500', 'bg-red-500', 'bg-blue-500',
                        'bg-slate-100', 'text-white', 'text-slate-600', 'shadow-md', 'hover:bg-slate-200'
                    );
                    
                    // Añadir clases correspondientes
                    const clases = esActivo ? colores[filtro].activo : colores[filtro].inactivo;
                    btn.classList.add(...clases.split(' '));
                });
            },

            // Actualizar info de búsqueda
            actualizarInfoBusqueda() {
                const infoDiv = document.getElementById('busquedaInfo');
                const textoSpan = document.getElementById('busquedaTexto');
                
                if (!infoDiv || !textoSpan) return;
                
                if (this.busquedaActual) {
                    infoDiv.classList.remove('hidden');
                    textoSpan.textContent = this.busquedaActual;
                } else {
                    infoDiv.classList.add('hidden');
                }
            },

            // Actualizar URL
            actualizarURL() {
                const params = new URLSearchParams();
                if (this.filtroActual !== 'activos') params.append('filtro', this.filtroActual);
                if (this.busquedaActual) params.append('busqueda', this.busquedaActual);
                if (this.paginaActual > 1) params.append('page', this.paginaActual);
                
                const newUrl = params.toString() 
                    ? `${window.location.pathname}?${params.toString()}`
                    : window.location.pathname;
                    
                history.pushState({ filtro: this.filtroActual, busqueda: this.busquedaActual, page: this.paginaActual }, '', newUrl);
            },

            // Eliminar producto (soft delete)
            async eliminar(id, nombre) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Mover a papelera?',
                    message: `"${nombre}" se moverá a la papelera y podrás restaurarlo después.`,
                    type: 'warning',
                    confirmText: 'Mover a papelera'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminProductos/EliminarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.animarFilaEliminada(id);
                        AldaToast.success(data.message);
                        // Recargar para actualizar contadores
                        setTimeout(() => this.cargarDatos(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Restaurar producto
            async restaurar(id, nombre) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Restaurar producto?',
                    message: `"${nombre}" volverá a estar activo en el catálogo.`,
                    type: 'info',
                    confirmText: 'Restaurar'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminProductos/RestaurarAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.animarFilaEliminada(id);
                        AldaToast.success(data.message);
                        setTimeout(() => this.cargarDatos(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Eliminar permanentemente
            async eliminarPermanente(id, nombre) {
                const confirmar = await AldaConfirm.show({
                    title: '¿Eliminar permanentemente?',
                    message: `"${nombre}" será eliminado para siempre. Esta acción NO se puede deshacer.`,
                    type: 'danger',
                    confirmText: 'Eliminar para siempre'
                });

                if (!confirmar) return;

                try {
                    const response = await fetch('/AdminProductos/EliminarPermanenteAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}`
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.animarFilaEliminada(id);
                        AldaToast.success(data.message);
                        setTimeout(() => this.cargarDatos(), 500);
                    } else {
                        AldaToast.error(data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    AldaToast.error('Error de conexión');
                }
            },

            // Animar fila al eliminarla
            animarFilaEliminada(id) {
                const fila = document.querySelector(`tr[data-producto-id="${id}"]`);
                if (fila) {
                    fila.style.transition = 'all 0.3s ease';
                    fila.style.transform = 'translateX(50px)';
                    fila.style.opacity = '0';
                    setTimeout(() => fila.remove(), 300);
                }
            }
        };

        // Manejar botón atrás del navegador
        window.addEventListener('popstate', (event) => {
            if (event.state) {
                adminProductos.filtroActual = event.state.filtro || 'activos';
                adminProductos.busquedaActual = event.state.busqueda || '';
                adminProductos.paginaActual = event.state.page || 1;
                
                const inputBusqueda = document.getElementById('busquedaProductos');
                if (inputBusqueda) {
                    inputBusqueda.value = adminProductos.busquedaActual;
                }
                
                adminProductos.cargarDatos();
                adminProductos.actualizarBotonesFiltro(adminProductos.filtroActual);
                adminProductos.actualizarInfoBusqueda();
            }
        });

        window.adminProductos = adminProductos;
    </script>
}
