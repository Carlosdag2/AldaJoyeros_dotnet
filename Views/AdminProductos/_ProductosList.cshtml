@model AldaJoyeros.Helpers.PagedResult<AldaJoyeros.DTOs.ProductoDto>
<div data-product-list data-current-page="@Model.PageNumber" data-total="@Model.TotalItems" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500"><p>Mostrando <strong class="text-slate-800">@Model.StartItem–@Model.EndItem</strong> de <strong class="text-slate-800">@Model.TotalItems</strong> productos</p><p>Página @Model.PageNumber de @Math.Max(1, Model.TotalPages)</p></div>
    @if(Model.Items.Any())
    {
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="hidden grid-cols-12 gap-4 border-b border-slate-200 bg-slate-50 px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 lg:grid"><span class="col-span-4">Producto</span><span class="col-span-2">Categoría</span><span class="col-span-2">Precio y estado</span><span class="col-span-4">Acciones</span></div>
        <div class="divide-y divide-slate-100">
        @foreach(var p in Model.Items)
        {
            <article data-product-id="@p.Id" data-name="@p.Nombre" class="grid min-w-0 gap-4 p-4 sm:p-5 lg:grid-cols-12 lg:items-center">
                <div class="flex min-w-0 items-center gap-3 lg:col-span-4"><div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-100 bg-white">@if(p.TieneImagenes) { <img src="@p.ImagenPrincipal" alt="" loading="lazy" class="h-full w-full object-contain" /> } else { <i class="fas fa-gem text-slate-300" aria-hidden="true"></i> }</div><div class="min-w-0"><h2 class="break-words text-sm font-semibold text-slate-900">@p.Nombre</h2><p class="mt-1 text-xs text-slate-500">ID #@p.Id</p><p class="mt-1 line-clamp-2 break-words text-xs text-slate-500">@p.Descripcion</p></div></div>
                <p class="break-words text-sm text-slate-600 lg:col-span-2"><span class="mr-2 text-xs text-slate-400 lg:hidden">Categoría</span>@p.CategoriaNombre</p>
                <div class="flex flex-wrap items-center gap-3 lg:col-span-2 lg:block"><p class="text-base font-semibold text-slate-900">@p.Precio.ToString("C")</p><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium lg:mt-2 @(p.Eliminado ? "bg-red-50 text-red-700" : "bg-emerald-50 text-emerald-800")">@(p.Eliminado ? "En papelera" : "Activo")</span></div>
                <div class="flex flex-wrap gap-2 lg:col-span-4">
                @if(p.Eliminado) {
                    <button type="button" data-product-action="restaurar" class="admin-row-action border-emerald-200 text-emerald-800"><i class="fas fa-undo" aria-hidden="true"></i>Restaurar</button>
                    <button type="button" data-product-action="permanente" class="admin-row-action border-red-200 text-red-700">Eliminar definitivamente</button>
                } else {
                    <a asp-action="Editar" asp-route-id="@p.Id" data-product-editor="@p.Id" class="admin-row-action border-emerald-200 text-emerald-800"><i class="fas fa-pen" aria-hidden="true"></i>Editar</a>
                    <a asp-controller="AdminImagenes" asp-action="Gestionar" asp-route-id="@p.Id" class="admin-row-action border-slate-200 text-slate-600"><i class="far fa-images" aria-hidden="true"></i>Imágenes</a>
                    <a href="@Url.Action("Detalle", "Productos", new { id=p.Id, slug=(string?)null })" target="_blank" rel="noopener" aria-label="Ver @p.Nombre en la tienda (nueva pestaña)" class="admin-row-action border-slate-200 text-slate-600">Ver ficha<i class="fas fa-external-link-alt text-xs" aria-hidden="true"></i></a>
                    <button type="button" data-product-action="eliminar" class="admin-row-action border-red-200 text-red-700" aria-label="Mover @p.Nombre a la papelera"><i class="far fa-trash-alt" aria-hidden="true"></i>Papelera</button>
                }
                </div>
            </article>
        }
        </div>
    </div>
    @if(Model.TotalPages > 1) { @await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, "adminProductos.cargarPagina", "paginacionProductos", false)) }
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center"><i class="fas fa-search mb-4 text-2xl text-slate-400" aria-hidden="true"></i><h2 class="text-lg font-semibold text-slate-800">No hay productos con estos filtros</h2><p class="mt-2 text-sm text-slate-500">Prueba con otra categoría o limpia la búsqueda.</p><a asp-action="Index" data-product-clear class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-emerald-800 underline">Ver productos activos</a></div>
    }
</div>
