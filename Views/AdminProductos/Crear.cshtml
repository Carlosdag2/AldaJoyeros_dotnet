@model AldaJoyeros.DTOs.ProductoCreateDto

@{
    ViewData["Title"] = "Nuevo Producto";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;
}

<!-- Header -->
<div class="mb-8">
    <h1 class="font-display text-4xl font-bold text-gray-900 mb-2">
        <i class="fas fa-plus-circle text-green-600"></i> Nuevo Producto
    </h1>
    <p class="text-gray-600">Añade un nuevo producto al catálogo de joyas</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-3xl shadow-xl p-8">
            <form asp-action="Crear" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                        <span class="text-red-800 text-sm"></span>
                    </div>
                </div>

                <!-- Nombre -->
                <div>
                    <label asp-for="Nombre" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-gem mr-2 text-gray-500"></i>Nombre del Producto
                    </label>
                    <input asp-for="Nombre" 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:ring focus:ring-green-200 transition-all duration-200 text-lg"
                           placeholder="Ej: Anillo de Diamantes Solitario" />
                    <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <!-- Descripción -->
                <div>
                    <label asp-for="Descripcion" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-align-left mr-2 text-gray-500"></i>Descripción
                    </label>
                    <textarea asp-for="Descripcion" 
                              rows="4"
                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:ring focus:ring-green-200 transition-all duration-200"
                              placeholder="Describe las características, materiales y detalles del producto..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-red-500 text-sm mt-1 block"></span>
                    <p class="text-gray-500 text-xs mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Sé descriptivo para ayudar a los clientes a tomar su decisión
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Precio -->
                    <div>
                        <label asp-for="Precio" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-euro-sign mr-2 text-gray-500"></i>Precio (€)
                        </label>
                        <input asp-for="Precio" 
                               type="number" 
                               step="0.01"
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:ring focus:ring-green-200 transition-all duration-200 text-lg font-semibold"
                               placeholder="99.99" />
                        <span asp-validation-for="Precio" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Categoría -->
                    <div>
                        <label asp-for="CategoriaId" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-tags mr-2 text-gray-500"></i>Categoría
                        </label>
                        <select asp-for="CategoriaId" 
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:ring focus:ring-green-200 transition-all duration-200 text-lg">
                            <option value="">Selecciona una categoría</option>
                            @if (categorias != null)
                            {
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria.Id">@categoria.Nombre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-red-500 text-sm mt-1 block"></span>
                    </div>
                </div>

                <!-- Preview Card -->
                <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 border-2 border-green-200">
                    <h3 class="font-semibold text-gray-900 mb-4 flex items-center">
                        <i class="fas fa-eye text-green-600 mr-2"></i>
                        Vista Previa del Producto
                    </h3>
                    <div class="bg-white rounded-xl overflow-hidden shadow-lg">
                        <div class="bg-gradient-to-br from-amber-50 to-orange-50 h-48 flex items-center justify-center">
                            <i class="fas fa-gem text-8xl text-yellow-600 opacity-20"></i>
                        </div>
                        <div class="p-4">
                            <h3 class="font-bold text-lg mb-2" id="preview-nombre">Nuevo Producto</h3>
                            <p class="text-sm text-gray-600 mb-3 line-clamp-2" id="preview-descripcion">Descripción del producto...</p>
                            <div class="text-2xl font-bold text-gradient" id="preview-precio">0,00 €</div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="flex flex-col sm:flex-row justify-between gap-4">
                    <a asp-action="Index" 
                       class="inline-flex items-center justify-center px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-green-500 hover:text-green-600 transition-all duration-200 font-semibold">
                        <i class="fas fa-times mr-2"></i>
                        Cancelar
                    </a>
                    <button type="submit" 
                            class="inline-flex items-center justify-center gradient-gold text-gray-900 px-8 py-3 rounded-lg font-bold text-lg hover:shadow-2xl transition-all duration-200 transform hover:scale-105">
                        <i class="fas fa-save mr-2"></i>
                        Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Info Sidebar -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Tips -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-lightbulb text-yellow-600 mr-2"></i>
                Consejos de Venta
            </h3>
            <ul class="space-y-3 text-sm text-gray-700">
                <li class="flex items-start">
                    <i class="fas fa-check-circle text-green-600 mr-2 mt-1"></i>
                    <span>Usa nombres descriptivos y atractivos</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-check-circle text-green-600 mr-2 mt-1"></i>
                    <span>Detalla materiales y características</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-check-circle text-green-600 mr-2 mt-1"></i>
                    <span>Precios competitivos aumentan ventas</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-check-circle text-green-600 mr-2 mt-1"></i>
                    <span>Categoriza correctamente tus productos</span>
                </li>
            </ul>
        </div>

        <!-- Información sobre imágenes -->
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-images text-purple-600 mr-2"></i>
                Imágenes del Producto
            </h3>
            <div class="text-sm text-gray-700">
                <p class="mb-3">
                    Después de crear el producto, podrás añadir imágenes desde la página de edición.
                </p>
                <ul class="space-y-2">
                    <li class="flex items-start">
                        <i class="fas fa-check text-purple-600 mr-2 mt-1"></i>
                        <span>Múltiples imágenes por producto</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-purple-600 mr-2 mt-1"></i>
                        <span>Formatos: JPG, PNG, WEBP, GIF</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-purple-600 mr-2 mt-1"></i>
                        <span>Máximo 5MB por imagen</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Categories -->
        @if (categorias != null && categorias.Any())
        {
            <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                    <i class="fas fa-tags text-purple-600 mr-2"></i>
                    Categorías Disponibles
                </h3>
                <div class="space-y-2">
                    @foreach (var categoria in categorias.Take(5))
                    {
                        <div class="bg-purple-50 rounded-lg p-3 text-sm flex items-center">
                            <i class="fas fa-tag text-purple-600 mr-2"></i>
                            <span class="font-medium">@categoria.Nombre</span>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded-r-lg">
                <div class="flex items-start">
                    <i class="fas fa-exclamation-triangle text-yellow-600 mr-3 mt-1"></i>
                    <div class="text-sm">
                        <p class="font-semibold text-gray-900 mb-1">Sin categorías</p>
                        <p class="text-gray-700">Crea categorías primero para organizar tus productos.</p>
                        <a asp-controller="AdminCategorias" asp-action="Crear" class="text-yellow-700 hover:text-yellow-800 font-semibold mt-2 inline-block">
                            Crear categoría ?
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview
        document.querySelector('input[name="Nombre"]')?.addEventListener('input', function(e) {
            document.getElementById('preview-nombre').textContent = e.target.value || 'Nuevo Producto';
        });

        document.querySelector('textarea[name="Descripcion"]')?.addEventListener('input', function(e) {
            document.getElementById('preview-descripcion').textContent = e.target.value || 'Descripción del producto...';
        });

        document.querySelector('input[name="Precio"]')?.addEventListener('input', function(e) {
            const precio = parseFloat(e.target.value) || 0;
            document.getElementById('preview-precio').textContent = precio.toFixed(2) + ' €';
        });
    </script>
}

@section Styles {
    <style>
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}
