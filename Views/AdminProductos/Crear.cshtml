@model AldaJoyeros.DTOs.ProductoCreateDto
@{
    ViewData["Title"] = "Nuevo Producto";
    var categorias = ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        
        <div class="relative container mx-auto px-6 py-8">
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-4">
                <a asp-controller="Admin" asp-action="Index" class="hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" class="hover:text-white transition-colors">Productos</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-white">Nuevo</span>
            </nav>
            
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-2xl flex items-center justify-center shadow-xl shadow-emerald-500/25">
                    <i class="fas fa-plus text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white">Nuevo Producto</h1>
                    <p class="text-slate-400 text-sm mt-1">Añade un nuevo producto al catálogo</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-6 border-b border-slate-100">
                        <h2 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i class="fas fa-gem text-emerald-500"></i>
                            Información del Producto
                        </h2>
                    </div>
                    
                    <form asp-action="Crear" method="post" class="p-6 space-y-5">
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg text-red-700 text-sm"></div>

                        <div>
                            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 mb-2">Nombre *</label>
                            <input asp-for="Nombre" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none" placeholder="Nombre del producto"/>
                            <span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Descripcion" class="block text-sm font-medium text-slate-700 mb-2">Descripción</label>
                            <textarea asp-for="Descripcion" rows="3" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none resize-none" placeholder="Describe materiales, características..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="Precio" class="block text-sm font-medium text-slate-700 mb-2">Precio (€) *</label>
                                <input asp-for="Precio" type="number" step="0.01" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none font-semibold" placeholder="99.99"/>
                                <span asp-validation-for="Precio" class="text-red-500 text-sm mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="CategoriaId" class="block text-sm font-medium text-slate-700 mb-2">Categoría *</label>
                                <select asp-for="CategoriaId" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none">
                                    <option value="">Selecciona categoría</option>
                                    @if(categorias != null)
                                    {
                                        @foreach(var c in categorias)
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoriaId" class="text-red-500 text-sm mt-1 block"></span>
                            </div>
                        </div>

                        <!-- Preview -->
                        <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-5 border border-emerald-200">
                            <h3 class="font-medium text-slate-700 mb-3 flex items-center gap-2">
                                <i class="fas fa-eye text-emerald-500"></i>Vista Previa
                            </h3>
                            <div class="bg-white rounded-lg overflow-hidden shadow-sm">
                                <div class="bg-slate-100 h-32 flex items-center justify-center">
                                    <i class="fas fa-gem text-slate-300 text-4xl"></i>
                                </div>
                                <div class="p-4">
                                    <h4 class="font-semibold text-slate-800" id="preview-nombre">Nuevo Producto</h4>
                                    <p class="text-sm text-slate-500 mt-1 line-clamp-2" id="preview-descripcion">Descripción del producto...</p>
                                    <div class="text-lg font-bold text-emerald-600 mt-2" id="preview-precio">0,00 €</div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4 border-t border-slate-100">
                            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 transition-all font-medium">
                                <i class="fas fa-times"></i>Cancelar
                            </a>
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl font-semibold shadow-lg shadow-emerald-500/25 transition-all">
                                <i class="fas fa-save"></i>Guardar Producto
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-lightbulb text-amber-500"></i>Consejos
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-600">
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Nombres descriptivos y atractivos</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Detalla materiales y características</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-emerald-500 mt-0.5"></i>
                            <span>Precios competitivos</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl p-5 border border-violet-200">
                    <h3 class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-images text-violet-500"></i>Imágenes
                    </h3>
                    <p class="text-sm text-slate-600 mb-3">Después de crear el producto, podrás añadir imágenes desde la página de edición.</p>
                    <ul class="text-sm text-slate-500 space-y-1">
                        <li><i class="fas fa-check text-violet-400 mr-2"></i>JPG, PNG, WEBP</li>
                        <li><i class="fas fa-check text-violet-400 mr-2"></i>Máximo 5MB</li>
                    </ul>
                </div>

                @if(categorias == null || !categorias.Any())
                {
                    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5"></i>
                            <div class="text-sm">
                                <p class="font-medium text-amber-700 mb-1">Sin categorías</p>
                                <p class="text-amber-600 mb-2">Crea categorías para organizar productos.</p>
                                <a asp-controller="AdminCategorias" asp-action="Crear" class="text-amber-700 hover:text-amber-800 font-medium underline">Crear categoría ?</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[name="Nombre"]')?.addEventListener('input', e => document.getElementById('preview-nombre').textContent = e.target.value || 'Nuevo Producto');
        document.querySelector('textarea[name="Descripcion"]')?.addEventListener('input', e => document.getElementById('preview-descripcion').textContent = e.target.value || 'Descripción del producto...');
        document.querySelector('input[name="Precio"]')?.addEventListener('input', e => {
            const p = parseFloat(e.target.value) || 0;
            document.getElementById('preview-precio').textContent = p.toLocaleString('es-ES', {style: 'currency', currency: 'EUR'});
        });
    </script>
}

@section Styles {
    <style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
}
