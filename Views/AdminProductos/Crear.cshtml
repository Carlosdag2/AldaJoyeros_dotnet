@model AldaJoyeros.DTOs.ProductoCreateDto
@{ViewData["Title"]="Nuevo Producto";var categorias=ViewBag.Categorias as IEnumerable<AldaJoyeros.DTOs.CategoriaDto>;}

<div class="container mx-auto px-6 py-8">
<div class="mb-8"><h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3"><div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg"><i class="fas fa-plus-circle text-white text-2xl"></i></div>Nuevo Producto</h1><p class="text-gray-600 text-lg">Añade un nuevo producto al catálogo de joyas</p></div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<div class="lg:col-span-2">
<div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
<form asp-action="Crear" method="post" class="space-y-6">
<div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl mb-6"><div class="flex items-center"><i class="fas fa-exclamation-circle text-red-500 mr-3"></i><span class="text-red-800 text-sm"></span></div></div>

<div><label asp-for="Nombre" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-emerald-100 rounded-lg flex items-center justify-center"><i class="fas fa-gem text-emerald-600 text-xs"></i></div>Nombre del Producto</label>
<input asp-for="Nombre" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg" placeholder="Ej: Anillo de Diamantes Solitario"/>
<span asp-validation-for="Nombre" class="text-red-500 text-sm mt-1 block"></span></div>

<div><label asp-for="Descripcion" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-align-left text-blue-600 text-xs"></i></div>Descripción</label>
<textarea asp-for="Descripcion" rows="4" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none" placeholder="Describe materiales, características y detalles..."></textarea>
<span asp-validation-for="Descripcion" class="text-red-500 text-sm mt-1 block"></span>
<p class="text-gray-500 text-xs mt-2 flex items-center gap-1"><i class="fas fa-info-circle"></i>Sé descriptivo para ayudar a los clientes</p></div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div><label asp-for="Precio" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-green-100 rounded-lg flex items-center justify-center"><i class="fas fa-euro-sign text-green-600 text-xs"></i></div>Precio (€)</label>
<input asp-for="Precio" type="number" step="0.01" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg font-bold" placeholder="99.99"/>
<span asp-validation-for="Precio" class="text-red-500 text-sm mt-1 block"></span></div>

<div><label asp-for="CategoriaId" class="block text-sm font-bold text-gray-700 mb-3 flex items-center gap-2"><div class="w-6 h-6 bg-purple-100 rounded-lg flex items-center justify-center"><i class="fas fa-tags text-purple-600 text-xs"></i></div>Categoría</label>
<select asp-for="CategoriaId" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-lg">
<option value="">Selecciona una categoría</option>
@if(categorias!=null){@foreach(var c in categorias){<option value="@c.Id">@c.Nombre</option>}}
</select>
<span asp-validation-for="CategoriaId" class="text-red-500 text-sm mt-1 block"></span></div>
</div>

<div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
<h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center"><i class="fas fa-eye text-white"></i></div>Vista Previa</h3>
<div class="bg-white rounded-xl overflow-hidden shadow-lg">
<div class="bg-gradient-to-br from-emerald-50 to-green-50 h-48 flex items-center justify-center"><i class="fas fa-gem text-8xl text-emerald-600 opacity-20"></i></div>
<div class="p-5"><h3 class="font-bold text-lg mb-2" id="preview-nombre">Nuevo Producto</h3><p class="text-sm text-gray-600 mb-3 line-clamp-2" id="preview-descripcion">Descripción del producto...</p><div class="text-2xl font-bold text-emerald-600" id="preview-precio">0,00 €</div></div>
</div>
</div>

<hr class="border-gray-200"/>

<div class="flex flex-col sm:flex-row justify-between gap-4">
<a asp-action="Index" class="inline-flex items-center justify-center px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all font-semibold"><i class="fas fa-times mr-2"></i>Cancelar</a>
<button type="submit" class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-2xl transition-all transform hover:scale-105"><i class="fas fa-save mr-2"></i>Guardar Producto</button>
</div>
</form>
</div>
</div>

<div class="lg:col-span-1 space-y-6">
<div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200"><h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center"><i class="fas fa-lightbulb text-white"></i></div>Consejos de Venta</h3>
<ul class="space-y-3 text-sm text-gray-700">
<li class="flex items-start gap-2"><div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-check text-white text-xs"></i></div><span>Nombres descriptivos y atractivos</span></li>
<li class="flex items-start gap-2"><div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-check text-white text-xs"></i></div><span>Detalla materiales y características</span></li>
<li class="flex items-start gap-2"><div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-check text-white text-xs"></i></div><span>Precios competitivos</span></li>
<li class="flex items-start gap-2"><div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-check text-white text-xs"></i></div><span>Categoriza correctamente</span></li>
</ul></div>

<div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-200"><h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center"><i class="fas fa-images text-white"></i></div>Imágenes del Producto</h3>
<div class="text-sm text-gray-700"><p class="mb-3">Después de crear el producto, podrás añadir imágenes desde la página de edición.</p>
<ul class="space-y-2">
<li class="flex items-start gap-2"><i class="fas fa-check text-purple-600 mt-0.5"></i><span>Múltiples imágenes</span></li>
<li class="flex items-start gap-2"><i class="fas fa-check text-purple-600 mt-0.5"></i><span>JPG, PNG, WEBP, GIF</span></li>
<li class="flex items-start gap-2"><i class="fas fa-check text-purple-600 mt-0.5"></i><span>Máximo 5MB por imagen</span></li>
</ul></div></div>

@if(categorias!=null&&categorias.Any()){<div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100"><h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2"><div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center"><i class="fas fa-tags text-purple-600"></i></div>Categorías Disponibles</h3>
<div class="space-y-2">@foreach(var c in categorias.Take(5)){<div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-3 text-sm flex items-center border border-purple-200"><i class="fas fa-tag text-purple-600 mr-2"></i><span class="font-medium">@c.Nombre</span></div>}</div></div>}else{
<div class="bg-gradient-to-r from-yellow-50 to-orange-50 border-l-4 border-yellow-500 p-4 rounded-r-xl"><div class="flex items-start gap-3"><div class="w-10 h-10 bg-yellow-500 rounded-lg flex items-center justify-center flex-shrink-0"><i class="fas fa-exclamation-triangle text-white"></i></div>
<div class="text-sm"><p class="font-bold text-gray-900 mb-1">Sin categorías</p><p class="text-gray-700 mb-2">Crea categorías primero para organizar tus productos.</p>
<a asp-controller="AdminCategorias" asp-action="Crear" class="text-yellow-700 hover:text-yellow-800 font-bold">Crear categoría ?</a></div></div></div>}
</div>
</div>
</div>

@section Scripts{<partial name="_ValidationScriptsPartial"/>
<script>
document.querySelector('input[name="Nombre"]')?.addEventListener('input',e=>document.getElementById('preview-nombre').textContent=e.target.value||'Nuevo Producto');
document.querySelector('textarea[name="Descripcion"]')?.addEventListener('input',e=>document.getElementById('preview-descripcion').textContent=e.target.value||'Descripción del producto...');
document.querySelector('input[name="Precio"]')?.addEventListener('input',e=>{const p=parseFloat(e.target.value)||0;document.getElementById('preview-precio').textContent=p.toFixed(2)+' €';});
</script>}

@section Styles{<style>.line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}</style>}
