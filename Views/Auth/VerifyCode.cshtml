@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verificar código";
    ViewData["AuthRecovery"] = 2;
    ViewData["AuthHeading"] = "Comprueba tu correo";
    ViewData["AuthDescription"] = "Introduce el código de 6 dígitos que aparece en el correo de recuperación.";
}
<form asp-controller="Auth" asp-action="VerifyCode" method="post" class="auth-form space-y-5" data-auth-form>
    <input type="hidden" name="token" value="@ViewBag.Token" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div><label for="verificationCode" class="mb-2 block text-sm font-semibold text-stone-800">Código de verificación</label><input id="verificationCode" name="code" type="text" required minlength="6" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" data-verification-code aria-describedby="code-help" placeholder="000000" class="auth-code block min-h-[56px] w-full rounded-lg border border-stone-300 bg-white px-4 py-4 text-center font-semibold text-stone-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-100" /><p id="code-help" class="mt-2 text-xs leading-relaxed text-stone-500">Puedes escribirlo o pegarlo. Comprueba también la carpeta de spam; el código caduca en una hora.</p></div>
    @if (ViewBag.Attempts != null && (int)ViewBag.Attempts > 0) { <p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Intentos utilizados: <strong>@ViewBag.Attempts de 5</strong>.</p> }
    <button type="submit" data-busy-label="Comprobando código…" class="flex min-h-[48px] w-full items-center justify-center gap-3 rounded-lg bg-emerald-800 px-5 py-4 text-sm font-semibold text-white hover:bg-emerald-900 disabled:opacity-60"><span data-submit-label>Verificar código</span><i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></button>
</form>
<div class="mt-5 flex flex-wrap gap-x-5 gap-y-2"><a asp-controller="Auth" asp-action="ForgotPassword" class="py-3 text-sm font-semibold text-emerald-800 underline underline-offset-4">Solicitar otro código</a><a asp-controller="Auth" asp-action="Login" class="py-3 text-sm text-stone-600 hover:underline">Volver a iniciar sesión</a></div>
