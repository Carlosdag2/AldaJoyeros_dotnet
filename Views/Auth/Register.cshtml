@model AldaJoyeros.DTOs.UsuarioCreateDto

@{
    ViewData["Title"] = "Registrarse";
}

<div class="min-h-[calc(100vh-7rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Background decorativo -->
    <div class="absolute inset-0 -z-10">
        <div class="absolute top-0 -left-4 w-96 h-96 bg-emerald-300/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob"></div>
        <div class="absolute top-0 -right-4 w-96 h-96 bg-teal-300/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-96 h-96 bg-green-300/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-4000"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    </div>

    <div class="max-w-md w-full mx-auto">
        <div class="bg-white rounded-3xl shadow-2xl shadow-gray-200/50 overflow-hidden backdrop-blur-xl border border-gray-100">
            
            <div class="p-8 lg:p-10">
                <!-- Header -->
                <div class="text-center mb-8">
                    <div class="inline-flex items-center gap-3 mb-6">
                        <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/30 animate-float">
                            <i class="fas fa-user-plus text-2xl text-white"></i>
                        </div>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Crear Cuenta</h2>
                    <p class="text-gray-500">Únete a la familia Alda Joyeros</p>
                </div>

                @* Mensaje informativo si viene desde el carrito *@
                @if (TempData["Info"] != null)
                {
                    <div class="mb-6 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 p-4 rounded-2xl">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-shopping-cart text-blue-600"></i>
                            </div>
                            <div>
                                <p class="text-blue-800 text-sm font-semibold">Continúa tu compra</p>
                                <p class="text-blue-700 text-xs">@TempData["Info"]</p>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Register" method="post" class="space-y-5" x-data="{ showPassword: false }">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    
                    <div asp-validation-summary="ModelOnly" class="bg-gradient-to-r from-red-50 to-rose-50 border border-red-200 p-4 rounded-2xl">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-exclamation-triangle text-red-600"></i>
                            </div>
                            <span class="text-red-800 text-sm font-medium"></span>
                        </div>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label asp-for="Email" class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                            <i class="fas fa-envelope text-emerald-500 text-xs"></i>
                            Correo Electrónico
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center group-focus-within:bg-emerald-100 transition-colors">
                                    <i class="fas fa-at text-gray-400 group-focus-within:text-emerald-600 transition-colors"></i>
                                </div>
                            </div>
                            <input asp-for="Email" 
                                   type="email"
                                   class="w-full pl-16 pr-4 py-4 bg-gray-50 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 outline-none text-gray-900 placeholder-gray-400"
                                   placeholder="tu@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="space-y-2">
                        <label asp-for="Password" class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                            <i class="fas fa-lock text-emerald-500 text-xs"></i>
                            Contraseña
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center group-focus-within:bg-emerald-100 transition-colors">
                                    <i class="fas fa-key text-gray-400 group-focus-within:text-emerald-600 transition-colors"></i>
                                </div>
                            </div>
                            <input asp-for="Password" 
                                   x-bind:type="showPassword ? 'text' : 'password'"
                                   class="w-full pl-16 pr-14 py-4 bg-gray-50 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 outline-none text-gray-900 placeholder-gray-400"
                                   placeholder="Mínimo 6 caracteres" />
                            <button type="button" 
                                    @@click="showPassword = !showPassword"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center">
                                <div class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-lg flex items-center justify-center transition-colors">
                                    <i class="fas text-gray-500 text-sm" x-bind:class="showPassword ? 'fa-eye-slash' : 'fa-eye'"></i>
                                </div>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Password Requirements -->
                    <div class="bg-gradient-to-r from-gray-50 to-emerald-50/30 border border-gray-100 rounded-xl p-4">
                        <p class="text-gray-700 text-sm font-medium mb-2 flex items-center gap-2">
                            <i class="fas fa-shield-alt text-emerald-500"></i>
                            Requisitos de seguridad
                        </p>
                        <ul class="space-y-1.5 text-sm text-gray-600">
                            <li class="flex items-center gap-2">
                                <i class="fas fa-check-circle text-emerald-500 text-xs"></i>
                                <span>Mínimo 6 caracteres</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <i class="fas fa-lightbulb text-amber-500 text-xs"></i>
                                <span class="text-gray-500">Combina letras, números y símbolos</span>
                            </li>
                        </ul>
                    </div>


                    <!-- Submit Button -->
                    <button type="submit" 
                            class="relative w-full overflow-hidden bg-gradient-to-r from-emerald-500 via-emerald-600 to-teal-600 text-white py-4 rounded-2xl font-bold text-lg shadow-xl shadow-emerald-500/30 hover:shadow-emerald-500/50 transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] group">
                        <span class="absolute inset-0 bg-gradient-to-r from-emerald-600 via-emerald-700 to-teal-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                        <span class="relative flex items-center justify-center gap-3">
                            <i class="fas fa-user-plus"></i>
                            <span>Crear Cuenta</span>
                            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </span>
                    </button>
                </form>

                <!-- Divider -->
                <div class="my-8 flex items-center gap-4">
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    <span class="text-gray-400 text-sm font-medium">¿Ya tienes cuenta?</span>
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                </div>

                <!-- Login Link -->
                <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl"
                   class="flex items-center justify-center gap-3 w-full py-4 border-2 border-gray-200 rounded-2xl font-semibold text-gray-700 hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50/50 transition-all duration-300 group">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Inicia sesión aquí</span>
                    <i class="fas fa-arrow-right text-sm opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"></i>
                </a>

                <!-- Benefits -->
                <div class="mt-8 pt-6 border-t border-gray-100">
                    <p class="text-center text-xs text-gray-500 font-medium mb-4">Al registrarte obtienes</p>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="text-center p-3 bg-gradient-to-br from-purple-50 to-indigo-50 rounded-xl border border-purple-100 hover:shadow-md transition-shadow">
                            <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-gift text-purple-600"></i>
                            </div>
                            <p class="text-xs text-gray-700 font-medium">Ofertas<br/>Exclusivas</p>
                        </div>
                        <div class="text-center p-3 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl border border-emerald-100 hover:shadow-md transition-shadow">
                            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-truck text-emerald-600"></i>
                            </div>
                            <p class="text-xs text-gray-700 font-medium">Envío Gratis<br/>+50€</p>
                        </div>
                        <div class="text-center p-3 bg-gradient-to-br from-amber-50 to-yellow-50 rounded-xl border border-amber-100 hover:shadow-md transition-shadow">
                            <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-star text-amber-600"></i>
                            </div>
                            <p class="text-xs text-gray-700 font-medium">Puntos<br/>Reward</p>
                        </div>
                    </div>
                </div>

                <!-- Security badges -->
                <div class="mt-6 flex items-center justify-center gap-6">
                    <div class="flex items-center gap-2 text-gray-400">
                        <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-shield-alt text-emerald-500 text-sm"></i>
                        </div>
                        <span class="text-xs font-medium">Datos Seguros</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-400">
                        <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-lock text-emerald-500 text-sm"></i>
                        </div>
                        <span class="text-xs font-medium">Encriptado SSL</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Brand footer -->
        <div class="mt-8 text-center">
            <div class="inline-flex items-center gap-2 text-gray-400">
                <i class="fas fa-gem text-emerald-500"></i>
                <span class="font-serif text-lg font-semibold text-gray-600">Alda Joyeros</span>
            </div>
            <p class="text-gray-400 text-xs mt-1">Elegancia y calidad desde 1962</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Animación de blobs */
        @@keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        
        .animate-blob {
            animation: blob 7s infinite;
        }
        
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        
        .animation-delay-4000 {
            animation-delay: 4s;
        }

        /* Floating animation for icon */
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        /* Fade in animation */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .max-w-md {
            animation: fadeInUp 0.8s ease-out;
        }

        /* Input autofill styling */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px #f9fafb inset;
            -webkit-text-fill-color: #111827;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Custom checkbox */
        input[type="checkbox"]:checked {
            background-image: none;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
