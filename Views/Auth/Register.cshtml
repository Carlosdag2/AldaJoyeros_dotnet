@model AldaJoyeros.DTOs.UsuarioCreateDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear cuenta";
    ViewData["AuthRegister"] = true;
}
<form asp-controller="Auth" asp-action="Register" method="post" class="auth-form space-y-5" data-auth-form>
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div>
        <label asp-for="Email" class="mb-2 block text-sm font-semibold text-stone-800">Correo electrónico</label>
        <input asp-for="Email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" aria-describedby="Email-validation" placeholder="tu@email.com" class="block min-h-[48px] w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-stone-900 placeholder-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-100" />
        <span asp-validation-for="Email" id="Email-validation" class="mt-2 block text-sm text-red-700"></span>
    </div>
    <div>
        <label asp-for="Password" class="mb-2 block text-sm font-semibold text-stone-800">Contraseña</label>
        <div class="relative">
            <input asp-for="Password" type="password" value="" autocomplete="new-password" minlength="6" aria-describedby="password-help Password-validation" placeholder="Crea una contraseña" class="block min-h-[48px] w-full rounded-lg border border-stone-300 bg-white py-3 pl-4 pr-14 text-stone-900 placeholder-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-100" />
            <button type="button" data-password-toggle hidden aria-label="Mostrar contraseña" aria-controls="Password" aria-pressed="false" class="auth-password-toggle absolute right-1 top-1/2 -translate-y-1/2"><i class="fas fa-eye" aria-hidden="true"></i></button>
        </div>
        <span asp-validation-for="Password" id="Password-validation" class="mt-2 block text-sm text-red-700"></span>
        <p id="password-help" class="mt-2 text-xs leading-relaxed text-stone-500">Al menos 6 caracteres. Puedes combinar letras, números y símbolos.</p>
    </div>
    <button type="submit" data-busy-label="Creando tu cuenta…" class="flex min-h-[48px] w-full items-center justify-center gap-3 rounded-lg bg-emerald-800 px-5 py-4 text-sm font-semibold text-white transition-colors hover:bg-emerald-900 disabled:cursor-wait disabled:opacity-60"><span data-submit-label>Crear mi cuenta</span><i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
