@model AldaJoyeros.DTOs.UsuarioCreateDto

@{
    ViewData["Title"] = "Registrarse";
}

<div class="flex items-center justify-center py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 p-8 text-center">
                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-user-plus text-3xl text-emerald-600"></i>
                </div>
                <h2 class="font-serif text-3xl font-bold text-white">Crear Cuenta</h2>
                <p class="text-emerald-100 mt-2">Únete a la familia Alda Joyeros</p>
            </div>

            <!-- Form -->
            <div class="p-8">
                @* Mensaje informativo si viene desde el carrito *@
                @if (TempData["Info"] != null)
                {
                    <div class="mb-6 bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
                        <div class="flex items-start">
                            <i class="fas fa-info-circle text-blue-500 mt-0.5 mr-3"></i>
                            <div>
                                <p class="text-blue-800 text-sm font-semibold mb-1">Continúa tu compra</p>
                                <p class="text-blue-700 text-sm">@TempData["Info"]</p>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Register" method="post" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                            <span class="text-red-800 text-sm"></span>
                        </div>
                    </div>

                    <!-- Email Field -->
                    <div class="relative">
                        <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2">
                            Correo Electrónico
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-envelope text-gray-400"></i>
                            </div>
                            <input asp-for="Email" 
                                   type="email"
                                   class="w-full pl-12 pr-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all duration-200 outline-none"
                                   placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="relative">
                        <label asp-for="Password" class="block text-sm font-semibold text-gray-700 mb-2">
                            Contraseña
                        </label>
                        <div class="relative" x-data="{ showPassword: false }">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input asp-for="Password" 
                                   x-bind:type="showPassword ? 'text' : 'password'"
                                   class="w-full pl-12 pr-12 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all duration-200 outline-none"
                                   placeholder="Mínimo 6 caracteres" />
                            <button type="button" 
                                    @@click="showPassword = !showPassword"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600 transition-colors">
                                <i class="fas" x-bind:class="showPassword ? 'fa-eye-slash' : 'fa-eye'"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
                        <p class="text-gray-500 text-xs mt-2 flex items-center">
                            <i class="fas fa-info-circle mr-1"></i>Mínimo 6 caracteres
                        </p>
                    </div>

                    <!-- Password Strength Indicator -->
                    <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-4 border border-emerald-100">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 bg-emerald-500 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-shield-alt text-white"></i>
                            </div>
                            <div>
                                <h4 class="font-semibold text-gray-900 text-sm mb-1">Seguridad Garantizada</h4>
                                <p class="text-gray-600 text-xs leading-relaxed">Tu información está protegida con encriptación de nivel bancario</p>
                            </div>
                        </div>
                    </div>

                    <!-- Terms and Conditions -->
                    <div class="bg-gray-50 rounded-xl p-4">
                        <label class="flex items-start cursor-pointer group">
                            <input type="checkbox" required class="w-4 h-4 mt-0.5 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500 focus:ring-2 cursor-pointer">
                            <span class="ml-3 text-sm text-gray-600 group-hover:text-gray-800">
                                Acepto los <a href="#" class="text-emerald-600 hover:text-emerald-700 font-semibold hover:underline">términos y condiciones</a> y la <a href="#" class="text-emerald-600 hover:text-emerald-700 font-semibold hover:underline">política de privacidad</a>
                            </span>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                            class="w-full bg-gradient-to-r from-emerald-500 to-emerald-600 text-white py-4 rounded-xl font-bold text-lg hover:from-emerald-600 hover:to-emerald-700 hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                        <i class="fas fa-user-plus mr-2"></i>
                        Crear Cuenta
                    </button>
                </form>

                <!-- Divider -->
                <div class="mt-8">
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-300"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-4 bg-white text-gray-500">¿Ya tienes cuenta?</span>
                        </div>
                    </div>
                    
                    <!-- Login Link -->
                    <a asp-action="Login" 
                       class="mt-6 w-full flex items-center justify-center border-2 border-emerald-500 text-emerald-600 py-3 rounded-xl font-semibold hover:bg-emerald-50 transition-all duration-200 group">
                        Inicia sesión aquí
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                    </a>
                </div>
            </div>

            <!-- Footer Info -->
            <div class="bg-gradient-to-r from-gray-50 to-emerald-50 px-8 py-6 border-t border-gray-200">
                <div class="text-center">
                    <p class="text-xs text-gray-600 mb-3 font-semibold">Al registrarte obtienes:</p>
                    <div class="flex justify-center items-center gap-6 text-xs">
                        <div class="flex items-center gap-2 text-gray-700">
                            <i class="fas fa-check-circle text-emerald-600"></i>
                            <span>Ofertas exclusivas</span>
                        </div>
                        <div class="flex items-center gap-2 text-gray-700">
                            <i class="fas fa-check-circle text-emerald-600"></i>
                            <span>Envío gratis +50€</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Benefits Cards -->
        <div class="mt-8 grid grid-cols-3 gap-4">
            <div class="bg-white rounded-xl p-4 text-center shadow-md hover:shadow-lg transition-shadow duration-200">
                <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-gift text-2xl text-purple-600"></i>
                </div>
                <p class="text-xs text-gray-700 font-semibold">Ofertas<br/>Exclusivas</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-md hover:shadow-lg transition-shadow duration-200">
                <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-truck text-2xl text-emerald-600"></i>
                </div>
                <p class="text-xs text-gray-700 font-semibold">Envío Gratis<br/>+50€</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-md hover:shadow-lg transition-shadow duration-200">
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-star text-2xl text-yellow-600"></i>
                </div>
                <p class="text-xs text-gray-700 font-semibold">Puntos<br/>Reward</p>
            </div>
        </div>

        <!-- Branding -->
        <div class="mt-6 mb-8 text-center">
            <div class="inline-flex items-center gap-3 text-emerald-600">
                <i class="fas fa-gem text-2xl"></i>
                <span class="font-serif text-2xl font-bold">Alda Joyeros</span>
            </div>
            <p class="text-gray-600 mt-2">Elegancia y calidad desde 1962</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Custom animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .max-w-md {
            animation: fadeInUp 0.6s ease-out;
        }

        /* Focus states enhancement */
        input:focus {
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
        }

        /* Smooth transitions */
        * {
            transition-property: transform, box-shadow, background-color, border-color;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
