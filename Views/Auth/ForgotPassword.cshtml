@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["AuthRecovery"] = 1;
    ViewData["AuthHeading"] = "¿Olvidaste tu contraseña?";
    ViewData["AuthDescription"] = "Indica el correo de tu cuenta. Después podrás introducir el código aquí mismo para recuperar el acceso.";
}
    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="auth-form space-y-5" data-auth-form>
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div><label for="recoveryEmail" class="mb-2 block text-sm font-semibold text-stone-800">Correo electrónico</label><input id="recoveryEmail" name="email" type="email" required autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="tu@email.com" class="block min-h-[48px] w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-100" /></div>
        <p class="rounded-lg bg-stone-50 p-4 text-xs leading-relaxed text-stone-600">Recibirás un enlace y un código de 6 dígitos. Por seguridad, ambos caducan en una hora.</p>
        <button type="submit" data-busy-label="Enviando solicitud…" class="flex min-h-[48px] w-full items-center justify-center gap-3 rounded-lg bg-emerald-800 px-5 py-4 text-sm font-semibold text-white hover:bg-emerald-900 disabled:opacity-60"><span data-submit-label>Enviar instrucciones</span><i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></button>
    </form>
    <a asp-controller="Auth" asp-action="Login" class="mt-5 inline-flex min-h-[44px] items-center gap-3 text-sm font-semibold text-emerald-800 hover:underline"><i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>Volver a iniciar sesión</a>
