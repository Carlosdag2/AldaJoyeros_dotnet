@model AldaJoyeros.Models.FeaturedProductsViewModel
@{ ViewData["Title"] = "Productos destacados"; }
<main id="featuredPanel" data-index-url="@Url.Action("Index", "AdminDestacados")" class="min-h-screen bg-slate-50 px-4 py-8 text-slate-800 md:px-6"><div class="mx-auto max-w-7xl">
<nav class="mb-5 flex gap-2 text-xs text-slate-500"><a asp-controller="Admin" asp-action="Index">Panel de administración</a><span>/</span><span>Productos destacados</span></nav>
<header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h1 class="text-2xl font-bold md:text-3xl">Productos destacados</h1><p class="mt-2 text-sm text-slate-500">Elige hasta ocho productos para el inicio. Añade, quita o cambia su orden sin salir de esta pantalla.</p></div><a asp-controller="Home" asp-action="Index" asp-fragment="productos-destacados" target="_blank" rel="noopener" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold">Ver inicio</a></header>
<div class="mb-4 flex flex-wrap items-center gap-3 text-sm"><p id="estadoOrdenDestacados" role="status" aria-live="polite"></p><a asp-controller="AdminDestacados" asp-action="Index" asp-route-busqueda="@Model.Search" asp-route-categoriaId="@Model.CategoryId" asp-route-page="@Model.Candidates.PageNumber" id="recargarDestacados" hidden class="font-semibold text-emerald-800 underline">Actualizar selección</a></div>
<section id="featuredSelection" class="mb-8 rounded-xl border border-slate-200 bg-white p-4 md:p-6" aria-labelledby="seleccionTitulo"><partial name="_SeleccionDestacados" model="Model" /></section>
<section aria-labelledby="catalogoTitulo"><h2 id="catalogoTitulo" class="mb-4 text-lg font-semibold">Añadir desde el catálogo</h2>
<form asp-controller="AdminDestacados" asp-action="Index" method="get" data-featured-filter class="mb-5 grid gap-4 rounded-xl border border-slate-200 bg-white p-4 md:grid-cols-2 xl:grid-cols-[1fr_1fr_auto]">
<div class="min-w-0"><label for="buscarDestacados" class="mb-2 block text-xs font-semibold text-slate-600">Nombre o referencia</label><input id="buscarDestacados" name="busqueda" value="@Model.Search" type="search" placeholder="Escribe un nombre o referencia…" class="w-full rounded-lg border border-slate-300 px-3 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-100" /></div>
<div class="min-w-0"><label for="categoriaDestacados" class="mb-2 block text-xs font-semibold text-slate-600">Categoría</label><select id="categoriaDestacados" name="categoriaId" class="w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm"><option value="">Todas las categorías</option>
@foreach (var group in Model.Categories.GroupBy(c => c.Grupo)) { <optgroup label="@group.Key">@foreach (var category in group) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Nombre (@category.CantidadProductos)</option> }</optgroup> }
</select></div>
<div class="flex flex-wrap items-end gap-2 md:col-span-2 xl:col-span-1"><button class="min-h-11 rounded-lg bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Buscar</button><a asp-controller="AdminDestacados" asp-action="Index" data-featured-clear class="min-h-11 rounded-lg border border-slate-200 px-4 py-3 text-center text-sm font-semibold">Limpiar</a></div>
</form>
<div id="featuredCandidates"><partial name="_CandidatosDestacados" model="Model" /></div></section>
</div></main>
<partial name="_FeaturedReplacement" />
@section Scripts {
<script src="~/js/featured-actions.js" asp-append-version="true" defer></script>
<script src="~/js/admin-featured.js" asp-append-version="true" defer></script>
}
@section Styles { <link rel="stylesheet" href="~/css/featured.css" asp-append-version="true" /> }
