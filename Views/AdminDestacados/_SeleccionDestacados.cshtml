@model AldaJoyeros.Models.FeaturedProductsViewModel
<div class="mb-5 flex justify-between gap-3"><h2 id="seleccionTitulo" class="text-lg font-semibold">Tu selección</h2><span class="rounded-lg bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-800">@Model.Selected.Count / 8</span></div>
@if (Model.Selected.Count == 0) { <p class="p-6 text-sm text-slate-500">Todavía no hay destacados. Añade productos desde el catálogo de abajo.</p> }
<p id="ayudaOrdenDestacados" class="mb-4 text-sm text-slate-500">Usa las flechas o arrastra desde el tirador para cambiar la posición. El orden se guarda al soltar.</p>
<form asp-controller="AdminDestacados" asp-action="Ordenar" method="post" id="ordenDestacados" hidden></form>
<ol class="space-y-3" id="seleccionDestacados" aria-describedby="ayudaOrdenDestacados">
@for (var index = 0; index < Model.Selected.Count; index++)
{
var item = Model.Selected[index];
<li data-featured-id="@item.Id" class="flex flex-col gap-3 rounded-lg border border-slate-200 p-3 md:flex-row md:items-center">
<div class="flex min-w-0 flex-1 items-center gap-3"><button type="button" data-featured-drag hidden aria-label="Arrastrar producto @(item.Product?.Nombre ?? item.Id.ToString())" title="Arrastrar para cambiar de posición" class="featured-drag-handle h-11 w-11 shrink-0 touch-none rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50"><i class="fas fa-grip-vertical" aria-hidden="true"></i></button><span data-featured-position class="w-5 shrink-0 text-sm font-bold text-slate-400">@(index + 1)</span>
@if (item.Product?.TieneImagenes == true) { <img src="@item.Product.ImagenPrincipal" alt="" class="h-14 w-14 shrink-0 rounded-lg bg-slate-50 object-contain" /> }
else { <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-400"><i class="fas fa-gem" aria-hidden="true"></i></span> }
<div class="min-w-0"><span class="block break-words text-sm font-semibold">@(item.Product?.Nombre ?? "Producto no disponible")</span><span class="text-xs text-slate-500">#@item.Id · @(item.Product?.CategoriaNombre ?? "Sin categoría")</span>
@if (item.Product == null || item.Product.Eliminado) { <p class="mt-1 text-xs font-semibold text-amber-700">Oculto: no aparece en el inicio. Puedes quitarlo de la selección.</p> }
</div></div>
<form asp-controller="AdminDestacados" asp-action="Cambiar" data-featured-change method="post" class="flex shrink-0 flex-wrap gap-2">
<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="busqueda" value="@Model.Search" /><input type="hidden" name="page" value="@Model.Candidates.PageNumber" /><input type="hidden" name="categoriaId" value="@Model.CategoryId" />
<button name="accion" value="subir" disabled="@(index == 0)" class="rounded-lg border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 disabled:opacity-40" aria-label="Subir producto @item.Id"><i class="fas fa-arrow-up" aria-hidden="true"></i></button>
<button name="accion" value="bajar" disabled="@(index == Model.Selected.Count - 1)" class="rounded-lg border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 disabled:opacity-40" aria-label="Bajar producto @item.Id"><i class="fas fa-arrow-down" aria-hidden="true"></i></button>
<button name="accion" value="quitar" class="rounded-lg border border-red-100 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">Quitar del inicio</button>
</form></li>
}
</ol><p class="mt-4 text-xs text-slate-500">Quitar un destacado no elimina el producto del catálogo. Los productos ocultos nunca se muestran al público.</p>