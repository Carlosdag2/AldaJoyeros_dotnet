@{
    ViewData["Title"] = "Panel de Administración";
    var totalCategorias = ViewBag.TotalCategorias ?? 0;
    var totalProductos = ViewBag.TotalProductos ?? 0;
    var totalPedidos = ViewBag.TotalPedidos ?? 0;
    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <!-- Hero Header -->
    <div class="relative overflow-hidden bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%239C92AC\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
        
        <div class="relative container mx-auto px-6 py-12">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-16 h-16 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-2xl flex items-center justify-center shadow-xl shadow-emerald-500/25 ring-4 ring-white/10">
                            <i class="fas fa-gem text-white text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">Panel de Control</h1>
                            <p class="text-slate-400 mt-1">Gestiona tu tienda desde un solo lugar</p>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="hidden md:flex items-center gap-2 px-4 py-2 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10">
                        <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
                        <span class="text-sm text-slate-300">Sistema activo</span>
                    </div>
                    <a asp-controller="Home" asp-action="Index" 
                       class="flex items-center gap-2 px-4 py-2.5 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-xl text-white text-sm font-medium transition-all border border-white/10 hover:border-white/20">
                        <i class="fas fa-external-link-alt text-xs"></i>
                        Ver tienda
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 -mt-8 relative z-10 pb-12">
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-10">
            <!-- Productos -->
            <a asp-controller="AdminProductos" asp-action="Index" 
               class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-emerald-200 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-gem text-white text-lg"></i>
                    </div>
                    <span class="flex items-center gap-1 text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                        <i class="fas fa-box text-[10px]"></i>
                        Stock
                    </span>
                </div>
                <div class="text-3xl font-bold text-slate-800 mb-1">@totalProductos</div>
                <div class="text-sm text-slate-500">Productos</div>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Gestionar catálogo</span>
                    <i class="fas fa-arrow-right text-emerald-500 text-xs group-hover:translate-x-1 transition-transform"></i>
                </div>
            </a>

            <!-- Categorías -->
            <a asp-controller="AdminCategorias" asp-action="Index" 
               class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-violet-200 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-violet-400 to-violet-600 rounded-xl flex items-center justify-center shadow-lg shadow-violet-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-tags text-white text-lg"></i>
                    </div>
                    <span class="flex items-center gap-1 text-xs font-medium text-violet-600 bg-violet-50 px-2 py-1 rounded-full">
                        <i class="fas fa-folder text-[10px]"></i>
                        Activas
                    </span>
                </div>
                <div class="text-3xl font-bold text-slate-800 mb-1">@totalCategorias</div>
                <div class="text-sm text-slate-500">Categorías</div>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Organizar productos</span>
                    <i class="fas fa-arrow-right text-violet-500 text-xs group-hover:translate-x-1 transition-transform"></i>
                </div>
            </a>

            <!-- Pedidos -->
            <a asp-controller="AdminPedidos" asp-action="Index" 
               class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-amber-200 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-amber-400 to-orange-500 rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-shopping-bag text-white text-lg"></i>
                    </div>
                    <span class="flex items-center gap-1 text-xs font-medium text-amber-600 bg-amber-50 px-2 py-1 rounded-full">
                        <i class="fas fa-clock text-[10px]"></i>
                        Total
                    </span>
                </div>
                <div class="text-3xl font-bold text-slate-800 mb-1">@totalPedidos</div>
                <div class="text-sm text-slate-500">Pedidos</div>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Ver todos los pedidos</span>
                    <i class="fas fa-arrow-right text-amber-500 text-xs group-hover:translate-x-1 transition-transform"></i>
                </div>
            </a>

            <!-- Usuarios -->
            <a asp-controller="AdminUsuarios" asp-action="Index" 
               class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-blue-200 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-users text-white text-lg"></i>
                    </div>
                    <span class="flex items-center gap-1 text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full">
                        <i class="fas fa-user-check text-[10px]"></i>
                        Registrados
                    </span>
                </div>
                <div class="text-3xl font-bold text-slate-800 mb-1">@totalUsuarios</div>
                <div class="text-sm text-slate-500">Usuarios</div>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Gestionar cuentas</span>
                    <i class="fas fa-arrow-right text-blue-500 text-xs group-hover:translate-x-1 transition-transform"></i>
                </div>
            </a>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
            <!-- Quick Actions -->
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-slate-100 to-slate-200 rounded-xl flex items-center justify-center">
                            <i class="fas fa-bolt text-slate-600"></i>
                        </div>
                        <div>
                            <h2 class="font-semibold text-slate-800">Acciones Rápidas</h2>
                            <p class="text-xs text-slate-400">Accede a las funciones más usadas</p>
                        </div>
                    </div>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <a asp-controller="AdminProductos" asp-action="Crear" 
                           class="group flex items-center gap-4 p-4 rounded-xl bg-gradient-to-br from-emerald-50 to-green-50 hover:from-emerald-100 hover:to-green-100 border border-emerald-100 transition-all">
                            <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
                                <i class="fas fa-plus text-white"></i>
                            </div>
                            <div class="flex-1">
                                <div class="font-semibold text-slate-800">Nuevo Producto</div>
                                <div class="text-xs text-slate-500">Añadir al catálogo</div>
                            </div>
                            <i class="fas fa-chevron-right text-emerald-400 group-hover:translate-x-1 transition-transform"></i>
                        </a>

                        <a asp-controller="AdminCategorias" asp-action="Crear" 
                           class="group flex items-center gap-4 p-4 rounded-xl bg-gradient-to-br from-violet-50 to-purple-50 hover:from-violet-100 hover:to-purple-100 border border-violet-100 transition-all">
                            <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
                                <i class="fas fa-folder-plus text-white"></i>
                            </div>
                            <div class="flex-1">
                                <div class="font-semibold text-slate-800">Nueva Categoría</div>
                                <div class="text-xs text-slate-500">Organizar productos</div>
                            </div>
                            <i class="fas fa-chevron-right text-violet-400 group-hover:translate-x-1 transition-transform"></i>
                        </a>

                        <a asp-controller="AdminUsuarios" asp-action="Crear" 
                           class="group flex items-center gap-4 p-4 rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 hover:from-blue-100 hover:to-indigo-100 border border-blue-100 transition-all">
                            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
                                <i class="fas fa-user-plus text-white"></i>
                            </div>
                            <div class="flex-1">
                                <div class="font-semibold text-slate-800">Nuevo Usuario</div>
                                <div class="text-xs text-slate-500">Crear cuenta</div>
                            </div>
                            <i class="fas fa-chevron-right text-blue-400 group-hover:translate-x-1 transition-transform"></i>
                        </a>

                        <a asp-controller="AdminPedidos" asp-action="Index" 
                           class="group flex items-center gap-4 p-4 rounded-xl bg-gradient-to-br from-amber-50 to-orange-50 hover:from-amber-100 hover:to-orange-100 border border-amber-100 transition-all">
                            <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
                                <i class="fas fa-clipboard-list text-white"></i>
                            </div>
                            <div class="flex-1">
                                <div class="font-semibold text-slate-800">Ver Pedidos</div>
                                <div class="text-xs text-slate-500">Gestionar envíos</div>
                            </div>
                            <i class="fas fa-chevron-right text-amber-400 group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Navigation Panel -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-slate-100 to-slate-200 rounded-xl flex items-center justify-center">
                            <i class="fas fa-compass text-slate-600"></i>
                        </div>
                        <div>
                            <h2 class="font-semibold text-slate-800">Navegación</h2>
                            <p class="text-xs text-slate-400">Accesos directos</p>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    <nav class="space-y-1">
                        <a asp-controller="AdminProductos" asp-action="Index" 
                           class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition-all group">
                            <i class="fas fa-gem text-emerald-500 w-5"></i>
                            <span class="font-medium">Productos</span>
                            <i class="fas fa-chevron-right text-xs ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
                        </a>
                        <a asp-controller="AdminCategorias" asp-action="Index" 
                           class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-violet-50 hover:text-violet-700 transition-all group">
                            <i class="fas fa-tags text-violet-500 w-5"></i>
                            <span class="font-medium">Categorías</span>
                            <i class="fas fa-chevron-right text-xs ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
                        </a>
                        <a asp-controller="AdminPedidos" asp-action="Index" 
                           class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-amber-50 hover:text-amber-700 transition-all group">
                            <i class="fas fa-shopping-bag text-amber-500 w-5"></i>
                            <span class="font-medium">Pedidos</span>
                            <i class="fas fa-chevron-right text-xs ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
                        </a>
                        <a asp-controller="AdminUsuarios" asp-action="Index" 
                           class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-blue-50 hover:text-blue-700 transition-all group">
                            <i class="fas fa-users text-blue-500 w-5"></i>
                            <span class="font-medium">Usuarios</span>
                            <i class="fas fa-chevron-right text-xs ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Management Sections -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Catálogo Section -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-6 text-white relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>
                
                <div class="relative">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-store text-white text-lg"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">Catálogo</h3>
                            <p class="text-slate-400 text-sm">Gestión de inventario</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <a asp-controller="AdminProductos" asp-action="Index" 
                           class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 hover:border-emerald-500/30 transition-all group/item">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-emerald-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-gem text-emerald-400"></i>
                                </div>
                                <div>
                                    <div class="font-medium">Productos</div>
                                    <div class="text-xs text-slate-400">@totalProductos artículos</div>
                                </div>
                            </div>
                            <i class="fas fa-arrow-right text-emerald-400 group-hover/item:translate-x-1 transition-transform"></i>
                        </a>

                        <a asp-controller="AdminCategorias" asp-action="Index" 
                           class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 hover:border-violet-500/30 transition-all group/item">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-violet-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-tags text-violet-400"></i>
                                </div>
                                <div>
                                    <div class="font-medium">Categorías</div>
                                    <div class="text-xs text-slate-400">@totalCategorias categorías</div>
                                </div>
                            </div>
                            <i class="fas fa-arrow-right text-violet-400 group-hover/item:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Gestión Section -->
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-6 text-white relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl"></div>
                
                <div class="relative">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-cogs text-white text-lg"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">Gestión</h3>
                            <p class="text-slate-400 text-sm">Pedidos y usuarios</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <a asp-controller="AdminPedidos" asp-action="Index" 
                           class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 hover:border-amber-500/30 transition-all group/item">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-shopping-bag text-amber-400"></i>
                                </div>
                                <div>
                                    <div class="font-medium">Pedidos</div>
                                    <div class="text-xs text-slate-400">@totalPedidos pedidos</div>
                                </div>
                            </div>
                            <i class="fas fa-arrow-right text-amber-400 group-hover/item:translate-x-1 transition-transform"></i>
                        </a>

                        <a asp-controller="AdminUsuarios" asp-action="Index" 
                           class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 hover:border-blue-500/30 transition-all group/item">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-users text-blue-400"></i>
                                </div>
                                <div>
                                    <div class="font-medium">Usuarios</div>
                                    <div class="text-xs text-slate-400">@totalUsuarios registrados</div>
                                </div>
                            </div>
                            <i class="fas fa-arrow-right text-blue-400 group-hover/item:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .container > .grid > * {
            animation: fadeInUp 0.5s ease-out forwards;
            opacity: 0;
        }

        .container > .grid > *:nth-child(1) { animation-delay: 0.05s; }
        .container > .grid > *:nth-child(2) { animation-delay: 0.1s; }
        .container > .grid > *:nth-child(3) { animation-delay: 0.15s; }
        .container > .grid > *:nth-child(4) { animation-delay: 0.2s; }
    </style>
}
