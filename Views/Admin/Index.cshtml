@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mx-auto px-6 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-3 flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-tachometer-alt text-white text-2xl"></i>
            </div>
            Panel de Administración
        </h1>
        <p class="text-gray-600 text-lg">Gestiona todos los aspectos de Alda Joyeros desde aquí</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <!-- Categorías -->
        <div class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl p-6 text-white shadow-xl hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300 border border-purple-400">
            <div class="flex items-center justify-between mb-4">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm shadow-lg">
                    <i class="fas fa-tags text-3xl"></i>
                </div>
                <div class="w-10 h-10 bg-green-400 rounded-full flex items-center justify-center">
                    <i class="fas fa-arrow-up text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-xs font-bold text-purple-100 mb-2 uppercase tracking-wider">CATEGORÍAS</h3>
            <div class="text-4xl font-bold mb-3">@ViewBag.TotalCategorias</div>
            <a asp-controller="AdminCategorias" asp-action="Index" 
               class="inline-flex items-center text-sm font-semibold hover:text-purple-100 transition-colors group">
                Ver todas
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>

        <!-- Productos -->
        <div class="bg-gradient-to-br from-emerald-500 to-green-600 rounded-2xl p-6 text-white shadow-xl hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300 border border-emerald-400">
            <div class="flex items-center justify-between mb-4">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm shadow-lg">
                    <i class="fas fa-gem text-3xl"></i>
                </div>
                <div class="w-10 h-10 bg-green-400 rounded-full flex items-center justify-center">
                    <i class="fas fa-arrow-up text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-xs font-bold text-emerald-100 mb-2 uppercase tracking-wider">PRODUCTOS</h3>
            <div class="text-4xl font-bold mb-3">@ViewBag.TotalProductos</div>
            <a asp-controller="AdminProductos" asp-action="Index" 
               class="inline-flex items-center text-sm font-semibold hover:text-emerald-100 transition-colors group">
                Gestionar
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>

        <!-- Pedidos -->
        <div class="bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl p-6 text-white shadow-xl hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300 border border-orange-400">
            <div class="flex items-center justify-between mb-4">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm shadow-lg">
                    <i class="fas fa-box text-3xl"></i>
                </div>
                <div class="w-10 h-10 bg-orange-300 rounded-full flex items-center justify-center">
                    <i class="fas fa-arrow-up text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-xs font-bold text-orange-100 mb-2 uppercase tracking-wider">PEDIDOS</h3>
            <div class="text-4xl font-bold mb-3">@ViewBag.TotalPedidos</div>
            <a asp-controller="AdminPedidos" asp-action="Index" 
               class="inline-flex items-center text-sm font-semibold hover:text-orange-100 transition-colors group">
                Ver pedidos
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>

        <!-- Usuarios -->
        <div class="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl p-6 text-white shadow-xl hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-300 border border-blue-400">
            <div class="flex items-center justify-between mb-4">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-xl flex items-center justify-center backdrop-blur-sm shadow-lg">
                    <i class="fas fa-users text-3xl"></i>
                </div>
                <div class="w-10 h-10 bg-blue-300 rounded-full flex items-center justify-center">
                    <i class="fas fa-arrow-up text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-xs font-bold text-blue-100 mb-2 uppercase tracking-wider">USUARIOS</h3>
            <div class="text-4xl font-bold mb-3">@ViewBag.TotalUsuarios</div>
            <a asp-controller="AdminUsuarios" asp-action="Index" 
               class="inline-flex items-center text-sm font-semibold hover:text-blue-100 transition-colors group">
                Gestionar
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
            </a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-3xl shadow-xl p-8 mb-12 border border-gray-100">
        <h2 class="font-serif text-3xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                <i class="fas fa-bolt text-emerald-600"></i>
            </div>
            Acciones Rápidas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a asp-controller="AdminCategorias" asp-action="Crear" 
               class="group bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-purple-500">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-purple-500 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform shadow-md">
                        <i class="fas fa-plus text-white text-xl"></i>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900 text-lg">Nueva Categoría</div>
                        <div class="text-sm text-gray-600">Crear categoría de productos</div>
                    </div>
                </div>
            </a>

            <a asp-controller="AdminProductos" asp-action="Crear" 
               class="group bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-emerald-500">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-emerald-500 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform shadow-md">
                        <i class="fas fa-plus text-white text-xl"></i>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900 text-lg">Nuevo Producto</div>
                        <div class="text-sm text-gray-600">Agregar producto al catálogo</div>
                    </div>
                </div>
            </a>

            <a asp-controller="AdminUsuarios" asp-action="Crear" 
               class="group bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-blue-500">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform shadow-md">
                        <i class="fas fa-user-plus text-white text-xl"></i>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900 text-lg">Nuevo Usuario</div>
                        <div class="text-sm text-gray-600">Crear cuenta de usuario</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <!-- Categories & Products -->
        <div class="bg-gradient-to-br from-emerald-900 to-emerald-800 rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden border border-emerald-700">
            <!-- Decorative Elements -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-700 rounded-full opacity-20 -mr-16 -mt-16"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-emerald-700 rounded-full opacity-10 -ml-24 -mb-24"></div>
            
            <div class="relative z-10">
                <h2 class="font-serif text-2xl font-bold mb-6 flex items-center gap-2">
                    <div class="w-10 h-10 bg-emerald-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-store text-white"></i>
                    </div>
                    Catálogo
                </h2>
                <div class="space-y-4">
                    <a asp-controller="AdminCategorias" asp-action="Index" 
                       class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group backdrop-blur-sm border border-white border-opacity-10">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-purple-500 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-tags text-white text-xl"></i>
                            </div>
                            <div>
                                <div class="font-bold text-lg">Categorías</div>
                                <div class="text-sm text-emerald-200">Gestionar categorías de productos</div>
                            </div>
                        </div>
                        <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                    </a>
                    <a asp-controller="AdminProductos" asp-action="Index" 
                       class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group backdrop-blur-sm border border-white border-opacity-10">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-emerald-400 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-gem text-white text-xl"></i>
                            </div>
                            <div>
                                <div class="font-bold text-lg">Productos</div>
                                <div class="text-sm text-emerald-200">Administrar inventario</div>
                            </div>
                        </div>
                        <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Orders & Users -->
        <div class="bg-gradient-to-br from-blue-900 to-indigo-900 rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden border border-blue-700">
            <!-- Decorative Elements -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-700 rounded-full opacity-20 -mr-16 -mt-16"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-blue-700 rounded-full opacity-10 -ml-24 -mb-24"></div>
            
            <div class="relative z-10">
                <h2 class="font-serif text-2xl font-bold mb-6 flex items-center gap-2">
                    <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center">
                        <i class="fas fa-users-cog text-white"></i>
                    </div>
                    Gestión
                </h2>
                <div class="space-y-4">
                    <a asp-controller="AdminPedidos" asp-action="Index" 
                       class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group backdrop-blur-sm border border-white border-opacity-10">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-box text-white text-xl"></i>
                            </div>
                            <div>
                                <div class="font-bold text-lg">Pedidos</div>
                                <div class="text-sm text-blue-200">Ver y gestionar pedidos</div>
                            </div>
                        </div>
                        <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                    </a>
                    <a asp-controller="AdminUsuarios" asp-action="Index" 
                       class="flex items-center justify-between bg-white bg-opacity-10 rounded-xl p-4 hover:bg-opacity-20 transition-all group backdrop-blur-sm border border-white border-opacity-10">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-blue-400 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-users text-white text-xl"></i>
                            </div>
                            <div>
                                <div class="font-bold text-lg">Usuarios</div>
                                <div class="text-sm text-blue-200">Administrar cuentas</div>
                            </div>
                        </div>
                        <i class="fas fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Banner -->
    <div class="bg-gradient-to-r from-emerald-50 to-green-50 border-l-4 border-emerald-500 rounded-r-2xl p-6 mb-12 shadow-sm">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-emerald-500 rounded-xl flex items-center justify-center flex-shrink-0">
                <i class="fas fa-info-circle text-white text-xl"></i>
            </div>
            <div>
                <h3 class="font-bold text-gray-900 text-lg mb-2">
                    Bienvenido al Panel de Administración
                </h3>
                <p class="text-gray-700 leading-relaxed">
                    Desde aquí puedes gestionar todas las funcionalidades de Alda Joyeros: categorías, productos, pedidos y usuarios. 
                    Utiliza el menú superior o las tarjetas de acceso rápido para navegar entre las diferentes secciones.
                </p>
            </div>
        </div>
    </div>

    <!-- Product Migration Section -->
    <div class="bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
        <h2 class="font-serif text-3xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
                <i class="fas fa-exchange-alt text-red-600"></i>
            </div>
            Migración de Productos
        </h2>
        <p class="text-gray-700 mb-6 leading-relaxed">
            Si has actualizado recientemente la estructura de la base de datos de productos, o si has cambiado de método de gestión de imágenes,
            utiliza la herramienta de migración para evitar problemas de compatibilidad.
        </p>
        <a asp-controller="AdminUtilities" asp-action="Migration" 
           class="inline-flex items-center bg-gradient-to-br from-red-50 to-orange-50 rounded-xl p-4 hover:shadow-lg transition-all duration-300 border-2 border-transparent hover:border-red-500 group">
            <div class="w-10 h-10 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                <i class="fas fa-arrow-right text-white"></i>
            </div>
            <div>
                <div class="font-bold text-gray-900">Ir a Migración</div>
                <div class="text-sm text-gray-600">Herramienta de migración de datos</div>
            </div>
            <i class="fas fa-chevron-right ml-auto text-red-500 group-hover:translate-x-2 transition-transform"></i>
        </a>
    </div>
</div>

@section Styles {
    <style>
        /* Smooth animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .grid > div {
            animation: fadeInUp 0.6s ease-out;
            animation-fill-mode: both;
        }

        .grid > div:nth-child(1) { animation-delay: 0.1s; }
        .grid > div:nth-child(2) { animation-delay: 0.2s; }
        .grid > div:nth-child(3) { animation-delay: 0.3s; }
        .grid > div:nth-child(4) { animation-delay: 0.4s; }

        /* Pulse animation for icons */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.8;
            }
        }

        .bg-gradient-to-br:hover {
            transform: translateY(-8px);
        }
    </style>
}
