@model AldaJoyeros.DTOs.AdminDashboardViewModel
@using AldaJoyeros.Helpers
@{
    ViewData["Title"] = "Panel de Control";
    var ecommerce = ViewBag.EcommerceEnabled == true;
    var summaries = new[] {
        (Controller:"AdminProductos",Title:"Productos",Count:Model.TotalProductos,Description:"Referencias activas del catálogo",Icon:"fa-gem"),
        (Controller:"AdminCategorias",Title:"Categorías",Count:Model.TotalCategorias,Description:"Organiza cómo se encuentra cada pieza",Icon:"fa-tags"),
        (Controller:"AdminPedidos",Title:"Pedidos",Count:Model.TotalPedidos,Description:"Consulta y gestiona las compras",Icon:"fa-bag-shopping"),
        (Controller:"AdminUsuarios",Title:"Usuarios",Count:Model.TotalUsuarios,Description:"Administra las cuentas de tus clientes",Icon:"fa-users")
    };
}
<div class="min-h-screen bg-slate-50 px-4 py-6 text-slate-800 sm:px-6 lg:py-10">
<div class="mx-auto max-w-7xl space-y-7">
    <header class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
        <div><p class="mb-3 text-xs font-semibold uppercase tracking-widest text-emerald-700">Alda Joyeros · Administración</p><h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Panel de Control</h1><p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-500">Tu catálogo, tus pedidos y la imagen de tu tienda, en un solo lugar.</p></div>
        <div class="flex flex-wrap gap-2"><a asp-controller="Home" asp-action="Index" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:border-emerald-700 hover:text-emerald-800"><i class="fas fa-store" aria-hidden="true"></i>Ver tienda</a><a asp-action="Metricas" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-800 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-900"><i class="fas fa-chart-line" aria-hidden="true"></i>Métricas y tráfico</a></div>
    </header>
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs"><a href="#configuracion" class="inline-flex items-center gap-2 rounded-full border px-3 py-2 font-semibold @(ecommerce ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-amber-200 bg-amber-50 text-amber-800")"><i class="fas @(ecommerce ? "fa-bag-shopping" : "fa-eye")" aria-hidden="true"></i>@(ecommerce ? "Tienda online activa" : "Modo escaparate")<span class="ml-1 underline underline-offset-2">Cambiar modo</span></a><p class="text-slate-500">Datos de @Model.ActualizadoEn.ToString("dd/MM/yyyy HH:mm") · Madrid</p></div>
    <nav aria-label="Secciones del panel" class="flex flex-wrap gap-2 text-xs font-medium text-slate-600"><a href="#configuracion" class="rounded-lg border border-slate-200 bg-white px-3 py-2 hover:border-emerald-600 hover:text-emerald-800">Modo de la web</a><a href="#proveedores" class="rounded-lg border border-slate-200 bg-white px-3 py-2 hover:border-emerald-600 hover:text-emerald-800">Proveedores</a><a href="#escaparate" class="rounded-lg border border-slate-200 bg-white px-3 py-2 hover:border-emerald-600 hover:text-emerald-800">Imagen de la tienda</a><a href="#pedidos" class="rounded-lg border border-slate-200 bg-white px-3 py-2 hover:border-emerald-600 hover:text-emerald-800">Pedidos</a></nav>

    <div id="configuracion" class="scroll-mt-28"><partial name="_StoreModePanel" /></div>

    <section id="proveedores" class="scroll-mt-28" aria-labelledby="proveedoresTitulo"><div class="mb-4"><h2 id="proveedoresTitulo" class="text-lg font-semibold">Actualización de proveedores</h2><p class="mt-1 text-sm text-slate-500">Revisa los cambios del catálogo y configura cuándo quieres actualizarlo.</p></div><div class="grid gap-4 lg:grid-cols-2">
        <a asp-controller="AdminMunreco" asp-action="Index" class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-emerald-600 sm:p-6"><div class="flex items-center justify-between gap-3"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-50 text-emerald-700"><i class="fas fa-arrows-rotate text-lg" aria-hidden="true"></i></span><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">Catálogo online</span></div><h3 class="mt-4 text-lg font-semibold">Munreco</h3><p class="mt-2 text-sm leading-relaxed text-slate-500">Comprueba novedades, reposiciones y retirados. Consulta los informes y la programación mensual.</p><span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-emerald-800">Gestionar Munreco<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></span></a>
        <a asp-controller="AdminPerezMora" asp-action="Index" class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-emerald-600 sm:p-6"><div class="flex items-center justify-between gap-3"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-50 text-emerald-700"><i class="fas fa-file-excel text-lg" aria-hidden="true"></i></span><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">Catálogo Excel</span></div><h3 class="mt-4 text-lg font-semibold">Pérez Mora</h3><p class="mt-2 text-sm leading-relaxed text-slate-500">Importa el Excel, revisa cambios y reposiciones, ajusta los coeficientes y configura las actualizaciones.</p><span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-emerald-800">Gestionar Pérez Mora<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></span></a>
    </div></section>

    <section id="escaparate" class="scroll-mt-28" aria-labelledby="escaparateTitulo"><div class="mb-4"><h2 id="escaparateTitulo" class="text-lg font-semibold">La imagen de tu tienda</h2><p class="mt-1 text-sm text-slate-500">Elige qué ven tus clientes en la web y en la tienda.</p></div><div class="grid gap-4 lg:grid-cols-2">
        <a asp-controller="AdminDestacados" asp-action="Index" class="group flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-emerald-600 sm:p-6"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas fa-star text-lg" aria-hidden="true"></i></span><div class="min-w-0 flex-1"><h3 class="font-semibold">Productos destacados</h3><p class="mt-2 text-sm leading-relaxed text-slate-500">Selecciona y ordena las piezas que aparecen en la página de inicio.</p><span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-800">Elegir destacados<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></span></div></a>
        <a asp-controller="AdminPresentacion" asp-action="Index" class="group flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-emerald-600 sm:p-6"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas fa-display text-lg" aria-hidden="true"></i></span><div class="min-w-0 flex-1"><h3 class="font-semibold">Presentación del catálogo</h3><p class="mt-2 text-sm leading-relaxed text-slate-500">Prepara las diapositivas de productos para mostrarlas en la tienda.</p><span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-800">Preparar presentación<i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></span></div></a>
    </div></section>

    <section aria-label="Gestión principal" class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
        @foreach(var item in summaries)
        {
            <a asp-controller="@item.Controller" asp-action="Index" class="group min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 sm:p-5"><div class="mb-4 flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas @item.Icon" aria-hidden="true"></i></span><i class="fas fa-arrow-right text-xs text-slate-400 group-hover:text-emerald-700" aria-hidden="true"></i></div><h2 class="text-sm font-semibold text-slate-600">@item.Title</h2><p class="mt-2 break-words text-3xl font-bold tracking-tight text-slate-900">@item.Count.ToString("N0")</p><p class="mt-2 text-xs leading-relaxed text-slate-500">@item.Description</p></a>
        }
    </section>

    <div class="grid items-start gap-6 xl:grid-cols-3">
        <section id="pedidos" class="min-w-0 scroll-mt-28 space-y-4 xl:col-span-2" aria-labelledby="pedidosTitulo">
            <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 id="pedidosTitulo" class="text-lg font-semibold">Pedidos por atender</h2><p class="mt-1 text-sm text-slate-500">@(Model.Pendientes > 0 ? $"Tienes {Model.Pendientes} pedidos pendientes de gestionar." : "No hay nuevos pedidos pendientes.")</p></div><a asp-controller="AdminPedidos" asp-action="Index" class="text-sm font-semibold text-emerald-800 underline underline-offset-4">Ver todos</a></div>
            <div class="grid grid-cols-3 gap-2 sm:gap-3">
                @foreach(var item in new[] { (State:"PENDIENTE",Title:"Pendientes",Count:Model.Pendientes,Icon:"fa-clock"),(State:"EN_PROCESO",Title:"En preparación",Count:Model.EnProceso,Icon:"fa-box"),(State:"ENVIADO",Title:"Enviados",Count:Model.Enviados,Icon:"fa-truck") })
                {
                    <a asp-controller="AdminPedidos" asp-action="Index" asp-route-estado="@item.State" class="min-w-0 rounded-xl border border-slate-200 bg-white p-3 transition-colors hover:border-emerald-600 sm:p-4"><div class="mb-3 flex items-center gap-2 text-slate-500"><i class="fas @item.Icon text-xs" aria-hidden="true"></i><h3 class="break-words text-xs font-medium">@item.Title</h3></div><p class="text-2xl font-bold @(item.State=="PENDIENTE" && item.Count>0 ? "text-amber-700" : "text-slate-900")">@item.Count</p></a>
                }
            </div>
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h3 class="text-sm font-semibold">Últimos pedidos recibidos</h3><p class="mt-1 text-xs text-slate-500">Los cinco más recientes. Pulsa un pedido para ver su detalle.</p></div>
                @if(Model.UltimosPedidos.Count > 0)
                {
                    <ol class="divide-y divide-slate-100">
                        @foreach(var order in Model.UltimosPedidos)
                        {
                            var status = PedidoPresentacion.Desde(order.Estado?.ToString());
                            <li><a asp-controller="AdminPedidos" asp-action="Detalle" asp-route-id="@order.Id" aria-label="Ver pedido #@order.Id" class="grid grid-cols-2 items-center gap-3 px-5 py-4 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-600 sm:grid-cols-[minmax(0,1fr)_auto_auto]"><div class="min-w-0"><p class="font-semibold text-slate-900">Pedido #@order.Id</p><p class="mt-1 text-xs text-slate-500">@(order.Fecha?.ToString("dd/MM/yyyy HH:mm") ?? "Fecha no disponible")</p></div><strong class="text-right text-sm text-slate-900 sm:order-3">@order.Total.ToString("C")</strong><div class="col-span-2 sm:order-2 sm:col-span-1"><partial name="_PedidoEstado" model="status" /></div></a></li>
                        }
                    </ol>
                }
                else
                {
                    <div class="px-6 py-10 text-center"><i class="fas fa-bag-shopping text-2xl text-slate-300" aria-hidden="true"></i><p class="mt-3 text-sm font-semibold">Aún no hay pedidos</p><p class="mt-2 text-xs leading-relaxed text-slate-500">Cuando recibas una compra aparecerá aquí para que puedas gestionarla.</p></div>
                }
            </div>
        </section>
        <aside class="min-w-0 space-y-5" aria-label="Accesos rápidos">
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><header class="border-b border-slate-100 px-5 py-4"><h2 class="font-semibold">¿Qué quieres hacer?</h2><p class="mt-1 text-xs text-slate-500">Accede directamente a las tareas habituales.</p></header><ul class="divide-y divide-slate-100">
                @foreach(var item in new[] { (Controller:"AdminProductos",Title:"Añadir un producto",Description:"Crea una nueva ficha de catálogo",Icon:"fa-plus"),(Controller:"AdminCategorias",Title:"Crear una categoría",Description:"Organiza mejor tus productos",Icon:"fa-folder-plus"),(Controller:"AdminUsuarios",Title:"Crear una cuenta",Description:"Añade un usuario desde el panel",Icon:"fa-user-plus") })
                {<li><a asp-controller="@item.Controller" asp-action="Crear" class="group flex min-h-20 items-center gap-3 px-5 py-4 hover:bg-slate-50"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-50 text-emerald-700"><i class="fas @item.Icon" aria-hidden="true"></i></span><div class="min-w-0 flex-1"><h3 class="text-sm font-semibold">@item.Title</h3><p class="mt-1 text-xs leading-relaxed text-slate-500">@item.Description</p></div><i class="fas fa-chevron-right text-[10px] text-slate-400" aria-hidden="true"></i></a></li>}
            </ul></section>
            <a asp-action="Metricas" class="group block rounded-2xl border border-emerald-200 bg-emerald-50 p-5"><div class="mb-4 flex items-center justify-between text-emerald-800"><i class="fas fa-chart-line text-xl" aria-hidden="true"></i><i class="fas fa-arrow-right text-sm" aria-hidden="true"></i></div><h2 class="font-semibold text-emerald-900">¿Cómo va la tienda?</h2><p class="mt-2 text-sm leading-relaxed text-emerald-800">Consulta ventas, pedidos y visitantes en tiempo real.</p><span class="mt-4 inline-block text-sm font-semibold text-emerald-900 underline underline-offset-4">Abrir métricas y estadísticas</span></a>
        </aside>
    </div>

</div></div>
