@model AldaJoyeros.DTOs.MetricasDto
@using AldaJoyeros.DTOs
@using System.Globalization
@{
    ViewData["Title"] = "Métricas y Estadísticas";
    var traffic = ViewBag.Trafico as TraficoDto;
    var pages = traffic?.VisitantesPorPagina ?? new Dictionary<string,int>();
    var active = traffic?.VisitantesActivos ?? 0;
    var states = new[] { ("Pendientes", Model.PedidosPendientes), ("En proceso", Model.PedidosEnProceso), ("Enviados", Model.PedidosEnviados), ("Entregados", Model.PedidosEntregados), ("Cancelados", Model.PedidosCancelados) };
    var salesMax = Math.Max(0, Model.VentasPorDia.Select(v=>v.Total).DefaultIfEmpty(0).Max());
    var ordersMax = Math.Max(0, Model.PedidosPorDia.Select(v=>v.Cantidad).DefaultIfEmpty(0).Max());
    var madrid = TimeZoneInfo.FindSystemTimeZoneById("Europe/Madrid");
    var livePoints = (traffic?.Historial ?? Array.Empty<TraficoMinutoDto>()).Select(h=>new MetricChartPoint(TimeZoneInfo.ConvertTime(h.Fecha,madrid).ToString("dd/MM HH:mm"),TimeZoneInfo.ConvertTime(h.Fecha,madrid).ToString("HH:mm"),h.Visitantes)).ToArray();

}
<div class="min-h-screen bg-slate-50 px-4 py-6 text-slate-800 sm:px-6 lg:py-10">
<div class="mx-auto max-w-7xl space-y-6">
    <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-xs text-slate-500"><a asp-action="Index" class="hover:text-emerald-800">Panel de administración</a><i class="fas fa-chevron-right text-[10px]" aria-hidden="true"></i><span>Métricas y estadísticas</span></nav>
    <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div><div class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-emerald-700"><i class="fas fa-chart-line" aria-hidden="true"></i>Estado de tu tienda</div><h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Métricas y Estadísticas</h1><p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">Consulta la actividad comercial y descubre qué secciones están viendo tus visitantes.</p></div>
        <form method="get" asp-action="Metricas" class="flex flex-wrap items-end gap-2">
            <label class="text-xs font-medium text-slate-600" for="diasMetricas">Periodo del informe<select id="diasMetricas" name="dias" class="mt-2 block min-h-11 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800"><option value="7" selected="@(Model.DiasPeriodo==7)">Últimos 7 días</option><option value="30" selected="@(Model.DiasPeriodo==30)">Últimos 30 días</option><option value="90" selected="@(Model.DiasPeriodo==90)">Últimos 90 días</option></select></label>
            <button type="submit" class="min-h-11 rounded-xl bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900">Actualizar informe</button>
        </form>
    </header>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500"><span>@Model.InicioPeriodo.ToString("dd MMM yyyy") – @Model.FinPeriodo.ToString("dd MMM yyyy")</span><span>Actualizado: @Model.GeneradasEn.ToString("dd/MM/yyyy HH:mm") · Madrid</span></div>
    <section aria-label="Resumen del periodo" class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        @foreach (var item in new[] { ("Importe de pedidos", Model.VentasPeriodo.ToString("C"), "Sin pedidos cancelados", "fa-euro-sign"), ("Pedidos recibidos",Model.PedidosPeriodo.ToString("N0"),"En el periodo seleccionado","fa-bag-shopping"),("Importe medio",Model.TicketPeriodo.ToString("C"),"Por pedido no cancelado","fa-receipt"),("Pedidos pendientes",Model.PedidosPendientes.ToString("N0"),"Pendientes de gestionar en total","fa-clock") })
        {
            <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="mb-5 flex items-center justify-between gap-3"><h2 class="text-sm font-medium text-slate-500">@item.Item1</h2><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><i class="fas @item.Item4" aria-hidden="true"></i></span></div><p class="break-words text-3xl font-bold tracking-tight text-slate-900">@item.Item2</p><p class="mt-2 text-xs leading-relaxed text-slate-500">@item.Item3</p></article>
        }
    </section>
    <section aria-label="Resumen rápido de actividad comercial" class="grid gap-3 sm:grid-cols-3">
        @foreach (var summary in new[] { ("Hoy",Model.VentasHoy,Model.PedidosHoy), ("Últimos 7 días",Model.VentasUltimos7Dias,Model.PedidosUltimos7Dias), ("Últimos 30 días",Model.VentasUltimos30Dias,Model.PedidosUltimos30Dias) })
        {
            <article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-5 py-4"><div><h2 class="text-xs font-semibold text-slate-500">@summary.Item1</h2><p class="mt-1 text-xs text-slate-500">@summary.Item3 pedidos recibidos</p></div><p class="text-xl font-semibold text-slate-900">@summary.Item2.ToString("C")</p></article>
        }
    </section>
    <p class="text-xs leading-relaxed text-slate-500">Los importes corresponden a pedidos no cancelados; no equivalen necesariamente a cobros confirmados. El informe incluye el día de hoy.</p>

    <section id="traficoEnVivo" data-live-traffic data-endpoint="@Url.Action("ObtenerTrafico", "Admin")" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="traficoTitulo">
        <header class="flex flex-col gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"><div><div class="flex flex-wrap items-center gap-3"><h2 id="traficoTitulo" class="text-lg font-semibold">Tráfico en vivo</h2><span data-live-status role="status" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-800">Conectando…</span></div><p class="mt-2 text-xs leading-relaxed text-slate-500">Visitantes con actividad en los últimos 2 minutos, también en segundo plano. Actualización cada 5 segundos.</p></div><div class="flex flex-wrap gap-2"><button type="button" data-live-refresh class="min-h-10 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold hover:bg-slate-50">Actualizar tráfico</button><button type="button" data-live-pause aria-pressed="false" class="min-h-10 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold hover:bg-slate-50">Pausar</button></div></header>
        <div class="grid gap-6 p-5 sm:p-6 lg:grid-cols-2">
            <div class="min-w-0 space-y-5"><div class="grid grid-cols-3 gap-3"><div><p class="min-h-10 text-xs leading-relaxed text-slate-500">Visitantes activos</p><p data-live-active aria-live="polite" class="mt-2 text-4xl font-bold text-emerald-800">@active</p></div><div><p class="min-h-10 text-xs leading-relaxed text-slate-500">Páginas vistas · 30 min</p><p data-live-views class="mt-2 text-2xl font-bold text-slate-900">@(traffic?.VistasUltimos30Minutos ?? 0)</p></div><div><p class="min-h-10 text-xs leading-relaxed text-slate-500">Visitantes · 30 min</p><p data-live-visitors class="mt-2 text-2xl font-bold text-slate-900">@(traffic?.VisitantesUltimos30Minutos ?? 0)</p></div></div>
                <div class="rounded-xl bg-slate-50 p-4"><p class="mb-3 text-xs font-medium text-slate-500">Máximo de visitantes activos por minuto · últimos 15 min</p><partial name="_MetricChart" model='new MetricChartViewModel("live", "Visitantes activos por minuto", "integer", livePoints, true)' /></div>
            </div>
            <div class="min-w-0"><h3 class="mb-4 text-sm font-semibold">Secciones que están viendo</h3><ul data-live-pages class="space-y-4">
                @foreach (var item in pages) { <li class="flex items-center justify-between gap-3 text-sm"><span class="text-slate-600">@item.Key</span><strong class="text-slate-900">@item.Value</strong></li> }
                @if (pages.Count==0) { <li class="rounded-xl border border-dashed border-slate-200 px-4 py-7 text-center text-sm text-slate-500">No hay visitantes activos en este momento.</li> }
            </ul><p data-live-error role="alert" hidden class="mt-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-900"></p><a data-live-login asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" hidden class="mt-3 text-sm font-semibold text-emerald-800 underline">Volver a iniciar sesión</a></div>
        </div>
        <footer class="space-y-2 border-t border-slate-100 bg-slate-50 px-5 py-4 text-xs leading-relaxed text-slate-500 sm:px-6"><p>Última actualización: <time data-live-time>pendiente</time>. Datos de tráfico desde <time data-live-start>@(traffic == null ? "el arranque de la aplicación" : TimeZoneInfo.ConvertTime(traffic.InicioMedicion, TimeZoneInfo.FindSystemTimeZoneById("Europe/Madrid")).ToString("dd/MM/yyyy HH:mm"))</time>.</p><p>Solo se cuentan visitas con permiso para estadísticas. Varias pestañas del mismo navegador cuentan como un visitante; una ventana de incógnito cuenta por separado. Se excluyen el panel de administración, los accesos, los recursos y los robots reconocibles. Al reiniciar la aplicación se reinicia este tráfico.</p></footer>
    </section>

    <section class="grid gap-6 lg:grid-cols-2" aria-label="Evolución del periodo">
        <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"><div class="mb-6 flex items-start justify-between gap-3"><div><h2 class="font-semibold">Importe diario de pedidos</h2><p class="mt-1 text-xs text-slate-500">Sin cancelados · @Model.DiasPeriodo días</p></div><span class="text-xs text-slate-500">Máx. @salesMax.ToString("C")</span></div><partial name="_MetricChart" model='new MetricChartViewModel("sales", "Importe diario de pedidos", "currency", Model.VentasPorDia.Select(v=>new MetricChartPoint(v.Fecha.ToString("dd/MM/yyyy"),v.Fecha.ToString("dd MMM"),v.Total)).ToArray())' /></article>
        <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"><div class="mb-6 flex items-start justify-between gap-3"><div><h2 class="font-semibold">Pedidos por día</h2><p class="mt-1 text-xs text-slate-500">Todos los estados · @Model.DiasPeriodo días</p></div><span class="text-xs text-slate-500">Máx. @ordersMax.ToString("N0")</span></div><partial name="_MetricChart" model='new MetricChartViewModel("orders", "Pedidos por día", "integer", Model.PedidosPorDia.Select(v=>new MetricChartPoint(v.Fecha.ToString("dd/MM/yyyy"),v.Fecha.ToString("dd MMM"),v.Cantidad)).ToArray())' /></article>
    </section>
    <details class="rounded-2xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer text-sm font-semibold text-emerald-800">Ver los datos diarios del informe</summary><div class="mt-4 max-h-80 overflow-auto"><table class="w-full text-left text-sm"><thead class="sticky top-0 bg-white text-xs text-slate-500"><tr><th class="py-3">Fecha</th><th class="py-3 text-right">Importe</th><th class="py-3 text-right">Pedidos</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var day in Model.VentasPorDia) { <tr><td class="py-3">@day.Fecha.ToString("dd/MM/yyyy")</td><td class="py-3 text-right">@day.Total.ToString("C")</td><td class="py-3 text-right">@(Model.PedidosPorDia.FirstOrDefault(d=>d.Fecha==day.Fecha)?.Cantidad ?? 0)</td></tr> }</tbody></table></div></details>
    <section class="grid gap-6 lg:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"><h2 class="font-semibold">Estado de los pedidos</h2><p class="mt-1 text-xs text-slate-500">Histórico · @Model.TotalPedidos pedidos</p><ul class="mt-5 space-y-4">@foreach(var state in states) { <li class="flex justify-between gap-3 text-sm"><span class="text-slate-600">@state.Item1</span><strong>@state.Item2</strong></li> }</ul><a asp-controller="AdminPedidos" asp-action="Index" class="mt-6 inline-block text-sm font-semibold text-emerald-800 underline">Gestionar pedidos</a></article>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"><h2 class="font-semibold">Categorías con más ventas</h2><p class="mt-1 text-xs text-slate-500">Periodo seleccionado</p><ol class="mt-5 space-y-4">@foreach(var item in Model.CategoriasMasPopulares) { <li class="flex items-start justify-between gap-3 text-sm"><div class="min-w-0"><p class="break-words font-medium">@item.Nombre</p><p class="mt-1 text-xs text-slate-500">@item.CantidadVendida unidades · @item.NumeroProductos productos</p></div><strong class="shrink-0">@item.TotalVentas.ToString("C")</strong></li> }</ol>@if(Model.CategoriasMasPopulares.Count==0){<p class="mt-6 text-sm text-slate-500">Todavía no hay ventas en este periodo.</p>}</article>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"><h2 class="font-semibold">Resumen de la tienda</h2><dl class="mt-5 space-y-4 text-sm">@foreach(var item in new[]{("Referencias activas",Model.TotalProductos.ToString("N0")),("Categorías",Model.TotalCategorias.ToString("N0")),("Cuentas registradas",Model.TotalUsuarios.ToString("N0")),("Clientes con pedidos no cancelados",Model.UsuariosActivos.ToString("N0")),("Importe histórico sin cancelados",Model.VentasTotales.ToString("C"))}){<div class="flex justify-between gap-3"><dt class="text-slate-600">@item.Item1</dt><dd class="text-right font-semibold">@item.Item2</dd></div>}</dl></article>
    </section>
    <section class="grid items-start gap-6 xl:grid-cols-2">
        <article class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><header class="border-b border-slate-100 p-5"><h2 class="font-semibold">Productos más vendidos</h2><p class="mt-1 text-xs text-slate-500">Periodo seleccionado · hasta 10 productos</p></header><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs text-slate-500"><tr><th class="p-4">Producto</th><th class="p-4 text-right">Unidades</th><th class="p-4 text-right">Importe</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var item in Model.ProductosMasVendidos){<tr><td class="p-4"><a asp-controller="AdminProductos" asp-action="Editar" asp-route-id="@item.Id" class="font-semibold text-emerald-800 hover:underline">@item.Nombre</a><p class="mt-1 text-xs text-slate-500">@item.CategoriaNombre</p></td><td class="p-4 text-right">@item.CantidadVendida</td><td class="whitespace-nowrap p-4 text-right font-medium">@item.TotalVentas.ToString("C")</td></tr>}</tbody></table></div>@if(Model.ProductosMasVendidos.Count==0){<p class="p-6 text-sm text-slate-500">No hay productos vendidos en este periodo.</p>}</article>
        <article class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><header class="border-b border-slate-100 p-5"><h2 class="font-semibold">Clientes con más compras</h2><p class="mt-1 text-xs text-slate-500">Pedidos no cancelados del periodo</p></header><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs text-slate-500"><tr><th class="p-4">Cliente</th><th class="p-4 text-right">Pedidos</th><th class="p-4 text-right">Importe</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var item in Model.MejoresClientes){<tr><td class="max-w-48 break-words p-4 text-slate-700">@item.Email</td><td class="p-4 text-right">@item.TotalPedidos</td><td class="whitespace-nowrap p-4 text-right font-medium">@item.TotalGastado.ToString("C")</td></tr>}</tbody></table></div>@if(Model.MejoresClientes.Count==0){<p class="p-6 text-sm text-slate-500">No hay compras de clientes en este periodo.</p>}</article>
    </section>
</div></div>
@section Scripts { <script src="~/js/metric-charts.js" asp-append-version="true"></script><script src="~/js/admin-metrics.js" asp-append-version="true"></script> }
